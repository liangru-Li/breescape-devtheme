{% schema %}
{
  "name": "Custom Multicolumn 2",
  "tag": "div",
  "class": "product-highlight-multicolumn-section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.global.settings.header__heading.content"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Multicolumn"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "title-sm",
          "label": "t:sections.global.settings.heading_size.options__1.label"
        },
        {
          "value": "title-md",
          "label": "t:sections.global.settings.heading_size.options__2.label"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__3.label"
        },
        {
          "value": "title-xl tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__4.label"
        }
      ],
      "default": "title-md",
      "label": "t:sections.global.settings.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.global.settings.heading_alignment.label",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "t:sections.global.settings.heading_alignment.options__1.label"
        },
        {
          "value": "text-center md:items-center",
          "label": "t:sections.global.settings.heading_alignment.options__2.label"
        },
        {
          "value": "text-right md:items-end md:flex-row-reverse",
          "label": "t:sections.global.settings.heading_alignment.options__3.label"
        }
      ],
      "default": "text-center md:items-center"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.global.settings.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.global.settings.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.global.settings.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.global.settings.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.global.settings.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.global.settings.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.global.settings.heading_tag.options__7.label"
        },
        {
          "value": "span",
          "label": "t:sections.global.settings.heading_tag.options__8.label"
        },
        {
          "value": "p",
          "label": "t:sections.global.settings.heading_tag.options__9.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.global.settings.heading_tag.label",
      "info": "t:sections.global.settings.heading_tag.info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.global.settings.subheading.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.global.settings.description.label"
    },
    {
      "type": "liquid",
      "id": "liquid",
      "label": "Tab Liquid"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.global.settings.button_label.label",
      "info": "t:sections.global.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.global.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "button_external",
      "label": "t:sections.global.settings.button_external.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "button_icon",
      "label": "t:sections.global.settings.button_icon.label",
      "default": true
    },
    {
      "type": "select",
      "id": "gap",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large",
      "label": "Gap Between Elements"
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Number of Columns (Desktop)"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1 Column"
        },
        {
          "value": "2",
          "label": "2 Columns"
        }
      ],
      "default": "1",
      "label": "Number of Columns (Mobile)"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "Enable Swipe on Mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "color",
      "id": "color_background_2",
      "label": "t:sections.global.settings.color_background_2.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background_2",
      "label": "t:sections.global.settings.gradient_background_2.label"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "t:sections.global.settings.color_highlight.label"
    },
    {
      "type": "color_background",
      "id": "gradient_highlight",
      "label": "t:sections.global.settings.gradient_highlight.label"
    },
    {
      "type": "color",
      "id": "color_button_text",
      "label": "t:sections.global.settings.color_button_text.label"
    },
    {
      "type": "color",
      "id": "color_button_background",
      "label": "t:sections.global.settings.color_button_background.label"
    },
    {
      "type": "color_background",
      "id": "color_button_gradient",
      "label": "t:sections.global.settings.color_button_gradient.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "Show Divider",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "Rounded Corners"
    }
  ],
  "blocks": [
    {
      "type": "ugc_column",
      "name": "UGC Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "checkbox",
          "id": "enable_video_autoplay",
          "label": "Enable Video Autoplay",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "enable_video_looping",
          "label": "Enable Video Looping",
          "default": false
        },
        {
          "type": "select",
          "id": "image_ratio",
          "options": [
            {
              "value": "adapt",
              "label": "Adapt to Image"
            },
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            },
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "wide",
              "label": "Wide"
            }
          ],
          "default": "adapt",
          "label": "Image Ratio"
        },
        {
          "type": "select",
          "id": "layout",
          "options": [
            {
              "value": "image_first",
              "label": "t:sections.image-with-text.settings.layout.options__1.label"
            },
            {
              "value": "text_first",
              "label": "t:sections.image-with-text.settings.layout.options__2.label"
            }
          ],
          "default": "image_first",
          "label": "t:sections.image-with-text.settings.layout.label",
          "info": "t:sections.image-with-text.settings.layout.info"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "User Content"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>Add a description here.</p>"
        },
        {
        "type": "liquid",
        "id": "liquid",
        "label": "Tab Liquid",
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Multicolumn 2",
      "blocks": [
        {
          "type": "ugc_column"
        },
        {
          "type": "ugc_column"
        },
        {
          "type": "ugc_column"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  }
}
{% endschema %}

<div
  class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}"
  id="shopify-section-{{ section.id }}" 
  {% if section.settings.background_image %}
    style="background-image: url('{{ section.settings.background_image | img_url: 'master' }}'); background-size: cover; background-position: center;"
  {% endif %}
>
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    <div class="md:flex md:flex-wrap justify-between block">
      <!-- Left Section: Title and Stats -->
      <div class="highlight-content md:w-1/3 md:px-4">
        {%- render 'section-heading', section: section -%}
        {{- section.settings.liquid -}}
      </div>

      <div class="md:w-2/3">
        <!-- Right Section: UGC Multicolumn -->
        <slider-element
          id="Slider-{{ section.id }}"
          class="grid slider{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}"
          selector=".card-grid>.card"
        >
          <div class="multicolumn with-{{ section.blocks.size }} card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid relative z-1">
            {%- liquid
              assign loading = 'lazy'
            -%}
            {%- for block in section.blocks -%}
              <div
                class="multicolumn-card card flex gap-5 w-full flex-col items-start xl:flex-row md:text-left text-left"
                {{ block.shopify_attributes }}
              >
                <div class="shawn__multicolumn-card overflow-hidden w-full h-full md:relative flex md:gap-8{% if block.settings.layout == 'image_first' %} flex-col{% else %} flex-col-reverse{% endif %}">
                  {%- if block.settings.video != blank -%}
                    {%- capture sizes -%}(max-width: 639px) 100vw, (max-width: 1023px) calc(100vw / 2 - 40px), (max-width: 1535px) calc(min(100vw, {{ settings.page_width }}px) / 3 - 40px), calc(min(100vw, {{ settings.page_width }}px) / 3 - 80px){%- endcapture -%}
                    <a
                      class="block media media--{{ block.settings.image_ratio }} media--transparent relative overflow-hidden"
                      {% if block.settings.button_link != blank %}
                        href="{{ block.settings.button_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      aria-label="{{ block.settings.heading | escape }}"
                    >
                      {%- liquid
                        assign video_alt = block.settings.video.alt | default: block.settings.image.alt
                        assign alt = 'general.accessibility.load_video' | t: description: video_alt | escape
                        assign preview_image = block.settings.video.preview_image | default: block.settings.image

                        capture poster
                          if preview_image != blank
                            echo preview_image | image_url: width: preview_image.width | image_tag: loading: loading, widths: '180,360,540,720,900,1080,1600', sizes: sizes, is: 'lazy-image', class: 'inline-block', alt: alt
                          else
                            echo 'lifestyle-1' | placeholder_svg_tag: 'placeholder'
                          endif
                        endcapture
                      -%}
                      {%- liquid
                        assign show_play_button = true
                        if section.settings.enable_video_autoplay
                          assign show_play_button = false
                        endif
                      -%}
                      <video-media class="block" style="--aspect-ratio: {{ block.settings.video.aspect_ratio }}">
                        {{- poster -}}
                        <template>
                          {{-
                            block.settings.video
                            | video_tag:
                              playsinline: true,
                              muted: true,
                              autoplay: block.settings.enable_video_autoplay,
                              loop: block.settings.enable_video_looping,
                              show_play_button: show_play_button,
                              controls: false,
                              preload: 'auto',
                              image_size: sizes,
                              loading: loading
                          -}}
                        </template>
                        {%- if show_play_button -%}
                          <button
                            type="button"
                            id="DeferredPoster-{{ video_id }}"
                            class="deferred-poster absolute top-0 left-0 w-full h-full"
                            aria-label="{{ 'general.accessibility.play_video' | t | escape }}"
                          >
                            <span class="play-button absolute flex items-center justify-center rounded-full pointer-events-auto z-10">
                              {%- render 'icon', icon: 'play' -%}
                              {%- render 'icon', icon: 'pause' -%}
                            </span>
                          </button>
                        {%- endif -%}
                      </video-media>
                    </a>
                  {%- elsif block.settings.image != blank -%}
                    {%- capture sizes -%}(max-width: 639px) 100vw, (max-width: 1023px) calc(100vw / 2 - 40px), (max-width: 1535px) calc(min(100vw, {{ settings.page_width }}px) / 3 - 40px), calc(min(100vw, {{ settings.page_width }}px) / 3 - 80px){%- endcapture -%}
                    <a
                      class="block media media--{{ block.settings.image_ratio }} media--transparent relative overflow-hidden"
                      {% if block.settings.button_link != blank %}
                        href="{{ block.settings.button_link }}"
                      {% else %}
                        role="link" aria-disabled="true"
                      {% endif %}
                      aria-label="{{ block.settings.heading | escape }}"
                    >
                      {{-
                        block.settings.image
                        | image_url: width: block.settings.image.width
                        | image_tag:
                          loading: 'lazy',
                          widths: '180,360,540,720,900,1080,1600',
                          sizes: sizes,
                          is: 'lazy-image',
                          class: 'inline-block'
                      -}}
                    </a>
                  {%- else -%}
                    <div class="block media media--square media--transparent relative overflow-hidden">
                      <p class="ugc-placeholder-text">UGC</p>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.heading != blank or block.settings.text != blank -%}
                    <div class="multicolumn-card__info gap-4 lg:gap-6 flex flex-col justify-center">
                      {%- if block.settings.heading != blank -%}
                        <p class="heading text-lg-2xl leading-tight tracking-tight">
                          {{ block.settings.heading }}
                        </p>
                      {%- endif -%}

                      {%- if block.settings.text != blank -%}
                        <div class="rte leading-normal sm:text-sm">
                          {{- block.settings.text -}}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.liquid != blank -%}
                        <div class="rte leading-normal">
                           {{- block.settings.liquid -}}
                        </div>
                      {%- endif -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        </slider-element>

        {%- if section.blocks.size > 1 -%}
          <div class="scroll-area lg:hidden">
            <slider-dots
              class="timeline-dots flex justify-center items-center gap-2d5"
              align-selected=".scroll-area"
              aria-controls="Slider-{{ section.id }}"
            >
              {%- for block in section.blocks -%}
                <button
                  type="button"
                  class="text-lg text-left font-bold flex items-center gap-2d5"
                  data-index="{{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                >
                  <span class="sr-only">{{ 'general.pagination.page' | t: number: forloop.index }}</span>
                </button>
              {%- endfor -%}
            </slider-dots>
          </div>
        {%- endif -%}

      
        {%- if section.blocks.size > 1 -%}
        <div class="indicators hidden lg:flex gap-2d5 justify-end items-center gap-2d5 py-4">
          <button class="button button--secondary" type="button" is="previous-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-left', class: 'transform' -%}
            </span>
          </button>
          <button class="button button--secondary" type="button" is="next-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-right', class: 'transform' -%}
            </span>
          </button>
        </div>
      {%- endif -%}
    
      </div>
    </div>
  </div>
</div>

<style>
  /* Section Padding */
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  #shopify-section-{{ section.id }} .stat-item {
    width:33.333%;
        padding: 8px;
  }

  /* Multicolumn (Right Side) */
  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .multicolumn {
      --card-grid-gap: {% if section.settings.gap == 'small' %}var(--sp-4){% elsif section.settings.gap == 'medium' %}var(--sp-6){% else %}clamp(24px, 2vw, 48px){% endif %};
    }

    #shopify-section-{{ section.id }} .multicolumn .flex {
      gap: var(--sp-3);
    }

    #shopify-section-{{ section.id }} .slider--tablet .card-grid {
      --slider-item-width: 15vw;
      --slider-grid: auto / auto-flow var(--slider-item-width);
      grid: var(--slider-grid);
    }

    #shopify-section-{{ section.id }} .slider--tablet {
      overflow-y: hidden;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scroll-behavior: smooth;
      scroll-padding-inline: var(--page-padding);
      padding-block-end: var(--card-shadow-vertical-offset);
    }
  }

  @media screen and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .multicolumn .flex {
      gap: var(--sp-2);
    }
  }

  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .multicolumn .md\:relative {
      position: relative;
    }

    #shopify-section-{{ section.id }} .sm\:text-sm {
      font-size: var(--text-sm);
    }
  }

  @media screen and (max-width: 639px) {
    #shopify-section-{{ section.id }} .slider--tablet .mobile\:card-grid--1 {
      --slider-item-width: 52vw !important;
    }
  }

  /* UGC Placeholder */
  #shopify-section-{{ section.id }} .ugc-placeholder-text {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background-color: #e0e0e0;
    color: #999;
    font-size: 1.5em;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .page-width {
      flex-direction: column;
    }

    #shopify-section-{{ section.id }} .highlight-content {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 768px) {
      #shopify-section-{{ section.id }} .md\:w-1\/3 {
          width: 33.333%;
        }
        #shopify-section-{{ section.id }} .md\:w-2\/3 {
          width: 66.666%;
        }

    #shopify-section-{{ section.id }} .md\:px-4 {
              padding-left: var(--sp-4);
              padding-right: var(--sp-4);
        }
  }


    #shopify-section-{{ section.id }} .multicolumn .media {
      border-radius:0 !important;
    }

    #shopify-section-{{ section.id }} .multicolumn .shawn__multicolumn-card{
      background: #ffffff70;
      border-radius: 10px;
    }

    #shopify-section-{{ section.id }} .shawn__product-card__rating__icon{
      height:14px!important;
    }

    #shopify-section-{{ section.id }} .section:before{
      background-color: transparent !important;
    }
</style>






