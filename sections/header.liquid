{%- liquid
  assign header_radius_desktop = section.settings.header_radius | default: 0
  assign header_inset_x_desktop = section.settings.header_inset_x | default: 0
  assign header_inset_y = section.settings.header_inset_y | default: 0
  assign header_radius_mobile = section.settings.header_radius_mobile | default: header_radius_desktop
  assign header_inset_x_mobile = section.settings.header_inset_x_mobile | default: header_inset_x_desktop
  assign header_padding_x_mobile = section.settings.header_padding_x_mobile | default: 12
  assign header_padding_top_mobile = section.settings.header_padding_top_mobile | default: 6
  assign header_padding_bottom_mobile = section.settings.header_padding_bottom_mobile | default: 6
  assign header_logo_width_mobile = section.settings.header_logo_width_mobile | default: settings.logo_width_mobile | default: 80
  assign icons_size_mobile = section.settings.icons_size_mobile | default: 'sm'
  case icons_size_mobile
    when 'sm'
      assign header_icon_size_mobile = '1.25rem'
      assign header_icon_btn_mobile = '2.25rem'
    when 'lg'
      assign header_icon_size_mobile = '1.5rem'
      assign header_icon_btn_mobile = '2.75rem'
    else
      assign header_icon_size_mobile = '1.375rem'
      assign header_icon_btn_mobile = '2.5rem'
  endcase
  assign nav_hover = false
  if section.settings.nav_dropdown_trigger == 'hover'
    assign nav_hover = true
  elsif section.settings.nav_dropdown_trigger == blank and section.settings.hover_menu
    assign nav_hover = true
  endif
-%}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --color-background: {{ section.settings.color_background.rgb }};
    --color-foreground: {{ section.settings.color_text.rgb }};
    --color-transparent: {{ section.settings.transparent_color_text.rgb }};
    --color-localization: {{ section.settings.color_localization.rgb }};
    --header-bg-alpha: {{ section.settings.header_bg_opacity | default: 75 | divided_by: 100.0 }};
    --header-radius: {{ header_radius_desktop }}px;
    --header-inset-x: {{ header_inset_x_desktop }}px;
    --header-inset-y: {{ header_inset_y }}px;
    --header-blur: {{ section.settings.header_blur | default: 25 }}px;
    --header-radius-bottom: {{ header_radius_desktop }}px;
    {%- if header_inset_x_desktop > 0 or header_inset_y > 0 -%}
    --header-radius-top: {{ header_radius_desktop }}px;
    {%- else -%}
    --header-radius-top: 0px;
    {%- endif -%}
    --header-logo-width-mobile: {{ header_logo_width_mobile }}px;
    --header-icon-size-mobile: {{ header_icon_size_mobile }};
    --header-icon-btn-mobile: {{ header_icon_btn_mobile }};
    --menu-drawer-tab-size: {{ section.settings.menu_drawer_tab_font_size | default: 24 }}px;
    --nav-first-item-color: {{ section.settings.nav_first_item_color | default: '#AC4D3C' }};
    --nav-dropdown-tab-bg: {{ section.settings.nav_dropdown_tab_bg | default: '#E8E8E8' }};
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .header__menu .menu__item--first {
      color: var(--nav-first-item-color);
    }

    #shopify-section-{{ section.id }} .header__menu .menu__item--dropdown .btn-text::after {
      content: none !important;
      display: none !important;
    }

    #shopify-section-{{ section.id }} .header__menu .menu__item--dropdown {
      position: relative;
    }

    #shopify-section-{{ section.id }} .header__menu .menu__item--dropdown::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 0;
      width: calc(100% + 1.5rem);
      height: 2.375rem;
      border-radius: 999px;
      background-color: var(--nav-dropdown-tab-bg);
      pointer-events: none;
      opacity: 0;
      transform: translate(-50%, -50%);
    }

    #shopify-section-{{ section.id }} .header__menu .menu__item--dropdown .btn-text {
      position: relative;
      z-index: 1;
    }

    #shopify-section-{{ section.id }} .header__menu > ul > li > details > summary[aria-expanded="true"] .menu__item--dropdown::before {
      opacity: 1;
    }

    #shopify-section-{{ section.id }} .header__menu > ul.with-block .menu__item--dropdown::before {
      width: 100%;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .header__menu > ul.with-block > li > details > summary[aria-expanded="true"] .menu__item--dropdown .btn-duplicate {
      opacity: 0;
      transform: none;
    }

    #shopify-section-{{ section.id }} .header__menu > ul.with-block > li > details > summary[aria-expanded="true"] .menu__item--dropdown [data-text] {
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .header__menu > ul > li > details > summary .menu__item .icon {
      display: none;
    }

    {%- unless nav_hover -%}
    #shopify-section-{{ section.id }} .mega-menu[open],
    #shopify-section-{{ section.id }} .header .dropdown[open] {
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .mega-menu[open] .mega-menu__container,
    #shopify-section-{{ section.id }} .header .dropdown[open] .dropdown__container {
      pointer-events: none;
    }

    #shopify-section-{{ section.id }} .mega-menu[open] .mega-menu__container > *,
    #shopify-section-{{ section.id }} .header .dropdown[open] .dropdown__container > * {
      pointer-events: auto;
    }
    {%- endunless -%}
  }

  @media screen and (max-width: 1023px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: {{ header_padding_top_mobile }}px;
      --section-padding-bottom: {{ header_padding_bottom_mobile }}px;
      --header-inset-x: {{ header_inset_x_mobile }}px;
      --header-padding-x-mobile: {{ header_padding_x_mobile }}px;
      --header-radius-bottom: {{ header_radius_mobile }}px;
      {%- if header_inset_x_mobile > 0 or header_inset_y > 0 -%}
      --header-radius-top: {{ header_radius_mobile }}px;
      {%- else -%}
      --header-radius-top: 0px;
      {%- endif -%}
    }
  }

  #MenuDrawer {
    --menu-drawer-tab-size: {{ section.settings.menu_drawer_tab_font_size | default: 24 }}px;
  }
</style>

{%- liquid
  assign header_layout = section.settings.header_layout
  assign main_menu = section.settings.menu
  assign link_count = main_menu.links.size

  if header_layout == 'center-split'
    assign link_count = link_count | divided_by: 2
  endif

  assign main_menu_class = 'lg:justify-start'
  case header_layout
    when 'center-split'
      assign main_menu_class = 'lg:justify-end'

    when 'center'
      assign main_menu_class = 'lg:justify-center'
  endcase

  assign show_toggle = false
  if header_layout == 'center'
    assign show_toggle = true
  endif

  render 'header-drawer', section: section
-%}

<header data-section-id="{{ section.id }}" class="header header--{{ header_layout }} mobile:header--{{ section.settings.logo_position_mobile }} page-width{% if section.settings.full_width %} page-width--full{% endif %} section{% if section.settings.rounded %} section--rounded{% endif %}{% if section.settings.header_glass %} header--glass{% endif %} section--padding grid items-center z-20 relative w-full"{% if section.settings.sticky_header_type != 'none' %} is="sticky-header" data-sticky-type="{{ section.settings.sticky_header_type }}"{% else %} is="custom-header"{% endif %}>
  {%- liquid
    render 'header-icons', section: section, show_search: true, show_hamburger: true, show_toggle: show_toggle, context: 'start'

    if header_layout != 'center-left' and header_layout != 'center-split'
      render 'header-logo', logo_h1: section.settings.logo_h1
    endif

    if header_layout == 'center'
      render 'header-icons', section: section, show_search: true, show_account: true, show_cart: true, show_hamburger: true, context: 'end'
    endif
  -%}
  
  <div class="header__navigation hidden lg:flex lg:gap-5 {{ main_menu_class }}"{% if header_layout == 'center' %} id="MenuToggle"{% endif %}>
    <nav class="header__menu hidden lg:flex" role="navigation" aria-label="Primary">
      {%- render 'header-nav-desktop', section: section, main_menu: main_menu, limit: link_count, context: 'start' -%}
    </nav>
  </div>

  {%- liquid
    if header_layout == 'center-left' or header_layout == 'center-split'
      render 'header-logo', logo_h1: section.settings.logo_h1
    endif
  -%}
  
  {%- if header_layout == 'center-split' -%}
    <div class="header__navigation header__navigation--split hidden lg:flex lg:gap-5 lg:justify-start">
      <nav class="header__menu hidden lg:flex" role="navigation" aria-label="Secondary">
        {%- render 'header-nav-desktop', section: section, main_menu: main_menu, offset: link_count, context: 'end' -%}
      </nav>
    </div>
  {%- endif -%}

  {%- liquid
    if header_layout != 'center'
      render 'header-icons', section: section, show_search: true, show_account: true, show_cart: true, show_hamburger: true, context: 'end'
    endif
  -%}

  {%- if section.settings.rounded -%}
    {%- render 'corner', dir: 'bottom', border: true, prefix: 'header' -%}
  {%- else -%}
    <span class="header__cutout cutout opacity-0 absolute left-0 top-100 w-full pointer-events-none"></span>
  {%- endif -%}
</header>

{%- if nav_hover -%}
  <span class="overlay opacity-0 z-1 fixed left-0 w-full pointer-events-none"></span>
{%- else -%}
  <overlay-element class="overlay opacity-0 z-1 fixed left-0 w-full pointer-events-none"></overlay-element>
{%- endif -%}

{%- if request.design_mode -%}
  <script>
    document.documentElement.style.setProperty('--header-height', document.getElementById('shopify-section-{{ section.id }}').getBoundingClientRect().height.toFixed(1) + 'px');
  </script>
{%- endif -%}

