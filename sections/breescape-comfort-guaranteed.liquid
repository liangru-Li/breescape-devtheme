<!-- ============================================================
  Section: Breescape — Comfort is Guaranteed
  4 张人物推荐卡（PC：一行 4 张；移动端：2 × 2）
  整块 + 卡片所有视觉参数都可在主题编辑器里调
  ============================================================ -->

{%- liquid
  assign s = section.settings
  assign blocks = section.blocks
  assign card_count = blocks.size
  if card_count < 1
    assign card_count = 1
  endif
-%}

<section
  class="be-cig{% if s.background_image == blank and s.background_image_mobile == blank %} be-cig--no-bg{% endif %}"
  aria-label="{{ s.heading | escape }}"
  style="
    --be-cig-bg-color:          {{ s.background_color }};
    --be-cig-bg-overlay:        rgba(0,0,0,{{ s.background_dim | divided_by: 100.0 }});
    --be-cig-pad-top-pc:        {{ s.section_padding_top_pc }}px;
    --be-cig-pad-bottom-pc:     {{ s.section_padding_bottom_pc }}px;
    --be-cig-pad-top-m:         {{ s.section_padding_top_mobile }}px;
    --be-cig-pad-bottom-m:      {{ s.section_padding_bottom_mobile }}px;

    --be-cig-title-size-pc:     {{ s.heading_size_pc }}px;
    --be-cig-title-size-m:      {{ s.heading_size_mobile }}px;
    --be-cig-title-mb-pc:       {{ s.heading_margin_bottom_pc }}px;
    --be-cig-title-mb-m:        {{ s.heading_margin_bottom_mobile }}px;
    --be-cig-title-color:       {{ s.heading_color }};

    --be-cig-grid-gap-pc:       {{ s.card_gap_pc }}px;
    --be-cig-grid-gap-m:        {{ s.card_gap_mobile }}px;

    --be-cig-card-radius-pc:    {{ s.card_radius_pc }}px;
    --be-cig-card-radius-m:     {{ s.card_radius_mobile }}px;

    --be-cig-name-bg:           rgba({{ s.name_bg_rgb }}, {{ s.name_bg_opacity | divided_by: 100.0 }});
    --be-cig-name-radius:       {{ s.name_radius }}px;
    --be-cig-name-pad-x:        {{ s.name_padding_x }}px;
    --be-cig-name-pad-y:        {{ s.name_padding_y }}px;
    --be-cig-name-offset-x:     {{ s.name_offset_x }}px;
    --be-cig-name-offset-y:     {{ s.name_offset_y }}px;
    --be-cig-name-size-pc:      {{ s.name_size_pc }}px;
    --be-cig-name-size-m:       {{ s.name_size_mobile }}px;
    --be-cig-name-color:        {{ s.name_color }};

    --be-cig-desc-size-pc:      {{ s.desc_size_pc }}px;
    --be-cig-desc-size-m:       {{ s.desc_size_mobile }}px;
    --be-cig-desc-line:         {{ s.desc_line_height }};
    --be-cig-desc-mt-pc:        {{ s.desc_margin_top_pc }}px;
    --be-cig-desc-mt-m:         {{ s.desc_margin_top_mobile }}px;
    --be-cig-desc-pad-x-pc:     {{ s.desc_padding_x_pc }}px;
    --be-cig-desc-pad-x-m:      {{ s.desc_padding_x_mobile }}px;
    --be-cig-desc-pad-bottom:   {{ s.desc_padding_bottom }}px;
    --be-cig-desc-color:        {{ s.desc_color }};
    --be-cig-desc-min-h-pc:     {{ s.desc_min_height_pc | default: 0 }}px;
    --be-cig-desc-min-h-m:      {{ s.desc_min_height_mobile | default: 0 }}px;

    --be-cig-max-width:         {{ s.max_width }}px;

    --be-cig-overlay-pad-x-pc:  {{ s.overlay_pad_x_pc }}px;
    --be-cig-overlay-pad-x-m:   {{ s.overlay_pad_x_mobile }}px;
    --be-cig-overlay-pad-bottom-pc: {{ s.overlay_pad_bottom_pc }}px;
    --be-cig-overlay-pad-bottom-m:  {{ s.overlay_pad_bottom_mobile }}px;
  "
>
  {% if s.background_image != blank or s.background_image_mobile != blank %}
    <picture class="be-cig__bg" aria-hidden="true">
      {% if s.background_image_mobile != blank %}
        <source
          media="(max-width: 768px)"
          srcset="
            {{ s.background_image_mobile | image_url: width: 600 }} 600w,
            {{ s.background_image_mobile | image_url: width: 900 }} 900w,
            {{ s.background_image_mobile | image_url: width: 1200 }} 1200w
          "
        >
      {% endif %}
      {% if s.background_image != blank %}
        <img
          src="{{ s.background_image | image_url: width: 1920 }}"
          srcset="
            {{ s.background_image | image_url: width: 1280 }} 1280w,
            {{ s.background_image | image_url: width: 1600 }} 1600w,
            {{ s.background_image | image_url: width: 1920 }} 1920w,
            {{ s.background_image | image_url: width: 2400 }} 2400w
          "
          sizes="100vw"
          alt=""
          loading="lazy"
        >
      {% else %}
        <img
          src="{{ s.background_image_mobile | image_url: width: 1200 }}"
          alt=""
          loading="lazy"
        >
      {% endif %}
    </picture>
    {% if s.background_dim > 0 %}
      <span class="be-cig__bg-dim" aria-hidden="true"></span>
    {% endif %}
  {% endif %}

  <div class="be-cig__inner">
    {% if s.heading != blank %}
      <h2 class="be-cig__title">{{ s.heading | escape }}</h2>
    {% endif %}

    {% if blocks.size > 0 %}
      <div
        class="be-cig__grid"
        style="--be-cig-cols-pc: {{ card_count }};"
      >
        {% for block in blocks %}
          {%- liquid
            assign img    = block.settings.image
            assign name   = block.settings.name
            assign desc   = block.settings.description
            assign img_alt = block.settings.alt | default: name
          -%}
          <article class="be-cig__card" {{ block.shopify_attributes }}>
            <div class="be-cig__media{% if img == blank %} be-cig__media--placeholder{% endif %}">
              {% if img != blank %}
                <img
                  class="be-cig__img"
                  src="{{ img | image_url: width: 800 }}"
                  srcset="
                    {{ img | image_url: width: 400 }} 400w,
                    {{ img | image_url: width: 600 }} 600w,
                    {{ img | image_url: width: 800 }} 800w,
                    {{ img | image_url: width: 1200 }} 1200w
                  "
                  sizes="(max-width: 768px) 50vw, 25vw"
                  width="{{ img.width }}"
                  height="{{ img.height }}"
                  alt="{{ img_alt | escape }}"
                  loading="lazy"
                />
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'be-cig__img placeholder' }}
              {% endif %}

              {% if name != blank or desc != blank %}
                <div class="be-cig__overlay">
                  {% if name != blank %}
                    <span class="be-cig__name">{{ name | escape }}</span>
                  {% endif %}
                  {% if desc != blank %}
                    <p class="be-cig__desc">{{ desc | escape | newline_to_br }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .be-cig,
  .be-cig *,
  .be-cig *::before,
  .be-cig *::after { box-sizing: border-box; }

  /* 整块：居中、突破父级 .page-width 的 padding-inline 兜底
     使用与同项目其他自定义 section 一致的 100vw + 负边距方案 */
  .be-cig {
    position: relative;
    isolation: isolate; /* 让 z-index: -1 的背景不会跑到祖先元素之外 */
    width: 100vw;
    max-width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding-top: var(--be-cig-pad-top-pc);
    padding-bottom: var(--be-cig-pad-bottom-pc);
    padding-left: clamp(16px, 4vw, 60px);
    padding-right: clamp(16px, 4vw, 60px);
    background: var(--be-cig-bg-color, transparent);
    color: #10374B;
    overflow: hidden; /* 防止背景图溢出 */
  }

  /* 整块外围背景图（cover，左右铺满）
     PC / Mobile 两张图通过 <picture><source> 切换 */
  .be-cig__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    display: block;
  }
  .be-cig__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  /* 可调的暗化遮罩（让卡片上的浅色文字更清晰） */
  .be-cig__bg-dim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--be-cig-bg-overlay);
    pointer-events: none;
  }

  .be-cig__inner {
    position: relative; /* 让内容压在背景之上 */
    z-index: 1;
    width: 100%;
    max-width: var(--be-cig-max-width, 1516px);
    margin: 0 auto;
  }

  .be-cig .be-cig__title {
    margin: 0 auto var(--be-cig-title-mb-pc) !important;
    text-align: center;
    font-style: italic !important;
    font-weight: 600 !important;
    font-size: var(--be-cig-title-size-pc) !important;
    line-height: 1 !important;
    letter-spacing: -0.02em !important;
    color: var(--be-cig-title-color) !important;
  }

  /* 卡片网格 —— PC 一行 N 张（默认 4） */
  .be-cig__grid {
    display: grid;
    grid-template-columns: repeat(var(--be-cig-cols-pc, 4), minmax(0, 1fr));
    gap: var(--be-cig-grid-gap-pc);
  }

  .be-cig__card {
    display: flex;
    flex-direction: column;
  }

  /* 媒体区：图片本体 + 左下角 overlay（name + desc 都叠在图片上） */
  .be-cig__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--be-cig-card-radius-pc);
    aspect-ratio: 3 / 4;
    background: #eee;
  }

  .be-cig__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Overlay：贴在图片左下，name + desc 一起在内 */
  .be-cig__overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 0 var(--be-cig-overlay-pad-x-pc) var(--be-cig-overlay-pad-bottom-pc);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--be-cig-desc-mt-pc);
    pointer-events: none;
  }

  /* 名字 pill：半透明背景 + 圆角 */
  .be-cig__name {
    display: inline-block;
    padding: var(--be-cig-name-pad-y) var(--be-cig-name-pad-x);
    border-radius: var(--be-cig-name-radius);
    background: var(--be-cig-name-bg);
    color: var(--be-cig-name-color);
    font-weight: 600;
    font-size: var(--be-cig-name-size-pc);
    line-height: 1.2;
    letter-spacing: 0.01em;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  /* 描述：直接压在图片上，无背景
     min-height 让内容较少的卡片也占足空间，
     从而使所有卡片的 Name 处于相同垂直位置 */
  .be-cig .be-cig__desc {
    margin: 0 !important;
    padding: 0;
    font-weight: 400 !important;
    font-style: italic !important;
    font-size: var(--be-cig-desc-size-pc) !important;
    line-height: var(--be-cig-desc-line) !important;
    color: var(--be-cig-desc-color) !important;
    text-align: left;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35); /* 让浅色文字在浅图上也可读 */
    min-height: var(--be-cig-desc-min-h-pc, 0px);
    width: 100%;
  }

  /* ---------- 移动端：2 × 2 ---------- */
  @media (max-width: 768px) {
    .be-cig {
      padding-top: var(--be-cig-pad-top-m);
      padding-bottom: var(--be-cig-pad-bottom-m);
    }

    .be-cig .be-cig__title {
      margin-bottom: var(--be-cig-title-mb-m) !important;
      font-size: var(--be-cig-title-size-m) !important;
      letter-spacing: -0.01em !important;
    }

    .be-cig__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--be-cig-grid-gap-m);
    }

    .be-cig__media {
      border-radius: var(--be-cig-card-radius-m);
    }

    .be-cig__overlay {
      padding: 0 var(--be-cig-overlay-pad-x-m) var(--be-cig-overlay-pad-bottom-m);
      gap: var(--be-cig-desc-mt-m);
    }

    .be-cig__name {
      font-size: var(--be-cig-name-size-m);
    }

    .be-cig .be-cig__desc {
      font-size: var(--be-cig-desc-size-m) !important;
      min-height: var(--be-cig-desc-min-h-m, 0px);
    }
  }
</style>

{% schema %}
{
  "name": "Comfort Guaranteed",
  "tag": "section",
  "class": "be-cig-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "PC background image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background image",
      "info": "Falls back to PC image when empty."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color (fallback)",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "background_dim",
      "label": "Background dim (%)",
      "info": "Darkens background image to make light overlay text more legible.",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 0,
      "unit": "%"
    },

    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Section max width (px)",
      "min": 800,
      "max": 1920,
      "step": 16,
      "default": 1520,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_top_pc",
      "label": "PC padding top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_pc",
      "label": "PC padding bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Comfort is Guaranteed"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#10374B"
    },
    {
      "type": "range",
      "id": "heading_size_pc",
      "label": "PC heading size",
      "min": 24,
      "max": 100,
      "step": 1,
      "default": 56,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 14,
      "max": 48,
      "step": 1,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_pc",
      "label": "PC heading margin-bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_margin_bottom_mobile",
      "label": "Mobile heading margin-bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 24,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Card grid"
    },
    {
      "type": "range",
      "id": "card_gap_pc",
      "label": "PC gap between cards",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_gap_mobile",
      "label": "Mobile gap between cards",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius_pc",
      "label": "PC image radius",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius_mobile",
      "label": "Mobile image radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 16,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Name pill (image overlay)"
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name text color",
      "default": "#FFFFFF"
    },
    {
      "type": "text",
      "id": "name_bg_rgb",
      "label": "Name background RGB (e.g. 16,55,75)",
      "default": "16,55,75",
      "info": "Three numbers separated by commas — used together with opacity below."
    },
    {
      "type": "range",
      "id": "name_bg_opacity",
      "label": "Name background opacity (%)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 35,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "name_radius",
      "label": "Name pill radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "name_padding_x",
      "label": "Name pill padding X",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "name_padding_y",
      "label": "Name pill padding Y",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "name_size_pc",
      "label": "PC name size",
      "min": 8,
      "max": 28,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "name_size_mobile",
      "label": "Mobile name size",
      "min": 6,
      "max": 20,
      "step": 1,
      "default": 12,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "color",
      "id": "desc_color",
      "label": "Description color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "desc_size_pc",
      "label": "PC description size",
      "min": 8,
      "max": 28,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desc_size_mobile",
      "label": "Mobile description size",
      "min": 6,
      "max": 20,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desc_line_height",
      "label": "Description line-height (× font-size)",
      "min": 1,
      "max": 2.4,
      "step": 0.1,
      "default": 1.4
    },
    {
      "type": "range",
      "id": "desc_margin_top_pc",
      "label": "PC description margin-top",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desc_margin_top_mobile",
      "label": "Mobile description margin-top",
      "min": 0,
      "max": 24,
      "step": 1,
      "default": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desc_min_height_pc",
      "label": "PC description min height",
      "info": "Reserve a minimum height for description, so cards with shorter text still align Name with other cards. Set 0 to disable.",
      "min": 0,
      "max": 300,
      "step": 4,
      "default": 96,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "desc_min_height_mobile",
      "label": "Mobile description min height",
      "info": "Reserve a minimum height on mobile. Set 0 to disable.",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 96,
      "unit": "px"
    },

    {
      "type": "header",
      "content": "Overlay (name + description on image)"
    },
    {
      "type": "range",
      "id": "overlay_pad_x_pc",
      "label": "PC overlay horizontal padding",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "overlay_pad_x_mobile",
      "label": "Mobile overlay horizontal padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "overlay_pad_bottom_pc",
      "label": "PC overlay bottom padding",
      "min": 0,
      "max": 60,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "overlay_pad_bottom_mobile",
      "label": "Mobile overlay bottom padding",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 10,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Person card",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Brittany Carsey"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "\"Breescape's cooling product regulates temperature and gets better the longer you're under it. You won't wake up hot and you'll sleep longer.\""
        }
      ]
    }
  ],
