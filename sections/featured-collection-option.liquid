<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  .featured-collection-scrollbar {
    display: block !important;
    position: relative;
    height: 4px;
    width: 100%;
    margin: clamp(var(--sp-4), 3vw, var(--sp-6)) 0 0;
    background: rgba(16, 55, 75, 0.12);
    border-radius: 999px;
    overflow: hidden;
    box-sizing: border-box;
    cursor: pointer;
    touch-action: pan-y;
  }

  .featured-collection-scrollbar[data-empty] {
    visibility: hidden;
  }

  .featured-collection-scrollbar__thumb {
    display: block !important;
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 20%;
    min-width: 32px;
    background: #10374B;
    border-radius: 999px;
    box-sizing: border-box;
    transition: left 0.08s linear, width 0.08s linear;
    cursor: grab;
  }

  .featured-collection-scrollbar__thumb:hover,
  .featured-collection-scrollbar.is-dragging .featured-collection-scrollbar__thumb {
    background: #0b2836;
  }

  .featured-collection-scrollbar.is-dragging .featured-collection-scrollbar__thumb {
    cursor: grabbing;
    transition: none;
  }
</style>

{%- liquid
  assign collection = section.settings.collection
  assign products = section.settings.products | default: collection.products
-%}
<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- capture view_all -%}
      {%- if section.settings.show_view_all and collection != blank and section.settings.product_limit < collection.all_products_count -%}
        <a class="button button--secondary icon-with-text" href="{{ collection.url }}" is="hover-link" aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}">
          <span class="btn-fill" data-fill></span>
          <span class="btn-text">
            {%- liquid
              render 'icon', icon: 'newspaper'
              echo 'sections.featured_collection.view_all' | t
            -%}
          </span>
        </a>
      {%- endif -%}
    {%- endcapture -%}
    {%- capture indicators -%}
      {%- if section.settings.carousel_on_desktop -%}
        <div class="indicators hidden lg:flex gap-2d5">
          <button class="button button--secondary" type="button" is="previous-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-left', class: 'transform' -%}
            </span>
          </button>
          <button class="button button--secondary" type="button" is="next-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
            <span class="btn-fill" data-fill></span>
            <span class="btn-text">
              {%- render 'icon', icon: 'chevron-right', class: 'transform' -%}
            </span>
          </button>
        </div>
        <p class="lg:hidden">{{ view_all }}</p>
      {%- else -%}
        <p>{{ view_all }}</p>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'section-heading', section: section, section_button: indicators -%}

    <slider-element id="Slider-{{ section.id }}" class="grid slider{% if section.settings.carousel_on_desktop %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}" selector=".card-grid>.card">
      <motion-list class="product-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
        {%- for product in products limit: section.settings.product_limit -%}
          {%- comment -%}
            侦测产品的"颜色类"选项 (名字包含 color/colour)
              color_count = 0  -> 无颜色选项, 直接渲染原 product-card
              color_count = 1  -> 单品多颜色, 按颜色值拆分 (兼容旧逻辑)
              color_count >= 2 -> Bundle 产品, 按所有颜色搭配的笛卡尔积拆分
          {%- endcomment -%}
          {%- liquid
            assign color_positions = ''
            assign color_count = 0
            for opt in product.options_with_values
              assign is_color_opt = false
              capture _is_color_opt
                render 'color-option-match', option_name: opt.name
              endcapture
              if _is_color_opt contains 'true'
                assign is_color_opt = true
              endif
              if is_color_opt
                assign color_positions = color_positions | append: opt.position | append: ','
                assign color_count = color_count | plus: 1
              endif
            endfor
          -%}

          {%- if color_count >= 2 -%}
            {%- comment -%} Bundle 产品 - 按所有颜色搭配组合渲染卡片 {%- endcomment -%}
            {%- assign positions_arr = color_positions | split: ',' -%}
            {%- assign seen_combos = ',' -%}
            {%- for variant in product.variants -%}
              {%- liquid
                assign combo_key = ''
                assign combo_label = ''
                for pos in positions_arr
                  assign optkey = 'option' | append: pos
                  assign val = variant[optkey]
                  assign combo_key = combo_key | append: val | append: '|'
                  if forloop.first
                    assign combo_label = val
                  else
                    assign combo_label = combo_label | append: ' + ' | append: val
                  endif
                endfor
                assign combo_marker = combo_key | prepend: ',' | append: ','
              -%}
              {%- unless seen_combos contains combo_marker -%}
                {%- assign seen_combos = seen_combos | append: combo_key | append: ',' -%}
                {%- render 'product-card-cus',
                  product: variant,
                  product_variants: product,
                  product_id: variant.id,
                  section_id: section.id,
                  is_variant: true,
                  is_bundle_combo: true,
                  bundle_combo_label: combo_label,
                  product_title: product.title,
                  product_material: product.metafields.custom.product_material,
                  product_promotion: product.metafields.custom.promotion_tips,
                  product_custom_badge: product.metafields.custom.custom_badge_image,
                  shawn_product_price: product.metafields.custom.shawn_product_price,
                  product_certification_badge: product.metafields.custom.certification_badge,
                  reviews_count: product.metafields.yotpo.reviews_count,
                  product_custom_badge_list: product.metafields.custom.badge_image,
                  reviews_average: product.metafields.yotpo.reviews_average,
                  lazy_load: false,
                  image_ratio: settings.product_image_ratio,
                  image_fill: settings.product_image_fill,
                  show_secondary_image: settings.product_secondary_image,
                  show_vendor: settings.product_vendor,
                  show_rating: settings.product_rating,
                  show_color_swatches: settings.product_color_swatches,
                  show_countdown: settings.product_countdown,
                  show_quick_add: settings.product_quick_add,
                  show_quick_view: settings.product_quick_view,
                  show_save_amount: settings.product_save_amount,
                  save_type: settings.product_save_type,
                  show_icon_list: settings.product_icon_list
                -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- elsif color_count == 1 -%}
            {%- comment -%}
              单一颜色选项 (单品或 5-Piece 这种 1 颜色 + 多 Size 的捆绑) - 按该颜色选项的所有值拆卡.
              选项名可能是 "Color" / "Colour" / "Comforter Set (Color)" 等任意写法,
              统一按上方侦测到的 color_positions 来定位, 无需精确匹配选项名.
              注意: split 出来的 position 是字符串, option.position 是数字, 需 plus:0 转 number 才能 == 比较.
            {%- endcomment -%}
            {%- assign single_color_pos = color_positions | split: ',' | first | plus: 0 -%}
            {%- assign optpos = 'option' | append: single_color_pos -%}
            {% for option in product.options_with_values %}
                {% if option.position == single_color_pos %}
                    {% for value in option.values %}
                        {% for variant in product.variants %}
                            {% if variant[optpos] == value %}
                              {%- render 'product-card-cus',
                                product: variant,
                                product_variants: product,
                                product_id: variant.id,
                                section_id: section.id,
                                is_variant: true,
                                product_title: product.title,
                                product_material: product.metafields.custom.product_material,
                                product_promotion: product.metafields.custom.promotion_tips,
                                product_custom_badge: product.metafields.custom.custom_badge_image,
                                shawn_product_price: product.metafields.custom.shawn_product_price,
                                product_certification_badge: product.metafields.custom.certification_badge,
                                reviews_count: product.metafields.yotpo.reviews_count,
                                product_custom_badge_list: product.metafields.custom.badge_image,
                                reviews_average: product.metafields.yotpo.reviews_average,
                                lazy_load: false,
                                image_ratio: settings.product_image_ratio,
                                image_fill: settings.product_image_fill,
                                show_secondary_image: settings.product_secondary_image,
                                show_vendor: settings.product_vendor,
                                show_rating: settings.product_rating,
                                show_color_swatches: settings.product_color_swatches,
                                show_countdown: settings.product_countdown,
                                show_quick_add: settings.product_quick_add,
                                show_quick_view: settings.product_quick_view,
                                show_save_amount: settings.product_save_amount,
                                save_type: settings.product_save_type,
                                show_icon_list: settings.product_icon_list
                              -%}
                              {% break %}
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                    {%- break -%}
                {% endif %}
            {% endfor %}
    {% else %}
          {%- render 'product-card',
            product: product,
            product_id: product.id,
            section_id: section.id,
            lazy_load: false,
            image_ratio: settings.product_image_ratio,
            image_fill: settings.product_image_fill,
            show_secondary_image: settings.product_secondary_image,
            show_vendor: settings.product_vendor,
            show_rating: settings.product_rating,
            show_color_swatches: settings.product_color_swatches,
            show_countdown: settings.product_countdown,
            show_quick_add: settings.product_quick_add,
            show_quick_view: settings.product_quick_view,
            show_save_amount: settings.product_save_amount,
            save_type: settings.product_save_type,
            prefer_badge_image: true,
            show_color_label: true
          -%}
            {% endif %}
        {%- else -%}
          {%- for i in (1..section.settings.product_limit) -%}
            {%- capture placeholder -%}product-{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
            {%- render 'product-card-placeholder',
              lazy_load: false,
              image_ratio: settings.product_image_ratio,
              image_fill: settings.product_image_fill,
              show_secondary_image: settings.product_secondary_image,
              show_vendor: settings.product_vendor,
              show_rating: settings.product_rating,
              show_color_swatches: settings.product_color_swatches,
              show_countdown: settings.product_countdown,
              show_quick_add: settings.product_quick_add,
              show_quick_view: settings.product_quick_view,
              show_save_amount: settings.product_save_amount,
              save_type: settings.product_save_type,
              placeholder: placeholder
            -%}
          {%- endfor -%}
        {%- endfor -%}
      </motion-list>

      {%- if section.settings.heading == blank and section.settings.subheading == blank and section.settings.description == blank -%}
        {%- if section.settings.carousel_on_desktop -%}
          <div class="indicators hidden lg:flex gap-2d5 items-center absolute top-0 left-0 w-full h-full pointer-events-none opacity-0 page-width">
            <button class="button button--primary pointer-events-auto" type="button" is="previous-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'icon', icon: 'chevron-left', class: 'stroke-2 transform' -%}
              </span>
            </button>
            <button class="button button--primary pointer-events-auto" type="button" is="next-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'icon', icon: 'chevron-right', class: 'stroke-2 transform' -%}
              </span>
            </button>
          </div>
        {%- endif -%}
      {%- endif -%}
    </slider-element>

    {%- if section.settings.swipe_on_mobile -%}
      <div
        class="featured-collection-scrollbar lg:hidden"
        data-slider-id="Slider-{{ section.id }}"
        role="scrollbar"
        aria-hidden="true"
        aria-orientation="horizontal"
        style="display: block; position: relative; height: 4px; width: 100%; margin: 24px 0 0; background: rgba(16, 55, 75, 0.12); border-radius: 999px; overflow: hidden; box-sizing: border-box; cursor: pointer; touch-action: pan-y;"
      >
        <div
          class="featured-collection-scrollbar__thumb"
          style="display: block; position: absolute; top: 0; left: 0%; width: 20%; min-width: 32px; height: 100%; background: #10374B; border-radius: 999px; box-sizing: border-box; cursor: grab;"
        >&nbsp;</div>
      </div>
      <script>
        (function () {
          var slider = document.getElementById('Slider-{{ section.id }}');
          var track = document.querySelector('.featured-collection-scrollbar[data-slider-id="Slider-{{ section.id }}"]');
          if (!slider || !track) return;
          var thumb = track.querySelector('.featured-collection-scrollbar__thumb');
          if (!thumb) return;

          function update() {
            var scrollWidth = slider.scrollWidth;
            var clientWidth = slider.clientWidth;
            if (!scrollWidth || !clientWidth) return;
            if (scrollWidth <= clientWidth + 1) {
              track.setAttribute('data-empty', '');
              return;
            }
            track.removeAttribute('data-empty');
            var scrollLeft = Math.max(0, Math.min(slider.scrollLeft, scrollWidth - clientWidth));
            var widthPct = Math.max(10, (clientWidth / scrollWidth) * 100);
            var maxLeftPct = 100 - widthPct;
            var leftPct = maxLeftPct > 0 ? (scrollLeft / (scrollWidth - clientWidth)) * maxLeftPct : 0;
            thumb.style.width = widthPct + '%';
            thumb.style.left = leftPct + '%';
          }

          function scheduleUpdate() { requestAnimationFrame(update); }

          scheduleUpdate();
          setTimeout(scheduleUpdate, 200);
          setTimeout(scheduleUpdate, 800);

          slider.addEventListener('scroll', update, { passive: true });
          window.addEventListener('resize', scheduleUpdate);
          window.addEventListener('load', scheduleUpdate);
          if ('ResizeObserver' in window) {
            new ResizeObserver(scheduleUpdate).observe(slider);
          }
          if (window.Shopify && Shopify.designMode) {
            document.addEventListener('shopify:section:load', scheduleUpdate);
            document.addEventListener('shopify:block:select', scheduleUpdate);
          }

          track.addEventListener('click', function (event) {
            if (event.target === thumb) return;
            var rect = track.getBoundingClientRect();
            var ratio = (event.clientX - rect.left) / rect.width;
            slider.scrollTo({ left: ratio * (slider.scrollWidth - slider.clientWidth), behavior: 'smooth' });
          });

          var isDragging = false;
          var dragStartX = 0;
          var dragStartScrollLeft = 0;
          thumb.addEventListener('pointerdown', function (event) {
            isDragging = true;
            dragStartX = event.clientX;
            dragStartScrollLeft = slider.scrollLeft;
            try { thumb.setPointerCapture(event.pointerId); } catch (e) {}
            track.classList.add('is-dragging');
            event.preventDefault();
          });
          thumb.addEventListener('pointermove', function (event) {
            if (!isDragging) return;
            var rect = track.getBoundingClientRect();
            var deltaRatio = (event.clientX - dragStartX) / rect.width;
            slider.scrollLeft = dragStartScrollLeft + deltaRatio * slider.scrollWidth;
          });
          function endDrag(event) {
            if (!isDragging) return;
            isDragging = false;
            track.classList.remove('is-dragging');
            try { thumb.releasePointerCapture(event.pointerId); } catch (e) {}
          }
          thumb.addEventListener('pointerup', endDrag);
          thumb.addEventListener('pointercancel', endDrag);
        })();
      </script>
    {%- endif -%}

    {%- if section.settings.carousel_on_desktop -%}
      <p class="hidden lg:block">{{ view_all }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product Option",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.global.settings.collection.label"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:sections.global.settings.products.label",
      "info": "t:sections.global.settings.products.info"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:sections.global.settings.product_limit.label",
      "default": 6,
      "min": 2,
      "max": 12,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.global.settings.columns.label"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_desktop",
      "label": "t:sections.global.settings.carousel_on_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "info": "t:sections.featured-collection.settings.show_view_all.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.global.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.global.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.global.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "t:sections.global.settings.swipe_on_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Featured collection"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "title-sm",
          "label": "t:sections.global.settings.heading_size.options__1.label"
        },
        {
          "value": "title-md",
          "label": "t:sections.global.settings.heading_size.options__2.label"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__3.label"
        },
        {
          "value": "title-xl tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__4.label"
        }
      ],
      "default": "title-md",
      "label": "t:sections.global.settings.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.global.settings.heading_alignment.label",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "t:sections.global.settings.heading_alignment.options__1.label"
        },
        {
          "value": "text-center md:items-center",
          "label": "t:sections.global.settings.heading_alignment.options__2.label"
        },
        {
          "value": "text-right md:items-end md:flex-row-reverse",
          "label": "t:sections.global.settings.heading_alignment.options__3.label"
        }
      ],
      "default": "text-left md:items-end md:flex-row"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.global.settings.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.global.settings.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.global.settings.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.global.settings.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.global.settings.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.global.settings.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.global.settings.heading_tag.options__7.label"
        },
        {
          "value": "span",
          "label": "t:sections.global.settings.heading_tag.options__8.label"
        },
        {
          "value": "p",
          "label": "t:sections.global.settings.heading_tag.options__9.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.global.settings.heading_tag.label",
      "info": "t:sections.global.settings.heading_tag.info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.global.settings.subheading.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.global.settings.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__highlight.content",
      "info": "t:sections.global.settings.header__highlight.info"
    },
    {
      "type": "select",
      "id": "highlighted_text",
      "options": [
        {
          "value": "none",
          "label": "t:sections.global.settings.highlighted_text.options__1.label"
        },
        {
          "value": "text",
          "label": "t:sections.global.settings.highlighted_text.options__2.label"
        },
        {
          "value": "full_text",
          "label": "t:sections.global.settings.highlighted_text.options__3.label"
        },
        {
          "value": "half_text",
          "label": "t:sections.global.settings.highlighted_text.options__4.label"
        },
        {
          "value": "underline",
          "label": "t:sections.global.settings.highlighted_text.options__5.label"
        },
        {
          "value": "stencil",
          "label": "t:sections.global.settings.highlighted_text.options__6.label"
        },
        {
          "value": "scribble",
          "label": "t:sections.global.settings.highlighted_text.options__7.label"
        }
      ],
      "default": "none",
      "label": "t:sections.global.settings.highlighted_text.label"
    },
    {
      "type": "select",
      "id": "highlighted_scribble",
      "options": [
        {
          "value": "circle",
          "label": "t:sections.global.settings.highlighted_scribble.options__1.label"
        },
        {
          "value": "basic-underline",
          "label": "t:sections.global.settings.highlighted_scribble.options__2.label"
        },
        {
          "value": "sketch-underline",
          "label": "t:sections.global.settings.highlighted_scribble.options__3.label"
        },
        {
          "value": "squiggle-underline",
          "label": "t:sections.global.settings.highlighted_scribble.options__4.label"
        },
        {
          "value": "squiggle-underline-2",
          "label": "t:sections.global.settings.highlighted_scribble.options__5.label"
        }
      ],
      "default": "circle",
      "label": "t:sections.global.settings.highlighted_scribble.label",
      "info": "t:sections.global.settings.highlighted_scribble.info"
    },
