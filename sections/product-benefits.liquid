<style>
  #shopify-section-{{section.id}} {
      --section-padding-top: {{section.settings.padding_top}}px;
      --section-padding-bottom: {{section.settings.padding_bottom}}px;
      --media-height: {{section.settings.image_height }};
  }

  #shopify-section-{{section.id}} .media-panel img,
  #shopify-section-{{section.id}} .media-panel video {
      width: 100%;
      height: var(--media-height);
      object-fit: cover;
      border-radius: 8px;
  }

  #shopify-section-{{section.id}} .shawn-tab__item {
      /**background: linear-gradient(135deg, #f6f6f8, #e9e9ed);**/
      border-radius: 8px 8px 0 0;
      padding: 1rem 1.5rem;
      transition: background 0.3s ease, transform 0.2s ease;
      opacity: .3;
  }

  /**#shopify-section-{{section.id}} .shawn-tab__item:hover {
      background: linear-gradient(135deg, #e9e9ed, #d9d9e2);
      transform: translateY(-2px);
  }**/

  #shopify-section-{{section.id}} .toggle-icon {
      font-size: 0.875rem;
      transition: transform 0.3s ease;
  }

  #shopify-section-{{section.id}} .shawn-tab__item[aria-expanded="true"] {
      opacity: 1;
  }

  #shopify-section-{{section.id}} .shawn-tab__content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out, opacity 0.3s ease;
      opacity: 0;
  }

  #shopify-section-{{section.id}} .shawn-tab__content:not(.hidden) {
      max-height: 1000px;
      opacity: 1;
      padding: .5rem 0 ;
  }

  #shopify-section-{{section.id}} .shawn-tab__item:after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 2px;
      background: rgba(103, 210, 223, 1);
      transition: all .2sease-out;
  }

   #shopify-section-{{section.id}} .shawn-tab__item[aria-expanded="true"]:after {
      opacity: 1;
  }

  #shopify-section-{{section.id}} .shawn-display__wg {
    margin-inline: auto;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto 1fr;
    grid-row-gap: 3.75rem;
    row-gap: 3.75rem;
    grid-column-gap: 5rem;
    column-gap: 5rem;
    border-radius: var(--rounded-block);
    overflow: hidden;
    background: rgba(242, 242, 242, 1);
}

  @media (max-width: 768px) {
    #shopify-section-{{section.id}} .shawn-display__wg {
        grid-template-columns: 1fr;
        grid-template-rows: auto;
        gap: 0;
    }

   #shopify-section-{{section.id}} .shawn-tab__item {
      padding: .5rem 1.5rem;

  }
}
</style>

<div class="section section--padding relative">
  <div class="page-width relative">
        <header>
          {%- render 'section-heading', section: section -%}
          
        </header>
    
    {%- if section.blocks.size > 0 -%}
      <div class="h-full grid shawn-display__wg">

        <div class="shawn-display__tx col-start-2 row-start-2 list-none p-0 m-0">
          <ul class="flex flex-col p-0 m-0 list-none" style="min-height: var(--min-height, 0);">
            {%- for block in section.blocks -%}
              <li class="overflow-hidden">
                <button
                  class="relative shawn-tab__item flex justify-between w-full p-4 border rounded-t-lg flex-col transition-colors cursor-pointer"
                  type="button"
                  data-index="{{ forloop.index0 }}"
                  aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                  {% if forloop.first %}
                    data-active="true"
                  {% endif %}
                >
                  <h3 class="text-xl font-medium text-left">{{ block.settings.title }}</h3>
                  {% comment %} <span class="toggle-icon text-blue-500 transform rotate-0 transition-transform"> {%- render 'icon', icon: 'chevron-right', size: 'lg' -%}</span>{% endcomment %}
               
                <div
                  class="shawn-tab__content p-4 border border-t-0 rounded-b-lg shadow-md {% unless forloop.first %} hidden{% endunless %}"
                  id="ContentPanel-{{ forloop.index0 }}"
                >
                  <div class="leading-normal text-base text-left">
                    {{ block.settings.liquid }}
                  </div>
                </div>
                </button>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="relative text-center shawn-display__md">
          <ul>
            {%- for block in section.blocks -%}
              <li
                class="media-panel {% unless forloop.first %} hidden{% endunless %}"
                id="MediaPanel-{{ forloop.index0 }}"
              >
                {%- if block.settings.video != blank -%}
                  {%- capture sizes -%}(max-width: 639px) 100vw, (max-width: 1023px) calc(100vw / 2 - 40px), (max-width: 1535px) calc(min(100vw, {{ settings.page_width }}px) / 3 - 40px), calc(min(100vw, {{ settings.page_width }}px) / 3 - 80px){%- endcapture -%}
                  <a
                    class="block media media--{{ block.settings.image_ratio }} media--transparent relative overflow-hidden"
                    {% if block.settings.button_link != blank %}
                      href="{{ block.settings.button_link }}"
                      {%- if block.settings.button_external %} target="_blank" rel="noopener"{% endif -%}
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    aria-label="{{ block.settings.heading | escape }}"
                  >
                    {%- liquid
                      assign video_alt = block.settings.video.alt | default: block.settings.image.alt
                      assign alt = 'general.accessibility.load_video' | t: description: video_alt | escape
                      assign preview_image = block.settings.video.preview_image | default: block.settings.image

                      capture poster
                        if preview_image != blank
                          echo preview_image | image_url: width: preview_image.width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080,1600', sizes: sizes, is: 'lazy-image', class: 'inline-block', alt: alt
                        else
                          echo 'lifestyle-1' | placeholder_svg_tag: 'placeholder'
                        endif
                      endcapture
                    -%}
                    <video-media class="block" style="--aspect-ratio: {{ block.settings.video.aspect_ratio }}" autoplay>
                      {{- poster -}}
                      <template>
                        {{-
                          block.settings.video
                          | video_tag:
                            playsinline: true,
                            muted: true,
                            autoplay: true,
                            loop: true,
                            controls: false,
                            preload: 'metadata', 
                            image_size: sizes,
                            loading: 'lazy'
                        -}}
                      </template>
                    </video-media>
                  </a>
                {%- elsif block.settings.image != blank -%}
                  {%- capture sizes -%}(max-width: 639px) 100vw, (max-width: 1023px) calc(100vw / 2 - 40px), (max-width: 1535px) calc(min(100vw, {{ settings.page_width }}px) / 3 - 40px), calc(min(100vw, {{ settings.page_width }}px) / 3 - 80px){%- endcapture -%}
                  <a
                    class="block media media--{{ block.settings.image_ratio }} media--transparent relative overflow-hidden"
                    {% if block.settings.button_link != blank %}
                      href="{{ block.settings.button_link }}"
                      {%- if block.settings.button_external %} target="_blank" rel="noopener"{% endif -%}
                    {% else %}
                      role="link" aria-disabled="true"
                    {% endif %}
                    aria-label="{{ block.settings.heading | escape }}"
                  >
                    {{-
                      block.settings.image
                      | image_url: width: block.settings.image.width
                      | image_tag:
                        loading: 'lazy',
                        widths: '180,360,540,720,900,1080,1600',
                        sizes: sizes,
                        is: 'lazy-image',
                        class: 'inline-block'
                    -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      </div>
    {%- endif -%}
  
    {{- section.settings.liquid -}}
  </div>
</div>

<script>
  function toggleContent(index) {
    const buttons = document.querySelectorAll('.shawn-tab__item');
    const contentPanels = document.querySelectorAll('.shawn-tab__content');
    const mediaPanels = document.querySelectorAll('.media-panel');

    buttons.forEach((button, btnIndex) => {
      const isActive = btnIndex === parseInt(index);
      button.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      button.classList.toggle('active', isActive);

      // 更新箭头图标
      const icon = button.querySelector('.toggle-icon');
      if (icon) {
        icon.classList.toggle('rotate-90', isActive);
      }
    });

    contentPanels.forEach((panel, panelIndex) => {
      panel.classList.toggle('hidden', panelIndex !== parseInt(index));
    });

    mediaPanels.forEach((panel, panelIndex) => {
      panel.classList.toggle('hidden', panelIndex !== parseInt(index));
    });
  }

  // 初始化第一个面板
  document.addEventListener('DOMContentLoaded', () => {
    const firstButton = document.querySelector('.shawn-tab__item[data-index="0"]');
    if (firstButton) {
      firstButton.setAttribute('aria-expanded', 'true');
      const icon = firstButton.querySelector('.toggle-icon');
      if (icon) {
        icon.classList.add('rotate-90');
      }
    }

    // 添加点击事件监听器
    document.querySelectorAll('.shawn-tab__item').forEach((button) => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const index = button.getAttribute('data-index');
        toggleContent(index);
      });
    });
  });
</script>

