{% if collection.metafields.custom.custom_schema.value %}
  <script type="application/ld+json">{{ collection.metafields.custom.custom_schema.value }}</script>
{% endif %}

{% assign seo_post_size = collection.metafields.custom.seo_post | metafield_tag | strip_html | size %}
{% if collection.metafields.custom.seo_post_html.value != blank or seo_post_size > 0 %}
  <style>
    #shopify-section-{{ section.id }}{
        padding-top:0px;
        padding-bottom:0px;
    }
      .rich-text__wrapper--left {
        text-align: left;
      }
      .rich-text__wrapper--center {
        text-align: center;
      }
      .rich-text__wrapper--right {
      text-align: right;
    }
    @media screen and (min-width: 750px) {
      body .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        padding-left: {{ section.settings.padding_left }}px;
        padding-right: {{ section.settings.padding_right }}px;
      }
    }
    {% comment %} 移动端 {% endcomment %}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
      padding-left: {{ section.settings.padding_left | times: 0.75 | round: 0}}px;
      padding-right: {{ section.settings.padding_right | times: 0.75 | round: 0}}px;
    }

  /* H标签默认字体大小及加粗，调整间距 */
  .custom-post h1 {
    font-size: 2.5em;
    font-weight: bold;
    margin-top: 1.5em;
    margin-bottom: 0.75em;
  }
  .custom-post h2 {
    text-align: {{ section.settings.faq_title_position }};
    font-size: 2em;
    font-weight: bold;
    margin-top: 1.3em;
    margin-bottom: 0.65em;
  }
  .custom-post h3 {
    font-size: 1.5em;
    font-weight: bold;
    margin-top: 1.1em;
    margin-bottom: 0.55em;
  }
  /* 段落间距 */
  .custom-post p {
    margin-top: 0.6em;
    margin-bottom: 1em;
    line-height: 1.6;
  }
  /* 无序列表样式生效 */
  .custom-post ul {
    margin-top: 0.6em;
    margin-bottom: 1em;
    padding-left: 2em; /* 缩进 */
    list-style-type: disc; /* 圆点 */
  }
  .custom-post ul li {
    margin-bottom: 0.5em;
  }
  /* 产品内链样式，颜色继承，增加下划线 */
  .custom-post a {
    color: inherit;
    text-decoration: underline;
  }

  /* Read Full Story 按钮样式 */
  .rich-text__text {
    position: relative;
  }
  .rich-text__text.content-collapsed {
    max-height: {{ section.settings.content_height }}px;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 60%, transparent 100%);
  }
  .read-full-story-btn {
    display: none;
    margin-top: 1.5rem;
    padding: 1rem 2rem;
    font-size: 14px;
    font-weight: 700;
    color: #000;
    background-color: #fff;
    border: 2px solid #000;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }
  .read-full-story-btn:hover {
    background-color: {{ section.settings.button_color }};
    color: #fff;
  }
  .read-full-story-btn.show {
    display: block;
  }
  .rich-text__wrapper--center .read-full-story-btn {
    margin-left: auto;
    margin-right: auto;
  }
  .rich-text__wrapper--left .read-full-story-btn {
    margin-left: 0;
    margin-right: auto;
  }
  .rich-text__wrapper--right .read-full-story-btn {
    margin-left: auto;
    margin-right: 0;
  }


  {% comment %} FAQ样式 {% endcomment %}
.accordion-container {
  margin: 0 auto;
  padding: 2rem 0;
  {% if section.settings.full_width == false %}
  max-width: 48rem;
  {% endif %}
  --color:#000;
}
.accordion .accordion-item {
  border-bottom: 1px solid #e5e5e5;
}
.accordion .accordion-item button[aria-expanded=true] {
  border-bottom: 1px solid var(--color);
  border-radius: unset;
}
.accordion button {
  position: relative;
  display: block;
  text-align: left;
  width: 100%;
  padding: 1em 0;
  color: var(--color);
  font-size: 1.15em;
  font-weight: 400;
  border: none;
  background: none;
  outline: none;
}
.accordion button:hover {
  cursor: pointer;
  color: var(--color);
}
.accordion button:hover::after {
  cursor: pointer;
  color: var(--color);
  border: 1px solid var(--color);
}
.accordion button .accordion-title {
  padding: 1em 1.5em 1em 0;
}
.accordion button .icon {
  display: inline-block;
  position: absolute;
  top: 18px;
  right: 0;
  width: 22px;
  height: 22px;
}
.accordion button .icon::before {
  display: block;
  position: absolute;
  content: "";
  top: 9px;
  left: 5px;
  width: 10px;
  height: 2px;
  background: currentColor;
}
.accordion button .icon::after {
  display: block;
  position: absolute;
  content: "";
  top: 5px;
  left: 9px;
  width: 2px;
  height: 10px;
  background: currentColor;
}
.accordion button[aria-expanded=true] {
  color: var(--color);
}
.accordion button[aria-expanded=true] .icon::after {
  width: 0;
}
.accordion button[aria-expanded=true] + .accordion-content {
  opacity: 1;
  max-height: 20em;
  transition: all 200ms linear;
  will-change: opacity, max-height;
}
.accordion .accordion-content {
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition: opacity 200ms linear, max-height 200ms linear;
  will-change: opacity, max-height;
}
.accordion .accordion-content p {
  font-size: 16px;
  font-weight: 300;
  margin: 2em 0;
}
{% comment %} FAQ样式 end {% endcomment %}
  </style>


  <div class="custom-post page-width container">
    <article class="section-{{ section.id }}-padding">
      <div
        id="rich-text-{{ section.id }}"
        class="rich-text__text rich-text__wrapper--{{ section.settings.content_position }} rte"
        {{ block.shopify_attributes }}
      >
        {{ collection.metafields.custom.seo_post | metafield_tag }}
        {{ collection.metafields.custom.seo_post_html.value }}
      </div>
      <button
        id="read-full-story-btn-{{ section.id }}"
        class="read-full-story-btn"
        aria-expanded="false"
      >
        {{ section.settings.read_more_button_text }}
      </button>
    </article>
  </div>

<script>
    (function() {
        const richTextContent = document.getElementById('rich-text-{{ section.id }}');
        const readMoreBtn = document.getElementById('read-full-story-btn-{{ section.id }}');
        const contentHeightThreshold = {{ section.settings.content_height }};

        if (richTextContent && readMoreBtn) {
            // 检查内容高度是否超过阈值
            if (richTextContent.scrollHeight > contentHeightThreshold) {
                richTextContent.classList.add('content-collapsed');
                readMoreBtn.classList.add('show');
            }

            // 按钮点击事件
            readMoreBtn.addEventListener('click', function() {
                const isExpanded = this.getAttribute('aria-expanded') === 'true';

                if (isExpanded) {
                    // 折叠
                    richTextContent.classList.add('content-collapsed');
                    this.setAttribute('aria-expanded', 'false');
                    this.textContent = {{ section.settings.read_more_button_text | json }};
                } else {
                    // 展开
                    richTextContent.classList.remove('content-collapsed');
                    this.setAttribute('aria-expanded', 'true');
                    this.textContent = {{ section.settings.read_less_button_text | json }};
                }
            });
        }
    })();

    const container = document.querySelector('.accordion-container');
    // 如果存在 accordion-container，将其移动到 article 的末尾
    if (container) {
        const article = document.querySelector('.custom-post article');
        if (article) {
            article.appendChild(container);
        }
    }
    const items = document.querySelectorAll(".accordion button");

    function toggleAccordion() {
    const itemToggle = this.getAttribute('aria-expanded');
    
    for (i = 0; i < items.length; i++) {
        items[i].setAttribute('aria-expanded', 'false');
    }
    
    if (itemToggle == 'false') {
        this.setAttribute('aria-expanded', 'true');
    }
    }

    items.forEach(item => item.addEventListener('click', toggleAccordion));
</script>
{% endif %}
{% schema %}
{
  "name": "集合页文章",
  "settings": [
    {
      "type": "text_alignment",
      "id": "content_position",
      "default": "left",
      "label": "内容对齐"
    },
    {
      "type": "header",
      "content": "阅读更多设置"
    },
    {
      "type": "range",
      "id": "content_height",
      "min": 200,
      "max": 2000,
      "step": 50,
      "unit": "px",
      "label": "内容高度阈值",
      "default": 600,
      "info": "当内容高度超过此值时显示阅读更多按钮"
    },
    {
      "type": "text",
      "id": "read_more_button_text",
      "label": "展开按钮文案",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "read_less_button_text",
      "label": "收起按钮文案",
      "default": "Show Less"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "按钮颜色",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部填充",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部填充",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "左侧填充",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 500,
      "step": 10,
      "unit": "px",
      "label": "右侧填充",
      "default": 0
    },
      {
      "type": "header",
      "content": "FAQ设置"
    },
    {
      "type":"checkbox",
      "id":"full_width",
      "label": "全宽展示",
      "default":true
    },
    {
      "type": "text_alignment",
      "id": "faq_title_position",
      "default": "left",
      "label": "标题对齐"
    },
  ],
  "presets": [
    {
      "name": "集合页文章",
    }
  ]
}
{% endschema %}
