<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }

  .featured-collections-scrollbar {
    display: block !important;
    position: relative;
    height: 4px;
    width: 100%;
    margin: clamp(var(--sp-4), 3vw, var(--sp-6)) 0 0;
    background: rgba(16, 55, 75, 0.12);
    border-radius: 999px;
    overflow: hidden;
    box-sizing: border-box;
    cursor: pointer;
    touch-action: pan-y;
  }

  .featured-collections-scrollbar[data-empty] {
    display: none !important;
    visibility: hidden;
    height: 0;
    margin: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .featured-collections-scrollbar__thumb {
    display: block !important;
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 20%;
    min-width: 32px;
    background: #10374B;
    border-radius: 999px;
    box-sizing: border-box;
    transition: left 0.08s linear, width 0.08s linear;
    cursor: grab;
  }

  .featured-collections-scrollbar__thumb:hover,
  .featured-collections-scrollbar.is-dragging .featured-collections-scrollbar__thumb {
    background: #0b2836;
  }

  .featured-collections-scrollbar.is-dragging .featured-collections-scrollbar__thumb {
    cursor: grabbing;
    transition: none;
  }
</style>

{%- liquid
  assign section_rendering_api = false
  if section.index == nil
    assign section_rendering_api = true
  endif
-%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- render 'section-heading', section: section -%}

    {%- if section.blocks.size > 0 -%}
      <tabs-element class="tab-list flex gap-6 justify-between">
        <scroll-shadow class="scroll-shadow grid overflow-hidden">
          <div class="scroll-area grid">
            <div class="flex gap-4" role="tablist">
              {%- for block in section.blocks -%}
                {%- assign collection = block.settings.collection -%}
                <button class="tab__item button{% if forloop.first %} button--primary{% else %} button--secondary{% endif %} whitespace-nowrap"{% if forloop.first %} disabled{% endif %} type="button" is="hover-button" role="tab" aria-controls="TabPanel-{{ block.id }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                  {%- unless forloop.first -%}
                    {%- unless section_rendering_api -%}
                      <api-button class="api-only" data-id="TabPanelContent-{{ block.id }}" data-section-id="{{ section.id }}"></api-button>
                    {%- endunless -%}
                  {%- endunless -%}
                  <span class="btn-fill" data-fill></span>
                  <span class="btn-text">
                    {%- liquid
                      if block.settings.title != blank or collection != blank
                        echo block.settings.title | default: collection.title | escape
                      else
                        echo 'onboarding.collection_title' | t | escape
                      endif
                    -%}
                  </span>
                </button>
              {%- endfor -%}
            </div>
          </div>
          <template>
            <slot></slot>
            <s dir="{% render 'direction' %}" style="--t: 0;--b: 0;--l: 0;--r: 0;">
              <span class="l"></span>
              <span class="r"></span>
            </s>
            <style>
              :host{display:inline-block;position:relative}:host([hidden]){display:none}
              s{position:absolute;inset:0;pointer-events:none;{% if settings.card_style == 'card' %}--color-background:var(--color-placeholder){% endif %}}
              s span{position:absolute;inset-block:0;width:var(--sp-12);opacity:0;transition:opacity var(--animation-short);}
              s .l{inset-inline-start:0;opacity:var(--l);background:linear-gradient(90deg,rgb(var(--color-background)) 0%,transparent 100%);}
              s .r{inset-inline-end:0;opacity:var(--r);background:linear-gradient(270deg,rgb(var(--color-background)) 0%,transparent 100%);}
              s[dir=rtl] :is(.icon-chevron-left,.icon-chevron-right){transform:scaleX(-1);}
            </style>
          </template>
        </scroll-shadow>
        
        {%- if section.settings.carousel_on_desktop -%}
          {%- for block in section.blocks -%}
            <div class="indicators hidden lg:flex gap-2d5"{% unless forloop.first %} hidden{% endunless %} data-index="{{ forloop.index0 }}">
              <button class="button button--secondary" type="button" is="previous-button" aria-controls="Slider-{{ block.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
                <span class="btn-fill" data-fill></span>
                <span class="btn-text">
                  {%- render 'icon', icon: 'chevron-left', class: 'transform' -%}
                </span>
              </button>
              <button class="button button--secondary" type="button" is="next-button" aria-controls="Slider-{{ block.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
                <span class="btn-fill" data-fill></span>
                <span class="btn-text">
                  {%- render 'icon', icon: 'chevron-right', class: 'transform' -%}
                </span>
              </button>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </tabs-element>
      
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign products = block.settings.products | default: collection.products

          comment
            颜色色卡全展示：除「Bundle Savings」(捆绑产品) 标签页外，其余标签页都展示全部颜色、不出现 "+N" 折叠。
            通过标签标题或集合 handle 是否包含 "bundle" 判断。
          endcomment
          assign tab_label = block.settings.title | default: collection.title | downcase
          assign show_all_swatches = true
          if tab_label contains 'bundle' or collection.handle contains 'bundle'
            assign show_all_swatches = false
          endif
        -%}
        <div id="TabPanel-{{ block.id }}" role="tabpanel"{% unless forloop.first %} hidden{% endunless %}>
          <div id="TabPanelContent-{{ block.id }}">
            {%- if section_rendering_api or forloop.first -%}
              <slider-element id="Slider-{{ block.id }}" class="grid slider{% if section.settings.carousel_on_desktop %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}" selector=".card-grid>.card"{% if section.settings.carousel_on_desktop or section.settings.swipe_on_mobile %} tabindex="0"{% endif %}>
                <motion-list class="product-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
                  {%- for product in products limit: section.settings.product_limit -%}
                    {%- render 'product-card',
                      product: product,
                      product_id: product.id,
                      section_id: section.id,
                      block_id: block.id,
                      lazy_load: false,
                      image_ratio: settings.product_image_ratio,
                      image_fill: settings.product_image_fill,
                      show_secondary_image: settings.product_secondary_image,
                      show_multiple_images: settings.product_multiple_images,
                      show_vendor: settings.product_vendor,
                      title_truncation: settings.product_title_truncation,
                      title_line_limit: settings.product_title_line_limit,
                      show_rating: settings.product_rating,
                      show_color_swatches: settings.product_color_swatches,
                      show_all_color_swatches: show_all_swatches,
                      show_countdown: settings.product_countdown,
                      show_quick_add: settings.product_quick_add,
                      show_quick_view: settings.product_quick_view,
                      vertical_badges: settings.product_vertical_badges,
                      show_sold_out: settings.product_sold_out,
                      show_save_amount: settings.product_save_amount,
                            product_promotion: product.metafields.custom.promotion_tips,
                            product_custom_badge: product.metafields.custom.custom_badge_image,
                            product_certification_badge: product.metafields.custom.certification_badge,
                            shawn_product_price: product.metafields.custom.shawn_product_price,
                            reviews_count: product.metafields.yotpo.reviews_count,
                            reviews_average: product.metafields.yotpo.reviews_average,
                      save_type: settings.product_save_type,
                      show_icon_list: settings.product_icon_list
                    -%}
                  {%- else -%}
                    {%- for i in (1..section.settings.product_limit) -%}
                      {%- capture placeholder -%}product-{% cycle '1', '2', '3', '4', '5', '6' %}{%- endcapture -%}
                      {%- render 'product-card-placeholder',
                        placeholder: placeholder
                        image_ratio: settings.product_image_ratio,
                        show_vendor: settings.product_vendor
                      -%}
                    {%- endfor -%}
                  {%- endfor -%}
                </motion-list>
              </slider-element>

              {%- if section.settings.swipe_on_mobile -%}
                <featured-collections-scrollbar
                  class="featured-collections-scrollbar lg:hidden"
                  data-slider-id="Slider-{{ block.id }}"
                  data-empty
                  role="scrollbar"
                  aria-hidden="true"
                  aria-orientation="horizontal"
                  style="display: block; position: relative; height: 4px; width: 100%; margin: 24px 0 0; background: rgba(16, 55, 75, 0.12); border-radius: 999px; overflow: hidden; box-sizing: border-box; cursor: pointer; touch-action: pan-y;"
                >
                  <div
                    class="featured-collections-scrollbar__thumb"
                    style="display: block; position: absolute; top: 0; left: 0%; width: 20%; min-width: 32px; height: 100%; background: #10374B; border-radius: 999px; box-sizing: border-box; cursor: grab;"
                  >&nbsp;</div>
                </featured-collections-scrollbar>
              {%- endif -%}
        
              {%- if section.settings.show_view_all and collection != blank and section.settings.product_limit < collection.all_products_count -%}
                <p class="text-center">
                  <a class="button button--secondary icon-with-text" href="{{ collection.url }}" is="hover-link" aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}">
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- liquid
                        render 'icon', icon: 'newspaper'
                        echo 'sections.featured_collection.view_all' | t
                      -%}
                    </span>
                  </a>
                </p>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{%- if section.settings.swipe_on_mobile -%}
  <script>
    (function () {
      if (customElements.get('featured-collections-scrollbar')) return;

      class FeaturedCollectionsScrollbar extends HTMLElement {
        connectedCallback() {
          this.boundUpdate = this.update.bind(this);
          this.boundSchedule = this.scheduleUpdate.bind(this);
          this.boundOnTrackClick = this.onTrackClick.bind(this);
          this.boundOnPointerDown = this.onPointerDown.bind(this);
          this.boundOnPointerMove = this.onPointerMove.bind(this);
          this.boundOnPointerUp = this.onPointerUp.bind(this);
          this.isDragging = false;
          this.dragStartX = 0;
          this.dragStartScrollLeft = 0;
          this.connectAttempts = 0;
          this.connectSlider();
        }

        disconnectedCallback() {
          this.teardown();
        }

        connectSlider() {
          this.slider = document.getElementById(this.dataset.sliderId);
          this.thumb = this.querySelector('.featured-collections-scrollbar__thumb');
          if (!this.slider || !this.thumb) {
            if (this.connectAttempts < 20) {
              this.connectAttempts += 1;
              this.retryTimer = window.setTimeout(this.connectSlider.bind(this), 80);
            }
            return;
          }

          this.panel = this.closest('[role="tabpanel"]');
          this.slider.addEventListener('scroll', this.boundUpdate, { passive: true });
          this.slider.addEventListener('slider:change', this.boundSchedule);
          this.slider.addEventListener('slider:next', this.boundSchedule);
          this.slider.addEventListener('slider:previous', this.boundSchedule);
          window.addEventListener('resize', this.boundSchedule);
          window.addEventListener('load', this.boundSchedule);
          this.addEventListener('click', this.boundOnTrackClick);
          this.thumb.addEventListener('pointerdown', this.boundOnPointerDown);
          this.thumb.addEventListener('pointermove', this.boundOnPointerMove);
          this.thumb.addEventListener('pointerup', this.boundOnPointerUp);
          this.thumb.addEventListener('pointercancel', this.boundOnPointerUp);

          if ('ResizeObserver' in window) {
            this.resizeObserver = new ResizeObserver(this.boundSchedule);
            this.resizeObserver.observe(this.slider);
            if (this.slider.firstElementChild) this.resizeObserver.observe(this.slider.firstElementChild);
          }

          if (this.panel) {
            this.hiddenObserver = new MutationObserver(this.boundSchedule);
            this.hiddenObserver.observe(this.panel, { attributes: true, attributeFilter: ['hidden', 'style', 'class'] });
          }

          this.scheduleUpdate();
          window.setTimeout(this.boundSchedule, 200);
          window.setTimeout(this.boundSchedule, 800);
        }

        teardown() {
          window.clearTimeout(this.retryTimer);
          if (this.slider) {
            this.slider.removeEventListener('scroll', this.boundUpdate);
            this.slider.removeEventListener('slider:change', this.boundSchedule);
            this.slider.removeEventListener('slider:next', this.boundSchedule);
            this.slider.removeEventListener('slider:previous', this.boundSchedule);
          }
          window.removeEventListener('resize', this.boundSchedule);
          window.removeEventListener('load', this.boundSchedule);
          this.removeEventListener('click', this.boundOnTrackClick);
          if (this.thumb) {
            this.thumb.removeEventListener('pointerdown', this.boundOnPointerDown);
            this.thumb.removeEventListener('pointermove', this.boundOnPointerMove);
            this.thumb.removeEventListener('pointerup', this.boundOnPointerUp);
            this.thumb.removeEventListener('pointercancel', this.boundOnPointerUp);
          }
          if (this.resizeObserver) this.resizeObserver.disconnect();
          if (this.hiddenObserver) this.hiddenObserver.disconnect();
        }

        isPanelHidden() {
          return !!(this.panel && this.panel.hidden);
        }

        scheduleUpdate() {
          window.requestAnimationFrame(this.boundUpdate);
        }

        update() {
          if (!this.slider || !this.thumb || this.isPanelHidden()) return;

          var scrollWidth = this.slider.scrollWidth;
          var clientWidth = this.slider.clientWidth;
          if (!scrollWidth || !clientWidth) return;

          if (scrollWidth <= clientWidth + 2) {
            this.setAttribute('data-empty', '');
            return;
          }

          this.removeAttribute('data-empty');
          var maxScroll = scrollWidth - clientWidth;
          var scrollLeft = Math.max(0, Math.min(this.slider.scrollLeft, maxScroll));
          var widthPct = Math.max(10, (clientWidth / scrollWidth) * 100);
          var maxLeftPct = 100 - widthPct;
          var leftPct = maxLeftPct > 0 ? (scrollLeft / maxScroll) * maxLeftPct : 0;
          this.thumb.style.width = widthPct + '%';
          this.thumb.style.left = leftPct + '%';
        }

        onTrackClick(event) {
          if (!this.slider || event.target === this.thumb || this.thumb.contains(event.target)) return;
          var rect = this.getBoundingClientRect();
          if (!rect.width) return;
          var ratio = (event.clientX - rect.left) / rect.width;
          this.slider.scrollTo({
            left: ratio * (this.slider.scrollWidth - this.slider.clientWidth),
            behavior: 'smooth'
          });
        }

        onPointerDown(event) {
          if (!this.slider) return;
          this.isDragging = true;
          this.dragStartX = event.clientX;
          this.dragStartScrollLeft = this.slider.scrollLeft;
          try { this.thumb.setPointerCapture(event.pointerId); } catch (e) {}
          this.classList.add('is-dragging');
          event.preventDefault();
        }

        onPointerMove(event) {
          if (!this.isDragging || !this.slider) return;
          var rect = this.getBoundingClientRect();
          if (!rect.width) return;
          var deltaRatio = (event.clientX - this.dragStartX) / rect.width;
          this.slider.scrollLeft = this.dragStartScrollLeft + deltaRatio * this.slider.scrollWidth;
        }

        onPointerUp(event) {
          if (!this.isDragging) return;
          this.isDragging = false;
          this.classList.remove('is-dragging');
          try { this.thumb.releasePointerCapture(event.pointerId); } catch (e) {}
        }
      }

      customElements.define('featured-collections-scrollbar', FeaturedCollectionsScrollbar);

      document.addEventListener('shopify:section:load', function () {
        document.querySelectorAll('featured-collections-scrollbar').forEach(function (el) {
          if (typeof el.scheduleUpdate === 'function') el.scheduleUpdate();
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.featured-collections.name",
  "class": "featured-collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:sections.global.settings.product_limit.label",
      "default": 6,
      "min": 2,
      "max": 12,
      "step": 1
    },
    {
      "type": "range",
      "id": "columns",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.global.settings.columns.label"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_desktop",
      "label": "t:sections.global.settings.carousel_on_desktop.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured-collection.settings.show_view_all.label",
      "info": "t:sections.featured-collection.settings.show_view_all.info",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__mobile.content"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:sections.global.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.global.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1",
      "label": "t:sections.global.settings.columns_mobile.label"
    },
    {
      "type": "checkbox",
      "id": "swipe_on_mobile",
      "label": "t:sections.global.settings.swipe_on_mobile.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Featured collections"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "title-sm",
          "label": "t:sections.global.settings.heading_size.options__1.label"
        },
        {
          "value": "title-md",
          "label": "t:sections.global.settings.heading_size.options__2.label"
        },
        {
          "value": "title-lg tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__3.label"
        },
        {
          "value": "title-xl tracking-heading",
          "label": "t:sections.global.settings.heading_size.options__4.label"
        }
      ],
      "default": "title-md",
      "label": "t:sections.global.settings.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.global.settings.heading_alignment.label",
      "options": [
        {
          "value": "text-left md:items-end md:flex-row",
          "label": "t:sections.global.settings.heading_alignment.options__1.label"
        },
        {
          "value": "text-center md:items-center",
          "label": "t:sections.global.settings.heading_alignment.options__2.label"
        },
        {
          "value": "text-right md:items-end md:flex-row-reverse",
          "label": "t:sections.global.settings.heading_alignment.options__3.label"
        }
      ],
      "default": "text-left md:items-end md:flex-row"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.global.settings.heading_tag.options__1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.global.settings.heading_tag.options__2.label"
        },
        {
          "value": "h3",
          "label": "t:sections.global.settings.heading_tag.options__3.label"
        },
        {
          "value": "h4",
          "label": "t:sections.global.settings.heading_tag.options__4.label"
        },
        {
          "value": "h5",
          "label": "t:sections.global.settings.heading_tag.options__5.label"
        },
        {
          "value": "h6",
          "label": "t:sections.global.settings.heading_tag.options__6.label"
        },
        {
          "value": "div",
          "label": "t:sections.global.settings.heading_tag.options__7.label"
        },
        {
          "value": "span",
          "label": "t:sections.global.settings.heading_tag.options__8.label"
        },
        {
          "value": "p",
          "label": "t:sections.global.settings.heading_tag.options__9.label"
        }
      ],
      "default": "h2",
      "label": "t:sections.global.settings.heading_tag.label",
      "info": "t:sections.global.settings.heading_tag.info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.global.settings.subheading.label"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:sections.global.settings.description.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__highlight.content",
      "info": "t:sections.global.settings.header__highlight.info"
    },
    {
      "type": "select",
      "id": "highlighted_text",
      "options": [
        {
          "value": "none",
          "label": "t:sections.global.settings.highlighted_text.options__1.label"
        },
        {
          "value": "text",
          "label": "t:sections.global.settings.highlighted_text.options__2.label"
        },
        {
          "value": "full_text",
          "label": "t:sections.global.settings.highlighted_text.options__3.label"
        },
        {
          "value": "half_text",
          "label": "t:sections.global.settings.highlighted_text.options__4.label"
        },
        {
          "value": "underline",
          "label": "t:sections.global.settings.highlighted_text.options__5.label"
        },
        {
          "value": "marker",
          "label": "t:sections.global.settings.highlighted_text.options__6.label"
        },
        {
          "value": "stencil",
          "label": "t:sections.global.settings.highlighted_text.options__7.label"
        },
        {
          "value": "scribble",
          "label": "t:sections.global.settings.highlighted_text.options__8.label"
        }
      ],
      "default": "none",
      "label": "t:sections.global.settings.highlighted_text.label"
    },
    {
      "visible_if": "{{ section.settings.highlighted_text == 'scribble' }}",
      "type": "select",
      "id": "highlighted_scribble",
      "options": [
        {
          "value": "circle",
          "label": "t:sections.global.settings.highlighted_scribble.options__1.label"
        },
        {
          "value": "basic-underline",
          "label": "t:sections.global.settings.highlighted_scribble.options__2.label"
        },
        {
          "value": "sketch-underline",
          "label": "t:sections.global.settings.highlighted_scribble.options__3.label"
        },
        {
          "value": "squiggle-underline",
          "label": "t:sections.global.settings.highlighted_scribble.options__4.label"
        },
        {
          "value": "squiggle-underline-2",
          "label": "t:sections.global.settings.highlighted_scribble.options__5.label"
        }
      ],
      "default": "circle",
      "label": "t:sections.global.settings.highlighted_scribble.label",
      "info": "t:sections.global.settings.highlighted_scribble.info"
    },
    {
      "visible_if": "{{ section.settings.highlighted_text != 'none' }}",
      "type": "checkbox",
      "id": "highlighted_reveal",
      "label": "t:sections.global.settings.highlighted_reveal.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
