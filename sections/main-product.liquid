                  return;
                }

                /* 2) Click anywhere inside an open menu (but not on an item) → keep menu open */
                if (e.target.closest('.xy-addon__menu')){
                  e.preventDefault();
                  e.stopPropagation();
                  return;
                }

                /* 3) Click anywhere inside a picker (swatch / trigger / caret / label) → toggle that picker */
                var pickerEl = e.target.closest('.xy-addon__picker');
                if (pickerEl){
                  e.preventDefault();
                  e.stopPropagation();
                  togglePickerMenu(pickerEl);
                  return;
                }

                /* 4) Click outside any picker → close all open menus */
                closeAllMenus(null);
              });

              /* Re-position any open menu when the user scrolls or resizes,
                 so it stays glued to the picker (instead of closing). */
              function repositionOpenMenus(){
                document.querySelectorAll('.xy-addon__picker.is-open').forEach(function(p){
                  positionAddonMenu(p);
                });
              }
              window.addEventListener('scroll', repositionOpenMenus, true);
              window.addEventListener('resize', repositionOpenMenus);

              function updateAddonPrice(addonEl){
                var map = getVariantMap(addonEl);
                if (!map) return;
                var vid = readVid(addonEl);
                if (!vid) return;
                var entry = map[String(vid)];
                if (!entry) return;

                var saleEl = addonEl.querySelector('[data-xy-addon-sale]');
                var cmpEl  = addonEl.querySelector('[data-xy-addon-compare]');

                if (saleEl){
                  if (saleEl.textContent !== entry.price) saleEl.textContent = entry.price;
                }
                if (cmpEl){
                  if (entry.raw_compare && entry.raw_compare > entry.raw_price){
                    if (cmpEl.textContent !== entry.compare) cmpEl.textContent = entry.compare;
                    if (cmpEl.hidden) cmpEl.hidden = false;
                  } else {
                    if (!cmpEl.hidden) cmpEl.hidden = true;
                  }
                }
              }

              function updateAddonImage(addonEl){
                var img = addonEl.querySelector('[data-xy-addon-img]');
                if (!img) return;
                var map = getVariantMap(addonEl);
                if (!map) return;
                var vid = readVid(addonEl);
                var entry = vid ? map[String(vid)] : null;
                var fallback = img.getAttribute('data-xy-addon-default-img') || '';
                var newSrc = (entry && entry.image) ? entry.image : fallback;
                if (newSrc && img.getAttribute('src') !== newSrc){
                  img.setAttribute('src', newSrc);
                }
              }

              function refreshAllPrices(){
                document.querySelectorAll('[data-xy-addon]').forEach(updateAddonPrice);
              }

              function refreshAllSwatches(){
                document.querySelectorAll('[data-xy-addon]').forEach(paintAddonSwatches);
              }

              function refreshAllImages(){
                document.querySelectorAll('[data-xy-addon]').forEach(updateAddonImage);
              }

              /* 标记 dropdown 里不可购买的项：
                 - size：根据当前 color，看（color, size）这条 variant 是否 available
                 - color：只看这个 color 下"是否还有任何 size 可购买"，全 sold-out 才置灰
                 不可用的 menu-item 在点击 handler 中会被直接忽略。 */
              function refreshAddonAvailability(addonEl){
                var map = getVariantMap(addonEl);
                if (!map) return;
                var meta = map.__meta__ || {};
                var colorIdx = (typeof meta.color_idx === 'number') ? meta.color_idx : -1;
                var sizeIdx  = (typeof meta.size_idx  === 'number') ? meta.size_idx  : -1;
                if (!meta.color_found) colorIdx = -1;
                if (!meta.size_found)  sizeIdx  = -1;
                var keys = Object.keys(map).filter(function(k){ return k !== '__meta__'; });
                var colorLabel = (getSelectedLabel(addonEl, 'color') || '').trim().toLowerCase();

                function setAvail(item, ok){
                  if (ok){
                    item.classList.remove('is-unavailable');
                    item.removeAttribute('aria-disabled');
                  } else {
                    item.classList.add('is-unavailable');
                    item.setAttribute('aria-disabled', 'true');
                  }
                }

                /* size dropdown：根据当前 color 标记不可用 size */
                var sizePicker = addonEl.querySelector('.xy-addon__picker--size');
                if (sizePicker){
                  var sizeMenu = findPickerMenu(sizePicker);
                  if (sizeMenu){
                    sizeMenu.querySelectorAll('.xy-addon__menu-item').forEach(function(item){
                      var label = (item.getAttribute('data-label') || item.textContent || '').trim().toLowerCase();
                      var hasAvail = false;
                      for (var i = 0; i < keys.length; i++){
                        var v = map[keys[i]];
                        if (!v || !v.options) continue;
                        var opts = v.options.map(function(o){ return o ? String(o).trim().toLowerCase() : ''; });
                        var matchSize  = (sizeIdx  >= 0) ? (opts[sizeIdx] === label) : (opts.indexOf(label) >= 0);
                        var matchColor = !colorLabel ? true : ((colorIdx >= 0) ? (opts[colorIdx] === colorLabel) : (opts.indexOf(colorLabel) >= 0));
                        if (matchSize && matchColor && v.available){ hasAvail = true; break; }
                      }
                      setAvail(item, hasAvail);
                    });
                  }
                }

                /* color dropdown：只有当一个 color 下所有 size 都缺货时才置灰 */
                var colorPicker = addonEl.querySelector('.xy-addon__picker--color');
                if (colorPicker){
                  var colorMenu = findPickerMenu(colorPicker);
                  if (colorMenu){
                    colorMenu.querySelectorAll('.xy-addon__menu-item').forEach(function(item){
                      var label = (item.getAttribute('data-label') || item.textContent || '').trim().toLowerCase();
                      var hasAvail = false;
                      for (var i = 0; i < keys.length; i++){
                        var v = map[keys[i]];
                        if (!v || !v.options) continue;
                        var opts = v.options.map(function(o){ return o ? String(o).trim().toLowerCase() : ''; });
                        var matchColor = (colorIdx >= 0) ? (opts[colorIdx] === label) : (opts.indexOf(label) >= 0);
                        if (matchColor && v.available){ hasAvail = true; break; }
                      }
                      setAvail(item, hasAvail);
                    });
                  }
                }
              }

              function refreshAllAvailability(){
                document.querySelectorAll('[data-xy-addon]').forEach(refreshAddonAvailability);
              }

              /* 如果 picker 当前选中项是 is-unavailable，自动选第一个可用项。
                 返回是否发生了切换。 */
              function pickFirstAvailable(picker){
                if (!picker) return false;
                var menu = findPickerMenu(picker);
                if (!menu) return false;
                var items = menu.querySelectorAll('.xy-addon__menu-item');
                if (!items.length) return false;
                var current = menu.querySelector('.xy-addon__menu-item.is-selected') || items[0];
                if (current && !current.classList.contains('is-unavailable')) return false;
                var alt = null;
                for (var i = 0; i < items.length; i++){
                  if (!items[i].classList.contains('is-unavailable')){ alt = items[i]; break; }
                }
                if (!alt) return false;
                items.forEach(function(s){ s.classList.remove('is-selected'); });
                alt.classList.add('is-selected');
                var labelEl = picker.querySelector('[data-xy-addon-label]');
                var hidden  = picker.querySelector('input[data-xy-addon-color], input[data-xy-addon-size]');
                var swatchEl = picker.querySelector('[data-xy-addon-swatch]');
                if (labelEl) labelEl.textContent = alt.getAttribute('data-label') || (alt.textContent || '').trim();
                if (hidden)  hidden.value = alt.getAttribute('data-value') || '';
                if (swatchEl){
                  var hint = alt.getAttribute('data-color') || alt.getAttribute('data-label') || '';
                  applySwatch(swatchEl, hint);
                }
                return true;
              }

              /* 一站式同步：标灰 → 把不可用的选中项自动跳到首个可用项 → UI 全量刷新 */
              function syncAddonState(addonEl){
                refreshAddonAvailability(addonEl);
                /* 先修 color（color 影响 size 标灰范围），再修 size */
                var changed = false;
                if (pickFirstAvailable(addonEl.querySelector('.xy-addon__picker--color'))) changed = true;
                if (changed) refreshAddonAvailability(addonEl);
                if (pickFirstAvailable(addonEl.querySelector('.xy-addon__picker--size')))  changed = true;
                if (changed) refreshAddonAvailability(addonEl);
                paintAddonSwatches(addonEl);
                updateAddonPrice(addonEl);
                updateAddonImage(addonEl);
              }

              function syncAllAddonState(){
                document.querySelectorAll('[data-xy-addon]').forEach(syncAddonState);
              }

              /* ============ Add-on carousel (group addon blocks across Shopify wrappers) ============ */
              function addonMoveUnit(el){
                if (!el || !el.closest) return el;
                var wrap = el.closest('.shopify-block, shopify-editor-block, [id^="shopify-block-"]');
                if (wrap && !wrap.hasAttribute('data-xy-addon-carousel')) return wrap;
                return el;
              }

              function isAddonUnit(node){
                if (!node || node.nodeType !== 1) return false;
                if (node.hasAttribute && node.hasAttribute('data-xy-addon')) return true;
                if (node.matches && node.matches('[data-xy-addon]')) return true;
                return !!(node.querySelector && node.querySelector('[data-xy-addon]'));
              }

              function isIgnorableSibling(node){
                if (!node || node.nodeType !== 1) return true;
                if (isAddonUnit(node)) return false;
                if (node.hasAttribute && node.hasAttribute('data-xy-addon-carousel')) return false;
                var tag = (node.tagName || '').toLowerCase();
                if (tag === 'style' || tag === 'script' || tag === 'link') return true;
                var cls = (node.className && node.className.toString) ? node.className.toString() : '';
                if (/shopify-block-slot|theme-editor|block-add/i.test(cls) && !isAddonUnit(node)) return true;
                if (!String(node.textContent || '').trim() && !node.querySelector('[data-xy-addon]')) return true;
                return false;
              }

              function nextMeaningful(node){
                var n = node ? node.nextElementSibling : null;
                while (n && isIgnorableSibling(n)) n = n.nextElementSibling;
                return n;
              }

              function collectAddonGroup(startAddon){
                var unit = addonMoveUnit(startAddon);
                var group = [unit];
                var n = nextMeaningful(unit);
                while (n && isAddonUnit(n) && !n.closest('[data-xy-addon-carousel]')){
                  var nextUnit = n.hasAttribute && n.hasAttribute('data-xy-addon') ? addonMoveUnit(n) : n;
                  if (group.indexOf(nextUnit) === -1) group.push(nextUnit);
                  n = nextMeaningful(nextUnit);
                }
                return group;
              }

              function uniqueUnits(list){
                var out = [];
                list.forEach(function(u){
                  if (u && out.indexOf(u) === -1) out.push(u);
                });
                return out;
              }

              function unwrapBrokenCarousels(){
                document.querySelectorAll('[data-xy-addon-carousel]').forEach(function(c){
                  if (c.querySelectorAll('[data-xy-addon]').length >= 2) return;
                  var parent = c.parentNode;
                  if (!parent) return;
                  var track = c.querySelector('.xy-addon-carousel__track');
                  var nodes = track ? Array.prototype.slice.call(track.children) : [];
                  nodes.forEach(function(n){ parent.insertBefore(n, c); });
                  c.remove();
                });
              }

              function bindCarouselNav(track, prev, next){
                if (!track || !prev || !next || track.__xyAddonNavBound) return;
                track.__xyAddonNavBound = true;
                function getStep(){
                  var first = track.querySelector('.xy-addon') || track.firstElementChild;
                  if (!first) return track.clientWidth || 0;
                  var rect = first.getBoundingClientRect();
                  var styles = window.getComputedStyle(track);
                  var gap = parseInt(styles.columnGap || styles.gap || '0', 10) || 0;
                  return rect.width + gap;
                }
                function updateNav(){
                  var maxScroll = track.scrollWidth - track.clientWidth - 1;
                  if (track.scrollLeft <= 0) prev.setAttribute('disabled', ''); else prev.removeAttribute('disabled');
                  if (track.scrollLeft >= maxScroll) next.setAttribute('disabled', ''); else next.removeAttribute('disabled');
                }
                prev.addEventListener('click', function(e){
                  e.preventDefault();
                  track.scrollBy({ left: -getStep(), behavior: 'smooth' });
                });
                next.addEventListener('click', function(e){
                  e.preventDefault();
                  track.scrollBy({ left: getStep(), behavior: 'smooth' });
                });
                track.addEventListener('scroll', updateNav, { passive: true });
                window.addEventListener('resize', updateNav);
                setTimeout(updateNav, 50);
                setTimeout(updateNav, 200);
                updateNav();
              }

              function wrapAddonCarousel(units){
                units = uniqueUnits(units).filter(function(u){
                  return u && !u.closest('[data-xy-addon-carousel]');
                });
                if (units.length < 2) return;
                var first = units[0];
                var parent = first.parentNode;
                if (!parent) return;

                var firstAddon = first.hasAttribute && first.hasAttribute('data-xy-addon')
                  ? first
                  : first.querySelector('[data-xy-addon]');

                var carousel = document.createElement('div');
                carousel.className = 'xy-addon-carousel';
                carousel.setAttribute('data-xy-addon-carousel', '');
                carousel.setAttribute('data-xy-addon-count', String(units.length));

                try {
                  var styleSrc = firstAddon || first;
                  var cs = window.getComputedStyle(styleSrc);
                  ['--xy-addon-arrow-color','--xy-addon-arrow-size','--xy-addon-arrow-offset','--xy-addon-arrow-top','--xy-addon-arrow-stroke','--xy-addon-heading-color','--xy-addon-heading-size','--xy-addon-heading-weight'].forEach(function(varName){
                    var v = cs.getPropertyValue(varName);
                    if (v) carousel.style.setProperty(varName, v.trim());
                  });
                } catch(e){}

                var arrowSvgPrev = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>';
                var arrowSvgNext = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>';

                var viewport = document.createElement('div');
                viewport.className = 'xy-addon-carousel__viewport';
                var track = document.createElement('div');
                track.className = 'xy-addon-carousel__track';
                viewport.appendChild(track);

                parent.insertBefore(carousel, first);

                var titleRow = first.querySelector('.xy-addon__title-row');
                var heading = (titleRow && titleRow.querySelector('.xy-addon__heading')) || first.querySelector('.xy-addon__heading');
                var navs = (titleRow && titleRow.querySelector('.xy-addon-carousel__navs')) || first.querySelector('[data-xy-addon-navs]');
                var prev = navs ? navs.querySelector('.xy-addon-carousel__nav--prev') : null;
                var next = navs ? navs.querySelector('.xy-addon-carousel__nav--next') : null;

                units.forEach(function(s){ track.appendChild(s); });

                var head = document.createElement('div');
                head.className = 'xy-addon-carousel__head';
                if (heading) head.appendChild(heading);

                if (!navs){
                  navs = document.createElement('div');
                  navs.className = 'xy-addon-carousel__navs';
                  navs.setAttribute('data-xy-addon-navs', '');
                }
                if (!prev){
                  prev = document.createElement('button');
                  prev.type = 'button';
                  prev.className = 'xy-addon-carousel__nav xy-addon-carousel__nav--prev';
                  prev.setAttribute('aria-label', 'Previous add-on');
                  prev.innerHTML = arrowSvgPrev;
                  navs.appendChild(prev);
                }
                if (!next){
                  next = document.createElement('button');
                  next.type = 'button';
                  next.className = 'xy-addon-carousel__nav xy-addon-carousel__nav--next';
                  next.setAttribute('aria-label', 'Next add-on');
                  next.innerHTML = arrowSvgNext;
                  navs.appendChild(next);
                }
                head.appendChild(navs);
                if (titleRow && titleRow.parentNode) titleRow.remove();

                if (prev && !prev.innerHTML.trim()) prev.innerHTML = arrowSvgPrev;
                if (next && !next.innerHTML.trim()) next.innerHTML = arrowSvgNext;

                carousel.appendChild(head);
                carousel.appendChild(viewport);
                bindCarouselNav(track, prev, next);
              }

              function buildAddonCarousels(){
                unwrapBrokenCarousels();

                var roots = document.querySelectorAll('product-info, .product__info');
                if (!roots.length) roots = [document];

                Array.prototype.forEach.call(roots, function(root){
                  var addons = Array.prototype.slice.call(root.querySelectorAll('[data-xy-addon]')).filter(function(el){
                    return !el.closest('[data-xy-addon-carousel]');
                  });
                  if (addons.length < 2) return;

                  var consumed = [];
                  addons.forEach(function(el){
                    if (el.closest('[data-xy-addon-carousel]')) return;
                    var unit = addonMoveUnit(el);
                    if (consumed.indexOf(unit) !== -1) return;
                    var group = collectAddonGroup(el);
                    if (group.length >= 2){
                      group.forEach(function(u){ consumed.push(u); });
                      wrapAddonCarousel(group);
                    }
                  });

                  var leftover = Array.prototype.slice.call(root.querySelectorAll('[data-xy-addon]')).filter(function(el){
                    return !el.closest('[data-xy-addon-carousel]');
                  });
                  if (leftover.length >= 2){
                    wrapAddonCarousel(leftover.map(addonMoveUnit));
                  }
                });
              }
              window.__xyBuildAddonCarousels = buildAddonCarousels;

              // Debug helper: window.__xyPickerDebug() to inspect picker / menu DOM state
              window.__xyPickerDebug = function(){
                var pickers = document.querySelectorAll('.xy-addon__picker');
                if (!pickers.length){
                  console.warn('[xy-picker-debug] No .xy-addon__picker elements found.');
                  return;
                }
                pickers.forEach(function(p, i){
                  var menuInside = p.querySelector('.xy-addon__menu');
                  var sib = p.nextElementSibling;
                  var menuSibling = null;
                  while (sib){
                    if (sib.classList && sib.classList.contains('xy-addon__menu')){ menuSibling = sib; break; }
                    if (sib.classList && sib.classList.contains('xy-addon__picker')) break;
                    sib = sib.nextElementSibling;
                  }
                  var resolved = menuInside || menuSibling;
                  console.log('Picker #'+i, {
                    tag: p.tagName,
                    classes: p.className,
                    pickerParentTag: p.parentElement ? p.parentElement.tagName : null,
                    menuInsidePicker: !!menuInside,
                    menuAsSibling: !!menuSibling,
                    menuItems: resolved ? resolved.querySelectorAll('.xy-addon__menu-item').length : 0,
                    isOpen: p.classList.contains('is-open'),
                    menuHidden: resolved ? resolved.hidden : 'no menu',
                    menuComputedDisplay: resolved ? window.getComputedStyle(resolved).display : 'no menu'
                  });
                });
              };

              // Debug helper: window.__xyAddonDebug() to inspect current addon resolution
              window.__xyAddonDebug = function(){
                document.querySelectorAll('[data-xy-addon]').forEach(function(el, i){
                  var map = getVariantMap(el);
                  var meta = map && map.__meta__ || {};
                  var colorLabel = getSelectedLabel(el, 'color');
                  var sizeLabel  = getSelectedLabel(el, 'size');
                  var vid = readVid(el);
                  var entry = vid ? map[String(vid)] : null;
                  console.log('[xy-addon #'+i+']', {
                    productMeta: meta,
                    selected: { color: colorLabel, size: sizeLabel },
                    resolvedVid: vid,
                    resolvedVariant: entry,
                    showsDiscount: !!(entry && entry.raw_compare && entry.raw_compare > entry.raw_price)
                  });
                });
                return 'See console output above.';
              };

              document.addEventListener('keydown', function(e){
                if (e.key === 'Escape') closeAllMenus(null);
              });

              function collectAddonItems(){
                var items = [];
                document.querySelectorAll('[data-xy-addon]').forEach(function(el){
                  var cb = el.querySelector('[data-xy-addon-check]');
                  if (cb && cb.checked){
                    var vid = readVid(el);
                    if (vid) items.push({ id: parseInt(vid, 10), quantity: 1 });
                  }
                });
                return items;
              }

              function bindForm(form){
                if (!form || form.__xyAddonBound) return;
                form.__xyAddonBound = true;
                form.addEventListener('submit', function(ev){
                  if (form.__xyAddonInFlight) return;
                  var items = collectAddonItems();
                  if (!items.length) return;
                  ev.preventDefault();
                  ev.stopImmediatePropagation();
                  form.__xyAddonInFlight = true;

                  /* finish：等一小段再让 ProductForm 提交主产品，避免和 add-on POST 紧挨着触发 429 */
                  function finish(){
                    document.querySelectorAll('[data-xy-addon] [data-xy-addon-check]').forEach(function(c){ c.checked = false; });
                    form.__xyAddonInFlight = false;
                    setTimeout(function(){
                      if (typeof form.requestSubmit === 'function') form.requestSubmit();
                      else form.submit();
                    }, 350);
                  }

                  /* 解析 Retry-After 响应头，没有则默认值 */
                  function parseRetryAfter(headers, fallbackMs){
                    try {
                      var h = headers && headers.get && headers.get('Retry-After');
                      if (h){
                        var s = parseFloat(h);
                        if (!isNaN(s)) return Math.max(500, Math.min(8000, s * 1000));
                      }
                    } catch(e){}
                    return fallbackMs;
                  }

                  /* 多 item 一次性 POST，含 429 指数退避重试 */
                  function postBatchWithRetry(arr, attempt){
                    attempt = attempt || 0;
                    return fetch('/cart/add.js', {
                      method: 'POST',
                      headers: {'Content-Type':'application/json','Accept':'application/json'},
                      body: JSON.stringify({ items: arr })
                    }).then(function(res){
                      if (res.status === 429 && attempt < 3){
                        var wait = parseRetryAfter(res.headers, 800 * Math.pow(2, attempt));
                        console.warn('[xy-addon] 429 batch, retry in', wait, 'ms (attempt', attempt + 1, ')');
                        return new Promise(function(resolve){
                          setTimeout(function(){ resolve(postBatchWithRetry(arr, attempt + 1)); }, wait);
                        });
                      }
                      return res.json().catch(function(){ return null; }).then(function(data){
                        return { status: res.status, data: data };
                      });
                    });
                  }

                  function fallbackSerial(arr, i, attempt){
                    if (i >= arr.length){ finish(); return; }
                    attempt = attempt || 0;
                    var it = arr[i];
                    setTimeout(function(){
                      fetch('/cart/add.js', {
                        method: 'POST',
                        headers: {'Content-Type':'application/json','Accept':'application/json'},
                        body: JSON.stringify({ id: it.id, quantity: it.quantity || 1 })
                      }).then(function(res){
                        if (res.status === 429 && attempt < 3){
                          var wait = parseRetryAfter(res.headers, 800 * Math.pow(2, attempt));
                          console.warn('[xy-addon] 429 serial item', i, 'retry in', wait, 'ms (attempt', attempt + 1, ')');
                          setTimeout(function(){ fallbackSerial(arr, i, attempt + 1); }, wait);
                          return;
                        }
                        return res.json().catch(function(){ return null; }).then(function(data){
                          if (res.status >= 400){
                            console.warn('[xy-addon] retry failed for item', it, data);
                          }
                          fallbackSerial(arr, i + 1, 0);
                        });
                      }).catch(function(err){
                        console.warn('[xy-addon] retry network error for item', it, err);
                        fallbackSerial(arr, i + 1, 0);
                      });
                    }, 400);
                  }

                  postBatchWithRetry(items).then(function(out){
                    if (!out || out.status >= 400){
                      console.warn('[xy-addon] batch add failed, fallback to serial retry', out && out.data);
                      fallbackSerial(items, 0, 0);
                    } else {
                      finish();
                    }
                  }).catch(function(err){
                    console.warn('[xy-addon] batch add network error, fallback to serial retry', err);
                    fallbackSerial(items, 0, 0);
                  });
                }, true);
              }

              function bindAll(){
                document.querySelectorAll('form#{{ product_form_id }}, form.product-form, form[action*="/cart/add"]').forEach(bindForm);
              }

              function bootAddonUi(){
                buildAddonCarousels();
                bindAll();
                refreshAllSwatches();
                syncAllAddonState();
              }
              window.__xyBootAddonUi = bootAddonUi;

              function scheduleAddonBoot(){
                if (window.__xyBootAddonUi) window.__xyBootAddonUi();
                setTimeout(function(){ if (window.__xyBootAddonUi) window.__xyBootAddonUi(); }, 0);
                setTimeout(function(){ if (window.__xyBootAddonUi) window.__xyBootAddonUi(); }, 160);
              }

              if (_xyAlreadyInit){
                scheduleAddonBoot();
                return;
              }
              window.__xyAddonInit = true;

              if (document.readyState === 'loading'){
                document.addEventListener('DOMContentLoaded', scheduleAddonBoot);
              } else {
                scheduleAddonBoot();
              }

              if (!window.__xyAddonEventsBound){
                window.__xyAddonEventsBound = true;
                ['shopify:section:load','shopify:section:reorder','shopify:block:select','shopify:block:deselect'].forEach(function(evt){
                  document.addEventListener(evt, function(){
                    setTimeout(function(){ if (window.__xyBootAddonUi) window.__xyBootAddonUi(); }, 40);
                  });
                });
              }

              var _xyMoTimer = null;
              new MutationObserver(function(){
                if (_xyMoTimer) return;
                _xyMoTimer = setTimeout(function(){
                  _xyMoTimer = null;
                  bindAll();
                  buildAddonCarousels();
                }, 200);
              }).observe(document.body, { childList: true, subtree: false });
            })();
          </script>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {%- render block -%}

            {%- when 'breadcrumb' -%}
              {%- render 'product-breadcrumb', product: product, block: block -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                {%- if block.settings.text != product.vendor -%}
                  {%- liquid
                    assign prev_index = forloop.index0 | minus: 1
                    assign prev_block = section.blocks[prev_index]
                    assign next_index = forloop.index0 | plus: 1
                    assign next_block = section.blocks[next_index]
  
                    if prev_block.type == 'sticky_buy_button'
                      assign prev_index = prev_index | minus: 1
                      assign prev_block = section.blocks[prev_index]
                    endif
  
                    if next_block.type == 'sticky_buy_button'
                      assign next_index = next_index | plus: 1
                      assign next_block = section.blocks[next_index]
                    endif
  
                    if prev_block.type != 'text'
                      assign block_index = 1
                    else
                      assign block_index = block_index | plus: 1
                    endif
  
                    assign modulo = block_index | modulo: 2
                  -%}
                  <div class="product__text{% if modulo == 0 %} even{% endif %}{% if prev_block.type != 'text' %} first{% endif %}{% if next_block.type != 'text' %} last{% endif %}" {{ block.shopify_attributes }}>
                    <div class="product__text-inner flex items-center gap-2d5">
                      {%- if block.settings.icon_image != blank -%}
                        {%- liquid
                          if block.settings.iwidth == 'fit'
                            assign icon_width = block.settings.icon_image.width
                          else
                            assign icon_width = block.settings.icon_width
                          endif
                          assign image_alt = block.settings.icon_image.alt | default: block.settings.accessibility_info | escape
                          assign image_alt = image_alt | default: block.settings.text | escape
                          assign max_width = block.settings.icon_image.width
                        -%}
                        <figure class="media media--transparent relative inline-block">
                          {%- capture sizes -%}{{ icon_width }}px{%- endcapture -%}
                          {%- capture widths -%}{{ icon_width | times: 1.5 | at_most: max_width | round }}, {{ icon_width | times: 2 | at_most: max_width }}, {{ icon_width | times: 3 | at_most: max_width }}{%- endcapture -%}
                          {{- block.settings.icon_image | image_url: width: max_width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, alt: image_alt, class: 'image-fit' -}}
                        </figure>
                      {%- elsif block.settings.icon != 'none' -%}
                        {%- liquid
                          if block.settings.iwidth == 'fit'
                            render 'icon-guarantee', icon: block.settings.icon, size: 'lg', class: 'inline-block stroke-1'
                          else
                            render 'icon-guarantee', icon: block.settings.icon, size: 'custom', class: 'inline-block stroke-1', width: block.settings.icon_width
                          endif
                        -%}
                      {%- endif -%}
                      <p class="rte {{ block.settings.text_size }} leading-tight">{{ block.settings.text }}</p>
                    </div>
                  </div>
                {%- else -%}
                  <p class="product__vendor {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                    <a href="{{ product.vendor | url_for_vendor }}" title="{{ product.vendor | escape }}" class="reversed-link">
                      <span class="sr-only">{{ 'general.accessibility.vendor' | t }}</span>
                      {{- product.vendor -}}
                    </a>
                  </p>
                {%- endif -%}
              {%- endif -%}

            {%- when 'sku' -%}
              <p class="product__sku" id="Sku-{{ section.id }}-{{ product.id }}" {{ block.shopify_attributes }}>
                {{- product.selected_or_first_available_variant.sku -}}
              </p>

            {%- when 'badges' -%}
              <div class="product__badges" id="Badges-{{ section.id }}-{{ product.id }}" {{ block.shopify_attributes }}>
                {%- render 'product-badges', product: product, use_variant: true, show_sold_out: block.settings.show_sold_out, show_save_amount: block.settings.show_save_amount, save_type: block.settings.save_type, class: 'flex flex-wrap gap-3' -%}
              </div>

            {%- when 'description' -%}
              <div class="product__text rte {{ block.settings.text_size }}" {{ block.shopify_attributes }}>
                {{- product.description -}}
              </div>
            
            {%- when 'title' -%}
              {%- liquid  
                assign price_block = section.blocks | where: "type", "price" | first
                assign rating_block = section.blocks | where: "type", "rating" | first
              -%}
              <div class="product__title grid hidden md:block gap-3{% if price_block == blank and block.settings.show_price %} with-price{% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %} with-price--on-sale{% endif %}{% endif %}" {{ block.shopify_attributes }}>
                <{{ block.settings.title_tag }} class="heading leading-none {{ block.settings.title_size }} mobile:{{ block.settings.title_size_mobile }} col-span-full"
                  {%- if block.settings.title_weight and block.settings.title_weight != 'default' %} style="font-weight: {{ block.settings.title_weight }} !important;"{% endif -%}
                >
                  {%- if settings.enable_heading_reveal -%}
                    <split-words class="split-words js-invisible block" data-animate="fade-up">{{ product.title }}</split-words>
                  {%- else -%}
                    {{- product.title -}}
                  {%- endif -%}
                </{{ block.settings.title_tag }}>

                {%- if price_block == blank and block.settings.show_price -%}
                  <div id="Price-{{ section.id }}-{{ product.id }}" class="product__price">
                    {%- render 'product-price', product: product, use_variant: true, class: 'flex flex-wrap items-baseline gap-2 lg:flex-col xl:items-end lg:gap-1d5' -%}
                    
                    {%- if product.quantity_price_breaks_configured? -%}
                      <div class="text-opacity text-sm font-medium leading-tight" id="VolumeNote-{{ section.id }}-{{ product.id }}">
                        {{- 'products.volume_pricing.note' | t -}}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {%- liquid
                  if rating_block == blank and block.settings.show_rating
                    render 'product-rating', product: product
                  endif
                -%}
              </div>

              {%- if price_block == blank and block.settings.show_price -%}
                {%- assign product_form_installment_id = 'ProductFormInstallment-' | append: section.id | append: '-' | append: product.id -%}
                {%- form 'product', product, id: product_form_installment_id, class: 'installment text-sm leading-tight' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
                  {{ form | payment_terms }}
                {%- endform -%}
              {%- endif -%}

            {%- when 'price' -%}
              <div class="product__price grid gap-2" {{ block.shopify_attributes }}>
                {%- if block.settings.use_custom_layout -%}
                  {%- comment -%} ====== 新布局（开启自定义价格布局开关时生效） ====== {%- endcomment -%}
                  {%- assign _base_price  = product.selected_or_first_available_variant.price -%}
                  {%- assign _compare_at = product.selected_or_first_available_variant.compare_at_price | default: 0 -%}
                  {%- comment -%} 价格优先级：compare_at_price > discount_amount > product_discounts {%- endcomment -%}
                  {%- assign _discount_amount = product.metafields.custom.discount_amount | default: 0 | plus: 0 -%}
                  {%- assign _metafield_percent = product.metafields.custom.product_discounts | default: 0 | plus: 0 -%}
                  {%- comment -%} 颜色+尺码促销规则（section 可配置多组） {%- endcomment -%}
                  {%- assign sale_rule_match = '' -%}
                  {%- assign sale_rule_percent = 0 -%}
                  {%- assign sale_rule_badge = '' -%}
                  {%- if section.settings.enable_ivory_clearance_50 -%}
                    {%- capture sale_rule_match -%}
                      {%- render 'clearance-ivory-comforter-check', product: product, variant: product.selected_or_first_available_variant, section: section -%}
                    {%- endcapture -%}
                    {%- assign sale_rule_match = sale_rule_match | strip -%}
                    {%- if sale_rule_match != blank -%}
                      {%- assign sale_rule_parts = sale_rule_match | split: ':::' -%}
                      {%- assign sale_rule_percent = sale_rule_parts.first | plus: 0 -%}
                      {%- assign sale_rule_badge = sale_rule_parts.last | default: '' -%}
                    {%- endif -%}
                  {%- endif -%}
                  {%- if sale_rule_percent > 0 -%}
                    {%- if _compare_at > _base_price -%}
                      {%- assign _regular_price = _compare_at -%}
                    {%- else -%}
                      {%- assign _regular_price = _base_price -%}
                    {%- endif -%}
                    {%- assign _discount_amount = 0 -%}
                    {%- assign _metafield_percent = sale_rule_percent -%}
                    {%- assign _discount = _regular_price | times: sale_rule_percent | divided_by: 100 -%}
                    {%- assign _final_price = _regular_price | minus: _discount -%}
                  {%- elsif _compare_at > _base_price -%}
                    {%- assign _discount      = _compare_at | minus: _base_price -%}
                    {%- assign _final_price   = _base_price -%}
                    {%- assign _regular_price = _compare_at -%}
                  {%- elsif _discount_amount > 0 -%}
                    {%- comment -%} 固定金额优惠：metafield 以货币单位存储，乘 100 转为最小货币单位（分） {%- endcomment -%}
                    {%- assign _discount      = _discount_amount | times: 100 -%}
                    {%- assign _final_price   = _base_price | minus: _discount -%}
                    {%- assign _regular_price = _base_price -%}
                  {%- elsif _metafield_percent > 0 -%}
                    {%- assign _discount    = _base_price | times: _metafield_percent | divided_by: 100 -%}
                    {%- assign _final_price = _base_price | minus: _discount -%}
                    {%- assign _regular_price = _base_price -%}
                  {%- else -%}
                    {%- assign _discount      = 0 -%}
                    {%- assign _final_price   = _base_price -%}
                    {%- assign _regular_price = _base_price -%}
                  {%- endif -%}

                  {%- comment -%} SAVE 显示优先级：discount_amount > product_discounts > compare_at_price {%- endcomment -%}
                  {%- assign _save_is_amount = false -%}
                  {%- assign _save_show_percent = false -%}
                  {%- assign _save_discount = 0 -%}
                  {%- assign _save_percent = 0 -%}
                  {%- assign _save_badge_custom_label = '' -%}
                  {%- if _discount_amount > 0 -%}
                    {%- assign _save_discount = _discount_amount | times: 100 -%}
                    {%- assign _save_is_amount = true -%}
                  {%- elsif _metafield_percent > 0 -%}
                    {%- assign _save_percent = _metafield_percent -%}
                    {%- assign _save_discount = _base_price | times: _metafield_percent | divided_by: 100 -%}
                    {%- assign _save_show_percent = true -%}
                  {%- elsif _compare_at > _base_price -%}
                    {%- assign _save_discount = _compare_at | minus: _base_price -%}
                    {%- assign _save_percent = _save_discount | times: 100 | divided_by: _compare_at -%}
                  {%- endif -%}
                  {%- if sale_rule_percent > 0 -%}
                    {%- assign _save_badge_custom_label = sale_rule_badge -%}
                    {%- assign _save_show_percent = true -%}
                    {%- assign _save_percent = sale_rule_percent -%}
                  {%- endif -%}

                  <div class="no-js-hidden flex flex-wrap items-center" style="gap: {{ block.settings.price_gap | default: 12 }}px; --xy-save-font-size: {{ block.settings.save_font_size | default: 15 }}px; --xy-save-font-size-m: {{ block.settings.save_font_size_mobile | default: 12 }}px;" id="Price-{{ section.id }}-{{ product.id }}">
                    {%- if _discount > 0 -%}
                      {%- comment -%} 1) 原价（划线） {%- endcomment -%}
                      <s style="{% if block.settings.regular_price_use_color %}color: {{ block.settings.regular_price_color }};{% endif %}
                                font-size: {{ block.settings.regular_price_size }}px;
                                font-weight: {{ block.settings.regular_price_weight | default: 400 }};
                                line-height: 1.2;
                                text-decoration-line: line-through;
                                position: relative;
                                bottom: -3px;">
                        {{- _regular_price | money -}}
                      </s>

                      {%- comment -%} 2) 折扣价（突出显示） {%- endcomment -%}
                      <span style="color: {{ block.settings.sale_price_color }};
                                   font-size: {{ block.settings.sale_price_size }}px;
                                   font-weight: {{ block.settings.sale_price_weight | default: 700 }};
                                   line-height: 1.1;">
                        {{- _final_price | money -}}
                      </span>

                      {%- comment -%} 3) SAVE / Clearance 徽标 {%- endcomment -%}
                      <span class="product-price-save-badge" style="display: inline-flex; align-items: center; justify-content: center;
                                   background: {{ block.settings.save_bg }};
                                   color: {{ block.settings.save_text_color }};
                                   font-size: var(--xy-save-font-size, 15px);
                                   font-weight: {{ block.settings.save_weight | default: 700 }};
                                   padding: {{ block.settings.save_padding_y }}px {{ block.settings.save_padding_x }}px;
                                   border-radius: {{ block.settings.save_radius }}px;
                                   letter-spacing: {{ block.settings.save_letter_spacing | default: 1.28 }}px;
                                   line-height: 1;
                                   text-align: center;">
                        {%- if _save_badge_custom_label != blank -%}
                          {{- _save_badge_custom_label -}}
                        {%- else -%}
                          SAVE&nbsp;
                          {%- if _save_is_amount -%}
                            {{- _save_discount | money_without_trailing_zeros -}}
                          {%- elsif _save_show_percent and block.settings.save_format == 'percent' -%}
                            {{- _save_percent | round -}}%
                          {%- else -%}
                            {{- _save_discount | money -}}
                          {%- endif -%}
                        {%- endif -%}
                      </span>
                    {%- else -%}
                      <span style="color: {{ block.settings.sale_price_color }};
                                   font-size: {{ block.settings.sale_price_size }}px;
                                   font-weight: {{ block.settings.sale_price_weight | default: 700 }};
                                   line-height: 1.1;">
                        {{- _base_price | money -}}
                      </span>
                    {%- endif -%}

                    {%- if product.quantity_price_breaks_configured? -%}
                      <div class="text-opacity text-sm font-medium leading-tight" id="VolumeNote-{{ section.id }}-{{ product.id }}">
                        {{- 'products.volume_pricing.note' | t -}}
                      </div>
                    {%- endif -%}
                  </div>

                  {%- assign _show_metafield_tip = false -%}
                  {%- if _discount_amount > 0 or _metafield_percent > 0 -%}
                    {%- assign _show_metafield_tip = true -%}
                  {%- endif -%}
                  {%- if _save_discount > 0 and block.settings.show_discount_tip and _show_metafield_tip -%}
                    <div class="text-sm" style="color: {{ block.settings.discount_tip_color | default: '#71717A' }};">
                      {%- if _save_is_amount -%}
                        {{ _save_discount | money_without_trailing_zeros }} discount auto-applied at checkout
                      {%- elsif _save_show_percent -%}
                        {{ _save_percent | round }}% discount auto-applied at checkout
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                {%- else -%}
                  {%- comment -%} ====== 旧布局（默认）—— 使用 xy-components-price ====== {%- endcomment -%}
                  <div class="no-js-hidden flex gap-4 items-center" id="Price-{{ section.id }}-{{ product.id }}">
                    {% render 'xy-components-price', product: product, position: 'price-style-visual', enable_clearance_override: section.settings.enable_ivory_clearance_50, section: section %}

                    {%- if product.quantity_price_breaks_configured? -%}
                      <div class="text-opacity text-sm font-medium leading-tight" id="VolumeNote-{{ section.id }}-{{ product.id }}">
                        {{- 'products.volume_pricing.note' | t -}}
                      </div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

                {% unless product.id == 7562295312462 %}
                      <div class="xo__product__truemed__widget">
                        <div id="truemed-instructions" style="display: none;" icon-height="12" data-public-id="tm_qual_1ftn8rdjcj"></div>
                        <div onclick="document.querySelector('.truemed-instructions-open').click()" style="cursor: pointer;">
                          <div class="xo__product__truemed__text text-sm"> 
                            <span class="a-hsa-badge text-xs font-bold">HSA/FSA</span> 
                            <span>Eligible with Truemed · </span> 
                            <span class="pdp-truemed__link" style="color: #10374B;text-decoration-line: underline;">Learn More</span> 
                          </div>
                        </div>
                      </div>
                      <script src="https://static.truemed.com/widgets/product-page-widget.min.js" defer></script>
                {% endunless %}

                {%- if block.settings.show_info_bar and block.settings.info_bar_text != blank -%}
                  {%- capture info_bar_points -%}
                    {%- render 'product-reward-points-amount',
                      product: product,
                      enable_clearance_override: section.settings.enable_ivory_clearance_50,
                      section: section
                    -%}
                  {%- endcapture -%}
                  {%- assign info_bar_points = info_bar_points | strip -%}
                  {%- assign info_bar_text = block.settings.info_bar_text
                    | replace: '{points}', info_bar_points
                    | replace: 'xxx', info_bar_points
                    | replace: 'xx', info_bar_points
                  -%}
                  {{ 'https://fonts.googleapis.com/css2?family=Inter:wght@300;400&display=swap' | stylesheet_tag }}
                  <div
                    id="PriceInfoBar-{{ section.id }}-{{ product.id }}"
                    class="product-price-info-bar"
                    style="
                      --pib-icon-size: {{ block.settings.info_bar_icon_size | default: 20 }}px;
                      --pib-gap: {{ block.settings.info_bar_gap | default: 8 }}px;
                      --pib-bg: {{ block.settings.info_bar_bg | default: '#E1F6F9' }};
                      --pib-border: {{ block.settings.info_bar_border | default: 'transparent' }};
                      --pib-border-w: {{ block.settings.info_bar_border_width | default: 1 }}px;
                      --pib-radius: {{ block.settings.info_bar_radius | default: 18 }}px;
                      --pib-pad-y: {{ block.settings.info_bar_padding_y | default: 8 }}px;
                      --pib-pad-x: {{ block.settings.info_bar_padding_x | default: 12 }}px;
                      --pib-mt: {{ block.settings.info_bar_margin_top | default: 0 }}px;
                      --pib-color: {{ block.settings.info_bar_text_color | default: '#10374B' }};
                      --pib-size: {{ block.settings.info_bar_font_size | default: 13 }}px;
                      --pib-weight: {{ block.settings.info_bar_font_weight | default: 300 }};
                    "
                  >
                    <span class="product-price-info-bar__icon" aria-hidden="true">
                      {%- if block.settings.info_bar_icon != blank -%}
                        {{
                          block.settings.info_bar_icon
                          | image_url: width: 80
                          | image_tag: loading: 'lazy', widths: '40, 80', class: 'product-price-info-bar__img'
                        }}
                      {%- else -%}
                        <img
                          class="product-price-info-bar__img"
                          src="https://cdn.shopify.com/s/files/1/0640/6779/7070/files/20260708-100216.png?v=1783476155"
                          alt=""
                          width="20"
                          height="20"
                          loading="lazy"
                        >
                      {%- endif -%}
                    </span>
                    <span class="product-price-info-bar__text">{{ info_bar_text }}</span>
                  </div>
                {%- endif -%}

                {%- if block.settings.show_taxes_notice -%}
                  {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                    <div class="product__tax rte text-sm">
                      {%- liquid
                        if cart.taxes_included
                          echo 'products.product.include_taxes' | t
                        endif
                        if shop.shipping_policy.body != blank
                          echo 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url
                        endif
                      -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
              </div>

            {%- when 'quantity_selector' -%}
              {%- if product.available -%}
                <div id="QuantityForm-{{ section.id }}-{{ product.id }}" class="field" {{ block.shopify_attributes }}>
                  {%- assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id -%}
                  <label for="Quantity-{{ section.id }}-{{ product.id }}" class="quantity__label label" is="quantity-label">
                    {{ 'products.quantity.label' | t }}
                    <span id="QuantityRulesCart-{{ section.id }}-{{ product.id }}" class="quantity__rules-cart{% if cart_qty == 0 %} hidden{% endif %} relative">
                      <span class="quantity-cart font-medium">({{ 'products.quantity.in_cart_html' | t: quantity: cart_qty }})</span>
                    </span>
                  </label>
                  <div class="flex items-center gap-4">
                    <quantity-input class="quantity inline-flex relative" data-section-id="{{ section.id }}" data-product-id="{{ product.id }}">
                      <button type="button" name="minus" class="quantity__button" aria-label="{{ 'products.quantity.decrease' | t: product: product.title | escape }}">
                        {%- render 'icon', icon: 'chevron-left', size: 'sm', class: 'stroke-2 transform' -%}
                      </button>
                      <input
                        id="Quantity-{{ section.id }}-{{ product.id }}"
                        class="quantity__input text-sm sm:text-base font-medium text-center"
                        type="number"
                        name="quantity"
                        inputmode="numeric"
                        autocomplete="off"
                        data-quantity-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        data-cart-quantity="{{ cart_qty }}"
                        data-min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        min="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        {% if product.selected_or_first_available_variant.quantity_rule.max != null %}
                          data-max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                          max="{{ product.selected_or_first_available_variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ product.selected_or_first_available_variant.quantity_rule.increment }}"
                        value="{{ product.selected_or_first_available_variant.quantity_rule.min }}"
                        form="{{ product_form_id }}"
                      />
                      <button type="button" name="plus" class="quantity__button" aria-label="{{ 'products.quantity.increase' | t: product: product.title | escape }}">
                        {%- render 'icon', icon: 'chevron-right', size: 'sm', class: 'stroke-2 transform' -%}
                      </button>
                    </quantity-input>

                    {%- if product.quantity_price_breaks_configured? -%}
                      {%- liquid
                        assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                        assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                        if cart_qty > 0
                          assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                        endif
                        assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price
                      -%}
                      <price-per-item
                        id="PricePerItem-{{ section.id }}-{{ product.id }}"
                        class="price flex flex-wrap items-center gap-2 lg:gap-1d5"
                        data-section-id="{{ section.id }}"
                        data-product-id="{{ product.id }}"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                      >
                        {%- if variant_price_compare -%}
                          <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                          <span class="price__sale inline-flex items-center h-auto relative">
                            {%- liquid
                              if settings.currency_code_enabled
                                echo variant_price_compare | money_with_currency
                              else
                                echo variant_price_compare | money
                              endif
                            -%}
                          </span>
                          <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                        {%- endif -%}
                        
                        {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                          {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                            {%- liquid
                              if settings.currency_code_enabled
                                assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                              else
                                assign variant_price = product.selected_or_first_available_variant.price | money
                              endif
                            -%}
                            <span class="price-per-item--current price__regular whitespace-nowrap">
                              {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                            </span>
                          {%- else -%}
                            {%- for price_break in volume_pricing_array -%}
                              {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                                {%- liquid
                                  if settings.currency_code_enabled
                                    assign price_break_price = price_break.price | money_with_currency
                                  else
                                    assign price_break_price = price_break.price | money
                                  endif
                                -%}
                                <span class="price-per-item--current price__regular whitespace-nowrap">
                                  {{- 'products.volume_pricing.price_at_each' | t: price: price_break_price -}}
                                </span>
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- else -%}
                          <span class="price-per-item--current price__regular whitespace-nowrap">
                            {%- liquid
                              if settings.currency_code_enabled
                                assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                              else
                                assign variant_price = product.selected_or_first_available_variant.price | money
                              endif
                            -%}
                            {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                          </span>
                        {%- endif -%}
                      </price-per-item>
                    {%- endif -%}
                  </div>

                  {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 or product.selected_or_first_available_variant.quantity_rule.min > 1 or product.selected_or_first_available_variant.quantity_rule.max != null -%}
                    <div class="quantity__rules text-sm font-medium leading-tight" id="QuantityRules-{{ section.id }}-{{ product.id }}">
                      {%- if product.selected_or_first_available_variant.quantity_rule.increment > 1 -%}
                        <span class="divider">
                          {{- 'products.quantity.multiples_of' | t: quantity: product.selected_or_first_available_variant.quantity_rule.increment -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.min > 1 -%}
                        <span class="divider">
                          {{- 'products.quantity.minimum_of' | t: quantity: product.selected_or_first_available_variant.quantity_rule.min -}}
                        </span>
                      {%- endif -%}
                      {%- if product.selected_or_first_available_variant.quantity_rule.max != null -%}
                        <span class="divider">
                          {{- 'products.quantity.maximum_of' | t: quantity: product.selected_or_first_available_variant.quantity_rule.max -}}
                        </span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

            {%- when 'volume_pricing' -%}
              {%- if product.quantity_price_breaks_configured? -%}
                <volume-pricing class="volume-pricing grid gap-6" id="Volume-{{ section.id }}-{{ product.id }}">
                  {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                    <span class="caption-large font-medium">{{ 'products.volume_pricing.title' | t }}</span>
                    <ul class="list-unstyled">
                      <li class="text-sm flex gap-2d5 justify-between">
                        <span class="font-medium">{{ product.selected_or_first_available_variant.quantity_rule.min }}+</span>
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        <span data-text="{{ 'products.volume_pricing.price_at_each' | t: price: variant_price }}">
                          {{- 'sections.quick_order_list.each' | t: money: variant_price -}}
                        </span>
                      </li>
                      {%- for price_break in product.selected_or_first_available_variant.quantity_price_breaks -%}
                        {%- liquid
                          if settings.currency_code_enabled
                            assign price_break_price = price_break.price | money_with_currency
                          else
                            assign price_break_price = price_break.price | money
                          endif
                        -%}
                        <li class="text-sm flex gap-2d5 justify-between{% if forloop.index >= 3 %} show-more-item hidden{% endif %}">
                          <span class="font-medium">
                            {{- price_break.minimum_quantity -}}
                            <span aria-hidden="true">+</span>
                          </span>
                          <span data-text="{{ 'products.volume_pricing.price_at_each' | t: price: price_break_price }}">
                            {{- 'sections.quick_order_list.each' | t: money: price_break_price -}}
                          </span>
                        </li>
                      {%- endfor -%}
                    </ul>
                    {%- if product.selected_or_first_available_variant.quantity_price_breaks.size >= 3 -%}
                      <show-more-button>
                        <button
                          class="button-show-more link text-sm leading-tight"
                          id="ShowMore-{{ section.id }}-{{ product.id }}"
                          type="button"
                        >
                          <span class="label-show-more">{{ 'products.general.show_more' | t }}</span>
                        </button>
                      </show-more-button>
                    {%- endif -%}
                  {%- endif -%}
                </volume-pricing>
              {%- endif -%}

            {%- when 'variant_picker' -%}
              {%- render 'product-variant-picker',
                block: block,
                product: product,
                product_id: product.id,
                section_id: section.id,
                product_form_id: product_form_id,
                image_ratio: section.settings.image_ratio,
                image_ratio_mobile: section.settings.image_ratio_mobile,
                image_fill: settings.product_image_fill,
                enable_clearance_override: section.settings.enable_ivory_clearance_50,
                section: section
              -%}
              
            {%- when 'product_variations' -%}
              {%- render 'product-variants',
                block: block,
                product: product,
                product_id: product.id,
                section_id: section.id,
                image_ratio: section.settings.image_ratio,
                image_ratio_mobile: section.settings.image_ratio_mobile,
                image_fill: settings.product_image_fill
              -%}

            {%- when 'buy_buttons' -%}
              {%- render 'buy-buttons',
                block: block,
                section: section,
                product: product,
                product_id: product.id,
                section_id: section.id,
                product_form_id: product_form_id
              -%}

            {%- when 'reward_points' -%}
              {%- render 'product-reward-points',
                block: block,
                product: product,
                product_id: product.id,
                section_id: section.id
              -%}

            {%- when 'pickup_availability' -%}
              {%- render 'pickup-availability',
                block: block,
                section: section,
                product: product,
                product_id: product.id,
                section_id: section.id,
                product_form_id: product_form_id
              -%}

            {%- when 'inventory' -%}
              {%- render 'product-inventory',
                block: block,
                product: product,
                product_id: product.id,
                section_id: section.id
              -%}

            {%- when 'share' -%}
              <div class="flex justify-between items-center" {{ block.shopify_attributes }}>
                {%- liquid
                  assign share_url = product.selected_variant.url | default: product.url | prepend: request.origin
                  assign share_image = product.selected_variant.featured_image | default: product.featured_image
                -%}
                {%- render 'social-sharing',
                  section_id: section.id,
                  share_id: product.id,
                  share_label: block.settings.share_label,
                  share_title: product.title,
                  share_link: share_url,
                  share_image: share_image
                -%}

                {%- if block.settings.show_help_desk -%}
                  <div class="flex items-center gap-2">
                    {%- render 'icon', icon: 'question' -%}
                    {%- if block.settings.help_type == 'drawer' -%}
                      <button type="button" class="link text-sm leading-tight cursor-pointer" aria-controls="HelpDrawer">
                        {{- block.settings.help_label | escape -}}
                      </button>
                    {%- else -%}
                      <a class="link text-sm leading-tight cursor-pointer"{% if block.settings.help_page != blank %} href="{{ block.settings.help_page.url }}"{% if block.settings.help_page_external %} target="_blank" rel="noopener noreferrer"{% endif %}{% else %} role="link" aria-disabled="true"{% endif %}>
                        {{- block.settings.help_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'help_desk' -%}
              <div class="flex items-center gap-2" {{ block.shopify_attributes }}>
                {%- render 'icon', icon: 'question' -%}
                {%- if block.settings.help_type == 'drawer' -%}
                  <button type="button" class="link text-sm leading-tight cursor-pointer" aria-controls="HelpDrawer">
                    {{- block.settings.help_label | escape -}}
                  </button>
                {%- else -%}
                  <a class="link text-sm leading-tight cursor-pointer"{% if block.settings.help_page != blank %} href="{{ block.settings.help_page.url }}"{% if block.settings.help_page_external %} target="_blank" rel="noopener noreferrer"{% endif %}{% else %} role="link" aria-disabled="true"{% endif %}>
                    {{- block.settings.help_label | escape -}}
                  </a>
                {%- endif -%}
              </div>

            {%- when 'rating' -%}
              {%- render 'product-rating', product: product, block: block -%}

            {%- when 'product_intro_features' -%}
              {%- liquid
                assign pif_visibility = block.settings.visibility | default: 'pc'
                assign pif_classes = ''
                case pif_visibility
                  when 'pc'
                    assign pif_classes = 'hidden md:block'
                  when 'mobile'
                    assign pif_classes = 'block md:hidden'
                  when 'all'
                    assign pif_classes = 'block'
                endcase
                assign pif_intro      = product.metafields.custom.product_introduce
                assign pif_icons      = product.metafields.custom.product_features_icon.value
                assign pif_tip_text   = product.metafields.custom.product_introduce_tip
                if pif_tip_text == blank
                  assign pif_tip_text = block.settings.tooltip_text
                endif
                assign pif_tip_color   = block.settings.tooltip_color   | default: '#10374B'
                assign pif_tip_bg      = block.settings.tooltip_bg      | default: '#FFFFFF'
                assign pif_tip_radius  = block.settings.tooltip_radius  | default: 12
                assign pif_tip_max_w   = block.settings.tooltip_max_width | default: 360
                assign pif_tip_size    = block.settings.tooltip_text_size | default: 13
                assign pif_tip_icon    = block.settings.tooltip_icon_size | default: 16
                assign pif_show_tip    = block.settings.show_tooltip
                if pif_tip_text == blank
                  assign pif_show_tip = false
                endif
              -%}
              {%- if pif_intro != blank or pif_icons != blank or block.settings.show_divider -%}
                {%- assign _pif_id = 'pif-' | append: section.id | append: '-' | append: block.id -%}
                <div id="{{ _pif_id }}" class="product__intro-features {{ pif_classes }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_intro and pif_intro != blank -%}
                    <span
                      class="product__intro-text"
                      style="
                        display: block;
                        margin: 0;
                        color: {{ block.settings.intro_color | default: '#10374B' }};
                        font-size: {{ block.settings.intro_size | default: 16 }}px;
                        line-height: {{ block.settings.intro_line_height | default: 1.5 }};
                        font-weight: {{ block.settings.intro_weight | default: '400' }};
                      "
                    >
                      {{ pif_intro }}
                      {%- if pif_show_tip -%}
                        <span class="xy-tip" data-xy-tip>
                          <button type="button" class="xy-tip__btn" aria-label="More info" aria-expanded="false">
                            <svg width="{{ pif_tip_icon }}" height="{{ pif_tip_icon }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <circle cx="8" cy="8" r="7"/>
                              <line x1="8" y1="7" x2="8" y2="11.5"/>
                              <circle cx="8" cy="4.8" r="0.55" fill="currentColor" stroke="none"/>
                            </svg>
                          </button>
                          <span class="xy-tip__bubble" role="tooltip" hidden>
                            <button type="button" class="xy-tip__close" aria-label="Close">
                              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                                <line x1="2" y1="2" x2="10" y2="10"/>
                                <line x1="10" y1="2" x2="2" y2="10"/>
                              </svg>
                            </button>
                            <span class="xy-tip__text">{{ pif_tip_text }}</span>
                          </span>
                        </span>
                      {%- endif -%}
                    </span>
                  {%- endif -%}

                  {%- if block.settings.show_features and pif_icons != blank -%}
                    <div
                      class="product__intro-feature-list flex flex-wrap"
                      style="
                        margin-top: {{ block.settings.features_margin_top | default: 12 }}px;
                        gap: {{ block.settings.feature_gap | default: 8 }}px;
                      "
                    >
                      {%- for item in pif_icons -%}
                        <div
                          class="product__intro-feature flex items-center"
                          style="
                            padding: {{ block.settings.feature_padding_y | default: 0 }}px {{ block.settings.feature_padding_x | default: 0 }}px;
                            gap: {{ block.settings.feature_inner_gap | default: 4 }}px;
                            background: {{ block.settings.feature_bg | default: 'transparent' }};
                            border-radius: {{ block.settings.feature_radius | default: 4 }}px;
                            color: {{ block.settings.feature_text_color | default: '#10374B' }};
                          "
                        >
                          {%- if item.icon.value != blank -%}
                            <img
                              src="{{ item.icon.value | image_url: width: 64 }}"
                              alt="{{ item.label | escape }}"
                              width="{{ block.settings.feature_icon_size | default: 16 }}"
                              height="{{ block.settings.feature_icon_size | default: 16 }}"
                              loading="lazy"
                              style="margin-block:0;width:{{ block.settings.feature_icon_size | default: 16 }}px;height:{{ block.settings.feature_icon_size | default: 16 }}px;"
                            >
                          {%- endif -%}
                          <span
                            class="leading-4 font-normal"
                            style="font-size: {{ block.settings.feature_text_size | default: 14 }}px;"
                          >{{ item.label }}</span>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.show_divider -%}
                    <hr
                      style="
                        border: 0;
                        border-bottom: {{ block.settings.divider_width | default: 1 }}px solid {{ block.settings.divider_color | default: '#f0eeea' }};
                        margin: {{ block.settings.divider_margin_top | default: 13 }}px 0 {{ block.settings.divider_margin_bottom | default: 13 }}px;
                      "
                    >
                  {%- endif -%}
                </div>

                <style>
                  #{{ _pif_id }} .xy-tip{
                    --xy-tip-color: {{ pif_tip_color }};
                    --xy-tip-bg: {{ pif_tip_bg }};
                    --xy-tip-radius: {{ pif_tip_radius }}px;
                    --xy-tip-arrow: 8px;
                    position: relative;
                    display: inline-flex;
                    align-items: center;
                    vertical-align: middle;
                    margin-left: 4px;
                    line-height: 0;
                  }
                  #{{ _pif_id }} .xy-tip__btn{
                    appearance: none;
                    background: transparent;
                    border: 0;
                    padding: 0;
                    margin: 0;
                    color: var(--xy-tip-color);
                    cursor: pointer;
                    line-height: 0;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                  }
                  #{{ _pif_id }} .xy-tip__btn:hover{ opacity: 0.78; }
                  #{{ _pif_id }} .xy-tip__btn:focus-visible{
                    outline: 2px solid var(--xy-tip-color);
                    outline-offset: 2px;
                    border-radius: 50%;
                  }
                  #{{ _pif_id }} .xy-tip__bubble{
                    position: absolute;
                    top: calc(100% + 14px);
                    left: 50%;
                    transform: translateX(-50%);
                    z-index: 50;
                    width: max-content;
                    max-width: {{ pif_tip_max_w }}px;
                    padding: 12px 28px 12px 14px;
                    background: var(--xy-tip-bg);
                    color: var(--xy-tip-color);
                    border: 1px solid var(--xy-tip-color);
                    border-radius: var(--xy-tip-radius);
                    font-size: {{ pif_tip_size }}px;
                    line-height: 1.45;
                    text-align: left;
                    box-shadow: 0 6px 18px rgba(16, 55, 75, 0.08);
                    white-space: normal;
                  }
                  #{{ _pif_id }} .xy-tip__bubble[hidden]{ display: none; }
                  #{{ _pif_id }} .xy-tip__bubble::before,
                  #{{ _pif_id }} .xy-tip__bubble::after{
                    content: '';
                    position: absolute;
                    left: var(--xy-tip-arrow-left, 50%);
                    width: 0; height: 0;
                    border-left: var(--xy-tip-arrow) solid transparent;
                    border-right: var(--xy-tip-arrow) solid transparent;
                  }
                  #{{ _pif_id }} .xy-tip__bubble::before{
                    top: -1px;
                    border-bottom: var(--xy-tip-arrow) solid var(--xy-tip-color);
                    transform: translate(-50%, -100%);
                  }
                  #{{ _pif_id }} .xy-tip__bubble::after{
                    top: 0;
                    border-bottom: var(--xy-tip-arrow) solid var(--xy-tip-bg);
                    transform: translate(-50%, -100%);
                  }
                  @media screen and (max-width: 767px) {
                    #{{ _pif_id }} .xy-tip__bubble{
                      max-width: min({{ pif_tip_max_w }}px, calc(100vw - 32px));
                      box-sizing: border-box;
                    }
                  }
                  #{{ _pif_id }} .xy-tip__close{
                    appearance: none;
                    background: transparent;
                    border: 0;
                    padding: 4px;
                    margin: 0;
                    position: absolute;
                    top: 4px;
                    right: 4px;
                    color: var(--xy-tip-color);
                    cursor: pointer;
                    line-height: 0;
                    display: inline-flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 999px;
                  }
                  #{{ _pif_id }} .xy-tip__close:hover{ background: rgba(16,55,75,0.08); }
                  #{{ _pif_id }} .xy-tip__text{ display: inline-block; }
                </style>
              {%- endif -%}

            {%- when 'complementary' -%}
              {%- render 'product-complementary',
                section_id: section.id,
                product_id: product.id,
                image_ratio: settings.product_image_ratio,
                image_fill: settings.product_image_fill,
                limit: block.settings.product_limit,
                heading: block.settings.heading,
                show_vendor: block.settings.show_vendor,
                show_price: block.settings.show_price,
              -%}

            {%- when 'liquid' -%}
              {%- if block.settings.liquid != blank -%}
                <div class="rte" {{ block.shopify_attributes }}>
                  {{- block.settings.liquid -}}
                </div>
              {%- endif -%}

            {%- when 'yotpo_rating_promo' -%}
              {%- render 'product-yotpo-rating-promo', product: product, block: block, placement: 'info' -%}

            {%- when 'marquee' -%}
              {%- if block.settings.text != blank -%}
                {%- assign _mq_id   = 'mq-' | append: section.id | append: '-' | append: block.id -%}
                {%- assign _mq_dir  = block.settings.direction | default: 'rtl' -%}
                {%- assign _mq_dur  = block.settings.duration | default: 20 -%}
                {%- assign _mq_repeat = block.settings.repeat | default: 4 | plus: 0 -%}
                {%- if _mq_repeat < 2 -%}{%- assign _mq_repeat = 2 -%}{%- endif -%}
                {%- assign _mq_pad_t = block.settings.padding_top -%}
                {%- if _mq_pad_t == blank -%}{%- assign _mq_pad_t = 2 -%}{%- endif -%}
                {%- assign _mq_pad_b = block.settings.padding_bottom -%}
                {%- if _mq_pad_b == blank -%}{%- assign _mq_pad_b = 0 -%}{%- endif -%}
                <div class="xy-mq" id="{{ _mq_id }}" {{ block.shopify_attributes }}
                  style="
                    {%- if block.settings.use_bg_color and block.settings.bg_color != blank -%}background: {{ block.settings.bg_color }};{%- endif -%}
                    {%- if block.settings.text_color != blank -%}color: {{ block.settings.text_color }};{%- endif -%}
                    font-size: {{ block.settings.font_size }}px;
                    font-weight: {{ block.settings.font_weight | default: 500 }};
                    letter-spacing: {{ block.settings.letter_spacing | default: 0 }}px;
                    padding: {{ _mq_pad_t }}px 0 {{ _mq_pad_b }}px;
                    --xy-mq-duration: {{ _mq_dur }}s;
                  ">
                  <div class="xy-mq__track xy-mq__track--{{ _mq_dir }}">
                    {%- for i in (1.._mq_repeat) -%}
                      <span class="xy-mq__item">{{ block.settings.text }}</span>
                    {%- endfor -%}
                  </div>
                </div>
                <style>
                  #{{ _mq_id }}.xy-mq{
                    overflow: hidden;
                    width: 100%;
                    line-height: 1;
                  }
                  #{{ _mq_id }} .xy-mq__track{
                    display: inline-flex;
                    flex-wrap: nowrap;
                    white-space: nowrap;
                    width: max-content;
                    will-change: transform;
                  }
                  #{{ _mq_id }} .xy-mq__item{
                    display: inline-block;
                    padding-inline-end: {{ block.settings.gap | default: 32 }}px;
                  }
                  #{{ _mq_id }} .xy-mq__track--rtl{
                    animation: xy-mq-rtl-{{ block.id | replace: '_','-' | replace: '.','-' }} var(--xy-mq-duration) linear infinite;
                  }
                  #{{ _mq_id }} .xy-mq__track--ltr{
                    animation: xy-mq-ltr-{{ block.id | replace: '_','-' | replace: '.','-' }} var(--xy-mq-duration) linear infinite;
                  }
                  @keyframes xy-mq-rtl-{{ block.id | replace: '_','-' | replace: '.','-' }}{
                    0%   { transform: translateX(0); }
                    100% { transform: translateX(calc(-100% / {{ _mq_repeat }})); }
                  }
                  @keyframes xy-mq-ltr-{{ block.id | replace: '_','-' | replace: '.','-' }}{
                    0%   { transform: translateX(calc(-100% / {{ _mq_repeat }})); }
                    100% { transform: translateX(0); }
                  }
                  @media (prefers-reduced-motion: reduce){
                    #{{ _mq_id }} .xy-mq__track{ animation: none !important; }
                  }
                </style>
              {%- endif -%}

            {%- when 'addon' -%}
              {%- assign _ap = block.settings.product -%}
              {%- if _ap != blank -%}
                {%- assign _afv = _ap.selected_or_first_available_variant -%}
                {%- assign _adef_vid = block.settings.default_variant_id | default: _afv.id -%}

                {%- comment %} 折扣优先级：compare_at_price > custom.discount_amount（固定金额）> custom.product_discounts（百分比）{%- endcomment -%}
                {%- assign _addon_amt = _ap.metafields.custom.discount_amount | default: 0 | plus: 0 -%}
                {%- assign _addon_pct = _ap.metafields.custom.product_discounts | default: 0 | plus: 0 -%}

                {%- assign _afv_orig    = _afv.price -%}
                {%- assign _afv_compare = _afv.compare_at_price | default: 0 -%}
                {%- if _afv_compare > _afv_orig -%}
                  {%- assign _asp  = _afv_orig -%}
                  {%- assign _acmp = _afv_compare -%}
                {%- elsif _addon_amt > 0 -%}
                  {%- assign _afv_disc       = _addon_amt | times: 100 -%}
                  {%- assign _asp            = _afv_orig | minus: _afv_disc -%}
                  {%- assign _acmp           = _afv_orig -%}
                {%- elsif _addon_pct > 0 -%}
                  {%- assign _afv_disc       = _afv_orig | times: _addon_pct | divided_by: 100 -%}
                  {%- assign _asp            = _afv_orig | minus: _afv_disc -%}
                  {%- assign _acmp           = _afv_orig -%}
                {%- else -%}
                  {%- assign _asp  = _afv_orig -%}
                  {%- assign _acmp = 0 -%}
                {%- endif -%}
                {%- assign _acmp_display = _acmp | money -%}
                {%- assign _asp_display  = _asp | money -%}
                {%- assign _show_acmp = false -%}
                {%- if _acmp > _asp -%}
                  {%- assign _show_acmp = true -%}
                {%- endif -%}

                {%- comment %} Auto-detect Color/Size option indexes {%- endcomment -%}
                {%- assign _color_opt_idx = 0 -%}
                {%- assign _size_opt_idx  = 0 -%}
                {%- assign _color_found = false -%}
                {%- assign _size_found  = false -%}
                {%- assign _color_target = block.settings.color_option_name | downcase -%}
                {%- assign _size_target  = block.settings.size_option_name  | downcase -%}
                {%- for opt in _ap.options_with_values -%}
                  {%- assign _opt_lc = opt.name | downcase -%}
                  {%- unless _color_found -%}
                    {%- if _color_target != blank -%}
                      {%- if _opt_lc == _color_target -%}
                        {%- assign _color_opt_idx = forloop.index0 -%}
                        {%- assign _color_found = true -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- capture _is_color_opt -%}{%- render 'color-option-match', option_name: opt.name -%}{%- endcapture -%}
                      {%- if _is_color_opt contains 'true' -%}
                        {%- assign _color_opt_idx = forloop.index0 -%}
                        {%- assign _color_found = true -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endunless -%}
                  {%- unless _size_found -%}
                    {%- if _size_target != blank -%}
                      {%- if _opt_lc == _size_target -%}
                        {%- assign _size_opt_idx = forloop.index0 -%}
                        {%- assign _size_found = true -%}
                      {%- endif -%}
                    {%- else -%}
                      {%- if _opt_lc contains 'size' or _opt_lc contains '尺寸' or _opt_lc contains '尺码' or _opt_lc contains '规格' -%}
                        {%- assign _size_opt_idx = forloop.index0 -%}
                        {%- assign _size_found = true -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endunless -%}
                {%- endfor -%}
                {%- assign _auto_color = false -%}
                {%- assign _auto_size  = false -%}
                {%- if _color_found -%}{%- assign _auto_color = true -%}{%- endif -%}
                {%- if _size_found  -%}{%- assign _auto_size  = true -%}{%- endif -%}

                {%- comment %} Default value per option axis: prefer selected_or_first_available_variant.optionN, fallback to options_with_values[i].values.first {%- endcomment -%}
                {%- assign _def0 = '' -%}
                {%- assign _def1 = '' -%}
                {%- assign _def2 = '' -%}
                {%- if _afv.option1 != blank -%}
                  {%- assign _def0 = _afv.option1 -%}
                {%- elsif _ap.options_with_values[0] -%}
                  {%- assign _v_tmp = _ap.options_with_values[0].values.first -%}
                  {%- if _v_tmp.name != blank -%}{%- assign _def0 = _v_tmp.name -%}{%- else -%}{%- assign _def0 = _v_tmp -%}{%- endif -%}
                {%- endif -%}
                {%- if _afv.option2 != blank -%}
                  {%- assign _def1 = _afv.option2 -%}
                {%- elsif _ap.options_with_values[1] -%}
                  {%- assign _v_tmp = _ap.options_with_values[1].values.first -%}
                  {%- if _v_tmp.name != blank -%}{%- assign _def1 = _v_tmp.name -%}{%- else -%}{%- assign _def1 = _v_tmp -%}{%- endif -%}
                {%- endif -%}
                {%- if _afv.option3 != blank -%}
                  {%- assign _def2 = _afv.option3 -%}
                {%- elsif _ap.options_with_values[2] -%}
                  {%- assign _v_tmp = _ap.options_with_values[2].values.first -%}
                  {%- if _v_tmp.name != blank -%}{%- assign _def2 = _v_tmp.name -%}{%- else -%}{%- assign _def2 = _v_tmp -%}{%- endif -%}
                {%- endif -%}
                {%- assign _show_color_picker = false -%}
                {%- assign _show_size_picker  = false -%}
                {%- if block.settings.show_color -%}
                  {%- if _auto_color -%}{%- assign _show_color_picker = true -%}{%- endif -%}
                  {%- if block.settings.color_options != blank -%}{%- assign _show_color_picker = true -%}{%- endif -%}
                {%- endif -%}
                {%- if block.settings.show_size -%}
                  {%- if _auto_size -%}{%- assign _show_size_picker = true -%}{%- endif -%}
                  {%- if block.settings.size_options != blank -%}{%- assign _show_size_picker = true -%}{%- endif -%}
                {%- endif -%}

                <div class="xy-addon" data-xy-addon
                  data-xy-addon-total="{{ _xy_addon_count }}"
                  data-default-vid="{{ _adef_vid }}"
                  data-color-idx="{{ _color_opt_idx }}"
                  data-size-idx="{{ _size_opt_idx }}"
                  data-color-found="{{ _color_found }}"
                  data-size-found="{{ _size_found }}"
                  {{ block.shopify_attributes }}
                  style="
                    --xy-addon-card-bg: {{ block.settings.card_bg }};
                    --xy-addon-card-border: {{ block.settings.card_border_color | default: '#D1D5DB' }};
                    --xy-addon-card-radius: {{ block.settings.card_radius }}px;
                    --xy-addon-card-pad-x: {{ block.settings.card_padding_x }}px;
                    --xy-addon-card-pad-y: {{ block.settings.card_padding_y }}px;
                    --xy-addon-card-margin-y: {{ block.settings.card_margin_y | default: 12 }}px;
                    --xy-addon-gap: {{ block.settings.card_gap }}px;
                    --xy-addon-active-color: {{ block.settings.active_color | default: '#10374B' }};
                    --xy-addon-card-checked-shadow: {{ block.settings.checked_shadow | default: '0 6px 18px rgba(16, 55, 75, 0.14)' }};
                    --xy-addon-check-color: {{ block.settings.check_color | default: '#FFFFFF' }};
                    --xy-addon-check-bg: {{ block.settings.check_bg }};
                    --xy-addon-check-size: {{ block.settings.check_size | default: 22 }}px;
                    --xy-addon-check-gap: {{ block.settings.check_gap | default: 14 }}px;
                    --xy-addon-title-color: {{ block.settings.title_color }};
                    --xy-addon-title-size: {{ block.settings.title_size }}px;
                    --xy-addon-title-weight: {{ block.settings.title_weight }};
                    --xy-addon-cmp-color: {{ block.settings.compare_color }};
                    --xy-addon-cmp-size: {{ block.settings.compare_size }}px;
                    --xy-addon-sale-color: {{ block.settings.sale_color }};
                    --xy-addon-sale-size: {{ block.settings.sale_size }}px;
                    --xy-addon-sale-weight: {{ block.settings.sale_weight }};
                    --xy-addon-price-offset-x: {{ block.settings.price_offset_x | default: 0 }}px;
                    --xy-addon-img-size: {{ block.settings.image_size }}px;
                    --xy-addon-img-radius: {{ block.settings.image_radius }}px;
                    --xy-addon-heading-color: {{ block.settings.heading_color }};
                    --xy-addon-heading-size: {{ block.settings.heading_size }}px;
                    --xy-addon-heading-weight: {{ block.settings.heading_weight }};
                    --xy-addon-picker-fz: {{ block.settings.picker_font_size | default: 14 }}px;
                    --xy-addon-arrow-color: {{ block.settings.arrow_color | default: '#10374B' }};
                    --xy-addon-arrow-size: {{ block.settings.arrow_size | default: 24 }}px;
                    --xy-addon-arrow-offset: {{ block.settings.arrow_offset | default: 10 }}px;
                    --xy-addon-arrow-top: {{ block.settings.arrow_top | default: 0 }}px;
                    --xy-addon-arrow-stroke: {{ block.settings.arrow_stroke | default: 2.5 }};
                  ">
                  <script type="application/json" data-xy-addon-variants>
                    {
                      "__meta__":{
                        "color_idx":{{ _color_opt_idx }},
                        "size_idx":{{ _size_opt_idx }},
                        "color_found":{{ _color_found | json }},
                        "size_found":{{ _size_found | json }},
                        "discount_pct":{{ _addon_pct }},
                        "defaults":[{{ _def0 | json }},{{ _def1 | json }},{{ _def2 | json }}]
                      }
                      {%- for v in _ap.variants -%}
                        {%- assign _v_orig    = v.price -%}
                        {%- assign _v_compare = v.compare_at_price | default: 0 -%}
                        {%- if _v_compare > _v_orig -%}
                          {%- assign _v_sale       = _v_orig -%}
                          {%- assign _v_show_cmp   = _v_compare -%}
                        {%- elsif _addon_amt > 0 -%}
                          {%- assign _v_disc       = _addon_amt | times: 100 -%}
                          {%- assign _v_sale       = _v_orig | minus: _v_disc -%}
                          {%- assign _v_show_cmp   = _v_orig -%}
                        {%- elsif _addon_pct > 0 -%}
                          {%- assign _v_disc       = _v_orig | times: _addon_pct | divided_by: 100 -%}
                          {%- assign _v_sale       = _v_orig | minus: _v_disc -%}
                          {%- assign _v_show_cmp   = _v_orig -%}
                        {%- else -%}
                          {%- assign _v_sale       = _v_orig -%}
                          {%- assign _v_show_cmp   = 0 -%}
                        {%- endif -%}
                        {%- assign _v_image = '' -%}
                        {%- if v.featured_image != blank -%}
                          {%- assign _v_image = v.featured_image | image_url: width: 240 -%}
                        {%- elsif v.image != blank -%}
                          {%- assign _v_image = v.image | image_url: width: 240 -%}
                        {%- endif -%}
                        ,"{{ v.id }}":{"price":{{ _v_sale | money | json }},"compare":{{ _v_show_cmp | money | json }},"raw_price":{{ _v_sale }},"raw_compare":{{ _v_show_cmp }},"available":{{ v.available | json }},"options":[{{ v.option1 | json }},{{ v.option2 | json }},{{ v.option3 | json }}],"image":{{ _v_image | json }}}
                      {%- endfor -%}
                    }
                  </script>
                  {%- if block.settings.heading != blank or _xy_addon_count > 1 and block.id == _xy_addon_first_id -%}
                    <div class="xy-addon__title-row">
                      {%- if block.settings.heading != blank -%}
                        <p class="xy-addon__heading">{{ block.settings.heading | escape }}</p>
                      {%- endif -%}
                      {%- if _xy_addon_count > 1 and block.id == _xy_addon_first_id -%}
                        <div class="xy-addon-carousel__navs" data-xy-addon-navs>
                          <button type="button" class="xy-addon-carousel__nav xy-addon-carousel__nav--prev" aria-label="Previous add-on" disabled>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
                          </button>
                          <button type="button" class="xy-addon-carousel__nav xy-addon-carousel__nav--next" aria-label="Next add-on">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
                          </button>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  <label class="xy-addon__card">
                    <span class="xy-addon__check-wrap">
                      <input type="checkbox" class="xy-addon__check" data-xy-addon-check
                        {% if block.settings.default_checked %}checked{% endif %}>
                      <span class="xy-addon__check-icon" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                          <path d="M5 12.5L10 17.5L19 7.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </span>
                    </span>

                    {%- if _ap.featured_image != blank -%}
                      {%- assign _ap_default_img = _ap.featured_image | image_url: width: 240 -%}
                      <span class="xy-addon__media">
                        <img data-xy-addon-img data-xy-addon-default-img="{{ _ap_default_img }}" src="{{ _ap_default_img }}" alt="{{ _ap.title | escape }}" loading="lazy" width="80" height="80">
                      </span>
                    {%- endif -%}

                    <div class="xy-addon__body">
                      <p class="xy-addon__title">{{ block.settings.product_title_override | default: _ap.title | escape }}</p>
                      <div class="xy-addon__row">
                        <div class="xy-addon__pickers">
                          {%- if _show_color_picker -%}
                            {%- if _auto_color -%}
                              {%- assign _color_opt = _ap.options_with_values[_color_opt_idx] -%}
                              {%- assign _first_color_val = _color_opt.values.first -%}
                              {%- assign _first_color_label = _first_color_val.name | default: _first_color_val -%}
                              {%- assign _first_color_hex = _first_color_val.swatch.color | default: '' -%}
                              {%- if _first_color_hex == blank -%}{%- assign _first_color_hex = _first_color_label -%}{%- endif -%}
                              {%- assign _first_color_vid = _first_color_val.variant.id | default: _adef_vid -%}
                            {%- else -%}
                              {%- assign _color_lines = block.settings.color_options | strip | newline_to_br | replace: '<br />', '|||' | replace: '<br/>', '|||' | replace: '<br>', '|||' | split: '|||' -%}
                              {%- assign _first_color_parts = _color_lines.first | strip | split: '|' -%}
                              {%- assign _first_color_label = _first_color_parts[0] | strip -%}
                              {%- assign _first_color_hex = _first_color_parts[1] | default: '#888' -%}
                              {%- assign _first_color_vid = _first_color_parts[2] | default: _adef_vid -%}
                            {%- endif -%}
                            {%- capture _first_color_bg -%}{%- render 'addon-color-bg', color_label: _first_color_label, fallback_hex: _first_color_hex -%}{%- endcapture -%}
                            {%- assign _first_is_img = false -%}
                            {%- if _first_color_bg contains 'url(' -%}{%- assign _first_is_img = true -%}{%- endif -%}
                            <div class="xy-addon__picker xy-addon__picker--color" data-xy-addon-dropdown="color" aria-label="{{ block.settings.color_label | default: 'Color' | escape }}">
                              <span class="xy-addon__swatch{% if _first_is_img %} is-img{% endif %}" data-xy-addon-swatch style="background: #888; background: {{ _first_color_bg }};"></span>
                              <button type="button" class="xy-addon__trigger" data-xy-addon-trigger aria-haspopup="listbox" aria-expanded="false">
                                <span class="xy-addon__trigger-label" data-xy-addon-label>{{ _first_color_label }}</span>
                                <span class="xy-addon__caret" aria-hidden="true">
                                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </span>
                              </button>
                              <input type="hidden" data-xy-addon-color value="{{ _first_color_vid }}">
                              <ul class="xy-addon__menu" role="listbox" hidden>
                                {%- if _auto_color -%}
                                  {%- for val in _color_opt.values -%}
                                    {%- assign _name = val.name | default: val -%}
                                    {%- assign _hex = val.swatch.color | default: '' -%}
                                    {%- if _hex == blank -%}{%- assign _hex = _name -%}{%- endif -%}
                                    {%- assign _vid = val.variant.id | default: _adef_vid -%}
                                    {%- capture _menu_bg -%}{%- render 'addon-color-bg', color_label: _name, fallback_hex: _hex -%}{%- endcapture -%}
                                    {%- assign _menu_is_img = false -%}
                                    {%- if _menu_bg contains 'url(' -%}{%- assign _menu_is_img = true -%}{%- endif -%}
                                    <li class="xy-addon__menu-item{% if forloop.first %} is-selected{% endif %}" role="option" data-value="{{ _vid }}" data-color="{{ _menu_bg | escape }}" data-label="{{ _name | escape }}" data-explicit-vid="false">
                                      <span class="xy-addon__menu-swatch{% if _menu_is_img %} is-img{% endif %}" style="background: #888; background: {{ _menu_bg }};"></span>
                                      <span class="xy-addon__menu-text">{{ _name }}</span>
                                      <span class="xy-addon__menu-check" aria-hidden="true">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                          <path d="M5 12.5L10 17.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                      </span>
                                    </li>
                                  {%- endfor -%}
                                {%- else -%}
                                  {%- for line in _color_lines -%}
                                    {%- assign _parts = line | strip | split: '|' -%}
                                    {%- if _parts[0] != blank -%}
                                      {%- assign _name = _parts[0] | strip -%}
                                      {%- assign _hex  = _parts[1] | default: '#888' -%}
                                      {%- assign _explicit = false -%}
                                      {%- if _parts.size > 2 and _parts[2] != blank -%}{%- assign _explicit = true -%}{%- endif -%}
                                      {%- assign _vid  = _parts[2] | default: _adef_vid -%}
                                      {%- capture _menu_bg -%}{%- render 'addon-color-bg', color_label: _name, fallback_hex: _hex -%}{%- endcapture -%}
                                      {%- assign _menu_is_img = false -%}
                                      {%- if _menu_bg contains 'url(' -%}{%- assign _menu_is_img = true -%}{%- endif -%}
                                      <li class="xy-addon__menu-item{% if forloop.first %} is-selected{% endif %}" role="option" data-value="{{ _vid }}" data-color="{{ _menu_bg | escape }}" data-label="{{ _name | escape }}" data-explicit-vid="{{ _explicit }}">
                                        <span class="xy-addon__menu-swatch{% if _menu_is_img %} is-img{% endif %}" style="background: #888; background: {{ _menu_bg }};"></span>
                                        <span class="xy-addon__menu-text">{{ _name }}</span>
                                        <span class="xy-addon__menu-check" aria-hidden="true">
                                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                            <path d="M5 12.5L10 17.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                          </svg>
                                        </span>
                                      </li>
                                    {%- endif -%}
                                  {%- endfor -%}
                                {%- endif -%}
                              </ul>
                            </div>
                          {%- endif -%}

                          {%- if _show_size_picker -%}
                            {%- if _auto_size -%}
                              {%- assign _size_opt = _ap.options_with_values[_size_opt_idx] -%}
                              {%- assign _first_size_val = _size_opt.values.first -%}
                              {%- assign _first_size_label = _first_size_val.name | default: _first_size_val -%}
                              {%- assign _first_size_vid = _first_size_val.variant.id | default: _adef_vid -%}
                            {%- else -%}
                              {%- assign _size_lines = block.settings.size_options | strip | newline_to_br | replace: '<br />', '|||' | replace: '<br/>', '|||' | replace: '<br>', '|||' | split: '|||' -%}
                              {%- assign _first_size_parts = _size_lines.first | strip | split: '|' -%}
                              {%- assign _first_size_label = _first_size_parts[0] | strip -%}
                              {%- assign _first_size_vid   = _first_size_parts[1] | default: _adef_vid -%}
                            {%- endif -%}
                            <div class="xy-addon__picker xy-addon__picker--size" data-xy-addon-dropdown="size" aria-label="{{ block.settings.size_label | default: 'Size' | escape }}">
                              <button type="button" class="xy-addon__trigger" data-xy-addon-trigger aria-haspopup="listbox" aria-expanded="false">
                                <span class="xy-addon__trigger-label" data-xy-addon-label>{{ _first_size_label }}</span>
                                <span class="xy-addon__caret" aria-hidden="true">
                                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
                                  </svg>
                                </span>
                              </button>
                              <input type="hidden" data-xy-addon-size value="{{ _first_size_vid }}">
                              <ul class="xy-addon__menu" role="listbox" hidden>
                                {%- if _auto_size -%}
                                  {%- for val in _size_opt.values -%}
                                    {%- assign _name = val.name | default: val -%}
                                    {%- assign _vid = val.variant.id | default: _adef_vid -%}
                                    <li class="xy-addon__menu-item{% if forloop.first %} is-selected{% endif %}" role="option" data-value="{{ _vid }}" data-label="{{ _name | escape }}" data-explicit-vid="false">
                                      <span class="xy-addon__menu-text">{{ _name }}</span>
                                      <span class="xy-addon__menu-check" aria-hidden="true">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                          <path d="M5 12.5L10 17.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                      </span>
                                    </li>
                                  {%- endfor -%}
                                {%- else -%}
                                  {%- for line in _size_lines -%}
                                    {%- assign _parts = line | strip | split: '|' -%}
                                    {%- if _parts[0] != blank -%}
                                      {%- assign _name = _parts[0] | strip -%}
                                      {%- assign _explicit = false -%}
                                      {%- if _parts.size > 1 and _parts[1] != blank -%}{%- assign _explicit = true -%}{%- endif -%}
                                      {%- assign _vid  = _parts[1] | default: _adef_vid -%}
                                      <li class="xy-addon__menu-item{% if forloop.first %} is-selected{% endif %}" role="option" data-value="{{ _vid }}" data-label="{{ _name | escape }}" data-explicit-vid="{{ _explicit }}">
                                        <span class="xy-addon__menu-text">{{ _name }}</span>
                                        <span class="xy-addon__menu-check" aria-hidden="true">
                                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none">
                                            <path d="M5 12.5L10 17.5L19 7.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                                          </svg>
                                        </span>
                                      </li>
                                    {%- endif -%}
                                  {%- endfor -%}
                                {%- endif -%}
                              </ul>
                            </div>
                          {%- endif -%}
                        </div>

                        <div class="xy-addon__price" data-xy-addon-price-wrap>
                          <span class="xy-addon__sale" data-xy-addon-sale>{{ _asp_display }}</span>
                          <s class="xy-addon__compare" data-xy-addon-compare {% unless _show_acmp %}hidden{% endunless %}>{{ _acmp_display }}</s>
                        </div>
                      </div>
                    </div>
                  </label>
                </div>
              {%- endif -%}

            {%- when 'gift_progress' -%}
              {%- render 'gift-progress', block: block -%}

            {%- when 'free_gift' -%}
              {%- comment %} 全局强制统一：优先使用「主题设置 → Free Gift 赠品（全局）」中的产品，
                  只有全局未配置时才回退到当前实例单独选择的产品，避免未配置前页面空白。 {%- endcomment -%}
              {%- assign _fg = settings.global_free_gift_product -%}
              {%- if _fg == blank -%}
                {%- assign _fg = block.settings.product -%}
              {%- endif -%}
              {%- if _fg != blank -%}
                {%- assign _fgv = _fg.selected_or_first_available_variant -%}
                {%- assign _fg_id = 'fg-' | append: section.id | append: '-' | append: block.id -%}

                {%- comment %} Collect color values from any option named "color"/"colour"/"颜色"/"色" {%- endcomment -%}
                {%- assign _fg_colors_str = '' -%}
                {%- for opt in _fg.options_with_values -%}
                  {%- assign _opt_lc = opt.name | downcase -%}
                  {%- capture _is_color_opt -%}{%- render 'color-option-match', option_name: opt.name -%}{%- endcapture -%}
                  {%- if _is_color_opt contains 'true' -%}
                    {%- for v in opt.values -%}
                      {%- assign _v_name = v.name | default: v -%}
                      {%- if _fg_colors_str == '' -%}
                        {%- assign _fg_colors_str = _v_name -%}
                      {%- else -%}
                        {%- assign _fg_colors_str = _fg_colors_str | append: ' / ' | append: _v_name -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}

                <div class="xy-fg" id="{{ _fg_id }}" {{ block.shopify_attributes }}
                  style="
                    --xy-fg-bg: {{ block.settings.card_bg }};
                    --xy-fg-radius: {{ block.settings.card_radius }}px;
                    --xy-fg-pad-x: {{ block.settings.card_padding_x }}px;
                    --xy-fg-pad-y: {{ block.settings.card_padding_y }}px;
                    --xy-fg-margin-y: {{ block.settings.card_margin_y | default: 23 }}px;
                    --xy-fg-top-gap: {{ block.settings.top_gap | default: 14 }}px;
                    --xy-fg-gap: {{ block.settings.card_gap | default: 14 }}px;
                    --xy-fg-img-size: {{ block.settings.image_size }}px;
                    --xy-fg-img-radius: {{ block.settings.image_radius }}px;
                    --xy-fg-badge-size: {{ block.settings.badge_size | default: 34 }}px;
                    --xy-fg-badge-x: {{ block.settings.badge_offset_x | default: -10 }}px;
                    --xy-fg-badge-y: {{ block.settings.badge_offset_y | default: 0 }}px;
                    --xy-fg-heading-color: {{ block.settings.heading_color }};
                    --xy-fg-heading-size: {{ block.settings.heading_size }}px;
                    --xy-fg-heading-weight: {{ block.settings.heading_weight }};
                    --xy-fg-sub-color: {{ block.settings.subheading_color }};
                    --xy-fg-sub-size: {{ block.settings.subheading_size }}px;
                    --xy-fg-sub-weight: {{ block.settings.subheading_weight }};
                    --xy-fg-title-color: {{ block.settings.title_color }};
                    --xy-fg-title-size: {{ block.settings.title_size }}px;
                    --xy-fg-title-weight: {{ block.settings.title_weight }};
                    --xy-fg-color-color: {{ block.settings.color_color }};
                    --xy-fg-color-size: {{ block.settings.color_size }}px;
                    --xy-fg-color-weight: {{ block.settings.color_weight }};
                    --xy-fg-cmp-color: {{ block.settings.compare_color }};
                    --xy-fg-cmp-size: {{ block.settings.compare_size }}px;
                    --xy-fg-free-color: {{ block.settings.free_color }};
                    --xy-fg-free-size: {{ block.settings.free_size }}px;
                    --xy-fg-free-weight: {{ block.settings.free_weight }};
                  ">
                  {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
                    <div class="xy-fg__top">
                      {%- if block.settings.heading != blank -%}
                        <span class="xy-fg__heading">
                          {{ block.settings.heading | escape }}
                          {%- assign _fg_tip_text = block.settings.tooltip_text | default: 'The $399 minimum is based on your order subtotal before tax.' -%}
                          {%- if block.settings.show_tooltip and _fg_tip_text != blank -%}
                            <span class="xy-tip" data-xy-tip>
                              <button type="button" class="xy-tip__btn" aria-label="More info" aria-expanded="false">
                                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <circle cx="8" cy="8" r="7"/>
                                  <line x1="8" y1="7" x2="8" y2="11.5"/>
                                  <circle cx="8" cy="4.8" r="0.55" fill="currentColor" stroke="none"/>
                                </svg>
                              </button>
                              <span class="xy-tip__bubble" role="tooltip" hidden>
                                <button type="button" class="xy-tip__close" aria-label="Close">
                                  <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                                    <line x1="2" y1="2" x2="10" y2="10"/>
                                    <line x1="10" y1="2" x2="2" y2="10"/>
                                  </svg>
                                </button>
                                <span class="xy-tip__text">{{ _fg_tip_text }}</span>
                              </span>
                            </span>
                          {%- endif -%}
                        </span>
                      {%- endif -%}
                      {%- if block.settings.subheading != blank -%}
                        <span class="xy-fg__sub">{{ block.settings.subheading | escape }}</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <div class="xy-fg__body">
                    {%- if _fg.featured_image != blank -%}
                      <div class="xy-fg__media">
                        <img class="xy-fg__img" src="{{ _fg.featured_image | image_url: width: 280 }}" alt="{{ _fg.title | escape }}" loading="lazy" width="120" height="120">
                        {%- if block.settings.badge_icon != blank -%}
                          <img class="xy-fg__badge" src="{{ block.settings.badge_icon | image_url: width: 160 }}" alt="" loading="lazy">
                        {%- else -%}
                          <span class="xy-fg__badge xy-fg__badge--default" aria-hidden="true">Free</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    <div class="xy-fg__info">
                      <p class="xy-fg__title">{{ block.settings.product_title_override | default: _fg.title | escape }}</p>
                      {%- if _fg_colors_str != '' -%}
                        <p class="xy-fg__color">{{ _fg_colors_str }}</p>
                      {%- endif -%}
                    </div>

                    <div class="xy-fg__price">
                      {%- if _fgv.price > 0 -%}
                        <s class="xy-fg__compare">{{ _fgv.price | money }}</s>
                      {%- endif -%}
                      <span class="xy-fg__free">{{ block.settings.free_text_override | default: '$0.00' }}</span>
                    </div>
                  </div>
                </div>
                <style>
                  #{{ _fg_id }}.xy-fg{
                    margin: var(--xy-fg-margin-y, 23px) 0;
                    overflow: visible;
                  }
                  #{{ _fg_id }} .xy-fg__top{
                    display: flex;
                    align-items: baseline;
                    justify-content: space-between;
                    gap: 12px;
                    margin: 0 0 var(--xy-fg-top-gap, 14px) 0;
                    padding: 0 4px;
                    overflow: visible;
                    position: relative;
                    z-index: 3;
                  }
                  #{{ _fg_id }} .xy-fg__heading{
                    display: inline-flex;
                    align-items: center;
                    color: var(--xy-fg-heading-color, #10374B);
                    font-size: var(--xy-fg-heading-size, 16px);
                    font-weight: var(--xy-fg-heading-weight, 700);
                    line-height: 1.2;
                  }
                  #{{ _fg_id }} .xy-fg__sub{
                    color: var(--xy-fg-sub-color, #7B8A93);
                    font-size: var(--xy-fg-sub-size, 13px);
                    font-weight: var(--xy-fg-sub-weight, 400);
                    line-height: 1.2;
                  }
                  #{{ _fg_id }} .xy-fg__body{
                    display: flex;
                    align-items: center;
                    gap: var(--xy-fg-gap, 14px);
                    background: var(--xy-fg-bg, #D1F2F6);
                    border-radius: var(--xy-fg-radius, 29px);
                    padding: var(--xy-fg-pad-y, 14px) var(--xy-fg-pad-x, 25px);
                  }
                  #{{ _fg_id }} .xy-fg__media{
                    position: relative;
                    flex: 0 0 var(--xy-fg-img-size, 72px);
                    width: var(--xy-fg-img-size, 72px);
                    height: var(--xy-fg-img-size, 72px);
                  }
                  #{{ _fg_id }} .xy-fg__img{
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                    display: block;
                    border-radius: var(--xy-fg-img-radius, 40px);
                    margin: 0;
                  }
                  #{{ _fg_id }} .xy-fg__badge{
                    position: absolute;
                    top: var(--xy-fg-badge-y, 0px);
                    left: var(--xy-fg-badge-x, -10px);
                    width: var(--xy-fg-badge-size, 34px);
                    height: var(--xy-fg-badge-size, 34px);
                    object-fit: contain;
                    z-index: 2;
                    pointer-events: none;
                    margin: 0;
                  }
                  #{{ _fg_id }} .xy-fg__badge--default{
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    box-sizing: border-box;
                    object-fit: unset;
                    background: linear-gradient(165deg, #93d8f5 0%, #4ebfe8 45%, #2aa9dd 100%);
                    color: #fff;
                    font-weight: 800;
                    font-size: clamp(9px, calc(var(--xy-fg-badge-size, 34px) * 0.34), 15px);
                    letter-spacing: 0.03em;
                    border-radius: 5px;
                    line-height: 1;
                    text-transform: uppercase;
                    box-shadow: 0 1px 3px rgba(16, 55, 75, 0.2);
                  }
                  #{{ _fg_id }} .xy-fg__info{
                    flex: 1 1 auto;
                    min-width: 0;
                  }
                  #{{ _fg_id }} .xy-fg__title{
                    color: var(--xy-fg-title-color, #10374B);
                    font-size: var(--xy-fg-title-size, 14px);
                    font-weight: var(--xy-fg-title-weight, 700);
                    line-height: 1.25;
                    margin: 0 0 4px 0;
                  }
                  #{{ _fg_id }} .xy-fg__color{
                    color: var(--xy-fg-color-color, #7B8A93);
                    font-size: var(--xy-fg-color-size, 13px);
                    font-weight: var(--xy-fg-color-weight, 500);
                    margin: 0;
                  }
                  #{{ _fg_id }} .xy-fg__price{
                    flex: 0 0 auto;
                    display: flex;
                    flex-direction: column;
                    align-items: flex-end;
                    gap: 4px;
                    text-align: right;
                    white-space: nowrap;
                  }
                  #{{ _fg_id }} .xy-fg__compare{
                    color: var(--xy-fg-cmp-color, #10374B);
                    font-size: var(--xy-fg-cmp-size, 14px);
                    text-decoration: line-through;
                    line-height: 1.2;
                  }
                  #{{ _fg_id }} .xy-fg__free{
                    color: var(--xy-fg-free-color, #10374B);
                    font-size: var(--xy-fg-free-size, 16px);
                    font-weight: var(--xy-fg-free-weight, 700);
                    line-height: 1.2;
                  }
                  @media (max-width: 640px){
                    #{{ _fg_id }} .xy-fg__top{ flex-direction: column; align-items: flex-start; gap: 4px; }
                    #{{ _fg_id }} .xy-fg__body{ gap: 10px; }
                  }
                </style>
              {%- endif -%}

            {%- when 'collapsible_tab' -%}
              <details class="product__accordion details {{ block.settings.style }} mb-2 bg-zinc-100" is="accordion-details"{% if block.settings.opened %} open{% endif %} {{ block.shopify_attributes }}>
                <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                  <div class="flex items-center gap-2d5">
                    {%- render 'icon-accordion', icon: block.settings.icon -%}
                    <span class="text-sm-base font-medium leading-none">{{ block.settings.heading | default: block.settings.page.title | escape }}</span>
                  </div>
                  {%- render 'icon', icon: 'plus-2', size: 'xs', class: 'shrink-0' -%}
                </summary>
                <div class="details__content rte text-opacity {{ block.settings.text_size }}">
                  {{ block.settings.content }}
                  {{ block.settings.page.content }}
                  {{ block.settings.liquid }}
                </div>
              </details>

            {%- when 'countdown' -%}
              {%- if product.metafields.theme.countdown.value != blank -%}
                {%- liquid
                  assign now_time = 'now' | date: '%s' | times: 1
                  assign countdown_time = product.metafields.theme.countdown.value | date: '%s' | times: 1
                -%}
                {%- if countdown_time > now_time -%}
                  <div class="product-countdown grid sm:flex items-center justify-between gap-2d5" id="shopify-block-{{ block.id }}" {{ block.shopify_attributes }}>
                    <div class="flex items-center gap-3">
                      {%- render 'icon', icon: 'countdown', size: 'xl', class: 'shrink-0 block lg:hidden xl:block' -%}
                      <div class="grid">
                        {%- if block.settings.heading != blank -%}
                          <p class="heading text-base lg:text-lg xl:text-xl leading-tight">{{ block.settings.heading | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="uppercase text-3xs font-medium leading-none tracking-widest">{{ block.settings.subheading | escape }}</p>
                        {%- endif -%}
                      </div>
                    </div>
                    <countdown-timer
                      class="countdown__timer flex text-center"
                      data-expires="{{ product.metafields.theme.countdown.value | date: '%FT%T%:z' | escape }}"
                    >
                      <div class="countdown__item">
                        <p>--</p><span>{{ 'general.date.days' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p><span>{{ 'general.date.hours' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p><span>{{ 'general.date.minutes' | t }}</span>
                      </div>
                      <div class="countdown__item">
                        <p>--</p><span>{{ 'general.date.seconds' | t }}</span>
                      </div>
                    </countdown-timer>
                    <style>
                      #shopify-block-{{ block.id }} {
                        {%- render 'section-variables', section: block -%}
                      }
                    </style>
                  </div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'back_in_stock' -%}
              <div id="BackInStock-{{ section.id }}-{{ product.id }}" class="back-in-stock" {{ block.shopify_attributes }}>
                {%- liquid
                  assign check_against_inventory = true
                  if product.selected_or_first_available_variant.inventory_management != 'shopify' or  product.selected_or_first_available_variant.inventory_policy == 'continue'
                    assign check_against_inventory = false
                  endif
                  if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                    assign quantity_rule_soldout = true
                  endif

                  if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
                    render 'back-in-stock', product: product, product_id: product.id, section_id: section.id, heading: block.settings.heading, description: block.settings.description, compact: true
                  endif
                -%}
              </div>

            {%- when 'product_bundle' -%}
              {%- liquid
                assign products = block.settings.products
                
                if block.settings.metafield != blank
                  assign metafield_parts = block.settings.metafield | split: '.'
                  assign metafield_namespace = metafield_parts | first
                  assign metafield_key = metafield_parts | last
                  
                  assign metafield = product.metafields[metafield_namespace][metafield_key]
                  if metafield.value != blank and metafield.list?
                    assign products = metafield.value
                  endif

                  assign metafield = product.selected_or_first_available_variant.metafields[metafield_namespace][metafield_key]
                  if metafield.value != blank and metafield.list?
                    assign products = metafield.value
                  endif
                endif
              -%}
              <div id="ProductBundle-{{ section.id }}-{{ product.id }}" {{ block.shopify_attributes }}>
              {%- if products.count > 0 -%}
                <details class="product__accordion details bg-zinc-100" is="product-bundle-details"{% if product.selected_or_first_available_variant.available and block.settings.opened %} open{% endif %} form="{{ product_form_id }}">
                  <summary class="details__summary flex items-center justify-between gap-2 cursor-pointer">
                    <div class="flex items-center gap-2d5">
                      {%- if block.settings.icon_image != blank -%}
                        {%- liquid
                          if block.settings.iwidth == 'fit'
                            assign icon_width = block.settings.icon_image.width
                          else
                            assign icon_width = block.settings.icon_width
                          endif
                          assign image_alt = block.settings.icon_image.alt | default: block.settings.accessibility_info | escape
                          assign image_alt = image_alt | default: block.settings.heading | escape
                          assign max_width = block.settings.icon_image.width
                        -%}
                        <figure class="media media--transparent relative inline-block">
                          {%- capture sizes -%}{{ icon_width }}px{%- endcapture -%}
                          {%- capture widths -%}{{ icon_width | times: 1.5 | at_most: max_width | round }}, {{ icon_width | times: 2 | at_most: max_width }}, {{ icon_width | times: 3 | at_most: max_width }}{%- endcapture -%}
                          {{- block.settings.icon_image | image_url: width: max_width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, alt: image_alt, class: 'image-fit' -}}
                        </figure>
                      {%- elsif block.settings.icon != 'none' -%}
                        {%- liquid
                          if block.settings.iwidth == 'fit'
                            render 'icon-guarantee', icon: block.settings.icon, size: 'lg', class: 'inline-block stroke-1'
                          else
                            render 'icon-guarantee', icon: block.settings.icon, size: 'custom', class: 'inline-block stroke-1', width: block.settings.icon_width
                          endif
                        -%}
                      {%- endif -%}
                      <span class="text-sm-base font-medium leading-none">{{ block.settings.heading | escape }}</span>
                    </div>
                    {%- render 'icon', icon: 'plus-2', size: 'xs', class: 'shrink-0' -%}
                  </summary>

                  <div class="details__content grid gap-2">
                    {%- for bundle_product in products -%}
                      {%- liquid
                        assign variant = bundle_product.first_available_variant | default: bundle_product
                        assign show_variant_title = true

                        if variant.product.has_only_default_variant
                          assign show_variant_title = false
                        endif

                        if bundle_product.first_available_variant == nil
                          assign show_variant_title = false
                        endif
                      -%}

                      {%- if variant.product -%}
                        {%- liquid
                          assign variant_image = variant.image | default: variant.product.featured_image
                          comment
                            折扣优先级：compare_at_price > discount_amount（固定金额）> product_discounts（百分比）
                          endcomment
                          assign discount_amount = variant.product.metafields.custom.discount_amount | default: 0 | plus: 0
                          assign percent = variant.product.metafields.custom.product_discounts | default: 0 | plus: 0
                          assign base_price = variant.price
                          assign variant_compare = variant.compare_at_price | default: 0

                          if variant_compare > base_price
                            assign discount = variant_compare | minus: base_price
                            assign final_price = base_price
                          elsif discount_amount > 0
                            assign discount = discount_amount | times: 100
                            assign final_price = base_price | minus: discount
                          elsif percent > 0
                            assign discount = base_price | times: percent | divided_by: 100
                            assign final_price = base_price | minus: discount
                          else
                            assign discount = 0
                            assign final_price = base_price
                          endif
                        -%}

                        <label
                          class="product-bundle__info{% if variant_image %} with-image{% endif %} flex items-center gap-4 md:gap-6 relative"
                          for="Recommendations-{{ section.id }}-{{ variant.id }}"
                          {% if block.settings.variant_selection %} is="product-bundle-picker"{% endif %}
                        >
                          <input
                            name="bundles"
                            value="{{ variant.id }}"
                            data-price="{{ final_price }}"
                            class="checkbox"
                            id="Recommendations-{{ section.id }}-{{ variant.id }}"
                            type="checkbox"
                            {% unless variant.available %} disabled{% endunless %}
                          />

                          {%- if variant_image -%}
                            <picture class="horizontal-product__media media media--{{ settings.product_image_ratio }}{% unless settings.product_image_fill %} media--contain{% endunless %} relative overflow-hidden shrink-0 pointer-events-none">
                              {%- assign max_width = variant_image.width -%}
                              {%- capture sizes -%}64px{%- endcapture -%}
                              {%- capture widths -%}{{ 64 | times: 1.5 | at_most: max_width | round }}, {{ 64 | times: 2 | at_most: max_width }}, {{ 64 | times: 3 | at_most: max_width }}{%- endcapture -%}
                              {{- variant_image | image_url: width: variant_image.width | image_tag: loading: 'lazy', widths: widths, sizes: sizes, is: 'lazy-image', class: 'bundle-variant-image' -}}
                            </picture>
                          {%- endif -%}

                          <div class="horizontal-product__details grow flex flex-col justify-start gap-1d5">
                            <div class="flex flex-col gap-1">
                              <p class="horizontal-product__title font-medium text-base leading-tight">
                                {%- liquid
                                  if block.settings.clickable
                                    echo variant.product.title | link_to: variant.url, class: 'reversed-link'
                                  else
                                    echo variant.product.title | escape
                                  endif
                                -%}
                              </p>

                              {%- if show_variant_title -%}
                                {%- if block.settings.variant_selection -%}
                                  <div>
                                    <div class="field inline-block">
                                      <select class="select bundle-variant-select" id="Variants-{{ section.id }}-{{ block.id }}-{{ bundle_product.id }}">
                                        {%- for product_variant in variant.product.variants -%}
                                          {%- liquid
                                            assign product_variant_image = product_variant.image | default: product_variant.product.featured_image
                                            comment
                                              折扣优先级：compare_at_price > discount_amount（固定金额）> product_discounts（百分比）
                                            endcomment
                                            assign variant_discount_amount = product_variant.product.metafields.custom.discount_amount | default: 0 | plus: 0
                                            assign variant_percent = product_variant.product.metafields.custom.product_discounts | default: 0 | plus: 0
                                            assign variant_base_price = product_variant.price
                                            assign variant_compare_at = product_variant.compare_at_price | default: 0

                                            if variant_compare_at > variant_base_price
                                              assign variant_discount = variant_compare_at | minus: variant_base_price
                                              assign variant_final_price = variant_base_price
                                            elsif variant_discount_amount > 0
                                              assign variant_discount = variant_discount_amount | times: 100
                                              assign variant_final_price = variant_base_price | minus: variant_discount
                                            elsif variant_percent > 0
                                              assign variant_discount = variant_base_price | times: variant_percent | divided_by: 100
                                              assign variant_final_price = variant_base_price | minus: variant_discount
                                            else
                                              assign variant_discount = 0
                                              assign variant_final_price = variant_base_price
                                            endif
                                          -%}

                                          <option
                                            {% if product_variant == variant %}selected{% endif %}
                                            {% if product_variant.available == false %}disabled{% endif %}
                                            value="{{ product_variant.id }}"
                                            data-price="{{ variant_final_price }}"
                                            data-base-price="{{ variant_base_price }}"
                                            data-final-price="{{ variant_final_price }}"
                                            data-base-price-formatted="{{ variant_base_price | money }}"
                                            data-final-price-formatted="{{ variant_final_price | money }}"
                                            data-discount-percent="{{ variant_percent }}"
                                            data-img-src="{{ product_variant_image | image_url }}"
                                            data-img-srcset="{{ product_variant_image | image_url: width: '180x' }} 180w, {{ product_variant_image | image_url: width: '360x' }} 360w, {{ product_variant_image | image_url: width: '540x' }} 540w"
                                          >
                                            {{ product_variant.title }}
                                            {%- if product_variant.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}
                                          </option>
                                        {%- endfor -%}
                                      </select>
                                      {%- render 'icon', icon: 'chevron-up', size: 'xs', class: 'absolute pointer-events-none' -%}
                                    </div>
                                  </div>
                                {%- else -%}
                                  <span class="text-xs text-opacity leading-tight">{{ variant.title }}</span>
                                {%- endif -%}
                              {%- endif -%}
                            </div>
                          </div>

                          <div class="horizontal-product__quantity shrink-0">
                            {%- if variant.available -%}
                              <div class="flex flex-wrap items-baseline gap-2 lg:flex-col xl:items-end lg:gap-1d5 bundle-price-wrap">
                                {%- if discount > 0 -%}
                                  <span class="price__regular whitespace-nowrap bundle-final-price">
                                    {{- final_price | money -}}
                                  </span>
                                  <span class="price__sale inline-flex items-center h-auto relative text-opacity bundle-base-price">
                                    <s>{{- base_price | money -}}</s>
                                  </span>
                                {%- else -%}
                                  <span class="price__regular whitespace-nowrap bundle-final-price">
                                    {{- base_price | money -}}
                                  </span>
                                  <span class="price__sale inline-flex items-center h-auto relative text-opacity bundle-base-price hidden">
                                    <s></s>
                                  </span>
                                {%- endif -%}
                              </div>
                            {%- else -%}
                              <span class="text-sm-base text-opacity">{{ 'products.product.sold_out' | t }}</span>
                            {%- endif -%}
                          </div>
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </details>
              {%- endif -%}
            </div>

            {%- when 'icon_list' -%}
              {{- icon_list_render -}}

            {%- when 'line_item_property' -%}
              {%- assign custom_name = block.settings.title | escape -%}
              <div class="field" {{ block.shopify_attributes }}>
                {%- if block.settings.type == 'checkbox' -%}
                  <label for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}" class="flex items-center gap-3">
                    <input
                      type="hidden"
                      name="properties[{{ custom_name }}]"
                      form="{{ product_form_id }}"
                      value="{{ block.settings.unchecked_value | escape }}"
                    />
                    <input
                      type="checkbox"
                      id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                      name="properties[{{ custom_name }}]"
                      form="{{ product_form_id }}"
                      value="{{ block.settings.checked_value | escape }}"
                      {%- if block.settings.required %} required{% endif -%}
                    />
                    {{- block.settings.title | escape -}}
                  </label>

                  {%- elsif block.settings.type == 'radio' -%}
                  <div class="grid gap-4">
                    <p>{{ block.settings.title | escape }}</p>
                    {%- assign options = block.settings.radio_options | split: ',' -%}
                    {%- if options.size > 0 -%}
                      <ul class="grid gap-2 leading-none" role="list">
                        {%- for option in options -%}
                          {%- assign option_2 = option | strip | escape -%}
                          <li>
                            <label for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}-{{ forloop.index0 }}" class="inline-flex items-center gap-3">
                              <input
                                type="radio"
                                id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}-{{ forloop.index0 }}"
                                name="properties[{{ custom_name }}]"
                                form="{{ product_form_id }}"
                                value="{{ option_2 }}"
                                {%- if block.settings.required %} required{% endif -%}
                              />
                              {{- option_2 -}}
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
  
                {%- else -%}
                  {%- case block.settings.type -%}
                    {%- when 'text' -%}
                      <input
                        class="input is-floating"
                        type="text"
                        id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                        name="properties[{{ custom_name }}]"
                        form="{{ product_form_id }}"
                        placeholder="{{ block.settings.title | escape }}"
                        {%- if block.settings.required %} required{% endif -%}
                      />
                      <label class="label is-floating" for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}">{{ block.settings.title | escape }}</label>
  
                    {%- when 'textarea' -%}
                      <textarea
                        class="textarea is-floating"
                        rows="5"
                        id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                        name="properties[{{ custom_name }}]"
                        form="{{ product_form_id }}"
                        placeholder=" "
                        {%- if block.settings.required %} required{% endif -%}
                      ></textarea>
                      <label class="label is-floating" for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}">{{ block.settings.title | escape }}</label>
  
                    {%- when 'select' -%}
                      {%- assign options = block.settings.select_options | split: ',' -%}
                      {%- if options.size > 0 -%}
                        <select
                          class="select is-floating"
                          id="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}"
                          name="properties[{{ custom_name }}]"
                          form="{{ product_form_id }}"
                          {%- if block.settings.required %} required{% else %} is="custom-select"{% endif -%}
                        >
                          <option value="" disabled selected></option>
                          {%- for option in options -%}
                            {%- assign option_2 = option | strip | escape -%}
                            <option value="{{ option_2 }}">{{ option_2 }}</option>
                          {%- endfor -%}
                        </select>
                        {%- render 'icon', icon: 'chevron-up', size: 'sm', class: 'absolute pointer-events-none' -%}
                      {%- endif -%}
                      <label class="label{% if options.size > 0 %} is-floating{% endif %}" for="LineItemInput-{{ section.id }}-{{ product.id }}-{{ block.id }}">{{ block.settings.title | escape }}</label>
                  {%- endcase -%}
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </product-info>
      {%- if _xy_has_addon -%}
        <script>
          (function(){
            function run(){
              if (typeof window.__xyBuildAddonCarousels === 'function') window.__xyBuildAddonCarousels();
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
            else run();
            setTimeout(run, 0);
            setTimeout(run, 180);
          })();
        </script>
      {%- endif -%}
    </div>

    {%- assign sticky_buy_button = section.blocks | where: "type", "sticky_buy_button" | first -%}
    {%- if product.available and sticky_buy_button -%}
      <product-sticky-form
        class="product-sticky-form w-full fixed z-20 bottom-0 right-0 pointer-events-none"
        id="ProductStickyForm-{{ section.id }}-{{ product.id }}"
        form="{{ product_form_id }}"
      >
        <div class="product-sticky-form__card grid gap-4 opacity-0 invisible pointer-events-auto">
          {%- assign featured_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
          <div class="product-sticky-form__variant{% if featured_media == blank %} no-image{% endif %} grid items-center gap-4">
            {%- if featured_media != blank -%}
              {%- assign max_width = featured_media.width -%}
              {%- capture sizes -%}80px{%- endcapture -%}
              {%- capture widths -%}{{ 80 | times: 1.5 | at_most: max_width | round }}, {{ 80 | times: 2 | at_most: max_width }}, {{ 80 | times: 3 | at_most: max_width }}{%- endcapture -%}
              <div class="hidden md:block media media--adapt relative overflow-hidden" data-widths="{{ widths }}" data-sticky-product-media>
                {{- featured_media | image_url: width: max_width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, is: 'lazy-image' -}}
              </div>
            {%- endif -%}

            <div class="hidden md:block grid gap-2">
              <div class="grid gap-1">
                <p class="text-base font-medium leading-tight">{{ product.title }}</p>
                {%- unless product.has_only_default_variant -%}
                  <div class="text-xs text-opacity leading-tight" data-sticky-product-options>
                    {{- product.selected_or_first_available_variant.title -}}
                  </div>
                {%- endunless -%}
              </div>


              {%- comment -%}
              <div id="StickyPrice-{{ section.id }}-{{ product.id }}">
                {%- if product.quantity_price_breaks_configured? != true -%}
                  {%- render 'product-price', product: product, use_variant: true, class: 'flex flex-wrap items-center gap-2 lg:gap-1d5' -%}
                {%- else -%}
                  {%- liquid
                    assign assign cart_qty = cart | item_count_for_variant: product.selected_or_first_available_variant.id
                    assign volume_pricing_array = product.selected_or_first_available_variant.quantity_price_breaks | sort: 'quantity' | reverse
                    assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.min
                    if cart_qty > 0
                      assign current_qty_for_volume_pricing = cart_qty | plus: product.selected_or_first_available_variant.quantity_rule.increment
                    endif
                    assign variant_price_compare = product.selected_or_first_available_variant.compare_at_price
                  -%}
                  <price-per-item
                    id="PricePerItem-{{ section.id }}-{{ product.id }}-2nd"
                    class="price flex flex-wrap items-center gap-2 lg:gap-1d5"
                    data-section-id="{{ section.id }}"
                    data-product-id="{{ product.id }}"
                    data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                  >
                    {%- if variant_price_compare -%}
                      <span class="sr-only">{{ 'products.price.regular_price' | t }}</span>
                      <span class="price__sale inline-flex items-center h-auto relative">
                        {%- liquid
                          if settings.currency_code_enabled
                            echo variant_price_compare | money_with_currency
                          else
                            echo variant_price_compare | money
                          endif
                        -%}
                      </span>
                      <span class="sr-only">{{ 'products.price.sale_price' | t }}</span>
                    {%- endif -%}
                    
                    {%- if product.selected_or_first_available_variant.quantity_price_breaks.size > 0 -%}
                      {%- if current_qty_for_volume_pricing < volume_pricing_array.last.minimum_quantity -%}
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        <span class="price-per-item--current price__regular whitespace-nowrap">
                          {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                        </span>
                      {%- else -%}
                        {%- for price_break in volume_pricing_array -%}
                          {%- if current_qty_for_volume_pricing >= price_break.minimum_quantity -%}
                            {%- liquid
                              if settings.currency_code_enabled
                                assign price_break_price = price_break.price | money_with_currency
                              else
                                assign price_break_price = price_break.price | money
                              endif
                            -%}
                            <span class="price-per-item--current price__regular whitespace-nowrap">
                              {{- 'products.volume_pricing.price_at_each' | t: price: price_break_price -}}
                            </span>
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                    {%- else -%}
                      <span class="price-per-item--current price__regular whitespace-nowrap">
                        {%- liquid
                          if settings.currency_code_enabled
                            assign variant_price = product.selected_or_first_available_variant.price | money_with_currency
                          else
                            assign variant_price = product.selected_or_first_available_variant.price | money
                          endif
                        -%}
                        {{- 'products.volume_pricing.price_at_each' | t: price: variant_price -}}
                      </span>
                    {%- endif -%}
                  </price-per-item>
                {%- endif -%}
              </div>
              {%- endcomment -%}
            </div>

            {%- liquid
              assign check_against_inventory = true
              if product.selected_or_first_available_variant.inventory_management != 'shopify' or  product.selected_or_first_available_variant.inventory_policy == 'continue'
                assign check_against_inventory = false
              endif
              if product.selected_or_first_available_variant.quantity_rule.min > product.selected_or_first_available_variant.inventory_quantity and check_against_inventory
                assign quantity_rule_soldout = true
              endif

              if product.selected_or_first_available_variant.available == false or quantity_rule_soldout
                assign add_to_cart_label = 'products.product.sold_out' | t
                assign add_to_cart_aria = 'products.product.sold_out' | t
              elsif product.template_suffix != 'pre-order'
                assign add_to_cart_label = 'products.product.add_to_cart' | t
                assign add_to_cart_aria = 'products.product.add_to_cart_label' | t: title: product.title
              else
                assign add_to_cart_label = 'products.product.pre_order' | t
                assign add_to_cart_aria = 'products.product.pre_order_label' | t: title: product.title
              endif
            -%}
            <button
              type="submit"
              name="add"
              form="{{ product_form_id }}"
              class="button button--primary"
              is="hover-button"
              aria-label="{{ add_to_cart_aria | escape }}"
              {%- if product.selected_or_first_available_variant.available == false or quantity_rule_soldout %} disabled{% endif -%}
              {%- if product.template_suffix == 'pre-order' %} data-pre-order{% endif -%}
            >
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">
                {%- render 'icon', icon: 'cart', size: 'sm', class: 'hidden' -%}
                <span class="block" data-sold-out="{{ 'products.product.sold_out' | t | escape }}">
                  {{- add_to_cart_label -}}
                </span>



                <div id="StickyPrice-{{ section.id }}-{{ product.id }}" class="flex Product__StickyPrice__PriceText">
         
                  <span class="relative">&nbsp;&nbsp;-&nbsp;&nbsp;</span>
                 
                    {% render 'xy-components-price', product: product, position: 'sticky-button', enable_clearance_override: section.settings.enable_ivory_clearance_50, section: section %}
                </div>
              </span>

              





            </button>
          </div>

           <style>
               @media screen and (max-width: 767px) {
                   .product-sticky-form .button {
                       width: 100%;
                       height: 40px !important;
                       padding: clamp(var(--sp-4d5), 1.2vw, var(--sp-5d5)) clamp(var(--sp-6d5), 1.473vw, var(--sp-7d5));
                   }
               }

               .product-sticky-form__card .price__regular,
               .Product__StickyPrice__PriceText .price__regular,
               .Product__StickyPrice__PriceText .price__sale
               {
               color: #fff!important
               }

            @media screen and (pointer: fine) {
                 .js [data-button-hover="standard"] .button--primary:hover .Product__StickyPrice__PriceText .price__regular:not([disabled], .self-button),
                 .js [data-button-hover="standard"] .button--primary:hover .Product__StickyPrice__PriceText .price__sale:not([disabled], .self-button) {
                     color: rgb(var(--color-button-background)) !important;
                 }
             }
               .product-sticky-form__card .button .btn-text {
                   font-weight: 700 !important;
               }
          </style>
          <div class="product-form__error-message alert alert--error text-sm font-medium leading-tight" role="alert" hidden></div>
        </div>
      </product-sticky-form>
    {%- endif -%}
  </div>

  {%- if first_3d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
  {%- endif -%}
  
  <script type="application/ld+json">
    {{- product | structured_data -}}
  </script>
</div>

{%- comment -%} xy-tip：产品介绍旁感叹号图标 + 气泡 tooltip（PC + 移动端通用） {%- endcomment -%}
<style>
  .xy-tip{position:relative;display:inline-flex;align-items:center;line-height:0;vertical-align:middle;margin-left:4px;}
  .xy-tip__btn{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;padding:0;border:0;background:transparent;color:#10374B;cursor:pointer;border-radius:50%;line-height:0;-webkit-tap-highlight-color:transparent;}
  .xy-tip__btn:focus{outline:none;}
  .xy-tip__btn:focus-visible{outline:2px solid rgba(16,55,75,.35);outline-offset:2px;}
  .xy-tip__btn svg{display:block;}
  .xy-tip__bubble{position:absolute;top:calc(100% + 14px);left:50%;transform:translateX(-50%);z-index:60;width:max-content;max-width:360px;padding:12px 28px 12px 14px;background:#fff;color:#10374B;border:1px solid #10374B;border-radius:8px;box-shadow:0 6px 18px rgba(16,55,75,.12);font-size:13px;font-weight:400;line-height:1.5;white-space:normal;text-align:left;box-sizing:border-box;}
  .xy-tip__bubble[hidden]{display:none;}
  .xy-tip__bubble::before,.xy-tip__bubble::after{
    content:"";
    position:absolute;
    left:var(--xy-tip-arrow-left, 50%);
    width:0;
    height:0;
    pointer-events:none;
    border-left:8px solid transparent;
    border-right:8px solid transparent;
    transform:translate(-50%, -100%);
  }
  .xy-tip__bubble::before{
    top:-1px;
    border-bottom:8px solid #10374B;
  }
  .xy-tip__bubble::after{
    top:0;
    border-bottom:8px solid #fff;
  }
  .xy-tip__bubble.is-above::before{
    top:auto;
    bottom:-1px;
    border-bottom:0;
    border-top:8px solid #10374B;
    transform:translate(-50%, 100%);
  }
  .xy-tip__bubble.is-above::after{
    top:auto;
    bottom:0;
    border-bottom:0;
    border-top:8px solid #fff;
    transform:translate(-50%, 100%);
  }
  .xy-tip__bubble.is-above{
    top:auto;
    bottom:calc(100% + 14px);
  }
  .xy-tip__close{position:absolute;top:6px;right:6px;width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;padding:0;border:0;background:transparent;color:#10374B;cursor:pointer;border-radius:50%;line-height:0;}
  .xy-tip__close:hover{background:rgba(16,55,75,.08);}
  .xy-tip__text{display:block;font-weight:400;}
  @media screen and (max-width:767px){
    .xy-tip__bubble{max-width:calc(100vw - 32px);font-size:12px;padding:10px 26px 10px 12px;}
  }

  .product-price-info-bar{
    display:inline-flex;
    align-items:center;
    gap:var(--pib-gap, 8px);
    width:max-content;
    max-width:100%;
    justify-self:start;
    box-sizing:border-box;
    margin-top:var(--pib-mt, 0px);
    padding:var(--pib-pad-y, 8px) var(--pib-pad-x, 12px);
    background:var(--pib-bg, #E1F6F9);
    border:var(--pib-border-w, 1px) solid var(--pib-border, transparent);
    border-radius:var(--pib-radius, 18px);
    color:var(--pib-color, #10374B);
  }
  .product-price-info-bar__icon{
    display:inline-flex;
    flex-shrink:0;
    align-items:center;
    justify-content:center;
    width:var(--pib-icon-size, 20px);
    height:var(--pib-icon-size, 20px);
    color:inherit;
  }
  .product-price-info-bar__icon svg,
  .product-price-info-bar__icon img,
  .product-price-info-bar__img{
    display:block;
    width:100%;
    height:100%;
    object-fit:contain;
  }
  .product-price-info-bar__text{
    min-width:0;
    font-family:Inter, var(--font-body-family), sans-serif;
    font-weight:var(--pib-weight, 300);
    font-style:normal;
    font-size:var(--pib-size, 13px);
    line-height:1;
    letter-spacing:0;
    color:inherit;
    white-space:nowrap;
  }
</style>
<script>
  (function(){
    if(window.__xyTipInit) return;
    window.__xyTipInit = true;
    var EDGE_PAD = 16;

    function resetBubblePosition(bubble){
      if(!bubble) return;
      bubble.style.left = '';
      bubble.style.right = '';
      bubble.style.top = '';
      bubble.style.bottom = '';
      bubble.style.width = '';
      bubble.style.maxWidth = '';
      bubble.style.transform = '';
      bubble.style.removeProperty('--xy-tip-arrow-left');
      bubble.classList.remove('is-above');
    }

    function layoutBubble(bubble){
      if(!bubble || bubble.hasAttribute('hidden')) return;
      resetBubblePosition(bubble);

      var wrap = bubble.closest('[data-xy-tip]');
      if(!wrap) return;

      var vw = Math.min(
        window.innerWidth || document.documentElement.clientWidth,
        document.documentElement.clientWidth || window.innerWidth
      );
      var vh = window.innerHeight || document.documentElement.clientHeight;
      var pad = EDGE_PAD;
      var wrapRect = wrap.getBoundingClientRect();
      var bubbleRect = bubble.getBoundingClientRect();
      var iconX = wrapRect.left + wrapRect.width / 2;

      var shift = 0;
      if(bubbleRect.left < pad) shift += pad - bubbleRect.left;
      if(bubbleRect.right + shift > vw - pad) shift -= bubbleRect.right + shift - (vw - pad);
      if(shift){
        bubble.style.transform = 'translateX(calc(-50% + ' + shift + 'px))';
      }

      var arrowLeft = iconX - (bubbleRect.left + shift);
      var bubbleW = bubbleRect.width || 1;
      arrowLeft = Math.max(12, Math.min(arrowLeft, bubbleW - 12));
      bubble.style.setProperty('--xy-tip-arrow-left', arrowLeft + 'px');

      var spaceBelow = vh - wrapRect.bottom - 14;
      var spaceAbove = wrapRect.top - 14;
      if(spaceBelow < bubbleRect.height && spaceAbove > spaceBelow){
        bubble.classList.add('is-above');
      }
    }

    function hideBubble(bubble){
      if(!bubble) return;
      bubble.setAttribute('hidden','');
      resetBubblePosition(bubble);
      var wrap = bubble.closest('[data-xy-tip]');
      var btn = wrap && wrap.querySelector('.xy-tip__btn');
      if(btn) btn.setAttribute('aria-expanded','false');
    }

    function closeAll(except){
      document.querySelectorAll('.xy-tip__bubble').forEach(function(b){
        if(b===except) return;
        if(!b.hasAttribute('hidden')) hideBubble(b);
      });
    }

    document.addEventListener('click', function(e){
      var btn = e.target.closest('.xy-tip__btn');
      if(btn){
        e.preventDefault();
        e.stopPropagation();
        var wrap = btn.closest('[data-xy-tip]');
        if(!wrap) return;
        var bubble = wrap.querySelector('.xy-tip__bubble');
        if(!bubble) return;
        var willOpen = bubble.hasAttribute('hidden');
        closeAll(willOpen ? bubble : null);
        if(willOpen){
          bubble.removeAttribute('hidden');
          btn.setAttribute('aria-expanded','true');
          layoutBubble(bubble);
        } else {
          hideBubble(bubble);
        }
        return;
      }
      if(e.target.closest('.xy-tip__close')){
        e.preventDefault();
        e.stopPropagation();
        hideBubble(e.target.closest('.xy-tip__bubble'));
        return;
      }
      if(!e.target.closest('.xy-tip__bubble')){
        closeAll(null);
      }
    }, true);

    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape'){ closeAll(null); }
    });

    window.addEventListener('resize', function(){
      document.querySelectorAll('.xy-tip__bubble:not([hidden])').forEach(layoutBubble);
    });
  })();
</script>

{%- comment -%}
  Yotpo 评论 - Custom Questions 属性表 DOM 重构脚本
  ---------------------------------------------------
  Yotpo 默认结构里 title×N 和 value×N 都是 wrapper 的直接子元素，
  只靠 grid-row-start 内联样式建立成对关系；grid 里同列强制等宽，
  无法让"每一行 pill"独立宽度。所以脚本把每对 title/value 用 JS 移动到
  新的 .yotpo-custom-question-row 容器里，让 CSS 能把它显示成
  独立宽度的 pill。不修改 innerHTML，仅移动节点，尽量避免影响 Yotpo。
{%- endcomment -%}

<script>
  (function () {
    function pairKey(el) {
      var v = (el.style && el.style.gridRowStart) || '';
      return String(v).trim();
    }

    function wrapWrapper(wrapper) {
      if (!wrapper || wrapper.dataset.pairsWrapped === '1') return;
      var titles = wrapper.querySelectorAll(':scope > .yotpo-custom-questions-title');
      var values = wrapper.querySelectorAll(':scope > .yotpo-custom-questions-value');
      if (titles.length === 0 || values.length === 0) return;

      var pairs = {};
      var order = [];
      titles.forEach(function (t) {
        var k = pairKey(t) || String(order.length + 1);
        if (!(k in pairs)) { pairs[k] = {}; order.push(k); }
        pairs[k].title = t;
      });
      values.forEach(function (v) {
        var k = pairKey(v);
        if (!k || !(k in pairs)) return;
        pairs[k].value = v;
      });

      order.sort(function (a, b) { return parseInt(a, 10) - parseInt(b, 10); });
      order.forEach(function (k) {
        var p = pairs[k];
        if (!p.title || !p.value) return;
        var row = document.createElement('div');
        row.className = 'yotpo-custom-question-row';
        row.setAttribute('data-question-row', k);
        wrapper.appendChild(row);
        row.appendChild(p.title);
        row.appendChild(p.value);
      });
      wrapper.dataset.pairsWrapped = '1';
    }

    function processAll() {
      var wrappers = document.querySelectorAll('.yotpo-custom-questions-wrapper');
      wrappers.forEach(wrapWrapper);
    }

    processAll();

    if (typeof MutationObserver !== 'undefined') {
      var debounceTimer = null;
      var mo = new MutationObserver(function () {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(processAll, 120);
      });
      mo.observe(document.body, { childList: true, subtree: true });
    }

    /* 兜底：Yotpo 异步渲染，前几秒重复检测 */
    var attempts = 0;
    var interval = setInterval(function () {
      processAll();
      attempts++;
      if (attempts >= 12) clearInterval(interval);
    }, 800);
  })();
</script>

