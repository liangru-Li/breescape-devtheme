<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --xy-mp-info-bg: {{ section.settings.info_card_bg | default: '#FFFFFF' }};
    --xy-mp-info-radius: {{ section.settings.info_card_radius | default: 16 }}px;
    --xy-mp-info-padding: {{ section.settings.info_card_padding | default: 24 }}px;
    --xy-mp-info-padding-y: {{ section.settings.info_card_padding_y | default: 28 }}px;
    --xy-mp-grid-gap: {{ section.settings.info_card_gap | default: 24 }}px;
    --xy-mp-info-shadow: {{ section.settings.info_card_shadow | default: '0 2px 12px rgba(0,0,0,0.04)' }};
    --xy-mp-info-radius-m: {{ section.settings.info_card_radius_mobile | default: 12 }}px;
    --xy-mp-info-padding-m: {{ section.settings.info_card_padding_mobile | default: 16 }}px;
    --xy-mp-info-padding-y-m: {{ section.settings.info_card_padding_y_mobile | default: 16 }}px;
    --xy-mp-info-margin-m: {{ section.settings.info_card_margin_mobile | default: 12 }}px;
  }

  #shopify-section-{{ section.id }} .product-price-save-badge {
    font-size: var(--xy-save-font-size, 15px);
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .product-price-save-badge {
      font-size: var(--xy-save-font-size-m, 12px) !important;
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} {
      {%- assign media_ratio = section.settings.media_size | divided_by: 50.0 -%}
      --product-grid: auto / minmax(0, {{ media_ratio }}fr) minmax(0, {{ 2.0 | minus: media_ratio }}fr);
    }
  }

  {%- assign first_media = product.selected_or_first_available_variant.featured_media | default: product.media.first -%}
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --aspect-ratio: {{ first_media.aspect_ratio }};
    }
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} {
      --aspect-ratio: {{ first_media.aspect_ratio }};
    }
  }

   @media screen and (min-width: 1280px) {
  #shopify-section-{{ section.id }} .product__thumbnails--beside {
    order: -1;
    width: var(--sp-16) !important;
  }
  }
  #shopify-section-{{ section.id }} .product-media-info {
    inset-block-start: var(--sp-6) !important;
    transition: inset-block-start var(--animation-nav);
    inset-block-start: calc(var(--header-height) + var(--sp-3)) !important;
  }

  {%- if section.settings.enable_info_card -%}
  /* 移动端右侧产品信息卡片样式（< 1024px） */
  @media screen and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .product__info {
      background: var(--xy-mp-info-bg);
      border-radius: var(--xy-mp-info-radius-m);
      padding: var(--xy-mp-info-padding-y-m) var(--xy-mp-info-padding-m);
      box-shadow: var(--xy-mp-info-shadow);
      box-sizing: border-box;
      margin-top: var(--xy-mp-info-margin-m);
    }
  }
  /* PC 端右侧产品信息卡片样式（强制启用 sticky，等待右侧滚到底） */
  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .featured-product.product {
      gap: var(--xy-mp-grid-gap) !important;
      align-items: start !important;
    }
    /* 左侧媒体：强制 sticky，不依赖 lg:sticky 类是否存在 */
    #shopify-section-{{ section.id }} .product-media-info {
      position: sticky !important;
      align-self: start !important;
      height: fit-content !important;
      top: calc(var(--header-height, 80px) + 12px) !important;
      inset-block-start: calc(var(--header-height, 80px) + 12px) !important;
    }
    /* 右侧信息卡：高度紧贴内容；卡片背景包裹内容而非延伸到 row 底部 */
    #shopify-section-{{ section.id }} .product__info {
      align-self: start !important;
      height: fit-content !important;
      background: var(--xy-mp-info-bg);
      border-radius: var(--xy-mp-info-radius);
      padding: var(--xy-mp-info-padding-y) var(--xy-mp-info-padding);
      box-shadow: var(--xy-mp-info-shadow);
      box-sizing: border-box;
      position: static !important;
    }
    /* 右侧卡片自身不要 sticky（避免与左侧 sticky 冲突，让右侧自然向上滚动） */
    #shopify-section-{{ section.id }} .product__info.lg\:sticky {
      position: static !important;
    }
  }
  @media screen and (min-width: 1280px) {
    #shopify-section-{{ section.id }} .featured-product.product {
      gap: var(--xy-mp-grid-gap) !important;
    }
  }
  @media screen and (min-width: 1536px) {
    #shopify-section-{{ section.id }} .featured-product.product--scroll {
      gap: var(--xy-mp-grid-gap) !important;
    }
  }
  {%- endif -%}
</style>

{%- liquid
  assign product_form_id = 'ProductForm-' | append: section.id | append: '-' | append: product.id
  assign media_count = product.media.size
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  assign icon_list_block = section.blocks | where: 'type', 'icon_list' | first
  assign reward_points_block = section.blocks | where: 'type', 'reward_points' | first
-%}

{%- if reward_points_block -%}
  {{ 'product-reward-points.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if first_3d_model -%}
  {{ 'model-viewer.css' | asset_url | stylesheet_tag }}
  <link
    id="ModelViewerStyle"
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
    media="print"
    onload="this.media='all'"
  />
  <link
    id="ModelViewerOverride"
    rel="stylesheet"
    href="{{ 'model-viewer-ui.css' | asset_url }}"
    media="print"
    onload="this.media='all'"
  />
{%- endif -%}

{%- if product.quantity_price_breaks_configured? -%}
  {{ 'volume-pricing.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'volume-pricing.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if icon_list_block -%}
  {%- capture icon_list_render -%}
    {%- if settings.product_icon_list_metafield != blank -%}
      {%- liquid
        assign metafield_parts = settings.product_icon_list_metafield | split: '.'
        assign metafield_namespace = metafield_parts | first
        assign metafield_key = metafield_parts | last
        assign metafield = product.metafields[metafield_namespace][metafield_key]
      -%}
      {%- if metafield.value != blank and metafield.list? -%}
        <div class="product__highlights{% if icon_list_block.settings.heading != blank %} with-heading flex flex-col gap-5 relative{% endif %}{% if icon_list_block.settings.show_below_media %} below-media{% endif %}" {{ icon_list_block.shopify_attributes }}>
          {%- if icon_list_block.settings.heading != blank -%}
            <p class="font-medium leading-tight md:text-lg">{{ icon_list_block.settings.heading | escape }}</p>
          {%- endif -%}
          <scroll-shadow class="product-card__spec block overflow-hidden">
            <div class="product-card__icons flex flex-nowrap{% unless icon_list_block.settings.enable_carousel %} lg:flex-wrap{% endunless %}" is="icons-carousel" tabindex="0">
              {%- for item in metafield.value -%}
                <div class="product-card__icon shrink-0">
                  <div class="flex flex-col items-center md:flex-row md:items-start gap-2">
                    {%- if item.icon.value != blank -%}
                      {%- assign icon_alt = item.icon.value.alt | default: item.title | escape -%}
                      {%- assign max_width = item.icon.value.width -%}
                      <figure class="shrink-0 media media--transparent relative inline-block">
                        {%- capture sizes -%}32px{%- endcapture -%}
                        {%- capture widths -%}{{ 32 | times: 1.5 | at_most: max_width | round }}, {{ 32 | times: 2 | at_most: max_width }}, {{ 32 | times: 3 | at_most: max_width }}{%- endcapture -%}
                        {{- item.icon.value | image_url: width: max_width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, alt: icon_alt, class: 'w-full h-full', is: 'lazy-image' -}}
                      </figure>
                    {%- endif -%}
                    <div class="flex flex-col items-center md:items-start gap-1 text-center md:text-left text-sm font-medium leading-none">
                      {{- item.title -}}
                      {%- if item.description != blank -%}
                        <p class="text-opacity font-normal text-xs leading-tight">{{ item.description }}</p>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
            <template>
              <slot></slot>
              <s dir="{% render 'direction' %}" style="--t: 0;--b: 0;--l: 0;--r: 0;">
                <span class="l"></span>
                <span class="r"></span>
              </s>
              <style>
                :host{display:inline-block;position:relative}:host([hidden]){display:none}
                s{position:absolute;inset:0;pointer-events:none;}
                s span{position:absolute;inset-block:0;width:clamp(var(--sp-12),4.73vw,var(--sp-23));opacity:0;transition:opacity var(--animation-short);}
                s .l{inset-inline-start:0;opacity:var(--l);background:linear-gradient(90deg,rgb(var(--color-background)) 0%,transparent 100%);}
                s .r{inset-inline-end:0;opacity:var(--r);background:linear-gradient(270deg,rgb(var(--color-background)) 0%,transparent 100%);}
                s[dir=rtl] :is(.icon-chevron-left,.icon-chevron-right){transform:scaleX(-1);}
              </style>
            </template>
          </scroll-shadow>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}
{%- endif  -%}

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if media_count > 0 %}{% if section.settings.full_width %} page-width--full{% endif %}{% else %} page-width--narrow{% endif %} relative">
    <div class="featured-product product product--{{ section.settings.gallery_layout }}{% if media_count == 0 %} no-media{% endif %} flex flex-col items-start lg:grid gap-2 w-full relative">
          
      {%- assign yr_promo_block = section.blocks | where: 'type', 'yotpo_rating_promo' | first -%}
      {%- assign yr_promo_vis = yr_promo_block.settings.visibility | default: 'all' -%}
      {%- if yr_promo_block and yr_promo_vis != 'desktop' -%}
        {%- render 'product-yotpo-rating-promo', product: product, block: yr_promo_block, placement: 'mobile-gallery' -%}
      {%- endif -%}

      {%- liquid
        assign price_block = section.blocks | where: 'type', 'price' | first
        assign rating_block = section.blocks | where: 'type', 'rating' | first
        assign title_block = section.blocks | where: 'type', 'title' | first
      -%}
        <div class="product__title md:hidden" {{ block.shopify_attributes }}>
          <div
            class="heading leading-none {{ block.settings.title_size }} title-sm mobile:{{ block.settings.title_size_mobile }} col-span-full"
            {%- if title_block.settings.title_weight and title_block.settings.title_weight != 'default' %} style="font-weight: {{ title_block.settings.title_weight }} !important;"{% endif -%}
          >
            {%- if settings.enable_heading_reveal -%}
              <split-words class="split-words js-invisible block" data-animate="fade-up">{{ product.title }}</split-words>
            {%- else -%}
              {{- product.title -}}
            {%- endif -%}
          </div>
        </div>

        {% unless product.id == 7528441315406 %}
        {% endunless %}

        {%- comment -%} mobile introduce {%- endcomment -%}
        {%- assign __xy_tip_text = product.metafields.custom.product_introduce_tip | default: '' | strip -%}
        <span class="md:hidden text-sm text-zinc-500" style="color: #10374B;">
          {{ product.metafields.custom.product_introduce }}
          {%- if product.metafields.custom.product_introduce != blank and template.suffix != 'bodypillow' and template.suffix != 'adjustablecomforter' -%}
          <span class="xy-tip" data-xy-tip>
            <button type="button" class="xy-tip__btn" aria-label="More info" aria-expanded="false">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="8" r="7"/>
                <line x1="8" y1="7" x2="8" y2="11.5"/>
                <circle cx="8" cy="4.8" r="0.55" fill="currentColor" stroke="none"/>
              </svg>
            </button>
            <span class="xy-tip__bubble" role="tooltip" hidden>
              <button type="button" class="xy-tip__close" aria-label="Close">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                  <line x1="2" y1="2" x2="10" y2="10"/>
                  <line x1="10" y1="2" x2="2" y2="10"/>
                </svg>
              </button>
              <span class="xy-tip__text">{% if __xy_tip_text != blank %}{{ __xy_tip_text }}{% else %}If any product that bears our limited warranty Seal proves to be deffective within two years from the date it was first sold to a consumer by an authorized retailer, we, Good Houseekeeping, will refund the purchase price or $2,000, whichever is less or, at Good Housekeeping&#39;s sole discretion, repair or replace the product.{% endif %}</span>
            </span>
          </span>
          {%- endif -%}
        </span>

        {%- comment -%} mobile icon {%- endcomment -%}
        <div class="md:hidden">
          {%- assign product_features_icon = product.metafields.custom.product_features_icon.value -%}

          {%- if product_features_icon != blank -%}
          <div class="flex flex-wrap gap-2 py-2">
            {%- for item in product_features_icon -%}
            <div class="flex items-center gap-1 text-base bg-zinc-200" style="padding: 4px 8px;border-radius: 4px;">
              {%- if item.icon.value != blank -%}
              <img src="{{ item.icon.value | image_url: width: 64 }}" alt="{{ item.label | escape }}" width="14" height="14"
                loading="lazy" style="margin-block:0;">
              {%- endif -%}

              <span class="text-xs leading-4 font-normal text-primary">
                {{ item.label }}
              </span>
            </div>
            {%- endfor -%}
          </div>
          {%- endif -%}
        </div>
 
      {%- comment -%} mobile icon end {%- endcomment -%}


      <div class="product-media-info {% if section.settings.enable_sticky_info %} lg:sticky{% endif %} ">




      {%- if media_count > 0 -%}
        <div class="product__gallery-container{% if section.settings.enable_sticky_info %} lg:sticky{% endif %} flex flex-col gap-0 md:gap-8 relative w-full">
          {%- render 'product-media-gallery',
            product: product,
            product_id: product.id,
            section_id: section.id,
            gallery_layout: section.settings.gallery_layout,
            thumbnail_position: section.settings.thumbnail_position,
            image_ratio: section.settings.image_ratio,
            image_ratio_mobile: section.settings.image_ratio_mobile,
            image_zoom: section.settings.image_zoom,
            image_fill: settings.product_image_fill,
            mobile_layout: section.settings.mobile_layout,
            mobile_thumbnail: section.settings.mobile_thumbnail,
            hide_variants: section.settings.hide_variants,
            enable_video_autoplay: section.settings.enable_video_autoplay,
            enable_video_looping: section.settings.enable_video_looping,
            first_3d_model: first_3d_model,
            product_form_id: product_form_id
          -%}

          {%- liquid
            if icon_list_block and icon_list_block.settings.show_below_media
              echo icon_list_render
            endif
          -%}
        </div>
      {%- endif -%}
      </div>

      <product-info
        id="ProductInfo-{{ section.id }}-{{ product.id }}"
        class="product__info{% if section.settings.enable_sticky_info %} lg:sticky{% endif %} block w-full"
        data-animate="fade-up"
        data-immediate
        data-section-id="{{ section.id }}"
        data-product-id="{{ product.id }}"
        data-product-url="{{ product.url }}"
        data-update-url="true"
        form="{{ product_form_id }}"
      >
        {%- assign _xy_has_addon = false -%}
        {%- assign _xy_addon_count = 0 -%}
        {%- assign _xy_addon_first_id = '' -%}
        {%- for _b in section.blocks -%}
          {%- if _b.type == 'addon' -%}
            {%- assign _xy_has_addon = true -%}
            {%- if _b.settings.product != blank -%}
              {%- assign _xy_addon_count = _xy_addon_count | plus: 1 -%}
              {%- if _xy_addon_first_id == blank -%}
                {%- assign _xy_addon_first_id = _b.id -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if _xy_has_addon -%}
          <style>
            .xy-addon{ margin: var(--xy-addon-card-margin-y, 12px) 0; }
            .xy-addon__title-row{
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 12px;
              width: 100%;
              box-sizing: border-box;
              margin: 0 0 8px;
            }
            .xy-addon__title-row .xy-addon__heading{
              margin: 0;
              flex: 1 1 auto;
              min-width: 0;
            }
            .xy-addon__heading{
              margin: 0 0 8px;
              color: var(--xy-addon-heading-color, #10374B);
              font-size: var(--xy-addon-heading-size, 16px);
              font-weight: var(--xy-addon-heading-weight, 700);
              line-height: 1.2;
            }
            .xy-addon__card{
              display: flex;
              align-items: center;
              gap: var(--xy-addon-gap, 14px);
              padding: var(--xy-addon-card-pad-y, 17px) var(--xy-addon-card-pad-x, 20px);
              background: var(--xy-addon-card-bg, #FFFFFF);
              border: 1px solid var(--xy-addon-card-border, #D1D5DB);
              border-radius: var(--xy-addon-card-radius, 999px);
              cursor: pointer;
              transition: border-color .15s ease, box-shadow .15s ease;
              position: relative;
            }
            .xy-addon__card:hover{
              border: 1px solid var(--xy-addon-active-color, #10374B) !important;
            }
            .xy-addon__card:has(.xy-addon__check:checked){
              border: 1px solid var(--xy-addon-active-color, #10374B) !important;
            }
            .xy-addon__check-wrap{
              position: relative;
              flex: 0 0 var(--xy-addon-check-size, 22px);
              width: var(--xy-addon-check-size, 22px) !important;
              height: var(--xy-addon-check-size, 22px) !important;
              aspect-ratio: 1 / 1;
              display: inline-flex; align-items: center; justify-content: center;
              box-sizing: border-box;
              margin-right: var(--xy-addon-check-gap, 14px);
            }
            .xy-addon__check{
              position: absolute; inset: 0;
              opacity: 0; cursor: pointer; margin: 0;
              width: 100%; height: 100%;
            }
            .xy-addon__check-icon{
              width: var(--xy-addon-check-size, 22px) !important;
              height: var(--xy-addon-check-size, 22px) !important;
              flex: 0 0 var(--xy-addon-check-size, 22px);
              aspect-ratio: 1 / 1;
              border-radius: 50%;
              border: 1.5px solid var(--xy-addon-card-border, #D1D5DB);
              display: inline-flex; align-items: center; justify-content: center;
              color: transparent;
              background: transparent;
              transition: background .15s ease, border-color .15s ease, color .15s ease;
              pointer-events: none;
              box-sizing: border-box;
            }
            .xy-addon__check:checked + .xy-addon__check-icon{
              background: var(--xy-addon-check-bg, #10374B);
              border-color: var(--xy-addon-check-bg, #10374B);
              color: var(--xy-addon-check-color, #FFFFFF);
            }
            .xy-addon__media{
              flex: 0 0 auto;
              width: var(--xy-addon-img-size, 64px);
              height: var(--xy-addon-img-size, 64px);
              border-radius: var(--xy-addon-img-radius, 8px);
              overflow: hidden;
              background: #F4F4F5;
              display: inline-flex; align-items: center; justify-content: center;
            }
            .xy-addon__media img{
              width: 100%; height: 100%; object-fit: cover; display: block; margin: 0;
            }
            .xy-addon__body{
              flex: 1 1 auto; min-width: 0;
              display: flex; flex-direction: column; gap: 8px;
            }
            .xy-addon__title{
              margin: 0;
              color: var(--xy-addon-title-color, #10374B) !important;
              font-size: var(--xy-addon-title-size, 16px) !important;
              font-weight: var(--xy-addon-title-weight, 700) !important;
              line-height: 1.25;
              white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            }
            .xy-addon__row{
              display: flex;
              align-items: center;
              justify-content: space-between;
              gap: 12px;
              flex-wrap: nowrap;
              min-width: 0;
            }
            .xy-addon__pickers{
              display: inline-flex; flex-wrap: wrap; gap: 6px;
              align-items: center;
              min-width: 0;
            }
            .xy-addon__picker{
              position: relative;
              display: inline-flex; align-items: center; gap: 6px;
              padding: 4px 6px;
              border-radius: 999px;
              background: transparent;
              border: 1px solid transparent;
              cursor: pointer;
              transition: background-color .15s ease, border-color .15s ease;
              line-height: 1;
              font-size: var(--xy-addon-picker-fz, 14px);
            }
            .xy-addon__picker:hover{
              background: rgba(16,55,75,.05);
            }
            .xy-addon__picker.is-open{
              background: rgba(16,55,75,.06);
              border-color: rgba(16,55,75,.18);
            }
            .xy-addon__picker--size{
              padding-left: 10px;
            }
            .xy-addon__picker--color .xy-addon__trigger-label{
              display: none;
            }
            .xy-addon__swatch{
              width: 22px; height: 22px;
              flex: 0 0 22px;
              aspect-ratio: 1 / 1;
              border-radius: 50%;
              border: 1px solid rgba(0,0,0,.12);
              box-shadow: inset 0 0 0 2px #fff;
              background: #888;
              display: inline-block;
              background-size: cover;
              background-position: center;
            }
            .xy-addon__menu-swatch{
              background-size: cover;
              background-position: center;
            }
            /* 图片型 swatch (Theme Editor 配了图片 URL) - 保留 1.5px 内白边 (装饰效果, 跟纯色 swatch 风格一致), 同时加深外描边让圆圈轮廓清晰. */
            .xy-addon__swatch.is-img,
            .xy-addon__menu-swatch.is-img{
              box-shadow: inset 0 0 0 1.5px #fff;
              border: 1.5px solid rgba(15,55,75,.55);
            }
            .xy-addon__trigger{
              appearance: none; -webkit-appearance: none;
              border: 0; background: transparent;
              padding: 0;
              display: inline-flex; align-items: center; gap: 6px;
              font: inherit;
              color: #10374B;
              font-weight: 500;
              cursor: pointer;
              outline: none;
