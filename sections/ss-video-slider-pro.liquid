                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                  <div class="video-slider-control-{{ section.id }}">
                    <button type="button" class="video-play-label-{{ section.id }}" aria-label="Play or pause video">
                      <svg
                        class="icon-play"
                        width="24"
                        height="29"
                        viewBox="0 0 24 29"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path d="M22.8463 12.8518L3.79321 1.19619C3.47199 0.999486 3.10407 0.892103 2.72747 0.885128C2.35086 0.878154 1.97922 0.971842 1.65093 1.15652C1.32577 1.33832 1.0549 1.60346 0.866176 1.92466C0.677454 2.24586 0.577692 2.61153 0.577148 2.98407V26.2926C0.579599 26.8514 0.803852 27.3864 1.20061 27.7799C1.59737 28.1735 2.13416 28.3934 2.69298 28.3913C3.08303 28.3911 3.4655 28.2836 3.7985 28.0805L22.8463 16.4249C23.1525 16.2383 23.4055 15.9761 23.5811 15.6634C23.7567 15.3508 23.8489 14.9982 23.8489 14.6397C23.8489 14.2811 23.7567 13.9286 23.5811 13.6159C23.4055 13.3033 23.1525 13.041 22.8463 12.8544V12.8518ZM2.69298 26.2675V3.00126L21.713 14.6383L2.69298 26.2675Z" fill="{{ control_color }}"></path>
                      </svg>
                      <svg
                        class="icon-pause"
                        width="24"
                        height="29"
                        viewBox="0 0 24 29"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <rect x="1" y="1" width="8" height="27" rx="2" fill="{{ control_color }}"/>
                        <rect x="15" y="1" width="8" height="27" rx="2" fill="{{ control_color }}"/>
