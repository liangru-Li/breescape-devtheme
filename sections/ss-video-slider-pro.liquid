          {% endfor %}
        </div>
      </div>
      <button class="video-slider-btn-prev-{{ section.id }}" aria-label="Previous slide">
        <span class="animate-icon"></span>
      </button>
      <button class="video-slider-btn-next-{{ section.id }}" aria-label="Next slide">
