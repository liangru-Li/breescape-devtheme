                    <video
                      {% if lazy %}
                        data-
                      {% endif %}
                      src="{% if block.settings.video != blank %}{{ block.settings.video.sources[1].url }}{% else %}{{ placeholder_video }}{% endif %}"
                      playsinline
                      preload="metadata"
                      {% if video_loop %}
                        loop
                      {% endif %}
                      class="lazy"
                    ></video>
