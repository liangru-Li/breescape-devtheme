{%- liquid
  assign show_section = true
  if section.settings.hide_homepage and request.page_type == 'index'
    assign show_section = false
  endif

  assign section_rendering_api = false
  if section.index == nil
    assign section_rendering_api = true
  endif
-%}

{%- if show_section -%}
  <style>
    :root {
      --topbar-height: var(--sp-12);
    }
    
    @media screen and (min-width: 1536px) {
      :root {
        --topbar-height: var(--sp-14);
      }
    }
    @media screen and (max-width: 767px) {
      :root {
        --topbar-height: 56px;
      }
    }

    #shopify-section-{{ section.id }} {
      --gradient-background: {% if section.settings.gradient_background != blank %}{{ section.settings.gradient_background }}{% else %}{{ section.settings.color_background }}{% endif %};
      --color-background: {{ section.settings.color_background.rgb }};
      --color-foreground: {{ section.settings.color_text.rgb }};
      --color-highlight: {{ section.settings.color_highlight.rgb }};
    }

    /* ---------- Announcement row alignment (icon + text + tooltip) ---------- */
    .announcement__content {
      display: flex !important;
      align-items: center !important;
      line-height: 1;
    }
    .announcement__content > .announcement-icon,
    .announcement__content > .announcement-icon--custom,
    .announcement__content > .ann-tooltip {
      align-self: center;
      flex-shrink: 0;
      line-height: 0;
    }
    .announcement__content > .announcement-text {
      align-self: center;
      line-height: 1.2;
      margin: 0 !important;
    }
    .announcement-text :is(p) { margin: 0; }
    @media screen and (max-width: 767px) {
      .announcement-text--mobile {
        white-space: normal;
        text-align: center;
      }
    }

    /* ---------- Announcement custom (uploaded) icon ---------- */
    .announcement-icon--custom {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      vertical-align: middle;
      line-height: 0;
      /* Pull text closer to the custom icon (offsets parent gap-2) */
      margin-inline-end: -8px;
    }
    .announcement-icon--custom .announcement-custom-icon {
      width: var(--ann-custom-icon-size, 18px) !important;
      height: var(--ann-custom-icon-size, 18px) !important;
      max-width: none;
      object-fit: contain;
      display: block;
    }

    /* ---------- Announcement tooltip (global, bubble lives in <body>) ---------- */
    .ann-tooltip {
      position: relative;
      display: inline-flex;
      align-items: center;
      vertical-align: middle;
      line-height: 0;
      /* Push tooltip icon further from the text (adds to parent gap-2) */
      margin-inline-start: 6px;
    }
    .ann-tooltip__btn {
      all: unset;
      cursor: pointer;
      width: 16px;
      height: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: currentColor;
      opacity: .9;
      line-height: 1;
    }
    .ann-tooltip__btn:hover { opacity: 1; }
    .ann-tooltip__btn svg {
      width: 16px;
      height: 16px;
      display: block;
    }
    .ann-tooltip__bubble {
      position: fixed;
      top: 0;
      left: 0;
      width: max-content;
      max-width: var(--ann-tt-max-w, 320px);
      padding: 12px 14px;
      background-color: #fff;
      color: rgb(20, 28, 36);
      border-radius: 10px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, .15);
      font-size: 13px;
      line-height: 1.45;
      text-align: left;
      white-space: normal;
      visibility: hidden;
      opacity: 0;
      pointer-events: none;
      transition: opacity .15s ease, visibility .15s linear;
      z-index: 99999;
    }
    .ann-tooltip__bubble.is-visible {
      visibility: visible;
      opacity: 1;
      pointer-events: auto;
    }
    .ann-tooltip__bubble::before {
      content: "";
      position: absolute;
      bottom: 100%;
      left: var(--ann-tt-arrow-left, 50%);
      transform: translateX(-50%);
      border: 6px solid transparent;
      border-bottom-color: #fff;
    }
    .ann-tooltip__bubble :is(p, ul, ol) { margin: 0; }
    .ann-tooltip__bubble :is(p, ul, ol) + :is(p, ul, ol) { margin-top: 6px; }
    .ann-tooltip__bubble a {
      color: inherit;
      text-decoration: underline;
    }
    @media (max-width: 768px) {
      .ann-tooltip__bubble {
        max-width: min(var(--ann-tt-max-w, 320px), calc(100vw - 24px));
      }
    }
  </style>

  {%- liquid
    assign announcements_count = section.blocks.size
    if section.settings.enable_language_selector and localization.available_languages.size > 1
      assign enable_language_selector = true
    endif
    if section.settings.enable_country_selector and localization.available_countries.size > 1
      assign enable_country_selector = true
    endif
  -%}

  <nav class="topbar topbar--{{ section.settings.announcement_position }}{% if section.settings.invert_icons_selectors %} topbar--inverted{% endif %}{% unless section.settings.show_social or enable_language_selector or enable_country_selector %} topbar--only{% endunless %} page-width{% if section.settings.full_width %} page-width--full{% endif %} section{% if section.settings.rounded %} section--rounded{% endif %} relative grid py-0 h-full w-full items-center" aria-label="{{ 'sections.announcements.announcement_bar' | t | escape }}">
    {%- if section.settings.show_social -%}
      <div class="social-icons hidden lg:flex items-center">
        {%- render 'social-icons', size: 'sm', gap: '6' -%}
      </div>
    {%- endif -%}

    {%- liquid
      if announcements_count > 0
        if section.settings.announcement_layout == 'carousel'
          render 'announcements-carousel', section: section, announcements_count: announcements_count
        else
          render 'announcements-marquee', section: section, announcements_count: announcements_count
        endif
      endif
    -%}

    {%- if enable_language_selector or enable_country_selector -%}
      <div class="localization hidden lg:flex items-center h-full">
        {%- if enable_language_selector -%}
          <div class="localization__item h-full relative" role="combobox" aria-controls="LanguageLocalization-{{ section.id }}" aria-expanded="false" aria-label="{{ 'localization.language_label' | t | escape }}">
            <button type="button" class="flex items-center gap-3 h-full z-2 relative">
              {%- unless section_rendering_api -%}
                <api-button class="api-only" data-id="announcement_localization_language_form" data-section-id="{{ section.id }}"></api-button>
              {%- endunless -%}
              {%- render 'icon', icon: 'language', size: 'xs', class: 'stroke-1 hidden xl:block' -%}
              <span class="leading-tight">{{ localization.language.endonym_name | capitalize }}</span>
              {%- render 'icon', icon: 'chevron-down', size: 'xs' -%}
            </button>
            <dropdown-localization class="dropdown opacity-0 invisible z-30 absolute top-100{% if enable_country_selector %} left-0{% else %} right-0{% endif %} pointer-events-none" id="LanguageLocalization-{{ section.id }}">
              {%- unless section_rendering_api -%}
                <div class="dropdown__container" id="announcement_localization_language_form"></div>
              {%- else -%}
                {%- form 'localization', id: 'announcement_localization_language_form', class: 'dropdown__container', is: 'localization-listbox' -%}
                  {%- render 'corner', dir: 'top', prefix: 'dropdown' -%}
                  <ul class="dropdown__nav flex flex-col gap-1d5 xl:gap-2" role="list">
                    {%- for language in localization.available_languages -%}
                      <li class="opacity-0">
                        <p>
                          <a class="reversed-link{% if language.iso_code == localization.language.iso_code %} active pointer-events-none{% endif %}"
                            href="#"
                            hreflang="{{ language.iso_code }}"
                            lang="{{ language.iso_code }}"
                            {% if language.iso_code == localization.language.iso_code %}
                              aria-current="true"
                            {% endif %}
                            data-value="{{ language.iso_code }}"
                            title="{{ language.endonym_name | capitalize | escape }}"
                            data-no-instant
                          >
                            {{- language.endonym_name | capitalize -}}
                          </a>
                        </p>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" />
                {%- endform -%}
              {%- endunless -%}
            </dropdown-localization>
          </div>
        {%- endif -%}
        {%- if enable_country_selector -%}
          <div class="localization__item h-full relative" role="combobox" aria-controls="CountryLocalization-{{ section.id }}" aria-expanded="false" aria-label="{{ 'localization.country_label' | t | escape }}">
            <button type="button" class="flex items-center gap-3 h-full z-2 relative">
              {%- unless section_rendering_api -%}
                <api-button class="api-only" data-id="announcement_localization_country_form" data-section-id="{{ section.id }}"></api-button>
              {%- endunless -%}
              {%- render 'icon', icon: 'currency', size: 'xs', class: 'stroke-1 hidden xl:block' -%}
              <span class="leading-tight">{{ localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})</span>
              {%- render 'icon', icon: 'chevron-down', size: 'xs' -%}
            </button>
            <dropdown-localization class="dropdown opacity-0 invisible z-30 absolute top-100 right-0 pointer-events-none" id="CountryLocalization-{{ section.id }}">
              {%- unless section_rendering_api -%}
                <div class="dropdown__container" id="announcement_localization_country_form"></div>
              {%- else -%}
                {%- form 'localization', id: 'announcement_localization_country_form', class: 'dropdown__container', is: 'localization-listbox' -%}
                  {%- render 'corner', dir: 'top', prefix: 'dropdown' -%}
                  <ul class="dropdown__nav flex flex-col gap-1d5 xl:gap-2" role="list">
                    {%- for country in localization.available_countries -%}
                      <li class="opacity-0">
                        <p>
                          <a class="reversed-link{% if country.iso_code == localization.country.iso_code %} active pointer-events-none{% endif %}"
                            href="#"
                            {% if country.iso_code == localization.country.iso_code %}
                              aria-current="true"
                            {% endif %}
                            data-value="{{ country.iso_code }}"
                            title="{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})"
                            data-no-instant
                          >
                            {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                          </a>
                        </p>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" />
                {%- endform -%}
              {%- endunless -%}
            </dropdown-localization>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </nav>

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root || root.__annTooltipBound) return;
      root.__annTooltipBound = true;

      var activeTip = null;

      function position(tip) {
        var btn = tip.querySelector('.ann-tooltip__btn');
        var bubble = tip._bubble;
        if (!btn || !bubble) return;
        var rect = btn.getBoundingClientRect();
        var cx = rect.left + rect.width / 2;
        var by = rect.bottom + 10;
        /* 临时让 bubble 可见以便测量宽度 */
        var measuring = !bubble.classList.contains('is-visible');
        if (measuring) {
          bubble.style.visibility = 'hidden';
          bubble.style.opacity = '0';
          bubble.style.transition = 'none';
          bubble.classList.add('is-visible');
        }
        var bw = bubble.offsetWidth;
        if (measuring) {
          bubble.classList.remove('is-visible');
          bubble.style.visibility = '';
          bubble.style.opacity = '';
          bubble.style.transition = '';
        }
        var pad = 8;
        var vw = window.innerWidth || document.documentElement.clientWidth;
        var halfBw = bw / 2;
        var shift = 0;
        if (cx - halfBw < pad) shift = pad - (cx - halfBw);
        else if (cx + halfBw > vw - pad) shift = (vw - pad) - (cx + halfBw);
        bubble.style.left = cx + 'px';
        bubble.style.top = by + 'px';
        bubble.style.transform = 'translateX(calc(-50% + ' + shift + 'px))';
        /* 气泡为防出屏平移后，箭头反向偏移，始终对准 (i) */
        var arrowLeft = halfBw - shift;
        arrowLeft = Math.max(10, Math.min(arrowLeft, bw - 10));
        bubble.style.setProperty('--ann-tt-arrow-left', arrowLeft + 'px');
      }

      function show(tip) {
        if (!tip._bubble) return;
        clearTimeout(tip._hideTimer);
        position(tip);
        tip._bubble.classList.add('is-visible');
        var btn = tip.querySelector('.ann-tooltip__btn');
        if (btn) btn.setAttribute('aria-expanded', 'true');
        activeTip = tip;
      }

      function hideSoon(tip) {
        if (!tip._bubble) return;
        if (tip.classList.contains('is-open')) return;
        clearTimeout(tip._hideTimer);
        tip._hideTimer = setTimeout(function () { hideNow(tip); }, 120);
      }

      function hideNow(tip) {
        if (!tip._bubble) return;
        clearTimeout(tip._hideTimer);
        tip._bubble.classList.remove('is-visible');
        tip.classList.remove('is-open');
        var btn = tip.querySelector('.ann-tooltip__btn');
        if (btn) btn.setAttribute('aria-expanded', 'false');
        if (activeTip === tip) activeTip = null;
      }

      /* 把每个 bubble 移到 <body>，避免 Flickity transform / overflow:hidden 把它裁掉 */
      root.querySelectorAll('.ann-tooltip').forEach(function (tip) {
        var bubble = tip.querySelector('.ann-tooltip__bubble');
        if (!bubble) return;
        tip._bubble = bubble;
        bubble._tip = tip;
        document.body.appendChild(bubble);

        tip.addEventListener('mouseenter', function () { show(tip); });
        tip.addEventListener('mouseleave', function () { hideSoon(tip); });
        tip.addEventListener('focusin', function () { show(tip); });
        tip.addEventListener('focusout', function (e) {
          if (!tip.contains(e.relatedTarget)) hideSoon(tip);
        });

        bubble.addEventListener('mouseenter', function () { show(tip); });
        bubble.addEventListener('mouseleave', function () { hideSoon(tip); });
      });

      /* 点击 ⓘ：阻止链接跳转 + 切换粘性显示 */
      root.addEventListener('click', function (e) {
        var btn = e.target.closest('.ann-tooltip__btn');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        var tip = btn.closest('.ann-tooltip');
        if (!tip) return;
        root.querySelectorAll('.ann-tooltip.is-open').forEach(function (other) {
          if (other !== tip) hideNow(other);
        });
        var willOpen = !tip.classList.contains('is-open');
        tip.classList.toggle('is-open', willOpen);
        if (willOpen) show(tip);
        else hideNow(tip);
      });

      /* 点击外部关闭 */
      document.addEventListener('click', function (e) {
        if (e.target.closest('.ann-tooltip__bubble')) return;
        if (e.target.closest('.ann-tooltip')) return;
        root.querySelectorAll('.ann-tooltip.is-open').forEach(hideNow);
      });

      /* Esc 关闭 */
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          root.querySelectorAll('.ann-tooltip.is-open').forEach(hideNow);
        }
      });

      /* 滚动 / resize 时重新定位 */
      function reposition() {
        if (activeTip && activeTip._bubble && activeTip._bubble.classList.contains('is-visible')) {
          position(activeTip);
        }
      }
      window.addEventListener('scroll', reposition, { passive: true });
      window.addEventListener('resize', reposition);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement-bar.name",
  "class": "topbar-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.announcement-bar.settings.show_social.label",
      "info": "t:sections.announcement-bar.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "t:sections.announcement-bar.settings.enable_language_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_language_selector.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.announcement-bar.settings.enable_country_selector.label",
      "info": "t:sections.announcement-bar.settings.enable_country_selector.info"
    },
    {
      "type": "checkbox",
      "id": "invert_icons_selectors",
      "default": false,
      "label": "t:sections.announcement-bar.settings.invert_icons_selectors.label"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header__announcements.content"
    },
    {
      "type": "select",
      "id": "announcement_position",
      "options": [
        {
          "value": "start",
          "label": "t:sections.announcement-bar.settings.announcement_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.announcement-bar.settings.announcement_position.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.announcement-bar.settings.announcement_position.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.announcement-bar.settings.announcement_position.label",
      "info": "t:sections.announcement-bar.settings.announcement_position.info"
    },
    {
      "type": "select",
      "id": "announcement_layout",
      "options": [
        {
          "value": "carousel",
          "label": "t:sections.announcement-bar.settings.announcement_layout.options__1.label"
        },
        {
          "value": "marquee",
          "label": "t:sections.announcement-bar.settings.announcement_layout.options__2.label"
        }
      ],
      "default": "carousel",
      "label": "t:sections.announcement-bar.settings.announcement_layout.label"
    },
    {
      "visible_if": "{{ section.settings.announcement_layout == 'carousel' }}",
      "type": "checkbox",
      "id": "autoplay",
      "default": true,
      "label": "t:sections.announcement-bar.settings.autoplay.label"
    },
    {
      "visible_if": "{{ section.settings.announcement_layout == 'carousel' and section.settings.autoplay == true }}",
      "type": "range",
      "id": "autoplay_speed",
      "label": "t:sections.announcement-bar.settings.autoplay_speed.label",
      "max": 10,
      "min": 3,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "visible_if": "{{ section.settings.announcement_layout == 'carousel' }}",
      "type": "checkbox",
      "id": "show_navigation",
      "default": false,
      "label": "t:sections.announcement-bar.settings.show_navigation.label"
    },
    {
      "visible_if": "{{ section.settings.announcement_layout == 'marquee' }}",
      "type": "select",
      "id": "direction",
      "options": [
        {
          "value": "left",
          "label": "t:sections.scrolling-text.settings.direction.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.scrolling-text.settings.direction.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.scrolling-text.settings.direction.label"
    },
    {
      "visible_if": "{{ section.settings.announcement_layout == 'marquee' }}",
      "type": "range",
      "id": "speed",
      "min": 1,
      "max": 30,
      "step": 1,
      "label": "t:sections.scrolling-text.settings.speed.label",
      "unit": "x",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content",
      "info": "t:sections.global.settings.header__colors.info"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "t:sections.global.settings.color_text.label",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label",
      "default": "#1f1f1f"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "color",
      "id": "color_highlight",
      "label": "t:sections.global.settings.color_highlight.label",
      "default": "#ffddbf"
    },
    {
      "type": "color_background",
      "id": "gradient_highlight",
      "label": "t:sections.global.settings.gradient_highlight.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "checkbox",
      "id": "hide_homepage",
      "label": "t:sections.announcement-bar.settings.hide_homepage.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.global.settings.icon.label",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "t:sections.global.settings.icon.options__1.label"
            },
            {
              "value": "alert",
              "label": "t:sections.global.settings.icon.options__2.label"
            },
            {
              "value": "award",
              "label": "t:sections.global.settings.icon.options__3.label"
            },
            {
              "value": "bag",
              "label": "t:sections.global.settings.icon.options__4.label"
            },
