{{ 'breescape-adjustable-comforter.css' | asset_url | stylesheet_tag }}
<div class="ac-story" style="--ac-bg:{{ section.settings.background }};--ac-ink:{{ section.settings.text_color }}">
  {%- for block in section.blocks -%}
    <section id="ac-{{ block.id }}" class="ac-block ac-block--{{ block.type }}{% if block.settings.divider %} ac-block--divider{% endif %}" style="--ac-top:{{ block.settings.padding_top }}px;--ac-bottom:{{ block.settings.padding_bottom }}px;--ac-mobile-top:{{ block.settings.mobile_padding_top }}px;--ac-mobile-bottom:{{ block.settings.mobile_padding_bottom }}px" {{ block.shopify_attributes }} aria-label="{{ block.settings.heading | escape }}">
      <div class="page-width ac-shell">
        {% unless block.type == 'comparison' %}<h2 class="ac-heading" id="ac-title-{{ block.id }}">{{ block.settings.heading | escape }}</h2>{% endunless %}
        {%- case block.type -%}
          {%- when 'temperature' -%}
            <div class="ac-temperature">
              {%- assign layer_types = 'cooling,midweight,combined' | split: ',' -%}
              {%- for layer_type in layer_types -%}
                {%- assign image_key = layer_type | append: '_image' -%}
                {%- assign label_key = layer_type | append: '_label' -%}
                {%- assign bubble_key = layer_type | append: '_bubble' -%}
                <div class="ac-layer ac-layer--{{ layer_type }}">
                  <p class="ac-bubble">{{ block.settings[bubble_key] | escape }}</p>
                  <div class="ac-layer-media">
                    {% if block.settings[image_key] != blank %}{{ block.settings[image_key] | image_url: width: 720 | image_tag: widths: '180, 360, 540, 720', sizes: '(max-width: 767px) 152px, 227px', loading: 'lazy', decoding: 'async', alt: block.settings[label_key] }}{% endif %}
                  </div>
                  <h3 class="ac-layer-label">{{ block.settings[label_key] | escape }}</h3>
                </div>
                {%- if forloop.index == 1 -%}<span class="ac-equation" aria-hidden="true">+</span>{%- elsif forloop.index == 2 -%}<span class="ac-equation ac-equation--equals" aria-hidden="true">=</span>{%- endif -%}
              {%- endfor -%}
            </div>
          {%- when 'seasons' -%}
            <div class="ac-scroll" tabindex="0" role="region" aria-labelledby="ac-title-{{ block.id }}" aria-describedby="ac-hint-{{ block.id }}">
              <p id="ac-hint-{{ block.id }}" class="ac-screenreader">{{ block.settings.scroll_hint | escape }}</p>
              <ul class="ac-track" role="list">
                {%- for i in (1..4) -%}
                  {%- assign image_key = 'image_' | append: i -%}{%- assign label_key = 'label_' | append: i -%}
                  <li class="ac-card ac-season-card">
                    {% if block.settings[image_key] != blank %}{{ block.settings[image_key] | image_url: width: 800 | image_tag: widths: '286, 400, 572, 680, 800', sizes: '(max-width: 767px) min(85vw, 340px), (min-width: 1536px) 310px, 25vw', loading: 'lazy', decoding: 'async', alt: block.settings[label_key] }}{% endif %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'lifestyle' -%}
            <div class="ac-scroll" tabindex="0" role="region" aria-labelledby="ac-title-{{ block.id }}" aria-describedby="ac-hint-{{ block.id }}">
              <p id="ac-hint-{{ block.id }}" class="ac-screenreader">{{ block.settings.scroll_hint | escape }}</p>
              <ul class="ac-track" role="list">
                {%- for i in (1..4) -%}
                  {%- assign image_key = 'image_' | append: i -%}{%- assign label_key = 'caption_' | append: i -%}
                  <li class="ac-card ac-life-card">
                    <div class="ac-life-photo">{% if block.settings[image_key] != blank %}{{ block.settings[image_key] | image_url: width: 800 | image_tag: widths: '286, 400, 572, 680, 800', sizes: '(max-width: 767px) min(85vw, 340px), (min-width: 1536px) 310px, 25vw', loading: 'lazy', decoding: 'async', alt: block.settings[label_key] }}{% endif %}</div>
                    <h3 class="ac-life-caption"><span>{{ block.settings[label_key] | escape }}</span></h3>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'comparison' -%}
            <div class="ac-scroll ac-scroll--comparison" tabindex="0" role="region" aria-label="{{ block.settings.heading | escape }}" aria-describedby="ac-hint-{{ block.id }}">
              <p id="ac-hint-{{ block.id }}" class="ac-screenreader">{{ block.settings.scroll_hint | escape }}</p>
              <div class="ac-compare-frame">
                <div class="ac-compare-panel" aria-hidden="true"></div><div class="ac-compare-highlight" aria-hidden="true"></div><div class="ac-compare-rules" aria-hidden="true"></div>
                <table class="ac-compare-table">
                  <caption class="ac-screenreader">{{ block.settings.heading | escape }}</caption>
                  <colgroup><col class="ac-feature-col"><col class="ac-brand-col"><col></colgroup>
                  <thead><tr><td></td><th scope="col">{{ block.settings.brand_name | escape }}{% if block.settings.brand_image != blank %}{{ block.settings.brand_image | image_url: width: 360 | image_tag: widths: '120, 240, 360', sizes: '(max-width: 767px) 76px, 120px', loading: 'lazy', decoding: 'async', alt: block.settings.brand_name }}{% endif %}</th><th scope="col">{{ block.settings.other_name | escape }}{% if block.settings.other_image != blank %}{{ block.settings.other_image | image_url: width: 360 | image_tag: widths: '120, 240, 360', sizes: '(max-width: 767px) 76px, 120px', loading: 'lazy', decoding: 'async', alt: block.settings.other_name }}{% endif %}</th></tr></thead>
                  <tbody>
                    {% for i in (1..4) %}{% assign label_key = 'feature_' | append: i %}{% assign brand_key = 'brand_' | append: i %}{% assign other_key = 'other_' | append: i %}
                      <tr><th scope="row">{{ block.settings[label_key] | escape | newline_to_br }}</th>
                      {% if i < 3 %}<td aria-label="{{ block.settings.brand_rating_label | escape }}"><span aria-hidden="true">★★★<span class="ac-star-break">★★</span></span></td><td aria-label="{{ block.settings.other_rating_label | escape }}"><span aria-hidden="true">★★</span></td>
                      {% else %}<td>{{ block.settings[brand_key] | escape | replace: ', ', ', <wbr>' }}</td><td>{{ block.settings[other_key] | escape | replace: ', ', ', <wbr>' }}</td>{% endif %}</tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
        {%- endcase -%}
      </div>
    </section>
  {%- endfor -%}
</div>

