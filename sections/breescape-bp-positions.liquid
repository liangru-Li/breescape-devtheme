{{ 'breescape-bodypillow.css' | asset_url | stylesheet_tag }}
<div id="bodypillow-{{ section.id }}" class="breescape-bp{% unless section.settings.show_divider %} bp-no-divider{% endunless %}" style="--bp-bg: {{ section.settings.background }};--bp-text: {{ section.settings.text_color }};--bp-width: {{ section.settings.content_width }}px;--bp-top: {{ section.settings.padding_top }};--bp-bottom: {{ section.settings.padding_bottom }};--bp-side: {{ section.settings.padding_horizontal }};--bp-mobile-top: {{ section.settings.mobile_padding_top }};--bp-mobile-bottom: {{ section.settings.mobile_padding_bottom }};--bp-mobile-side: {{ section.settings.mobile_padding_horizontal }};--bp-heading-size: {{ section.settings.heading_size }};--bp-mobile-heading-size: {{ section.settings.mobile_heading_size }};--bp-heading-align: {{ section.settings.heading_alignment }};--bp-mobile-heading-align: {{ section.settings.mobile_heading_alignment }};--bp-heading-gap: {{ section.settings.heading_gap }};--bp-mobile-heading-gap: {{ section.settings.mobile_heading_gap }};--bp-card-color: {{ section.settings.card_background }};--bp-columns: {{ section.settings.desktop_columns }};--bp-gap: {{ section.settings.card_gap }};--bp-card-mobile-width: {{ section.settings.mobile_card_width }};--bp-card-title-size: {{ section.settings.card_title_size }};--bp-card-description-size: {{ section.settings.card_description_size }}"><div class="bp-shell">
<section class="bp-section bp-poses" aria-labelledby="bp-heading-{{ section.id }}"><h2 id="bp-heading-{{ section.id }}" class="bp-heading">{{ section.settings.heading | escape }}</h2>{% assign selected_card_color = section.settings.card_background | color_to_hex %}
<div class="bp-track" tabindex="0" role="list" aria-labelledby="bp-heading-{{ section.id }}">
{% for block in section.blocks %}{% liquid
 assign card_image = block.settings.image
 assign card_source = ''
 if card_image != blank
   assign card_source = card_image | image_url: width: 1200
 endif
 assign card_alt = block.settings.image_alt | default: block.settings.title
%}
<article class="bp-card{% unless selected_card_color == '#c4e6ea' %} bp-custom-card{% endunless %}" role="listitem" {{ block.shopify_attributes }}><div class="bp-card-canvas"><div class="bp-card-decoration"><img src="https://cdn.shopify.com/s/files/1/0640/6779/7070/files/body-pillow-ca74d.svg?v=1791868977" class="bp-card-background" width="284.143" height="310.143" alt="" loading="lazy" decoding="async"></div><div class="bp-card-media"><div class="bp-photo-canvas">{% if card_image != blank %}
{% if block.settings.image_fit == 'original' %}
{% if card_source contains 'body-pillow-8d5e5' or card_source contains 'body-pillow-7c5a1' or card_source contains 'body-pillow-3a4a3' or card_source contains 'body-pillow-9711a' %}<div class="bp-rotated-photo"><div class="bp-rotated-inner">{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 767px) 74vw, (max-width: 1535px) 25vw, 320px', class: 'bp-rotated-image', alt: card_alt, loading: 'lazy', decoding: 'async' }}</div></div>
{% elsif card_source contains 'body-pillow-d297e' %}<div class="bp-lean-photo">{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 767px) 74vw, (max-width: 1535px) 25vw, 320px', class: 'bp-lean-image', alt: card_alt, loading: 'lazy', decoding: 'async' }}</div>
{% elsif card_source contains 'body-pillow-388ad' %}<div class="bp-lean-photo">{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 767px) 74vw, (max-width: 1535px) 25vw, 320px', class: 'bp-lean-image bp-bonus-cover-image', alt: card_alt, loading: 'lazy', decoding: 'async' }}</div>
{% elsif card_source contains 'body-pillow-9578a' %}<div class="bp-between-photo">{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 767px) 74vw, (max-width: 1535px) 25vw, 320px', class: 'bp-between-image', alt: card_alt, loading: 'lazy', decoding: 'async' }}</div>
{% elsif card_source contains 'body-pillow-66395' %}<div class="bp-rotated-photo"><div class="bp-rotated-inner"><img src="https://cdn.shopify.com/s/files/1/0640/6779/7070/files/body-pillow-01089-optimized.webp?v=1791963633" class="bp-rotated-image" width="446" height="622" alt="" loading="lazy" decoding="async"></div></div><div class="bp-silky-photo">{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 767px) 74vw, (max-width: 1535px) 25vw, 320px', class: 'bp-silky-image', alt: card_alt, loading: 'lazy', decoding: 'async' }}</div>
{% else %}<div class="bp-generic-photo bp-image-fit-{{ block.settings.image_fit }}">{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 767px) 74vw, (max-width: 1535px) 25vw, 320px', class: 'bp-generic-image', alt: card_alt, loading: 'lazy', decoding: 'async' }}</div>{% endif %}
{% else %}<div class="bp-generic-photo bp-image-fit-{{ block.settings.image_fit }}">{{ card_image | image_url: width: 1200 | image_tag: widths: '360, 600, 900, 1200', sizes: '(max-width: 767px) 74vw, (max-width: 1535px) 25vw, 320px', class: 'bp-generic-image', alt: card_alt, loading: 'lazy', decoding: 'async' }}</div>{% endif %}{% endif %}</div></div><div class="bp-caption"><h3 class="bp-card-title">{{ block.settings.title | escape }}</h3>{% if block.settings.description != blank %}<p class="bp-card-description">{{ block.settings.description | escape | newline_to_br }}</p>{% endif %}</div></div></article>
{% endfor %}</div></section>
</div></div>

{% schema %}
{
  "name": "Body Pillow 使用姿势",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Find Your Comfort, Your Way."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "标题字号（电脑）",
      "min": 18,
      "max": 64,
      "step": 1,
      "default": 44
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "标题字号（手机）",
      "min": 18,
      "max": 44,
      "step": 1,
      "default": 30
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "标题对齐（电脑）",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_heading_alignment",
      "label": "标题对齐（手机）",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        },
        {
          "value": "right",
          "label": "右对齐"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "background",
      "label": "板块背景色",
      "default": "#ededed"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#0f374b"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "内容最大宽度",
      "min": 960,
      "max": 1600,
      "step": 20,
      "default": 1280
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "顶部间距（电脑）",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "底部间距（电脑）",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "左右间距（电脑）",
      "min": 0,
      "max": 80,
      "step": 1,
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "顶部间距（手机）",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "底部间距（手机）",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_padding_horizontal",
      "label": "左右间距（手机）",
      "min": 0,
      "max": 48,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "标题下方间距（电脑）",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 37
    },
    {
      "type": "range",
      "id": "mobile_heading_gap",
      "label": "标题下方间距（手机）",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "显示顶部细线",
      "default": true
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "卡片背景色",
      "default": "#c4e6ea"
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "卡片列数（电脑）",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "卡片间距",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_card_width",
      "label": "卡片宽度（手机）",
      "min": 220,
      "max": 340,
      "step": 2,
      "default": 286
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "卡片标题字号",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "card_description_size",
      "label": "卡片说明字号",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 14
    }
  ],
  "presets": [
    {
      "name": "Body Pillow 使用姿势"
    }
  ],
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "blocks": [
    {
      "type": "card",
      "name": "图片卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "Comfort"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "说明"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "图片说明"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "图片显示方式",
          "options": [
            {
              "value": "original",
              "label": "保持原图布局"
            },
            {
              "value": "cover",
              "label": "填满图片区域"
            },
            {
              "value": "contain",
              "label": "完整显示图片"
            }
          ],
          "default": "original"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}

