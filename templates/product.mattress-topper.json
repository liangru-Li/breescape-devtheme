            "liquid": "<div class=\"w-full max-w-md mx-auto\">\n  <div class=\"flex gap-4 rounded-xl w-full items-stretch\" style=\"padding: 8px 0;border-bottom: 1px solid #eee;\">\n    <div class=\"s-solution-comparison-card relative overflow-hidden rounded-lg\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/71rs0O5P2vL.jpg?v=1785474990\"\n        alt=\"The mattress topper has arrived. It’s beautiful and came with really nice packaging.\"\n        class=\"s-solution-comparison-card__img w-full m-0 rounded-lg\"\n        loading=\"lazy\">\n    </div>\n\n    <div class=\"flex flex-col flex-1 py-2\">\n      <div class=\"review-content flex flex-col justify-between h-full\">\n        <div class=\"stars grid grid-4\">\n          {%- render 'icon', icon: '5reviews', size: 'custom', class: 'shawn__product-card__rating__icon' -%}\n          <span class=\"review-text text-md py-2\">\n            \"It’s beautiful and came with really nice packaging. It opens easily, feels comfortable on the bed with just the right softness and firmness. Can’t wait to have a great night’s sleep!\"\n          </span>\n        </div>\n        <div class=\"text-sm font-medium flex items-center\">\n          Helen L.\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"flex gap-4 rounded-xl w-full items-stretch\" style=\"padding: 8px 0;border-bottom: 1px solid #eee;\">\n    <div class=\"s-solution-comparison-card relative overflow-hidden rounded-lg\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/71HVYKOC2uL.jpg?v=1785474731\"\n        alt=\"This mattress is excellent.\"\n        class=\"s-solution-comparison-card__img w-full m-0 rounded-lg\"\n        loading=\"lazy\">\n    </div>\n\n    <div class=\"flex flex-col flex-1 py-2\">\n      <div class=\"review-content flex flex-col justify-between h-full\">\n        <div class=\"stars grid grid-4\">\n          {%- render 'icon', icon: '5reviews', size: 'custom', class: 'shawn__product-card__rating__icon' -%}\n          <span class=\"review-text text-md py-2\">\n            \"This mattress is excellent. It feels cool, soft, and supportive at the same time. I had already tried Breescape sheets and pillows before, and this mattress made me like the brand even more. My whole family loves it.\"\n          </span>\n        </div>\n        <div class=\"text-sm font-medium flex items-center\">\n          Ian M.\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"flex gap-4 rounded-xl w-full items-stretch\" style=\"padding: 8px 0;\">\n    <div class=\"s-solution-comparison-card relative overflow-hidden rounded-lg\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/original_1.webp?v=1785474731\"\n        alt=\"Doesn’t sag and has just the right amount of bounce.\"\n        class=\"s-solution-comparison-card__img w-full m-0 rounded-lg\"\n        loading=\"lazy\">\n    </div>\n\n    <div class=\"flex flex-col flex-1 py-2\">\n      <div class=\"review-content flex flex-col justify-between h-full\">\n        <div class=\"stars grid grid-4\">\n          {%- render 'icon', icon: '5reviews', size: 'custom', class: 'shawn__product-card__rating__icon' -%}\n          <span class=\"review-text text-md py-2\">\n            \"Doesn’t sag and has just the right amount of bounce. After work I just want to crash on it—super comfortable. The surface feels cool to the touch too, really relaxing.\"\n          </span>\n        </div>\n        <div class=\"text-sm font-medium flex items-center\">\n          Katrina M.\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <button\n    class=\"button button--secondary button--md w-full s--button--product--reviews\"\n    style=\"color: rgb(var(--color-button-background));\">\n    Read All Reviews\n  </button>\n\n  <style>\n    .s--button--product--reviews:hover {\n      background-size: 0% 1px !important;\n    }\n\n    .s-solution-comparison-card {\n      flex: 0 0 25%;\n      max-width: 120px;\n      overflow: hidden;\n      border-radius: 10px;\n      aspect-ratio: 3 / 4;\n    }\n\n    .s-solution-comparison-card__img {\n      display: block;\n      width: 100%;\n      height: 100%;\n      margin-block: 0 !important;\n      object-fit: cover;\n      border-radius: inherit;\n    }\n  </style>\n</div>",
            "text_size": "text-base"
          }
