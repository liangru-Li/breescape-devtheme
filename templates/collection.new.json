or 0.22s ease;\n  }\n\n  .xo__feature-tabs .xo__tab-item:hover {\n    background: rgba(255, 255, 255, 0.45);\n    color: #24475a;\n  }\n\n  .xo__feature-tabs .xo__tab-item.xo__is-active {\n    background: #ffffff;\n    color: #17394a;\n    box-shadow:\n      0 2px 12px rgba(23, 57, 74, 0.13),\n      0 1px 3px rgba(23, 57, 74, 0.07);\n  }\n\n  .xo__feature-tabs .xo__tab-icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n  }\n\n  .xo__feature-tabs .xo__tab-icon img {\n    display: block;\n    width: 28px;\n    height: 28px;\n    object-fit: contain;\n    opacity: 0.7;\n    transition: opacity 0.22s ease;\n  }\n\n  .xo__feature-tabs .xo__tab-item.xo__is-active .xo__tab-icon img,\n  .xo__feature-tabs .xo__tab-item:hover .xo__tab-icon img {\n    opacity: 1;\n  }\n\n  .xo__feature-tabs .xo__tab-text {\n    font-size: 19px;\n    line-height: 1.2;\n    white-space: nowrap;\n    color: inherit;\n    letter-spacing: -0.01em;\n  }\n\n  .xo__feature-tabs .xo__tab-item.xo__is-active .xo__tab-text {\n    font-weight: 700;\n  }\n\n  @media screen and (max-width: 767px) {\n    .xo__feature-tabs {\n      max-width: 300px;\n      margin: 0 auto;\n      border-radius: 24px;\n      padding: 5px;\n      gap: 4px;\n    }\n\n    .xo__feature-tabs .xo__tab-item {\n      min-height: 110px;\n      padding: 16px 10px;\n      flex-direction: column;\n      gap: 8px;\n      border-radius: 20px;\n    }\n\n    .xo__feature-tabs .xo__tab-icon img {\n      width: 40px;\n      height: 40px;\n    }\n\n    .xo__feature-tabs .xo__tab-text {\n      font-size: 16px;\n      white-space: normal;\n      text-align: center;\n    }\n  }\n</style>",
