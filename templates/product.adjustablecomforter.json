     c: document.getElementById('contentC')\n    };\n\n    const buttons = {\n        a: document.getElementById('buttonA'),\n        b: document.getElementById('buttonB'),\n        c: document.getElementById('buttonC')\n    };\n\n    const slider = document.getElementById('contentSlider');\n\n    function showContent(side, scroll = true) {\n        Object.keys(buttons).forEach(key => {\n            if (key === side) {\n                buttons[key].classList.add('bg-yellow-400', 'text-black');\n                buttons[key].classList.remove('bg-white');\n            } else {\n                buttons[key].classList.remove('bg-yellow-400');\n                buttons[key].classList.add('bg-white', 'text-black');\n            }\n        });\n\n        if (window.innerWidth > 768) {\n            Object.keys(contents).forEach(key => {\n                if (key === side) {\n                    contents[key].classList.remove('hidden');\n                } else {\n                    contents[key].classList.add('hidden');\n                }\n            });\n        }\n\n        if (scroll && window.innerWidth <= 768) {\n            const contentElement = contents[side];\n\n            setTimeout(() => {\n                contentElement.scrollIntoView({\n                    behavior: 'smooth',\n                    inline: 'center',\n                    block: 'nearest'\n                });\n            }, 50);\n        }\n    }\n\n    \/\/ (mobile only)\n    if (window.innerWidth <= 768) {\n        let isScrolling;\n        slider.addEventListener('scroll', () => {\n\n            clearTimeout(isScrolling);\n\n\n            isScrolling = setTimeout(() => {\n                const sliderRect = slider.getBoundingClientRect();\n                let activeSide = 'a';\n\n                Object.keys(contents).forEach(side => {\n                    const content = contents[side];\n                    const contentRect = content.getBoundingClientRect();\n                    const contentCenter = contentRect.left + contentRect.width \/ 2;\n                    const sliderCenter = sliderRect.left + sliderRect.width \/ 2;\n\n\n                    if (Math.abs(contentCenter - sliderCenter) < contentRect.width \/ 2) {\n                        activeSide = side;\n                    }\n                });\n\n\n                showContent(activeSide, false);\n            }, 100);\n        });\n    }\n\n\n   \/\/ 初始加载时不触发滚动\ndocument.addEventListener('DOMContentLoaded', () => showContent('a', false, false));\n\n\/\/ 按钮点击时触发滚动\nbuttons['a'].addEventListener('click', () => showContent('a', true, true));\nbuttons['b'].addEventListener('click', () => showContent('b', true, true));\nbuttons['c'].addEventListener('click', () => showContent('c', true, true));\n<\/script>","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":0,"padding_bottom":0,"divider":false,"narrow":false,"rounded":false}},"faq_Fb7GVR":{"type":"faq","blocks":{"question_ac_1":{"type":"question","settings":{"title":"Will Breescape Adjustable All Season Comforter actually regulate my temperature?","text":"<p>Yes. Breescape is designed with a dual-layer system: the light cooling layer pulls heat and moisture away to keep you cool when you feel overheated, while the mid-wieght warm layer traps warmth when you feel chilly. Zip together for extra warmth when you feel cold. Whether you run hot, cold, or fluctuate, it balances your body temperature for uninterrupted sleep.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_ac_2":{"type":"question","settings":{"title":"How is the comforter different from others?","text":"<p>Unlike traditional winter comforters, this comforter features a versatile 2-in-1 design for customizable warmth year-round. Enjoy lightweight cooling in summer, midweight comfort in spring and fall, or extra warmth in winter. One comforter, three ways to customize your comfort, and no need to switch comforters with the seasons. More versatility, better value.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_ac_3":{"type":"question","settings":{"title":"Is it good for couples who sleep differently?","text":"<p>Yes. Each layer can be used separately or together, so it adapts to different sleep temperatures. One person sleeps hot, one sleeps cold? Breescape covers both.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_ac_4":{"type":"question","settings":{"title":"Do I need a duvet cover with this?","text":"<p>Nope. Breescape has a built-in duvet-style shell, so you get the clean, lived-in look without the stuffing or shifting.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_ac_5":{"type":"question","settings":{"title":"Is it good for sensitive skin?","text":"<p>Yes. Breescape is made with OEKO-TEX® certified fabrics that are hypoallergenic and safe for sensitive skin.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_ac_6":{"type":"question","settings":{"title":"Can I return it if I don’t love it?","text":"<p>Yes. You have a 30-night return period.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question_ac_1","question_ac_2","question_ac_3","question_ac_4","question_ac_5","question_ac_6"],"name":"FAQ","settings":{"style":"with-border","heading":"FAQs","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"rgba(0,0,0,0)","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":