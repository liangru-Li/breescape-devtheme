    "custom_liquid_rFzNQR": {
      "type": "custom-liquid",
      "settings": {
        "liquid": "<script>\n    const contents = {\n        a: document.getElementById('contentA'),\n        b: document.getElementById('contentB'),\n        c: document.getElementById('contentC')\n    };\n\n    const buttons = {\n        a: document.getElementById('buttonA'),\n        b: document.getElementById('buttonB'),\n        c: document.getElementById('buttonC')\n    };\n\n    const slider = document.getElementById('contentSlider');\n\n    function showContent(side, scroll = true) {\n        Object.keys(buttons).forEach(key => {\n            if (key === side) {\n                buttons[key].classList.add('bg-yellow-400', 'text-black');\n                buttons[key].classList.remove('bg-white');\n            } else {\n                buttons[key].classList.remove('bg-yellow-400');\n                buttons[key].classList.add('bg-white', 'text-black');\n            }\n        });\n\n        if (window.innerWidth > 768) {\n            Object.keys(contents).forEach(key => {\n                if (key === side) {\n                    contents[key].classList.remove('hidden');\n                } else {\n                    contents[key].classList.add('hidden');\n                }\n            });\n        }\n\n        if (scroll && window.innerWidth <= 768) {\n            const contentElement = contents[side];\n\n            setTimeout(() => {\n                contentElement.scrollIntoView({\n                    behavior: 'smooth',\n                    inline: 'center',\n                    block: 'nearest'\n                });\n            }, 50);\n        }\n    }\n\n    // (mobile only)\n    if (window.innerWidth <= 768) {\n        let isScrolling;\n        slider.addEventListener('scroll', () => {\n\n            clearTimeout(isScrolling);\n\n\n            isScrolling = setTimeout(() => {\n                const sliderRect = slider.getBoundingClientRect();\n                let activeSide = 'a';\n\n                Object.keys(contents).forEach(side => {\n                    const content = contents[side];\n                    const contentRect = content.getBoundingClientRect();\n                    const contentCenter = contentRect.left + contentRect.width / 2;\n                    const sliderCenter = sliderRect.left + sliderRect.width / 2;\n\n\n                    if (Math.abs(contentCenter - sliderCenter) < contentRect.width / 2) {\n                        activeSide = side;\n                    }\n                });\n\n\n                showContent(activeSide, false);\n            }, 100);\n        });\n    }\n\n\n   // 初始加载时不触发滚动\ndocument.addEventListener('DOMContentLoaded', () => showContent('a', false, false));\n\n// 按钮点击时触发滚动\nbuttons['a'].addEventListener('click', () => showContent('a', true, true));\nbuttons['b'].addEventListener('click', () => showContent('b', true, true));\nbuttons['c'].addEventListener('click', () => showContent('c', true, true));\n</script>",
