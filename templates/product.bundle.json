    "custom_liquid_RmPqA6": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Custom Liquid",
      "settings": {
        "liquid": "<style>\n    .s--sides--side {\n        flex: 1;\n        display: flex;\n        align-items: center;\n    }\n\n    .s--sides--icon {\n        text-align: center;\n        display: flex;\n        flex-direction: row;\n        gap: var(--sp-2);\n        justify-content: center;\n        align-items: center;\n    }\n\n    .s--sides--icon span {\n        font-size: 2em;\n        display: block;\n    }\n\n    .s--sides--icon p {\n        font-size: 1em;\n        color: #1a3c5e;\n        margin: 0;\n    }\n\n    .s--sides--center-image img {\n        max-width: 100%;\n        height: auto;\n    }\n\n    /* Style for the letters 'a' and 'c' */\n    .letter {\n        position: absolute;\n        font-size: 16px;\n        font-weight: bold;\n        color: #1a3c5e;\n        background-color: rgba(255, 255, 255, 0.7);\n        border-radius: 50%;\n        width: 24px;\n        height: 24px;\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        cursor: pointer;\n        user-select: none;\n    }\n\n    /* Position for letter 'a' */\n    .letter-a {\n        top: 40%;\n        left: 20%;\n    }\n\n    /* Position for letter 'c' */\n    .letter-c {\n        top: 45%;\n        right: 20%;\n    }\n\n    /* Bold style for highlighted state */\n    .highlight-bold {\n        font-weight: bold !important;\n    }\n\n    /* Yellow background for highlighted letters */\n    .letter.highlight-bold {\n        background: #fffb79 !important;\n    }\n\n    /* Default style (normal weight) */\n    .default-style {\n        font-weight: normal !important;\n    }\n</style>\n\n<div class=\"s--sides--container\">\n    <div class=\"flex justify-between md:flex-row flex-col\">\n        <div class=\"s--sides--side left md:w-1/4 justify-start md:justify-center\">\n            <div class=\"s--sides--icon\">\n                <span class=\"snowflake\">{%- render 'icon', icon: 'cool-touch', size: 'xl' -%}</span>\n                <p id=\"tech-cooling\" class=\"md:text-xl text-base default-style\">Tech-Enhanced Cooling</p>\n            </div>\n        </div>\n        <div class=\"s--sides--center-image flex justify-center relative md:w-1/2\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/product-comforter-two-sides-image-lg-202504.png?v=1745579245\"\n                alt=\"Fabric Image\">\n            <span id=\"letter-c\" class=\"letter letter-c default-style\" onclick=\"highlight('c')\">a</span>\n            <span id=\"letter-a\" class=\"letter letter-a default-style\" onclick=\"highlight('a')\">c</span>\n        </div>\n        <div class=\"s--sides--side right md:w-1/4 justify-end md:justify-center\">\n            <div class=\"s--sides--icon\">\n                <span class=\"network\">{%- render 'icon', icon: 'moisture-wicking', size: 'xl' -%}</span>\n                <p id=\"natural-cooling\" class=\"md:text-xl text-base default-style\">Natural Cooling</p>\n            </div>\n        </div>\n    </div>\n</div>\n\n<script>\n    function highlight(letter) {\n        const letterA = document.getElementById('letter-a');\n        const letterC = document.getElementById('letter-c');\n        const techCooling = document.getElementById('tech-cooling');\n        const naturalCooling = document.getElementById('natural-cooling');\n\n        if (letter === 'a') {\n            // Highlight 'a' and 'Tech-Enhanced Cooling' with bold\n            letterA.classList.remove('default-style');\n            letterA.classList.add('highlight-bold');\n            techCooling.classList.remove('default-style');\n            techCooling.classList.add('highlight-bold');\n\n            // Reset 'c' and 'Natural Cooling' to default\n            letterC.classList.remove('highlight-bold');\n            letterC.classList.add('default-style');\n            naturalCooling.classList.remove('highlight-bold');\n            naturalCooling.classList.add('default-style');\n        } else if (letter === 'c') {\n            // Highlight 'c' and 'Natural Cooling' with bold\n            letterC.classList.remove('default-style');\n            letterC.classList.add('highlight-bold');\n            naturalCooling.classList.remove('default-style');\n            naturalCooling.classList.add('highlight-bold');\n\n            // Reset 'a' and 'Tech-Enhanced Cooling' to default\n            letterA.classList.remove('highlight-bold');\n            letterA.classList.add('default-style');\n            techCooling.classList.remove('highlight-bold');\n            techCooling.classList.add('default-style');\n        }\n    }\n</script>",
