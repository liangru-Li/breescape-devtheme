            "custom_liquid_bG3pU4": {
              "type": "custom-liquid",
              "name": "t:sections.custom-liquid.name",
              "settings": {
                "liquid": "<div class=\"relative bg-gray-100 s__expert-page__blendtek__table__content w-full\">\n    <div class=\"s__expert-page__blendtek__table w-full\">\n        <div class=\"flex\">\n            <div class=\"shawn-tb__col\">\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">Feature\n                    </div>\n\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">Cooler to\n                        the Touch\n                    </div>\n\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">More\n                        Breathable <br>(vs. Cotton)\n\n                    </div>\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">More\n                        Moisture-Wicking <br>(vs. Cotton)</div>\n                </div>\n\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">Larger\n\n                    </div>\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">More\n                        Advanced</div>\n\n                </div>\n            </div>\n            <div class=\"shawn-tb__col\">\n                <div\n                    class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4 bg-highlight text-xl font-bold text-white\">\n                    <div class=\"text-left lg:text-lg text-base font-medium\">Breescape</div>\n                </div>\n                <div\n                    class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4 bg-highlight text-white\">\n                    <div class=\"flex flex-col items-start justify-center self-auto gap-2\">\n\n                        <div class=\"text-left lg:text-lg md:text-base text-sm font-medium\">\n                            Q-Max 0.46</div>\n\n                    </div>\n                </div>\n                <div\n                    class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4 bg-highlight text-white\">\n                    <div class=\"flex flex-col items-start justify-center self-auto gap-2\">\n\n                        <div class=\"text-left lg:text-lg md:text-base text-sm font-medium\">\n                            4.5X</div>\n                    </div>\n                </div>\n                <div\n                    class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4 bg-highlight text-white\">\n                    <div class=\"flex flex-col items-start justify-center self-auto gap-2\">\n\n                        <div class=\"text-left lg:text-lg md:text-base text-sm font-medium\">\n                            1.5X</div>\n                    </div>\n                </div>\n                <div\n                    class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4 bg-highlight text-white\">\n                    <div class=\"flex flex-col items-start justify-center self-auto gap-2\">\n\n                        <div class=\"text-left lg:text-lg md:text-base text-sm font-medium\">\n                            13.8% Larger</div>\n                    </div>\n                </div>\n                <div\n                    class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4 bg-highlight text-white\">\n                    <div class=\"flex flex-col items-start justify-center self-auto gap-2\">\n\n                        <div class=\"text-left lg:text-lg md:text-base text-sm font-medium\">\n                            1 Year of R&D, 23 Iterations </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"shawn-tb__col\">\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">\n                        Others\n                    </div>\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">\n                        Q-Max 0.4\n                    </div>\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">\n                        0.29X\n                    </div>\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">\n                        0.9X\n                    </div>\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">\n                        Standard\n                    </div>\n                </div>\n                <div class=\"flex flex-col items-start justify-center self-auto border-b border-gray-200 py-4 px-4\">\n                    <div class=\"text-left lg:text-lg md:text-base text-sm\">\n                        /\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>\n\n<style>\n    .s__expert-page__blendtek__table__content {\n        border-radius: var(--rounded-block);\n        background: #f3f3f3;\n    }\n\n\n    .shawn-tb__col:first-child {\n        padding: 60px 0px 60px 0px;\n    }\n\n\n    .shawn-tb__col:nth-child(2) {\n        padding: 60px 0px;\n        background-color: rgb(var(--color-base-highlight));\n        border-radius: var(--rounded-block);\n    }\n\n    .shawn-tb__col:nth-child(3) {\n        padding: 60px 0px 60px 0px;\n    }\n\n    .shawn-tb__col:nth-child(3)>div {\n        padding-left: 30px;\n    }\n\n    .bg-highlight {\n        background-color: rgb(var(--color-base-highlight));\n    }\n\n    .text-white {\n        color: #fff\n    }\n\n    @media screen and (min-width: 768px) {\n        .shawn-tb__col {\n            flex: 1;\n            display: grid;\n            grid-auto-rows: 1fr;\n            grid-auto-flow: row;\n        }\n\n        .shawn-tb__col>div {\n            height: 60px;\n        }\n\n        .shawn-tb__col:first-child>div {\n            padding-left: 60px;\n        }\n\n        .shawn-tb__col:nth-child(3)>div {\n            padding-left: 30px;\n        }\n\n    }\n\n    @media (max-width: 767px) {\n        .shawn-tb__col>div {\n            height: 60px;\n        }\n\n        .shawn-tb__col:first-child {\n            padding: 20px 0;\n        }\n\n        .shawn-tb__col:nth-child(2) {\n            padding: 20px 0;\n        }\n\n        .shawn-tb__col:nth-child(3) {\n            padding: 20px 0;\n        }\n\n        .shawn-tb__col:first-child>div {\n            width: 140px;\n            padding: 10px 15px;\n        }\n\n        .shawn-tb__col:nth-child(2)>div {\n            width: 110px;\n            padding: 10px 15px;\n        }\n\n        .shawn-tb__col:nth-child(3)>div {\n            width: 85px;\n            padding: 10px 15px;\n        }\n    }\n</style>"
