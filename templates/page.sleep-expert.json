    "custom_liquid_TNyMfK": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.name",
      "settings": {
        "liquid": "<div class=\"be-cool\" role=\"region\" aria-label=\"Staying Cool at Night Shouldn't Be a Struggle\">\n  <div class=\"be-cool__inner\">\n    <h2 class=\"be-cool__title\">\n      Staying Cool at Night Shouldn&rsquo;t<br class=\"be-cool__br-pc\"> Be a Struggle\n    </h2>\n    <p class=\"be-cool__text\">\n      Most cooling fabrics lose their effectiveness too quickly, trap heat, or wear out over time. We&rsquo;re dedicated to creating something that truly works. It&rsquo;s not just about feeling cool for a moment&mdash;it&rsquo;s about staying comfortable for uninterrupted sleep all night long.\n    </p>\n  </div>\n</div>\n\n<style>\n  .be-cool,\n  .be-cool *,\n  .be-cool *::before,\n  .be-cool *::after { box-sizing: border-box; }\n\n  /* 用 100vw + 负边距突破父级 .page-width 的 padding-inline，\n     让本区域始终铺满整屏宽 */\n  .be-cool {\n    position: relative;\n    width: 100vw;\n    max-width: 100vw;\n    margin-left: calc(50% - 50vw);\n    margin-right: calc(50% - 50vw);\n    background-image: url(\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/group11.jpg?v=1777368622\");\n    background-repeat: no-repeat;\n    background-position: center center;\n    background-size: cover;\n    /* PC 背景图比例（按 Figma 1920×884） */\n    aspect-ratio: 1920 / 884;\n    color: #10374B;\n    font-family: Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  }\n\n  /* 内容浮层：一个严格 1516×520 比例的透明虚拟框，绝对居中\n     在背景图里的白色面板上；内部用 flex 让标题 + 正文垂直居中\n     PC 比例：1516/1920 = 79.17% 宽 / 520/884 = 58.82% 高 */\n  .be-cool__inner {\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%);\n    width: 79.17%;\n    height: 58.82%;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    text-align: center;\n    /* 透明（隐藏但存在），仅做布局参考 */\n  }\n\n  /* ---- 标题（PC 端）：仅设 italic / letter-spacing / 颜色 / 居中宽度\n     字体 / 字重 / 字号 / 行高 全部跟随主题 H2 默认 ---- */\n  .be-cool .be-cool__title {\n    margin: 0 auto !important;\n    max-width: 1442px;\n    font-style: italic !important;\n    letter-spacing: -0.02em !important;\n    color: #10374B !important;\n  }\n\n  /* ---- 正文（PC 端）：font-size 20 / line-height 43 / letter-spacing 0.01em\n     字体 / 字重 跟随主题 ---- */\n  .be-cool .be-cool__text {\n    margin: 33px auto 0 !important;\n    max-width: 1311px;\n    font-size: 20px !important;\n    line-height: 43px !important;\n    letter-spacing: 0.01em !important;\n    color: #10374B !important;\n  }\n\n  /* ---------- 移动端 ---------- */\n  @media (max-width: 768px) {\n    .be-cool {\n      /* 移动端换图，比例按移动端 Figma（标题 top 106 / 容器约 430 宽）估算 */\n      background-image: url(\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/grou1.jpg?v=1777368622\");\n      aspect-ratio: 430 / 475;\n    }\n\n    /* 移动端虚拟框：311×205，绝对居中\n       移动比例：311/430 = 72.33% 宽 / 205/475 = 43.16% 高 */\n    .be-cool__inner {\n      width: 72.33%;\n      height: 43.16%;\n    }\n\n    /* 移动端隐藏 PC 用的强制换行，靠 max-width 自然折行 */\n    .be-cool .be-cool__br-pc { display: none; }\n\n    /* 标题：Gill Sans 600 SemiBold Italic / 28 / 32 / -2%\n       max-width 332 让 \"Staying Cool at Night / Shouldn't Be a Struggle\" 自然换两行 */\n    .be-cool .be-cool__title {\n      max-width: 332px;\n      font-size: 28px !important;\n      line-height: 32px !important;\n      letter-spacing: -0.02em !important;\n    }\n\n    /* 正文：Inter 300 Light / 10 / 14 / 0.5%；与标题底部间距 13px（按 Figma） */\n    .be-cool .be-cool__text {\n      max-width: 272px;\n      margin-top: 13px !important;\n      font-size: 10px !important;\n      line-height: 14px !important;\n      letter-spacing: 0.005em !important;\n    }\n  }\n</style>",
        "color_text": "",
        "color_background": "",
