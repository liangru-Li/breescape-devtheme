            "liquid": "<div class=\"be-ctww\">\n  <h2 class=\"be-ctww__title\">Breescape: Cooling That Truly Works</h2>\n  <p class=\"be-ctww__desc\">\n    Our advanced BlendTek&trade; technology helps regulate your body temperature, so you can fall\n    asleep faster, stay asleep longer, and wake up refreshed from truly uninterrupted sleep.\n  </p>\n\n  <div class=\"be-ctww__table\" role=\"region\" aria-label=\"Cooling comparison\">\n    <!-- 外部标题行：无背景 -->\n    <div class=\"be-ctww__heads\">\n      <div class=\"be-ctww__head be-ctww__head--left\">Feature</div>\n      <div class=\"be-ctww__head be-ctww__head--right\">Others</div>\n    </div>\n\n    <!-- 白色圆角表格：只放左右两列数据 -->\n    <div class=\"be-ctww__card\">\n      <div class=\"be-ctww__row\">\n        <div class=\"be-ctww__cell be-ctww__cell--left\">Cooler to the Touch</div>\n        <div class=\"be-ctww__cell be-ctww__cell--right\">Q-Max 0.4</div>\n      </div>\n      <div class=\"be-ctww__row\">\n        <div class=\"be-ctww__cell be-ctww__cell--left\">More Breathable (vs. Cotton)</div>\n        <div class=\"be-ctww__cell be-ctww__cell--right\">0.29X</div>\n      </div>\n      <div class=\"be-ctww__row\">\n        <div class=\"be-ctww__cell be-ctww__cell--left\">More Moisture-Wicking (vs. Cotton)</div>\n        <div class=\"be-ctww__cell be-ctww__cell--right\">0.9X</div>\n      </div>\n      <div class=\"be-ctww__row\">\n        <div class=\"be-ctww__cell be-ctww__cell--left\">Larger</div>\n        <div class=\"be-ctww__cell be-ctww__cell--right\">Standard</div>\n      </div>\n      <div class=\"be-ctww__row\">\n        <div class=\"be-ctww__cell be-ctww__cell--left\">More Advanced</div>\n        <div class=\"be-ctww__cell be-ctww__cell--right\">/</div>\n      </div>\n    </div>\n\n    <!-- 中间蓝色高亮列：绝对定位，覆盖在上方 -->\n    <div class=\"be-ctww__highlight\" aria-label=\"Breescape\">\n      <div class=\"be-ctww__highlight-head\">Breescape</div>\n      <div class=\"be-ctww__highlight-list\">\n        <div>Q-Max 0.46</div>\n        <div>4.5X</div>\n        <div>1.4X</div>\n        <div>13.8% Larger</div>\n        <div>1 Year of R&amp;D, 23 Iterations</div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .be-ctww,\n  .be-ctww *,\n  .be-ctww *::before,\n  .be-ctww *::after { box-sizing: border-box; }\n\n  /* 整体宽度跟随父级 .page-width；字体跟主题 */\n  .be-ctww {\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 100%;\n    padding-top: 137px;\n    padding-bottom: 100px;\n    text-align: center;\n    color: #10374B;\n  }\n\n  /* ---- 标题（PC 端）：仅设 italic / line-height / letter-spacing / 颜色 / 居中宽度\n     字体 / 字重 / 字号 全部跟主题 H2 ---- */\n  .be-ctww .be-ctww__title {\n    margin: 0 auto 30px !important;\n    max-width: 1046px;\n    font-style: italic !important;\n    line-height: 1 !important;\n    letter-spacing: -0.02em !important;\n    color: #10374B !important;\n  }\n\n  /* ---- 描述（PC 端）：Inter 300 / 21 / 38 / 0.01em / 居中宽度 1139 ---- */\n  .be-ctww .be-ctww__desc {\n    margin: 0 auto 60px !important;\n    max-width: 1139px;\n    font-family: Inter, sans-serif !important;\n    font-weight: 300 !important;\n    font-size: 21px !important;\n    line-height: 38px !important;\n    letter-spacing: 0.01em !important;\n    color: #10374B !important;\n  }\n\n  /* ---- 外层容器：宽度由父级控制，给中间蓝块提供相对定位参考 ---- */\n  .be-ctww__table {\n    position: relative;\n    width: 100%;\n    margin-left: auto;\n    margin-right: auto;\n  }\n\n  /* ---- 白卡外的标题（Feature / Others）无背景 ----\n     三列：左 | 蓝色区域占位（blue width 280 + 右偏移 100 ≈ 380） | 右\n     Figma：白卡左右内边距 ~70 */\n  .be-ctww__heads {\n    display: grid;\n    grid-template-columns: 1fr 380px 1fr;\n    padding: 0 70px;\n    margin-bottom: 16px;\n  }\n\n  .be-ctww__head {\n    color: #67D2E0;\n  }\n\n  .be-ctww__head--left { grid-column: 1; text-align: left; }\n  .be-ctww__head--right { grid-column: 3; text-align: center; }\n\n  /* ---- 白色圆角表格：只放左右两列数据 ---- */\n  .be-ctww__card {\n    position: relative;\n    z-index: 1;\n    border-radius: 20px;\n    background: #ffffff;\n    box-shadow: 0 2.96px 11.82px 0 rgba(0, 0, 0, 0.08);\n    padding: 36px 70px; /* Figma：左右 70（约 69/70），上下 36 让整体高度接近 357 */\n    display: grid;\n    row-gap: 28px;     /* 5 行 × ~17 + 4 × 28 + 36×2 ≈ 269；与蓝块上下溢出后总高 ~297；\n                          叠加上方 heads ~14 + 16 mb = 30 → 总 ~327，靠近 357 */\n  }\n\n  .be-ctww__row {\n    display: grid;\n    grid-template-columns: 1fr 380px 1fr; /* 与 .be-ctww__heads 保持一致 */\n    align-items: center;\n  }\n\n  .be-ctww__cell {\n    color: rgba(16, 55, 75, 0.85);\n  }\n\n  .be-ctww__cell--left { grid-column: 1; text-align: left; }\n  .be-ctww__cell--right { grid-column: 3; text-align: center; }\n\n  /* ---- 中间蓝色高亮列：绝对定位叠在上面，与左右列对齐 ---- */\n  .be-ctww__highlight {\n    position: absolute;\n    /* 整体向右偏移 100px */\n    left: calc(50% + 100px);\n    transform: translateX(-50%);\n    /* 向上延伸 14px，使顶部突出白卡；padding-top 与该数值一致，\n       保证 Breescape 与 Feature/Others 同一水平线 */\n    top: -14px;\n    bottom: -14px;\n    width: 280px;\n    max-width: 28%;\n    z-index: 2;\n    border-radius: 22px;\n    background: #9FE0E9;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);\n    padding: 14px 18px;\n    text-align: center;\n  }\n\n  .be-ctww__highlight-head {\n    margin: 0 0 52px; /* = 白卡外标题的 margin-bottom 16 + 白卡 padding-top 36，\n                         让蓝色内的第一行数据与卡内第一行数据对齐 */\n    font-family: Inter, sans-serif;\n    font-weight: 700;\n    font-size: 14px;\n    line-height: 1.2;\n    letter-spacing: 0.02em;\n    color: #10374B;\n  }\n\n  .be-ctww__highlight-list {\n    display: grid;\n    row-gap: 28px; /* 与白卡 .be-ctww__card 的 row-gap 完全一致 */\n    font-family: Inter, sans-serif;\n    font-weight: 500;\n    font-size: 14px;\n    line-height: 1.2;\n    color: #10374B;\n  }\n\n  /* ---------- 响应式（中等屏：仅调表格内边距，title / desc 保持 PC 样式） ---------- */\n  @media (max-width: 1024px) {\n    .be-ctww__heads { padding: 0 32px; }\n    .be-ctww__card { padding: 24px 32px; }\n  }\n\n  @media (max-width: 768px) {\n    /* Figma 移动端 frame：375 宽\n       Title 距 frame 顶 31 → padding-top: 31 */\n    .be-ctww {\n      padding-top: 31px;\n      padding-bottom: 56px;\n    }\n\n    /* ---- 标题（移动端，图1）：字体跟系统/主题 body（去除主题 h2 的 GillSans）；\n       仅设字号 / 行高 / letter-spacing 与外边距 ---- */\n    .be-ctww .be-ctww__title {\n      margin: 0 auto 11px !important;\n      max-width: 286px;\n      font-size: 28px !important;\n      line-height: 28px !important;\n      letter-spacing: -0.01em !important;\n    }\n\n    /* ---- 描述（图2）：Inter 300 Light / 10 / 16 / 1% / 333×71\n       desc bottom (105+71=176) → table top 173 ⇒ 几乎贴着，给一个最小的视觉间距 ---- */\n    .be-ctww .be-ctww__desc {\n      max-width: 333px;\n      margin-bottom: 25px !important;\n      font-size: 10px !important;\n      line-height: 16px !important;\n      letter-spacing: 0.01em !important;\n    }\n\n    /* ---- 表格容器（图3：311 × 118，frame 左右各留 32） ---- */\n    .be-ctww__table {\n      max-width: 311px;\n    }\n\n    .be-ctww__heads {\n      padding: 0 14px;\n      margin-bottom: 6px;\n      grid-template-columns: 1fr 118px 1fr;\n    }\n\n    /* Feature / Others：与 cell 同一字号档（按 Figma ≈ 6-7） */\n    .be-ctww__head { font-size: 7px; letter-spacing: 0.04em; }\n\n    /* 表格总高度 ≈ 118：\n       heads(7 line-height:1 + mb 6) + card_pt 12 + 5 rows × 12 + 4 gaps × 6 + card_pb 12 ≈ 121\n       关键：grid-auto-rows: 12 让所有 row 严格 12px 高\n            （= 双行 6px × line-height 1 = 12，单行 cell 在 row 内 flex 居中） */\n    .be-ctww__card {\n      padding: 12px 14px;\n      row-gap: 6px;\n      border-radius: 16px;\n      grid-auto-rows: 12px;\n    }\n\n    .be-ctww__row {\n      grid-template-columns: 2fr 61px 1fr;\n      align-items: center;\n    }\n\n    /* Cell：Inter 300 Light / 6 / 100% / 0.25px（图2 Figma 实测最小值 6px）\n       用 flex 让单行 cell 在 12px row 内垂直居中，\n       双行 cell 自然填满 12px（6 + 6） */\n    .be-ctww__cell {\n      font-size: 6px;\n      line-height: 1;\n      letter-spacing: 0.04em; /* ≈ 0.25/6 */\n      display: flex;\n      align-items: center;\n    }\n    .be-ctww__cell--left  { justify-content: flex-start; }\n    .be-ctww__cell--right { justify-content: center; }\n\n    /* ---- 蓝色高亮（图4 / 5 / 6：118 × 76）\n       顶溢出 9.05 ≈ 9，底溢出 12.63 ≈ 13 ---- */\n    .be-ctww__highlight {\n      left: 58%;\n      width: 118px;\n      top: -5px;\n      bottom: -13px;\n      border-radius: 12px;\n      padding: 6px 6px;\n    }\n\n    /* Breescape：Inter 700 Bold / 6.55 ≈ 7 / 100% / 0.25px\n       margin-bottom 精确算：\n       list 起点 = 蓝块顶 (-9) + padding 6 + Breescape (7) + margin (8) = card.top + 12\n                 = 白卡 card_pt → row1 起点严格对齐 ✓ */\n    .be-ctww__highlight-head {\n      font-size: 7px;\n      line-height: 1;\n      letter-spacing: 0.04em;\n      margin: 0 0 19px;\n    }\n\n    /* highlight-list 也用 grid-auto-rows: 12 + row-gap: 6 与白卡完全同步\n       → row1/2/3/4/5 与白卡同一水平线 */\n    .be-ctww__highlight-list {\n      row-gap: 7px;\n      grid-auto-rows: 12px;\n      font-size: 6px;\n      line-height: 1;\n      letter-spacing: 0.04em;\n    }\n    .be-ctww__highlight-list > div {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n    }\n  }\n</style>"
          },
