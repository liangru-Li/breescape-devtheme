    "faq_LmxTQr": {
      "type": "faq",
      "blocks": {
        "question_Ghr3UL": {
          "type": "question",
          "settings": {
            "title": "Does the cooling wear off after a few hours?",
            "text": "<p>No, the cooling effect remains consistent throughout the night. BlendTek's innovative fabric technology ensures optimal breathability, moisture control, and extended coverage, providing lasting coolness without the reliance on chemicals or additives that wear off over time.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_nf6zii": {
          "type": "question",
          "settings": {
            "title": "Is this sheet set hypoallergenic and suitable for sensitive skin?",
            "text": "<p>Yes, this sheet set is gentle on skin. It’s OEKO-TEX® certified, ensuring it meets high safety and environmental standards.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_EXCRyz": {
          "type": "question",
          "settings": {
            "title": "How do I wash and care for the sheet set?",
            "text": "<p>Our cooling sheets are easy to care for—simply machine wash in cold water and tumble dry on low to keep them feeling fresh.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
