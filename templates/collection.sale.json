ignment_mobile":"left","image":"shopify:\/\/shop_images\/Group_1014_dc1dd631-ec77-4cb7-bf48-92d9a888d45e.png","image_mobile":"shopify:\/\/shop_images\/Group_637_3c2335b9-d385-4a85-b4d1-4f01d40fd496.png","image_ratio":"adapt","heading":"","heading_size":"text-lg-2xl","text":"","button_label":"","button_link":"","button_style":"secondary","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle"}},"column_DrtPWk":{"type":"column","settings":{"show_border":false,"text_alignment":"left","text_alignment_mobile":"left","image":"shopify:\/\/shop_images\/Group_642.png","image_mobile":"shopify:\/\/shop_images\/Group_638_4c3ab347-d94b-448b-81c1-d7f9431f346c.png","image_ratio":"adapt","heading":"","heading_size":"text-lg-2xl","text":"","button_label":"","button_link":"","button_style":"secondary","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["column_HjQmgB","column_DrtPWk"],"name":"t:sections.multicolumn.name","settings":{"gap":"small","columns":2,"carousel_on_desktop":false,"layout_style":"side_by_side","heading_col_ratio":25,"heading_gap":40,"heading_gap_mobile":20,"heading_valign":"center","columns_mobile":"2","swipe_on_mobile":false,"gap_mobile":20,"heading":"Your Trusted Source of Year-Round Comfort","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_alignment_mobile":"center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":60,"padding_bottom":60,"divider":false,"full_width":false,"rounded":false}},"faq_FNpjpb":{"type":"faq","blocks":{"question_eQLLjt":{"type":"question","settings":{"title":"Won't these feel cold in fall and winter?","text":"<p>Not at all. Breescape is engineered to keep your body temperature steady all year, not just cool. It's 4.5X more breathable and 1.5X more moisture-absorbent than cotton, so it prevents the stuffy, overheated feeling that heated rooms cause in fall and winter while still giving you real warmth. For the Comforter, simply flip it: cooling side for warmer nights, breathable side for fall and winter.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_mtCjJx":{"type":"question","settings":{"title":"Why choose Breescape over a regular winter comforter?","text":"<p>Most winter comforters trap heat and moisture, leaving you overheated in a heated room and needing a wash more often. Breescape's breathable, moisture-wicking fabric keeps your temperature steady through the night and works across every season, so you're not buying or storing a separate comforter for summer and winter.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_79Febw":{"type":"question","settings":{"title":"How do I wash and care for the sheet set?","text":"<p>Breescape Cooling Sheets are easy to care for. Simply machine wash in cold water and tumble dry on low to keep them feeling fresh.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_KVwDyR":{"type":"question","settings":{"title":"Are these bedding hypoallergenic and suitable for sensitive skin?","text":"<p>Yes. Every item bearing the OEKO-TEX® STANDARD 100 label is certified as having passed safety tests for harmful substances, so it's gentle on skin whether you're using it in summer or through the colder months.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_9Jzxgj":{"type":"question","settings":{"title":"Do I need to use a duvet cover with this comforter, or can it be used on its own?","text":"<p>Breescape Cooling Comforter Blanket delivers the best cooling and skin-friendly experience when used by itself. No extra covers needed.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_b74tzQ":{"type":"question","settings":{"title":"Is it worth it?","text":"<p>Yes. 13,300+ hot sleepers say goodbye to sweaty midnight wake-ups. Rooted in sleep science, Breescape is built to help you sleep through evey night, every season, replacing the need for separate summer and winter bedding. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_H9NbEM":{"type":"question","settings":{"title":"What if I don't like it?","text":"<p>Breescape offers a 30-night risk-free trial. <\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question_eQLLjt","question_mtCjJx","question_79Febw","question_KVwDyR","question_9Jzxgj","question_b74tzQ","question_H9NbEM"],"name":"t:sections.faq.name","settings":{"style":"with-border","heading":"FAQs","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":4,"padding_top":0,"padding_bottom":72,"divider":false,"narrow":true,"rounded":false}},"main-collection-banner":{"type":"main-collection-banner","disabled":true,"settings":{"transparent_header":false,"show_image":true,"image":"shopify:\/\/shop_images\/salepage_banner_self-care_image_lg_202602_v1.webp","image_height":"adapt","content_position":"md:items-center md:justify-center","text_alignment":"center","image_mobile":"shopify:\/\/shop_images\/salepage_banner_self-care_image_md_202602_v1.webp","image_height_mobile":"adapt","co