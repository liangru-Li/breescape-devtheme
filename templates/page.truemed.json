,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":80,"padding_bottom":80,"divider":false,"rounded":false}},"custom_section_7F7D4K":{"type":"custom-section","blocks":{"group_nNqk7x":{"type":"group","name":"t:blocks.group.name","settings":{"link":"","accessibility_info":"","open_in_new_tab":false,"group_custom_class":"","content_direction":"col","vertical_on_mobile":true,"content_wrap":false,"horizontal_alignment":"start","vertical_alignment":"center","horizontal_alignment_flex_direction_column":"center","vertical_alignment_flex_direction_column":"center","gap":24,"width":"custom","custom_width":100,"width_mobile":"custom","custom_width_mobile":100,"height":"fit","custom_height":100,"background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","custom_colors":false,"color_text":"","color_background":"","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{"icon_3LYaDx":{"type":"icon","name":"t:blocks.icon.name","settings":{"icon":"tag","icon_image":"shopify:\/\/shop_images\/truemedpage_truemed-logo_image_lg_202603_v1.webp","iwidth":"custom","icon_width":40,"link":"","accessibility_info":"","external":false,"width":"fill","custom_width":100,"alignment":"center","width_mobile":"fill","custom_width_mobile":100,"alignment_mobile":"center"},"blocks":{}},"heading_NRXyXG":{"type":"heading","name":"t:blocks.heading.name","settings":{"heading":"Who is Truemed?","heading_size":"title-md","heading_tag":"h2","width":"fill","custom_width":100,"alignment":"center","width_mobile":"fill","custom_width_mobile":100,"alignment_mobile":"center","effects":"none","highlighted_text":"text","highlighted_scribble":"circle","highlighted_reveal":false},"blocks":{}},"text_riE3Jk":{"type":"text","name":"t:blocks.text.name","settings":{"text":"<p>At <a href=\"https:\/\/www.truemed.com\/blog\/the-ultimate-guide-to-hsa-fsa-eligible-expenses-and-savings-strategies\" target=\"_blank\">Truemed<\/a>, we believe that investing in your health is far more valuable than waiting to spend on sickness. By unlocking pre-tax HSA\/FSA spend on research backed interventions such as fitness, supplements, and health technology, we’re shifting healthcare spend toward true medicine.<\/p>","text_font":"body","text_size":"text-base","text_max_size":32,"text_line_height":1.6,"text_letter_spacing":0,"text_capitalize":false,"secondary_color":false,"width":"custom","custom_width":50,"alignment":"center","width_mobile":"fit-content","custom_width_mobile":100,"alignment_mobile":"left","effects":"none","highlighted_text":"text","highlighted_scribble":"circle"},"blocks":{}}},"block_order":["icon_3LYaDx","heading_NRXyXG","text_riE3Jk"]}},"block_order":["group_nNqk7x"],"disabled":true,"name":"t:sections.custom-section.name","settings":{"content_direction":"col","vertical_on_mobile":true,"content_wrap":false,"horizontal_alignment":"start","vertical_alignment":"center","horizontal_alignment_flex_direction_column":"start","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page","section_height":"auto","section_height_custom":50,"section_height_mobile":"auto","section_height_custom_mobile":50,"background_media":"none","video_position":"cover","background_image_position":"cover","toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","color_text":"","color_background":"#faf8f6","gradient_background":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":80,"padding_bottom":80,"divider":false,"rounded":false}},"featured_collection_VQ4DUN":{"type":"featured-collection","custom_css":[".badge--onsale {display: none;}",".product-card__content {--card-content-padding-block: 4px;}",".title-wrapper .grid {gap: var(--sp-1);}"],"settings":{"collection":"all","products":[],"product_limit":11,"columns":4,"carousel_on_desktop":true,"show_view_all":false,"columns_mobile":"1","swipe_on_mobile":true,"heading":"Eligible Products","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"","highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":80,"padding_bottom":56,"divider":true,"full_width":false,"rounded":false}},"faq_HHaMfc":{"type":"faq","blocks":{"question_PQUUUM":{"type":"question","settings":{"title":"How does using my HSA\/FSA account save me money?","text":"<p>HSA\/FSA accounts were created so individuals could use pre-tax money to pay for expenses used to treat, mitigate, or prevent a diagnosed medical condition. Because HSA\/FSAs use pre-tax money, you’re getting more purchasing power for your dollars. Rather than pay taxes on income and then spend it on health items, qualified customers can use pre-tax funds to invest in their health.<\/p><p>An individual can contribute up to $4,150 pretax to their HSA per year, or $8,300 for a family (plus an additional $1,000 if you are at least 55 years old. Individuals can contribute up to $3,200 pretax to their FSA per year (with an additional $500 in employer contributions allowed).<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_rW6NR9":{"type":"question","settings":{"title":"What are FSA and HSA accounts?","text":"<p>Health savings accounts (HSA) and flexible spending accounts (FSA) are programs that allow you to set aside pre-tax dollars for eligible healthcare expenses. If you’re unsure whether or not you have an HSA or FSA account, please check with your employer or insurance company.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_waBDND":{"type":"question","settings":{"title":"Can I use my HSA\/ FSA at Breescape?","text":"<p>Yes, if qualified. Simply select Truemed as your payment option at checkout and use your FSA or HSA card as you would any other credit card. If you do not have sufficient HSA\/FSA funds, you can split your payment between your credit card and HSA\/FSA card.<br\/><br\/>Truemed is for qualified customers. HSA\/FSA tax savings vary. Learn more at <a href=\"https:\/\/docs.google.com\/document\/d\/19Cxl1ZbXTX25_44rZ8Mbj3nKfsuzmHVOXm7uYuVKewk\/edit?tab=t.0#heading=h.8fnbt71wtlyg\" target=\"_self\"><span style=\"text-decoration:underline\">truemed.com\/disclosures<\/span><\/a><\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_DGMf8K":{"type":"question","settings":{"title":"Can I use my regular credit card at checkout?","text":"<p>Yes. If you’d like to use your regular credit card, simply select that in Truemed checkout. After your purchase, Truemed will email you instructions on how to submit the receipt to your HSA\/FSA administrator for reimbursement.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_ebnXyy":{"type":"question","settings":{"title":"What is a Letter of Medical Necessity, and how is this compliant?","text":"<p>The items in your Truemed Letter of Medical Necessity (“LMN”) are now qualified medical expenses in the same way a visit to the doctor’s office or pharmaceutical product is.<\/p><p><br\/>There are thousands of studies showing food and exercise is often the best medicine to prevent and reverse disease. Exercise qualifies as a qualified medical expense with an LMN. Food, supplements, and other health purchases qualify as medical expenses if they treat or prevent an illness, and a doctor substantiates the need. Your Truemed LMN satisfies all IRS requirements to make your wellness spend fully reimbursable.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_AkwQXT":{"type":"question","settings":{"title":"Are there fees associated with using Truemed's services?","text":"<p>There is no cost to you, as long as you are shopping with a Truemed partner merchant.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_ewfRrX":{"type":"question","settings":{"title":"When should I use my FSA\/HSA dollars?","text":"<p>You can use your HSA\/FSA dollars all year long. However, most FSA dollars expire at the end of the year and unused money may not rollover into the next year. Make sure to spend the rest of your FSA dollars before December 31st — use it, so you don’t lose it!<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_FRdzUB":{"type":"question","settings":{"title":"How long does it take for me to receive my Letter of Medical Necessity?","text":"<p>Generally it takes 2-5 hours. In some cases, Truemed’s provider team will require additional time to issue a letter of medical necessity based on the needs associated with an individual qualification survey. If you aren’t seeing your letter in your inbox, check spam, then reach out to us at <a href=\"mailto:support@truemed.com\" target=\"_blank\">support@truemed.com <\/a>for help.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_nBGRe9":{"type":"question","settings":{"title":"I don’t have an HSA\/FSA. Can I still benefit from Truemed? ","text":"<p>Unfortunately, Truemed’s services are for individuals who have HSA or FSA accounts (or plan to fund one during open enrollment). We encourage you to ask your employer about information on your HSA or FSA!<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}},"question_pPMyjA":{"type":"question","settings":{"title":"I don’t live in the US. Can I still get reimbursed with Truemed?","text":"<p>Unfortunately, Truemed is currently only available in the United States.<\/p>","highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["question_PQUUUM","question_rW6NR9","question_waBDND","question_DGMf8K","question_ebnXyy","question_AkwQXT","question_ewfRrX","question_FRdzUB","question_nBGRe9","question_pPMyjA"],"name":"t:sections.faq.name","settings":{"style":"with-background","heading":"Common Questions","heading_size":"title-md","heading_alignment":"text-center md:items-center","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"#faf8f6","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","color_overlay":"#ffffff","overlay_opacity":4,"padding_top":80,"padding_bottom":80,"divider":false,"narrow":true,"rounded":false}}},"order":["main-page","image_with_text_zVgegt","image_with_text_PpUXtP","image_with_text_qinKyA","image_with_text_C4t7dK","image_with_text_HFDrLE","custom_section_hQ36J4","custom_section_Gnkxrp","custom_section_7F7D4K","featured_collection_VQ4DUN","faq_HHaMfc"]}