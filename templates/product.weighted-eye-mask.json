        "liquid_TAedQ8": {
          "type": "liquid",
          "settings": {
            "liquid": "{%- liquid\nassign cert_page_handle = 'third-party-tested'\nassign cert_page = pages[cert_page_handle]\nassign cert_modal_id = 'xo__third-party-tested'\nassign cert_trigger_id = 'xo__third-party-tested-trigger'\n-%}\n\n<div class=\"xo__third-party-tested w-full bg-zinc-100\">\n  <a\n    type=\"button\"\n    class=\"link inline-block size-style cursor-pointer flex items-center justify-between\"\n    role=\"link\"\n    is=\"hover-link\"\n    aria-controls=\"{{ cert_modal_id }}\"\n    aria-expanded=\"false\"\n    aria-label=\"{{ cert_page.title | default: 'Third-Party Tested, Globally Certified' | escape }}\"\n    id=\"{{ cert_trigger_id }}\"\n  >\n    <span class=\"link-text\">View Third-Party Test Results</span>\n    {%- render 'icon', icon: 'arrow-right', size: 'sm' -%}\n  </a>\n</div>\n\n<x-modal\n  id=\"{{ cert_modal_id }}\"\n  class=\"x-modal drawer z-30 fixed bottom-0 left-0 h-full w-full pointer-events-none\"\n  role=\"dialog\"\n  aria-modal=\"true\"\n  aria-label=\"{{ cert_page.title | default: 'Third-Party Tested, Globally Certified' | escape }}\"\n  hidden\n>\n  <overlay-element\n    class=\"overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none\"\n    aria-controls=\"{{ cert_modal_id }}\"\n    aria-expanded=\"false\"\n  ></overlay-element>\n\n  <div class=\"drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden\">\n    <gesture-element class=\"drawer__header flex justify-between opacity-0 invisible relative items-center\">\n      <span class=\"drawer__title heading text-lg-2xl leading-tight tracking-tight\">\n\n      </span>\n\n      <button\n        class=\"button button--secondary button--close drawer__close hidden sm:flex items-center justify-center\"\n        type=\"button\"\n        is=\"hover-button\"\n        aria-controls=\"{{ cert_modal_id }}\"\n        aria-expanded=\"false\"\n        aria-label=\"Close\"\n      >\n        <span class=\"btn-fill\" data-fill></span>\n        <span class=\"btn-text\">{% render 'icon', icon: 'close', size: 'sm' %}</span>\n      </button>\n    </gesture-element>\n\n    <div class=\"drawer__content opacity-0 invisible flex flex-col h-full grow shrink\">\n      <div class=\"drawer__scrollable relative grow shrink\">\n        <div class=\"rte text-base md:text-lg\">\n          <div class=\"container mx-auto py-10\">\n            {%- if cert_page != blank -%}\n              {{ cert_page.content }}\n            {%- else -%}\n              <p class=\"text-sm opacity-70\">\n                Page not found: <strong>{{ cert_page_handle }}</strong>\n              </p>\n            {%- endif -%}\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</x-modal>\n\n<style>\n  .xo__third-party-tested {\n    padding: var(--sp-5) var(--sp-6);\n    border-radius: var(--sp-2d5);\n  }\n  .xo__third-party-tested a {\n    background: transparent !important;\n  }\n</style>"
