        "liquid": "<a class=\"button button--secondary with-content flex items-center cursor-pointer py-4\" role=\"link\" aria-controls=\"Hotspot-ergonomics\"\n    aria-expanded=\"false\" aria-label=\"More on Ergonomics\" id=\"shopify-block-ergonomics\">\n    <span class=\"btn-plus heading normal-case font-medium md:text-base leading-none tracking-none\" style=\"font-weight: 600!important;\">Learn More</span>\n\n\n\n\n    <svg class=\"plus\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 15 15\" fill=\"none\">\n        <path d=\"M14.75 7.5C14.75 11.366 11.616 14.5 7.75 14.5C3.88401 14.5 0.75 11.366 0.75 7.5C0.75 3.63401 3.88401 0.5 7.75 0.5C11.616 0.5 14.75 3.63401 14.75 7.5Z\" fill=\"#67D2DF\"/>\n        <path d=\"M6.81566 10.764V8.482H4.56166V6.662H6.81566V4.38H8.67766V6.662H10.9317V8.482H8.67766V10.764H6.81566Z\" fill=\"white\"/>\n    </svg>\n</a>\n\n\n<x-modal id=\"Hotspot-ergonomics\" class=\"x-modal drawer z-30 fixed bottom-0 left-0 h-full w-full pointer-events-none\"\n    role=\"dialog\" aria-modal=\"true\" aria-label=\"More on Ergonomics\" hidden>\n    <overlay-element\n        class=\"overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none\"\n        aria-controls=\"Hotspot-ergonomics\" aria-expanded=\"false\"></overlay-element>\n\n    <div class=\"drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden\">\n        <gesture-element class=\"drawer__header flex justify-between opacity-0 invisible relative\">\n            <span class=\"drawer__title heading title-sm\">Powered by BlendTek</span>\n            <button\n                class=\"button button--secondary button--close drawer__close hidden sm:flex items-center justify-center\"\n                type=\"button\" is=\"hover-button\" aria-controls=\"Hotspot-ergonomics\" aria-expanded=\"false\"\n                aria-label=\"Close\">\n                <span class=\"btn-fill\" data-fill></span>\n                <span class=\"btn-text\">\n                    {% render 'icon', icon: 'close', size: 'sm' %}\n                </span>\n            </button>\n        </gesture-element>\n\n        <div class=\"drawer__content opacity-0 invisible flex flex-col h-full grow shrink\">\n            <div class=\"drawer__scrollable relative flex flex-col gap-5 md:gap-7 grow shrink\">\n                <div class=\"rte text-base md:text-lg\">\n                    <div class=\"container mx-auto py-10\">\n                        <!-- Header Section -->\n                        <div class=\"text-left mb-8\"\n                            style=\"background-image: url('https://cdn.shopify.com/s/files/1/0640/6779/7070/files/homepage-modal-blendtek-image-202504-v1.png?v=1743990771'); background-size: cover; background-position: center; padding: 20px;\">\n                            <h3 class=\"text-gray-800\" style=\"padding: 10px; \">BlendTek Technology: The Science of Cool\n                            </h3>\n                            <p class=\"text-gray-600 mt-2 text-base\" style=\"padding: 10px; \">\n                                Our patented fiber blend is crafted with the optimal ratio for proven, long-lasting\n                                coolness, perfected after a year of research and 25 iterations.\n                            </p>\n                        </div>\n\n                     \n                        <div class=\"flex flex-col md:flex-row items-center justify-between mb-8\">\n                            <!-- Image Placeholder -->\n                            <div class=\"w-full md:w-1/3 mb-6 md:mb-0\">\n                                <img src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/blendtekpage-high-performance-images-md-202503.png?v=1741578515\"\n                                    alt=\"\" width=\"1177\" height=\"1206\" loading=\"lazy\"\n                                    sizes=\"(max-width: 767px) 100vw, 50vw\" is=\"lazy-image\" class=\"loaded\"\n                                    style=\"margin:0;\" />\n                            </div>\n\n                            <!-- Features Section -->\n                            <div class=\"w-full md:w-2/3 md:pl-8\">\n                                <p class=\"text-base font-semibold text-gray-800\" style=\"margin:0;\">In-House Innovation\n                                </p>\n                                <h3 class=\"text-xl font-medium text-gray-700\" style=\"margin:0;\">A Precisely Balanced\n                                    Blend of High-Performance Fibers</h3>\n                                <ul class=\"space-y-3 text-gray-600 text-base\">\n                                    <li><strong>High Thermal Conductivity Fibers</strong> – Draws heat away fast.</li>\n                                    <li><strong>Polygonal Fiber Structure</strong> – Maximizes surface area to wick away\n                                        sweat.</li>\n                                    <li><strong>High-Porosity Fibers</strong> – Enhances airflow, releasing heat and\n                                        moisture.</li>\n                                </ul>\n                                <p class=\"text-gray-600 mt-4 italic text-sm\">\"These are just a few of the advanced\n                                    fibers in BlendTek™.\"</p>\n                            </div>\n                        </div>\n\n                        <hr>\n                        <div class=\"flex flex-col md:flex-row items-start justify-between mb-8\">\n                            <h3 class=\"text-2xl text-gray-800 mb-4 w-full md:w-1/3\" style=\"margin: 0;\">Sustainable\n                                Partner</h3>\n\n                            <div class=\"w-full md:w-2/3\">\n                                <p class=\"text-gray-600 mb-4 text-sm\" style=\"margin: 0;\">\n                                    We partner with like-minded brands like Naia™ and Eco-Cosy® to drive sustainability\n                                    in textiles, ensuring our materials support both people and the planet.\n                                </p>\n                                <div class=\"flex space-x-6 gap-4 items-center\" style=\"margin: 0;\">\n                                    <img src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/homepage-modal-blendtek-icon-naia-202504-v1.png?v=1743991112\" alt=\"Naia Logo\"\n                                        class=\"h-12\" style=\"height:60px;    margin-block: var(--sp-4);\">\n                                    <img src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/homepage-modal-blendtek-icon-ecocosy-202504-v1.png?v=1743991112\" alt=\"Eco-Cosy Logo\"\n                                        class=\"h-12\" style=\"height:46px;    margin-block: var(--sp-4);\">\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </div>\n</x-modal>\n\n<!-- 样式 -->\n<style>\n    .btn-plus+.plus {\n        width: 1.75em;\n        height: 1.75em;\n        border-radius: 50em;\n        margin-left: 0.5em;\n    }\n</style>",
