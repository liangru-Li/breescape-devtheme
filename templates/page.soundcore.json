                "tab_3_liquid": "<div class=\"w-full h-full\">\n  <p class=\"text-center text-base margin-auto\" style=\"max-width:80%;margin:0 auto;\">\n    Silky-soft fabric and ergonomic earbuds work together to keep you comfortable all night, so you rise refreshed.\n  </p>\n\n  <img src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/soundcorepage_waking-up_rejuvenated_content-image_lg_202508_v3.webp?v=1755569778\" style=\"margin-left: auto;\n    margin-right: auto;width:70%;\">\n</div>",
