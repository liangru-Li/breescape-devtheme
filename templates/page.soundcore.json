                "tab_1_content": "",
                "tab_1_liquid": "<div class=\"w-full h-full\">\n  <p class=\"text-center text-base margin-auto\" style=\"max-width:80%;margin:0 auto;\">\n    Breathable, cooling fabric lowers body temperature, while smart earbuds block out noise for a faster, calmer drift\n    to sleep.\n  </p>\n\n  <img src=\"https://cdn.shopify.com/s/files/1/0640/6779/7070/files/soundcorepage_waking-up_cooling-calm_content-image_lg_202508_v2.webp?v=1755660340\">\n</div>",
                "tab_2_enabled": true,
