    "faq_Fb7GVR": {
      "type": "faq",
      "blocks": {
        "bodypillow_question_1": {
          "type": "question",
          "settings": {
            "title": "What areas does Breescape Ergonomic Body Pillow support?",
            "text": "<p>It provides ergonomic support for the neck, spine, belly, legs, and feet, helping you find a more comfortable position while you sleep.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "bodypillow_question_2": {
          "type": "question",
          "settings": {
            "title": "Who is the body pillow best for?",
            "text": "<p>This ergonomic body pillow is ideal for side sleepers, hot sleepers, and anyone looking for full-body support while sleeping, lounging, relaxing, or traveling.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "bodypillow_question_3": {
          "type": "question",
          "settings": {
            "title": "What is the body pillow made of?",
            "text": "<p>The cooling cover is made with 88% Nylon and 12% Spandex cooling fabric. The pillow is filled with a combination of memory foam and shredded foam for supportive, soft cushioning.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "bodypillow_question_4": {
          "type": "question",
          "settings": {
            "title": "Is the cover removable and washable?",
            "text": "<p>Yes. The hidden zipper design makes the body pillow cover easy to remove for machine washing, making everyday care simple.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "bodypillow_question_5": {
          "type": "question",
          "settings": {
            "title": "Does the body pillow come with an extra cover?",
            "text": "<p>Yes. The ergonomic body pillow comes with a BONUS ultra-soft cover, giving you an extra cover to switch between washes or colder seasons.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "bodypillow_question_6": {
          "type": "question",
          "settings": {
            "title": "What size options are available?",
            "text": "<p>It measures 47” × 15”.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
