            "liquid": "<div class=\"w-full max-w-md mx-auto\">\n  <div class=\"flex gap-4 rounded-xl w-full items-stretch\" style=\"padding: 8px 0;border-bottom: 1px solid #eee;\">\n    <div class=\"s-solution-comparison-card relative overflow-hidden rounded-lg\">\n      <img src=\"{{ 'img_v3_02lr_ee642fa1-4086-485b-b573-415b1d26f8dg.jpg' | file_url }}\"\n        alt=\"{{ img_alt | default: 'Cooler, cozier, better sleep for everyone!' }}\"\n        class=\"s-solution-comparison-card__img w-full m-0 rounded-lg\" loading=\"lazy\">\n    </div>\n\n    <div class=\"flex flex-col flex-1 py-2\">\n      <div class=\"review-content flex flex-col justify-between h-full\">\n        <div class=\"stars grid grid-4\">\n          {%- render 'icon', icon: '5reviews', size: 'custom', class: 'shawn__product-card__rating__icon' -%}\n          <span class=\"review-text text-md py-2\">\n            \"Cooler, cozier, better sleep for everyone!\"\n          </span>\n        </div>\n        <div class=\"text-sm font-medium flex items-center\">\n          @sarahbanksie\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"flex gap-4 rounded-xl w-full items-stretch\" style=\"padding: 8px 0;border-bottom: 1px solid #eee;\">\n    <div class=\"s-solution-comparison-card relative overflow-hidden rounded-lg\">\n      <img src=\"{{ '20250429-110909.jpg' | file_url }}\"\n        alt=\"{{ img_alt | default: 'No more tossing and turning—just pure relaxation.' }}\"\n        class=\"s-solution-comparison-card__img w-full m-0 rounded-lg\" loading=\"lazy\">\n    </div>\n\n    <div class=\"flex flex-col flex-1 py-2\">\n      <div class=\"review-content flex flex-col justify-between h-full\">\n        <div class=\"stars grid grid-4\">\n          {%- render 'icon', icon: '5reviews', size: 'custom', class: 'shawn__product-card__rating__icon' -%}\n          <span class=\"review-text text-md py-2\">\n            \"No more tossing and turning—just pure relaxation.\"\n          </span>\n        </div>\n        <div class=\"text-sm font-medium flex items-center\">\n          @itsme_heathermarie_\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"flex gap-4 rounded-xl w-full items-stretch\" style=\"padding: 8px 0;\">\n    <div class=\"s-solution-comparison-card relative overflow-hidden rounded-lg\">\n      <img src=\"{{ '20250429-110951.jpg' | file_url }}\"\n        alt=\"{{ img_alt | default: 'Its so smooth and gentle on your skin' }}\"\n        class=\"s-solution-comparison-card__img w-full m-0 rounded-lg\" loading=\"lazy\">\n    </div>\n\n    <div class=\"flex flex-col flex-1 py-2\">\n      <div class=\"review-content flex flex-col justify-between h-full\">\n        <div class=\"stars grid grid-4\">\n          {%- render 'icon', icon: '5reviews', size: 'custom', class: 'shawn__product-card__rating__icon' -%}\n          <span class=\"review-text text-md py-2\">\n            \"It's so smooth and gentle on your skin\"\n          </span>\n        </div>\n        <div class=\"text-sm font-medium flex items-center\">\n          @alexisnbasik\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <button class=\"button button--secondary button--md w-full s--button--product--reviews\"\n    style=\"color: rgb(var(--color-button-background));\">\n    Read All Reviews\n  </button>\n\n  <style>\n    .s--button--product--reviews:hover {\n      background-size: 0% 1px !important;\n    }\n\n    .s-solution-comparison-card {\n      flex: 0 0 25%;\n      max-width: 120px;\n      overflow: hidden;\n      border-radius: 10px;\n      aspect-ratio: 3 / 4;\n    }\n\n    .s-solution-comparison-card__img {\n      display: block;\n      width: 100%;\n      height: 100%;\n      margin-block: 0 !important;\n      object-fit: cover;\n      border-radius: inherit;\n    }\n  </style>\n</div>",
