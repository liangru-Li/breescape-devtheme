eral US states permit states residents to authorize agents to make certain privacy requests on their behalf.<\/p><p>If you are an authorized agent making a request on behalf of any customer in the US, please provide the information below so that we may process the request. Please note that we may communicate with the customer at the customer’s contact email address you provide in order to conduct certain verification procedures directly with the customer.<\/p><p>If you are making a request on behalf of a customer to opt out of the selling orsharing of personal information for targeted advertising as described in our <a href=\"\/policies\/privacy-policy\" target=\"_blank\" title=\"Privacy Policy\">Privacy Policy<\/a>, please use the <a href=\"https:\/\/breescape.com\/pages\/data-sharing-opt-out\" target=\"_blank\" title=\"https:\/\/breescape.com\/pages\/data-sharing-opt-out\">“Do Not Sell or Share Personal Information” <\/a>link (also available at the bottom of our website).<\/p>","text_font":"body","text_size":"subtext-lg","text_max_size":32,"text_line_height":1.6,"text_letter_spacing":0,"text_capitalize":false,"secondary_color":false,"highlighted_text":"none","highlighted_scribble":"circle"}}},"block_order":["text_WWxMEm"],"name":"t:sections.rich-text.name","settings":{"text_alignment":"left","text_alignment_mobile":"left","heading":"","heading_size":"title-md","heading_alignment":"text-left md:items-end md:flex-row","heading_width":"small","heading_tag":"h2","subheading":"","description":"","button_label":"","button_link":"","button_external":false,"button_icon":true,"highlighted_text":"none","highlighted_scribble":"circle","highlighted_reveal":false,"color_text":"","color_background":"","gradient_background":"","color_highlight":"","gradient_highlight":"","color_button_text":"","color_button_background":"","color_button_gradient":"","padding_top":56,"padding_bottom":0,"divider":false,"narrow":true,"rounded":false}},"forms":{"type":"apps","blocks":{"b24a60ea-2b8a-