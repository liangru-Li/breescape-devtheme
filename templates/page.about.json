        top: -34px;\n        right: 42px;\n        width: 92px;\n        height: 92px;\n        border-radius: 999px;\n        padding: 6px;\n        background: rgba(255, 255, 255, 0.22);\n        border: 1px solid rgba(255, 255, 255, 0.25);\n        backdrop-filter: blur(10px);\n        -webkit-backdrop-filter: blur(10px);\n    }\n\n    .xo__founder__modal__story__avatar img {\n        width: 100%;\n        height: 100%;\n        border-radius: 999px;\n        object-fit: cover;\n        display: block;\n    }\n\n    @media (max-width: 767px) {\n        .xo__founder__modal__story {\n            background: #f3f4f6;\n            color: #111827;\n            border-radius: 0;\n            overflow: visible;\n        }\n\n        .xo__founder__modal__story::after {\n            display: none;\n        }\n\n        .xo__founder__modal__story__bg {\n            position: absolute;\n            top: 0;\n            left: 0;\n            right: 0;\n            inset: auto;\n            z-index: 0;\n        }\n\n        .discover-btn:hover .discover-btn__text {\n            transform: translateX(-20px);\n        }\n\n        .xo__founder__modal__story__bg img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            transform: none;\n            filter: saturate(1.05) contrast(1.05);\n        }\n\n        .xo__founder__modal__story__hero {\n            padding-top: 18px;\n            padding-bottom: 14px;\n            color: #fff;\n            position: relative;\n        }\n\n        .xo__founder__modal__story__card {\n\n            max-width: 100%;\n            border-radius: 16px;\n            padding: 16px 16px 14px;\n            background: rgba(255, 255, 255, 0.92);\n            border: 1px solid rgba(17, 24, 39, 0.08);\n            box-shadow: 0 18px 40px rgba(17, 24, 39, 0.18);\n            backdrop-filter: none;\n            -webkit-backdrop-filter: none;\n        }\n\n        .xo__founder__modal__story__avatar {\n       