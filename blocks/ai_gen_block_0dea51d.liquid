{% doc %}
  @prompt
    Create a new Shopify section called "Blog Category Hero".
    
    Layout:
    - Full-width section with a maximum content width of 1400px.
    - Light gray background (#F7F7F7).
    - Large rounded container with generous padding (40px top/bottom, 32px left/right).
    
    Top Row:
    - Left side:
      - Heading (H2): "Your Guide to Sleeping Through the Night"
      - Font size: 48px desktop, 30px mobile.
      - Font weight: 600.
      - Dark navy text (#233B5D).
    
    - Under the heading:
      - A short description.
      - Font size: 16px.
      - Weight: 400.
      - Color: #5F6C7B.
    
    - Right side:
      - A rounded outline button.
      - Text: "Explore Our Blog"
      - Arrow icon on the right.
      - Border color #233B5D.
      - Transparent background.
      - Height about 52px.
      - Border radius: 999px.
      - On mobile, place the button below the text.
    
    Bottom Row:
    Display blog categories as pill buttons.
    
    Categories:
    - Night Sweats
    - Menopause
    - Sensitive Skin
    - Shared Sleep
    - Stress & Anxiety
    - Inside Breescape®
    - Newsroom
    
    Each category should:
    - Be a rounded pill.
    - Light gray background (#ECEFF3).
    - Dark navy text.
    - Horizontal padding 24px.
    - Height about 42px.
    - Border radius: 999px.
    - Wrap to multiple lines on smaller screens.
    - Change to dark navy background with white text on hover.
    
    Theme Settings:
    - Editable heading.
    - Editable description.
    - Editable button text.
    - Editable button link.
    - Category blocks that can be added, removed and reordered.
    - Each category should have its own text and link.
    
    Responsive:
    - Desktop: heading and button aligned horizontally.
    - Mobile: stacked layout with full-width button.
    - Category pills wrap naturally.
    
    Use Shopify OS 2.0 schema and blocks so all content is editable from the Theme Editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-blog-hero-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-blog-hero-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    background-color: {{ block.settings.container_background }};
    border-radius: {{ block.settings.container_border_radius }}px;
    padding: {{ block.settings.container_padding_vertical }}px {{ block.settings.container_padding_horizontal }}px;
  }

  .ai-blog-hero-top-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    margin-bottom: {{ block.settings.spacing_between_rows }}px;
  }

  .ai-blog-hero-content-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-blog-hero-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.spacing_heading_description }}px 0;
    line-height: 1.2;
  }

  .ai-blog-hero-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    font-weight: {{ block.settings.description_weight }};
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-blog-hero-button-wrapper-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-blog-hero-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0 {{ block.settings.button_padding_horizontal }}px;
    height: {{ block.settings.button_height }}px;
    background-color: {{ block.settings.button_background }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-blog-hero-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-blog-hero-button-icon-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-blog-hero-categories-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.category_gap }}px;
  }

  .ai-blog-hero-category-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 {{ block.settings.category_padding_horizontal }}px;
    height: {{ block.settings.category_height }}px;
    background-color: {{ block.settings.category_background }};
    color: {{ block.settings.category_text_color }};
    border-radius: {{ block.settings.category_border_radius }}px;
    font-size: {{ block.settings.category_font_size }}px;
    font-weight: {{ block.settings.category_font_weight }};
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-blog-hero-category-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.category_hover_background }};
    color: {{ block.settings.category_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-blog-hero-top-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: stretch;
    }

    .ai-blog-hero-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-blog-hero-button-wrapper-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-blog-hero-button-{{ ai_gen_id }} {
      width: 100%;
      justify-content: center;
    }
  }
{% endstyle %}

<blog-category-hero-{{ ai_gen_id }} class="ai-blog-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-blog-hero-container-{{ ai_gen_id }}">
    <div class="ai-blog-hero-top-{{ ai_gen_id }}">
      <div class="ai-blog-hero-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-blog-hero-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.description != blank %}
          <p class="ai-blog-hero-description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
        {% endif %}
      </div>
      {% if block.settings.button_text != blank and block.settings.button_link != blank %}
        <div class="ai-blog-hero-button-wrapper-{{ ai_gen_id }}">
          <a href="{{ block.settings.button_link }}" class="ai-blog-hero-button-{{ ai_gen_id }}">
            {{ block.settings.button_text }}
            <span class="ai-blog-hero-button-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </span>
          </a>
        </div>
      {% endif %}
    </div>

    <div class="ai-blog-hero-categories-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign category_text_key = 'category_' | append: i | append: '_text'
          assign category_link_key = 'category_' | append: i | append: '_link'
          assign category_text = block.settings[category_text_key]
          assign category_link = block.settings[category_link_key]
        %}
        {% if category_text != blank and category_link != blank %}
          <a href="{{ category_link }}" class="ai-blog-hero-category-{{ ai_gen_id }}">
            {{ category_text }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</blog-category-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class BlogCategoryHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('blog-category-hero-{{ ai_gen_id }}', BlogCategoryHero{{ ai_gen_id }});
  })();
</script>

