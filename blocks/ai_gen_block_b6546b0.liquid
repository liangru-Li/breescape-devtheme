{% doc %}
  @prompt
    在多列布局中，让文字叠加在图片上方。每一列包含一张图片，文字（标题和描述）覆盖显示在图片上，带有半透明的深色遮罩以确保文字可读性。保持图片原始比例，文字居中或底部对齐显示在图片上。
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-columns-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-image-text-columns__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-image-text-columns__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-image-text-columns__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {% if block.settings.image_ratio == 'adapt' %}100%{% elsif block.settings.image_ratio == 'square' %}100%{% elsif block.settings.image_ratio == 'portrait' %}133%{% elsif block.settings.image_ratio == 'landscape' %}75%{% endif %};
  }

  .ai-image-text-columns__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-columns__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-text-columns__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-image-text-columns__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  .ai-image-text-columns__content-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.text_position == 'center' %}
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
    {% elsif block.settings.text_position == 'bottom' %}
      bottom: {{ block.settings.text_padding }}px;
      left: {{ block.settings.text_padding }}px;
      right: {{ block.settings.text_padding }}px;
      text-align: left;
    {% elsif block.settings.text_position == 'top' %}
      top: {{ block.settings.text_padding }}px;
      left: {{ block.settings.text_padding }}px;
      right: {{ block.settings.text_padding }}px;
      text-align: left;
    {% endif %}
    z-index: 2;
    width: {% if block.settings.text_position == 'center' %}90%{% else %}auto{% endif %};
  }

  .ai-image-text-columns__title-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    margin: 0 0 {{ block.settings.text_spacing }}px 0;
    line-height: 1.2;
  }

  .ai-image-text-columns__description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.description_size }}px;
    margin: 0;
    line-height: 1.5;
  }

  .ai-image-text-columns__link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    text-indent: -9999px;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text-columns__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.column_gap | times: 0.75 }}px;
    }

    .ai-image-text-columns__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }

    .ai-image-text-columns__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-image-text-columns__content-{{ ai_gen_id }} {
      {% if block.settings.text_position == 'bottom' or block.settings.text_position == 'top' %}
        left: {{ block.settings.text_padding | times: 0.75 }}px;
        right: {{ block.settings.text_padding | times: 0.75 }}px;
      {% endif %}
      {% if block.settings.text_position == 'bottom' %}
        bottom: {{ block.settings.text_padding | times: 0.75 }}px;
      {% elsif block.settings.text_position == 'top' %}
        top: {{ block.settings.text_padding | times: 0.75 }}px;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-image-text-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-image-text-columns__grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign image_key = 'image_' | append: i
        assign title_key = 'title_' | append: i
        assign description_key = 'description_' | append: i
        assign link_key = 'link_' | append: i
        assign show_key = 'show_column_' | append: i

        assign show_column = block.settings[show_key]
        assign image = block.settings[image_key]
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
        assign link = block.settings[link_key]
      %}

      {% if show_column %}
        <div class="ai-image-text-columns__item-{{ ai_gen_id }}">
          <div class="ai-image-text-columns__image-wrapper-{{ ai_gen_id }}">
            {% if image %}
              <img
                src="{{ image | image_url: width: 800 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                width="{{ image.width }}"
                height="{{ image.height }}"
                class="ai-image-text-columns__image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-image-text-columns__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            <div class="ai-image-text-columns__overlay-{{ ai_gen_id }}"></div>

            <div class="ai-image-text-columns__content-{{ ai_gen_id }}">
              {% if title != blank %}
                <h3 class="ai-image-text-columns__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if description != blank %}
                <div class="ai-image-text-columns__description-{{ ai_gen_id }}">{{ description }}</div>
              {% endif %}
            </div>

            {% if link != blank %}
              <a href="{{ link }}" class="ai-image-text-columns__link-{{ ai_gen_id }}" aria-label="{{ title | escape }}">{{ title }}</a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

