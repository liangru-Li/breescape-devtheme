<style>
  .content-item {
    display: flex;
    flex-direction: row;
    gap: 8px;
    border-radius: 10px;
    max-width: 100%;
    width: 420px;
    background: rgba(255, 255, 255, 1);
    border: 1px solid #fff;
    padding: 24px 16px;
    flex-shrink: 0;
    transition: opacity 0.3s ease, height 0.3s ease;
  }


  .content-item.hidden {
    opacity: 0;
    height: 0;
    padding: 0;
    margin: 0;
    overflow: hidden;
  }

  /* Slider container */
  .content-slider {
    display: flex;
    flex-direction: column;
    margin-left: 100px;
  }

  /* Mobile-specific styles */
  @media (max-width: 768px) {
    .content-slider {
      flex-direction: row;
      gap: 16px;
      padding: 0 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-left:0;
    }

    .s--materials-img-content {
      margin: 30px auto;
    }

    .content-slider::-webkit-scrollbar {
      display: none;
    }

    .content-item {
      width: 100%;
      max-width: 300px;
      align-items: center;
    }

    .content-item.hidden {
      display: flex;
      opacity: 1;
      height: auto;
      padding: 16px;
      margin: 0;
    }

    .md\:w-1\/4,
    .md\:w-1\/2 {
      width: 100%;
    }
  }

  @media (min-width: 768px) {
    .md\:w-1\/4 {
      width: 25%;
    }

    .md\:w-1\/2 {
      width: 50%;
    }
  }

  .text-black {
    color: #333;
  }

  button.transition-colors {
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .section::before {
    background-color: transparent !important;
  }
</style>

