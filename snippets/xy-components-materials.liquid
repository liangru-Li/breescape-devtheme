<script> const pins = document.querySelectorAll(".pillow-structure__pin"); const cards = document.querySelectorAll(".pillow-structure__card"); const setActive = target => { let activeCard = null; pins.forEach(pin => { const isActive = pin.dataset.target === target; pin.classList.toggle("is-active", isActive); }); cards.forEach(card => { const isActive = card.dataset.target === target; card.classList.toggle("is-active", isActive); if (isActive) activeCard = card; }); if (activeCard && window.matchMedia("(max-width: 1024px)").matches) { activeCard.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" }); } }; pins.forEach(pin => { pin.addEventListener("click", () => setActive(pin.dataset.target)); }); cards.forEach(card => { card.addEventListener("click", () => setActive(card.dataset.target)); }); if (!document.querySelector(".pillow-structure__pin.is-active") && pins.length) { setActive(pins[0].dataset.target); } </script>

