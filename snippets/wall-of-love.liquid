    { category: "cooling",    url: "https://cdn2.videowise.com/converted/videos/1742551934579_wid_NjdkZDNiN2UzNGQwYWQwMDU2MDVkZWE1_h264c.mp4",    thumbnail: "https://cdn2.videowise.com/custom-videos/thumbnails/1742551941729_f17157e2-2aa9-406e-802f-6339f0cf4e06.webp",       username: "@aleegamez_",              comments: [""] },
    { category: "cooling",    url: "https://cdn2.videowise.com/converted/videos/1742551929658_wid_NjdkZDNiNzkzNGQwYWQwMDU2MDVkZTQ4_h264c.mp4",    thumbnail: "https://cdn2.videowise.com/custom-videos/thumbnails/1742551933098_1bbacd1e-416f-4b80-895e-f0212d5b6811.webp",       username: "@_maruss",                 comments: ["This is the perfect solution for uninterrupted, restful sleep."] },
