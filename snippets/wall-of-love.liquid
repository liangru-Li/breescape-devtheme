// ─── Constants ────────────────────────────────────────────────────────────────
const INITIAL_LOAD    = 8;
const LOAD_MORE_COUNT = 8;
const HEIGHT_PATTERN  = [100, 95, 90, 98];

// ─── Helpers ──────────────────────────────────────────────────────────────────
function getColumnCount() {
    const w = window.innerWidth;
    return w > 960 ? 4 : w > 768 ? 3 : w > 360 ? 2 : 1;
}
function getBaseHeight() {
    return window.innerWidth < 768 ? 300 : 500;
}
function getCardHeight(i) {
    return getBaseHeight() * HEIGHT_PATTERN[i % HEIGHT_PATTERN.length] / 100;
}

// ─── Card DOM builder ─────────────────────────────────────────────────────────
function createCard({ url, thumbnail, username, comments }, index) {
    const card = document.createElement('div');
    card.className  = 'shawn__card bg-white mb-4 rounded shadow p-4';
    card.dataset.videoUrl = url;
    card.dataset.index    = index;

    const thumb      = thumbnail || 'https://via.placeholder.com/300x200';
    const hasComment = comments && comments.length > 0 && comments[0] !== '';
    const commentHTML = hasComment
        ? `<div class="text-sm px-4" style="color:#10425b;margin-bottom:10px;">${comments.join('<br>')}</div>`
        : '';

    // ← loading="lazy" prevents all thumbnails loading at once
    const imgBlock = (cls = '') => `
        <div class="shawn__thumbnail-container ${cls} rounded overflow-hidden">
            <img class="shawn__thumbnail" src="${thumb}" loading="lazy" decoding="async"
                 style="width:100%;object-fit:cover;border-radius:8px;" alt="">
            <span class="shawn__play-btn">
                <svg viewBox="0 0 36 36" fill="currentColor" xmlns="http://www.w3.org/2000/svg" style="width:16px;height:16px;">
                    <path d="M34 17.5C34 18.33 33.57 19.1 32.87 19.52L9.535 33.663C9.164 33.887 8.749 34 8.333 34 7.937 34 7.54 33.899 7.183 33.694 6.453 33.274 6 32.492 6 31.643V3.358C6 2.51 6.453 1.727 7.183 1.308 7.913.886 8.814.9 9.535 1.338L32.87 15.481C33.57 15.905 34 16.671 34 17.5"/>
                </svg>
            </span>
        </div>`;

    card.innerHTML = index % 2 === 0
        ? `<p class="font-bold text-sm mb-2 px-4 py-2" style="color:#10425b;">${username}</p>${commentHTML}${imgBlock('mt-2')}`
        : `${imgBlock('mb-3')}<p class="font-bold text-sm mt-3 mb-2 px-4 py-2" style="color:#10425b;">${username}</p>${commentHTML}`;

    return card;
}

// ─── Video element factory ────────────────────────────────────────────────────
function createVideoElement(url, height) {
    const v = document.createElement('video');
    v.className = 'shawn__media-preview';
    // preload="none" ← don't fetch anything until play() is called
    v.setAttribute('preload', 'none');
    v.setAttribute('playsinline', 'true');
    v.setAttribute('webkit-playsinline', 'true');
    v.setAttribute('x5-video-player-type', 'h5-page');
    v.muted = true;
    Object.assign(v.style, { height, width: '100%', objectFit: 'cover', borderRadius: '8px' });
    // Set src directly (not via <source>) so play() triggers fetch immediately
    v.src = url;
    return v;
}

// ─── Mute button ─────────────────────────────────────────────────────────────
function muteIcon(muted) {
    const speaker = `<path d="M4 15H5.586L10.293 19.707C10.923 20.337 12 19.891 12 19V5C12 4.109 10.923 3.663 10.293 4.293L5.586 9H4a1 1 0 00-1 1v4a1 1 0 001 1z" stroke="white" stroke-width="1.25" stroke-linejoin="round"/>`;
    const xLines  = `<path d="M19 12l2 2m-4 0l2-2-2 2zm2-2l2-2-2 2zm0 0l-2-2 2 2z" stroke="white" stroke-width="1.25" stroke-linecap="round"/>`;
    const waves   = `<path d="M16 8c1.333 1.833 1.333 6.167 0 8" stroke="white" stroke-width="1.25" stroke-linecap="round"/><path d="M18 5c2.667 3.5 2.667 10.5 0 14" stroke="white" stroke-width="1.25" stroke-linecap="round"/>`;
    return `<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width:20px;height:20px;">${speaker}${muted ? xLines : waves}</svg>`;
}

function addMuteControl(container, video) {
    const btn = document.createElement('button');
    btn.className = 'shawn__control-btn';
    btn.innerHTML = muteIcon(true);
    Object.assign(btn.style, { display: 'none' });
    btn.addEventListener('click', (e) => {
        e.stopPropagation();
        video.muted = !video.muted;
        btn.innerHTML = muteIcon(video.muted);
    });
    container.appendChild(btn);
    return btn;
}

// ─── Global active-video tracker ─────────────────────────────────────────────
// Ensures only one video plays at a time — key for mobile performance
let _activeStop = null;

function stopActive() {
    if (_activeStop) { _activeStop(); _activeStop = null; }
}

// ─── Video interaction (single definition) ───────────────────────────────────
function setupVideoHandlers(card, videoUrl, height) {
    const thumbnail = card.querySelector('.shawn__thumbnail');
    const playBtn   = card.querySelector('.shawn__play-btn');
    const container = card.querySelector('.shawn__thumbnail-container');
    let video = null, muteBtn = null;

    function showVideo() {
        if (video) return;          // already playing on this card
        stopActive();               // stop whatever was playing elsewhere

        video   = createVideoElement(videoUrl, `${height}px`);
        muteBtn = addMuteControl(container, video);
        container.insertBefore(video, playBtn);
        thumbnail.classList.add('hidden');
        playBtn.classList.add('hidden');
        muteBtn.style.display = 'block';

        // play() directly — no load() call needed, browser handles buffering
        video.play().catch(() => {
            // iOS: autoplay blocked — show tap-to-play overlay
            const overlay = document.createElement('button');
            overlay.className = 'shawn__play-btn';
            container.appendChild(overlay);
            overlay.addEventListener('click', (e) => {
                e.stopPropagation();
                video.play();
                overlay.remove();
            }, { once: true });
        });

        // Register stop callback so global tracker can clean up this card
        _activeStop = hideVideo;
    }

    function hideVideo() {
        if (!video) return;
        video.pause();
        video.removeAttribute('src');   // release network connection immediately
        video.load();                   // abort pending fetch
        video.remove();
        muteBtn.remove();
        thumbnail.classList.remove('hidden');
        playBtn.classList.remove('hidden');
        video = null; muteBtn = null;
        if (_activeStop === hideVideo) _activeStop = null;
    }

    playBtn.addEventListener('click', (e) => { e.stopPropagation(); showVideo(); });
    container.addEventListener('touchstart', (e) => { e.stopPropagation(); showVideo(); }, { passive: true });

    if (window.innerWidth >= 768) {
        container.addEventListener('mouseenter', showVideo);
        container.addEventListener('mouseleave', hideVideo);
    }
}

// ─── Pre-build card elements & category buckets ───────────────────────────────
const cards = mediaData.map((data, i) => createCard(data, i));

const buckets = { all: cards };
mediaData.forEach(({ category }, i) => {
    if (!buckets[category]) buckets[category] = [];
    buckets[category].push(cards[i]);
});

// ─── Main controller ──────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    const columns = ['shawn__column1','shawn__column2','shawn__column3','shawn__column4']
        .map(id => document.getElementById(id)).filter(Boolean);
    const tabButtons  = document.querySelectorAll('.tab-btn');
    const loadMoreBtn = document.getElementById('load-more-btn');
    if (!loadMoreBtn) return;

    let currentCards = cards;
    let loadedCount  = 0;

    function clearColumns() {
        stopActive();                           // stop video before wiping DOM
        columns.forEach(col => (col.innerHTML = ''));
    }

    function appendCards(subset, startIndex) {
        const colCount = getColumnCount();
        subset.forEach((card, idx) => {
            const globalIndex = startIndex + idx;
            const cloned  = card.cloneNode(true);
            const height  = getCardHeight(globalIndex);
            cloned.querySelector('.shawn__thumbnail').style.height = `${height}px`;
            setupVideoHandlers(cloned, card.dataset.videoUrl, height);
            columns[globalIndex % colCount].appendChild(cloned);
        });
    }

    function render(filtered, limit) {
        clearColumns();
        const count = Math.min(limit, filtered.length);
        appendCards(filtered.slice(0, count), 0);
        loadedCount = count;
        syncLoadMoreBtn();
    }

    function syncLoadMoreBtn() {
        loadMoreBtn.classList.toggle('hidden', loadedCount >= currentCards.length);
    }

    // Tab switching
    tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            tabButtons.forEach(b => b.classList.remove('shawn__tab-active'));
            btn.classList.add('shawn__tab-active');
            currentCards = buckets[btn.dataset.tab] || [];
            render(currentCards, INITIAL_LOAD);
        });
    });

    // Load more
    loadMoreBtn.addEventListener('click', () => {
        const start = loadedCount;
        const end   = Math.min(start + LOAD_MORE_COUNT, currentCards.length);
        appendCards(currentCards.slice(start, end), start);
        loadedCount = end;
        syncLoadMoreBtn();
    });

    // Resize (debounced)
    let resizeTimer;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => render(currentCards, loadedCount), 150);
    });

    // Init
    tabButtons[0]?.classList.add('shawn__tab-active');
    currentCards = cards;
    render(currentCards, INITIAL_LOAD);
});
</script>