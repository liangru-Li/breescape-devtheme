    { category: "cooling",    url: "https://cdn2.videowise.com/converted/videos/1742551948411_wid_NjdkZDNiOGMzNGQwYWQwMDU2MDVkZmU3_h264c.mp4",    thumbnail: "https://cdn2.videowise.com/custom-videos/thumbnails/1742551960308_9787f131-d18e-44f9-9965-17be9d587f83.webp",       username: "@amerikada.mutfak",        comments: [""] },
