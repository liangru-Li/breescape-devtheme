{% case position %}
  {% when 'primary-button' %}
    <style>
      .discover-btn {
        position: relative;
        overflow: hidden;
        display: inline-flex;
        align-items: center;

        height: 48px;
        border-radius: 48px;
        background: linear-gradient(270deg, #67D2E087 0%, #67D2E054 100%);
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
        border: 1px solid #ffffff50;
        backdrop-filter: blur(2px);

        transition: transform 0.2s ease, filter 0.2s ease;
      }

      .discover-btn::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        opacity: 0;
        pointer-events: none;
        z-index: 0;

        background: linear-gradient(90deg, #39c3cc 0%, #6fe6ec 40%, #baf7fa 100%);
        transition: opacity 0.25s ease;
      }

      .discover-btn::before {
        content: '';
        position: absolute;
        top: -30%;
        left: -55%;
        width: 55%;
        height: 160%;
        z-index: 0;
        pointer-events: none;

        background: linear-gradient(
          120deg,
          rgba(255, 255, 255, 0) 0%,
          rgba(255, 255, 255, 0.55) 45%,
          rgba(255, 255, 255, 0) 75%
        );
        transform: skewX(-18deg);
        opacity: 0.55;
        transition: left 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease;
      }

      .discover-btn__icon,
      .discover-btn__text {
        position: relative;
        z-index: 2;
      }

      .discover-btn__text {
        flex: 1 1 auto;
        width: 100%;
        justify-content: center;
        font-weight:500;
        padding-left: calc(30px + 10px);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.9) !important;

        transform: translateX(0);
        transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.2, 1), color 0.25s ease;
      }

      .discover-btn__icon {
        position: absolute;
        top: 50%;
        left: 2px;
        transform: translateY(-50%);
        z-index: 3;

        width: 40px;
        height: 40px;
        border-radius: 50%;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        background: #67D2E0;
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55);

        transition: left 0.35s cubic-bezier(0.2, 0.9, 0.2, 1), background 0.25s ease, box-shadow 0.25s ease,
          transform 0.2s ease;
      }


      .discover-btn__icon svg {
        width: 16px;
        height: 16px;
        color: #ffffff;
        opacity: 0.95;
        transition: color 0.25s ease, opacity 0.25s ease;
      }


      .discover-btn:hover {
        filter: brightness(1.03);
      }
      .discover-btn:hover::before {
        left: 115%;
        opacity: 0.7;
      }
      .discover-btn:hover::after {
        opacity: 1;
      }

      .discover-btn:hover .discover-btn__icon {
        left: calc(100% - 40px - 2px);
        background: radial-gradient(circle at 30% 30%, #ffffff 0%, #e9feff 60%, #d7fdff 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.95);
      }
      .discover-btn:hover .discover-btn__icon svg {
        color: #2fbfc8;
        opacity: 1;
      }

      .discover-btn:hover .discover-btn__text {
        transform: translateX(-40px);
        color: rgba(255, 255, 255, 1);
      }

      @media screen and (max-width: 767px) {
        .discover-btn {
          height: 32px;
          padding-top: 0;
          padding-bottom: 0;
        }
        .discover-btn__icon {
          width: 28px;
          height: 28px;
        }
        .discover-btn__icon svg {
          width: 16px;
          height: 16px;
        }
        .discover-btn__text {
          font-size: 10px;
          padding-left: calc(5px + 10px);
        }
      }
    </style>
{% endcase %}
