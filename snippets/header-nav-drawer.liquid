{%- doc -%}
  Renders mobile drawer navigation with multi-level menus, product showcases, and promotions.

  Supports standard navigation, mega menu tabs, product grids, and promotional content.

  @param {object} section - Section object with navigation settings and menu blocks
  @param {object} link - Navigation link object containing title and child links
  @param {object} block - Mega menu block configuration for advanced content
  @param {number} position - Numeric position for unique element IDs
  @param {boolean} enable_mega_menu - Enable promotional content and mega features
  @param {boolean} enable_accordion_menu - Enable accordion menu style

  @example
  {% render 'header-nav-drawer',
     section: section,
     link: link,
     block: block,
     position: forloop.index,
     enable_mega_menu: true,
     enable_accordion_menu: false
  %}
{%- enddoc -%}

{%- liquid
  assign section_rendering_api = false
  if section.index == nil
    assign section_rendering_api = true
  endif

  assign m_layout = 'default'
  assign m_sidebar = blank
  assign m_products = blank
  assign m_cols = 2
  assign m_gap = 12
  assign m_card_max = 160
  assign m_title_bottom = 12
  assign m_badge_size = 8
  assign m_show_sidebar = false
  assign m_button_label = blank
  assign m_button_link = blank
  assign m_show_promotions = false
  assign m_is_grid_layout = false

  if block != blank
    assign m_button_label = block.settings.button_label_mobile | default: block.settings.button_label
    assign m_button_link = block.settings.button_link_mobile | default: block.settings.button_link
    if block.settings.promo_image_1 != blank or block.settings.promo_image_2 != blank or block.settings.promo_image_3 != blank or block.settings.promo_image_4 != blank or block.settings.promo_image_5 != blank
      assign m_show_promotions = true
    endif

    if block.type == 'mega_menu'
      assign m_layout = block.settings.layout_style_mobile | default: 'inherit'
      if m_layout == 'inherit' or m_layout == blank
        assign m_layout = block.settings.layout_style | default: 'default'
      endif
      assign m_sidebar = block.settings.sidebar_menu_mobile | default: block.settings.sidebar_menu
      assign m_products = block.settings.grid_products_mobile
      if m_products == blank or m_products.size == 0
        assign m_products = block.settings.grid_products
      endif
      assign m_cols = block.settings.grid_columns_mobile | default: 2
      assign m_gap = block.settings.grid_gap_mobile | default: 12
      assign m_card_max = block.settings.card_max_width_mobile | default: 160
      assign m_title_bottom = block.settings.title_bottom_mobile | default: 12
      assign m_badge_size = block.settings.badge_size_mobile | default: 8
      if m_layout == 'images_only'
        assign m_is_grid_layout = true
        assign m_show_sidebar = false
        assign m_products = blank
      elsif m_layout == 'sidebar_grid'
        assign m_is_grid_layout = true
        if m_sidebar != blank and m_sidebar.links.size > 0
          assign m_show_sidebar = true
        endif
        if block.settings.hide_mobile_sidebar
          assign m_show_sidebar = false
        endif
      elsif m_layout == 'links_only'
        assign m_is_grid_layout = false
        assign m_show_sidebar = false
        assign m_products = blank
      endif
    endif
  endif
-%}
{%- liquid
  capture chevron_icon
    if enable_accordion_menu
      render 'icon', icon: 'chevron-down', size: 'lg'
    else
      render 'icon', icon: 'chevron-right', size: 'lg'
    endif
  endcapture
-%}
<details is="{% if enable_accordion_menu %}accordion-details{% else %}menu-details{% endif %}">
  <summary class="drawer__menu-item block cursor-pointer relative" aria-expanded="false">
    <span class="heading text-2xl leading-none tracking-tight">
      {%- unless section_rendering_api -%}
        <api-button class="api-only" data-id="DrawerSubMenu-{{ section.id }}-{{ position }}" data-section-id="{{ section.id }}"></api-button>
      {%- endunless -%}
      {{- link.title | escape -}}
    </span>
    {{- chevron_icon -}}
  </summary>
  <div class="drawer__submenu{% unless enable_accordion_menu %} z-1 absolute top-0 left-0{% endunless %} flex flex-col w-full h-full" data-parent>
    {%- unless enable_accordion_menu -%}
      <button type="button" class="tracking-tight heading text-base shrink-0 flex items-center gap-3 w-full" data-close>{{ link.title | escape }}</button>
    {%- endunless -%}
    {%- unless section_rendering_api -%}
      <div id="DrawerSubMenu-{{ section.id }}-{{ position }}" class="drawer__scrollable flex flex-col h-full"></div>
    {%- else -%}
      <ul id="DrawerSubMenu-{{ section.id }}-{{ position }}" class="drawer__scrollable flex flex-col h-full">
        {%- if block != blank and block.settings.drawer_promo_image != blank -%}
          <li class="menu-drawer__promo">
            <a
              class="menu-drawer__promo-card"
              {% if block.settings.drawer_promo_link != blank %}href="{{ block.settings.drawer_promo_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
            >
              <div class="menu-drawer__promo-media">
                {{- block.settings.drawer_promo_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', class: 'menu-drawer__promo-img', alt: block.settings.drawer_promo_heading | default: link.title | escape -}}
              </div>
              {%- if block.settings.drawer_promo_heading != blank or block.settings.drawer_promo_subtext != blank -%}
                <span class="menu-drawer__promo-copy">
                  {%- if block.settings.drawer_promo_heading != blank -%}
                    <span class="menu-drawer__promo-title">{{ block.settings.drawer_promo_heading | escape }}</span>
                  {%- endif -%}
                  {%- if block.settings.drawer_promo_subtext != blank -%}
                    <span class="menu-drawer__promo-sub">{{ block.settings.drawer_promo_subtext | escape }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </a>
          </li>
        {%- endif -%}

        {%- if block.type == 'mega_menu_tab' -%}
          {%- for i in (1..5) -%}
            {%- assign tab_target_link = 'tab_target_link_' | append: i -%}
            {%- if block.settings[tab_target_link] != blank -%}
              <li class="drawer__menu-group">
                {%- liquid
                  assign tab_target = 'tab_target_' | append: i
                  assign tab_target_heading = block.settings[tab_target] | default: block.settings[tab_target_link].object.title
                  assign tab_product_limit = 'tab_product_limit_' | append: i
                  assign tab_products = 'tab_products_' | append: i
                  assign products = block.settings[tab_products] | default: block.settings[tab_target_link].object.products
                -%}
                {%- if block.settings[tab_target_link].type == 'collection_link' and products.count > 0 -%}
                  <details is="{% if enable_accordion_menu %}accordion-details{% else %}menu-details{% endif %}">
                    <summary class="drawer__menu-item block heading text-2xl leading-none tracking-tight cursor-pointer relative" aria-expanded="false">
                      {%- liquid
                        echo tab_target_heading | escape
                        echo chevron_icon
                      -%}
                    </summary>
                    <div class="drawer__submenu{% unless enable_accordion_menu %} z-1 absolute top-0 left-0{% endunless %} flex flex-col w-full h-full">
                      {%- unless enable_accordion_menu -%}
                        <button type="button" class="tracking-tight heading text-base flex items-center gap-3 w-full" data-close>{{ block.settings[tab_target] | escape }}</button>
                      {%- endunless -%}
                      <div class="drawer__scrollable flex flex-col h-full">
                        <div class="horizontal-products product-grid">
                          {%- for product in products limit: block.settings[tab_product_limit] -%}
                            {%- render 'product-card-horizontal',
                              product: product,
                              product_id: product.id,
                              section_id: section.id,
                              block_id: block.id,
                              image_ratio: settings.product_image_ratio,
                              image_fill: settings.product_image_fill,
                              show_vendor: block.settings.show_vendor,
                              show_price: block.settings.show_price,
                              show_quick_add: settings.product_quick_add,
                              show_quick_view: settings.product_quick_view,
                              accessibility: true
                            -%}
                          {%- else -%}
                            {%- for i in (1..4) -%}
                              {%- render 'product-card-horizontal',
                                product: blank,
                                product_id: i,
                                section_id: section.id,
                                block_id: block.id,
                                image_ratio: settings.product_image_ratio,
                                image_fill: settings.product_image_fill,
                                show_vendor: block.settings.show_vendor,
                                show_price: block.settings.show_price,
                                show_quick_add: settings.product_quick_add,
                                show_quick_view: settings.product_quick_view,
                                accessibility: true
                              -%}
                            {%- endfor -%}
                          {%- endfor -%}
                        </div>
                      </div>
                      <div class="drawer__sticky w-full">
                        <a class="button button--primary icon-with-text w-full" href="{{ block.settings[tab_target_link].url }}" is="hover-link">
                          <span class="btn-fill" data-fill></span>
                          <span class="btn-text">
                            {{ 'collections.subcollections.all_products' | t: collection: tab_target_heading }}
                            ({{ block.settings[tab_target_link].object.all_products_count }})
                            {%- render 'icon', icon: 'arrow-right', size: 'sm', class: 'transform' -%}
                          </span>
                        </a>
                      </div>
                    </div>
                  </details>
                {%- else -%}
                  <a class="drawer__menu-item block heading text-2xl leading-none tracking-tight" href="{{ block.settings[tab_target_link] }}">
                    {{ block.settings[tab_target] | escape }}
                  </a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- elsif m_layout == 'links_only' -%}
          {%- comment -%} 只显示文字链接：使用「链接列表（移动端）」菜单，不渲染任何图片 {%- endcomment -%}
          {%- if m_sidebar != blank and m_sidebar.links.size > 0 -%}
            {%- for side_link in m_sidebar.links -%}
              <li class="drawer__menu-group">
                <a class="drawer__menu-item menu-drawer__link block heading text-2xl leading-none tracking-tight" href="{{ side_link.url }}">
                  <span>{{ side_link.title | escape }}</span>
                  {%- render 'icon', icon: 'chevron-right', size: 'xs', class: 'menu-drawer__chevron shrink-0' -%}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for childlink in link.links -%}
              <li class="drawer__menu-group">
                {%- if childlink.links != blank -%}
                  <details is="{% if enable_accordion_menu %}accordion-details{% else %}menu-details{% endif %}">
                    <summary class="drawer__menu-item block heading text-2xl leading-none tracking-tight cursor-pointer relative" aria-expanded="false">
                      {%- liquid
                        echo childlink.title | escape
                        echo chevron_icon
                      -%}
                    </summary>
                    <div class="drawer__submenu{% unless enable_accordion_menu %} z-1 absolute top-0 left-0{% endunless %} flex flex-col w-full h-full">
                      {%- unless enable_accordion_menu -%}
                        <button type="button" class="tracking-tight heading text-base flex items-center gap-3 w-full" data-close>{{ childlink.title | escape }}</button>
                      {%- endunless -%}
                      <ul class="drawer__scrollable flex flex-col h-full">
                        {%- for grandchildlink in childlink.links -%}
                          <li class="drawer__menu-group">
                            <a class="drawer__menu-item block heading text-2xl leading-none tracking-tight" href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </details>
                {%- else -%}
                  <a class="drawer__menu-item menu-drawer__link block heading text-2xl leading-none tracking-tight" href="{{ childlink.url }}">
                    <span>{{ childlink.title | escape }}</span>
                    {%- render 'icon', icon: 'chevron-right', size: 'xs', class: 'menu-drawer__chevron shrink-0' -%}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        {%- elsif m_is_grid_layout -%}
          {%- comment -%} Mobile: sidebar+products, or images_only using dedicated io_image cards {%- endcomment -%}
          <li class="drawer__menu-group drawer__mega-sidebar-grid">
            <div
              class="drawer__mega-grid{% if m_show_sidebar %} drawer__mega-grid--has-sidebar{% endif %}{% if m_layout == 'images_only' %} drawer__mega-grid--images-only{% endif %}"
              style="--mega-grid-cols: {{ m_cols }};--mega-grid-gap: {{ m_gap }}px;--mega-card-max: {{ m_card_max }}px;--mega-title-bottom: {{ m_title_bottom }}px;--mega-badge-size: {{ m_badge_size }}px;"
            >
              {%- if m_show_sidebar -%}
                <aside class="drawer__mega-sidebar">
                  <ul class="drawer__mega-sidebar-list" role="list">
                    {%- for side_link in m_sidebar.links -%}
                      <li>
                        <a href="{{ side_link.url }}" class="drawer__mega-sidebar-link{% if side_link.current %} is-active{% endif %}"{% if side_link.current %} aria-current="page"{% endif %}>
                          {{- side_link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </aside>
              {%- endif -%}

              <div class="drawer__mega-grid-panel">
                {%- if m_layout != 'images_only' and m_products != blank and m_products.size > 0 -%}
                  <ul class="drawer__mega-product-grid" role="list">
                    {%- for product in m_products -%}
                      {%- liquid
                        assign card_badge = blank
                        assign card_badge_class = ''
                        assign has_theme_label = false
                        if product.metafields.theme.label.value != blank
                          assign has_theme_label = true
                        endif
                        unless has_theme_label
                          for tag in product.tags
                            assign tag_down = tag | downcase
                            if tag_down == 'best seller' or tag_down == 'bestseller' or tag_down contains 'best seller'
                              assign card_badge = 'BEST SELLER'
                              assign card_badge_class = 'is-bestseller'
                              break
                            endif
                            if tag_down == 'new arrival' or tag_down contains 'new arrival'
                              assign card_badge = 'New Arrival'
                              assign card_badge_class = 'is-new'
                              break
                            endif
                            if tag_down == 'new' or tag_down contains 'new'
                              assign card_badge = 'New Arrival'
                              assign card_badge_class = 'is-new'
                              break
                            endif
                            if tag_down contains 'bundle'
                              assign card_badge = tag
                              assign card_badge_class = 'is-bundle'
                              break
                            endif
                          endfor
                        endunless
                        assign card_subtitle = product.metafields.custom.mega_menu_subtitle.value | default: product.metafields.custom.piece_count.value | default: blank
                        assign card_pieces = product.metafields.custom.pieces.value | default: product.metafields.custom.pieces | default: product.metafields.custom.piece_count.value | default: blank

                        comment
                          先匹配文件名含 breescapeHeaderTab_navigation 的图（会同时命中 _mb_ / _pc_），
                          移动端只用含 _mb_ 的那张；名称取 _mb_ 后面的值。
                        endcomment
                        assign nav_tab_image = blank
                        assign nav_tab_title = blank
                        for pimg in product.images
                          assign psrc = pimg.src | downcase
                          if psrc contains 'breescapeheadertab_navigation' and psrc contains '_mb_'
                            assign nav_tab_image = pimg
                            assign nav_fname = pimg.src | split: '/' | last | split: '?' | first
                            assign nav_fname_base = ''
                            assign nav_fname_parts = nav_fname | split: '.'
                            for nav_part in nav_fname_parts
                              unless forloop.last
                                if nav_fname_base != blank
                                  assign nav_fname_base = nav_fname_base | append: '.'
                                endif
                                assign nav_fname_base = nav_fname_base | append: nav_part
                              endunless
                            endfor
                            assign nav_try = nav_fname_base | split: '_mb_'
                            if nav_try.size < 2
                              assign nav_try = nav_fname_base | split: '_MB_'
                            endif
                            if nav_try.size < 2
                              assign nav_try = nav_fname_base | downcase | split: '_mb_'
                            endif
                            if nav_try.size > 1
                              assign nav_tab_title = nav_try.last | replace: '_R_', '®' | replace: '_r_', '®' | replace: '_.', '.' | replace: '._', '.' | replace: '_', ' ' | replace: ' . ', '.' | replace: ' .', '.' | replace: '. ', '.'
                            endif
                            break
                          endif
                        endfor
                        if nav_tab_image == blank
                          assign nav_tab_image = product.featured_image
                        endif
                        if nav_tab_title == blank
                          assign nav_tab_title = product.title
                        endif
                      -%}
                      <li class="drawer__mega-product-card-wrap">
                        <a href="{{ product.url }}" class="drawer__mega-product-card" aria-label="{{ nav_tab_title | escape }}">
                          <div class="drawer__mega-product-media">
                            {%- if has_theme_label -%}
                              {%- render 'product-badges', product: product, class: 'drawer__mega-product-badges' -%}
                            {%- elsif card_badge != blank -%}
                              <span class="drawer__mega-product-badge mega-menu__product-badge {{ card_badge_class }}">{{ card_badge }}</span>
                            {%- endif -%}
                            {%- if nav_tab_image != blank -%}
                              {%- assign card_img_alt = nav_tab_image.alt | default: nav_tab_title -%}
                              {{- nav_tab_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,400,600', class: 'drawer__mega-product-img', alt: card_img_alt -}}
                            {%- else -%}
                              {{ 'product-1' | placeholder_svg_tag: 'drawer__mega-product-img placeholder' }}
                            {%- endif -%}
                          </div>
                          <div class="drawer__mega-product-meta">
                            <p class="drawer__mega-product-title">
                              <span class="drawer__mega-product-title-text">{{ nav_tab_title | escape }}{%- if card_pieces != blank -%}<span class="mega-menu__product-pieces">{{ card_pieces | escape }}</span>{%- endif -%}</span>
                            </p>
                            {%- if card_subtitle != blank -%}
                              <p class="drawer__mega-product-subtitle">{{ card_subtitle | escape }}</p>
                            {%- endif -%}
                          </div>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- elsif m_layout == 'images_only' -%}
                  {%- liquid
                    assign io_tag_bg_rgb = block.settings.io_tag_bg.rgb | default: '0,0,0'
                    assign io_tag_bg_op = block.settings.io_tag_bg_opacity | default: 0 | divided_by: 100.0
                    assign io_tag_size = block.settings.io_tag_size | default: 15
                    assign io_tag_color = block.settings.io_tag_color.rgb | default: '255,255,255'
                  -%}
                  <ul class="drawer__mega-product-grid drawer__mega-product-grid--promo" role="list">
                    {%- for i in (1..6) -%}
                      {%- assign io_image = 'io_image_' | append: i -%}
                      {%- if block.settings[io_image] != blank -%}
                        {%- liquid
                          assign io_tag = 'io_tag_' | append: i
                          assign io_link = 'io_link_' | append: i
                          assign io_label = block.settings[io_tag]
                          assign io_aria = io_label | default: 'Image'
                        -%}
                        <li class="drawer__mega-product-card-wrap drawer__mega-product-card-wrap--promo">
                          <a
                            class="mega-menu__promo-card"
                            {% if block.settings[io_link] != blank %}href="{{ block.settings[io_link] }}"{% else %}role="link" aria-disabled="true"{% endif %}
                            aria-label="{{ io_aria | escape }}"
                            style="--mega-promo-tag-color: {{ io_tag_color }};--mega-promo-tag-bg: {{ io_tag_bg_rgb }};--mega-promo-tag-bg-opacity: {{ io_tag_bg_op }};--mega-promo-tag-size: {{ io_tag_size }}px;--mega-promo-tag-weight: 600;"
                          >
                            <div class="mega-menu__promo-media">
                              {{- block.settings[io_image] | image_url: width: block.settings[io_image].width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080', class: 'mega-menu__promo-img', is: 'lazy-image', alt: io_aria -}}
                            </div>
                            {%- if io_label != blank -%}
                              <span class="mega-menu__promo-tag">{{ io_label | escape }}</span>
                            {%- endif -%}
                          </a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- else -%}
          {%- for childlink in link.links -%}
            <li class="drawer__menu-group">
              {%- if childlink.links != blank -%}
                <details is="{% if enable_accordion_menu %}accordion-details{% else %}menu-details{% endif %}">
                  <summary class="drawer__menu-item block heading text-2xl leading-none tracking-tight cursor-pointer relative" aria-expanded="false">
                    {%- liquid
                      echo childlink.title | escape
                      echo chevron_icon
                    -%}
                  </summary>
                  <div class="drawer__submenu{% unless enable_accordion_menu %} z-1 absolute top-0 left-0{% endunless %} flex flex-col w-full h-full">
                    {%- unless enable_accordion_menu -%}
                      <button type="button" class="tracking-tight heading text-base flex items-center gap-3 w-full" data-close>{{ childlink.title | escape }}</button>
                    {%- endunless -%}
                    <ul class="drawer__scrollable flex flex-col h-full">
                      {%- for grandchildlink in childlink.links -%}
                        <li class="drawer__menu-group">
                          <a class="drawer__menu-item block heading text-2xl leading-none tracking-tight" href="{{ grandchildlink.url }}">{{ grandchildlink.title | escape }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </details>
              {%- else -%}
                <a class="drawer__menu-item block heading text-2xl leading-none tracking-tight" href="{{ childlink.url }}">{{ childlink.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}

          {%- if enable_mega_menu -%}
            {%- liquid
              assign show_promotions = m_show_promotions
              if m_layout == 'links_only'
                assign show_promotions = false
              endif
              if block.type == 'mega_menu_tab'
                if block.settings.tab_target_link_1 == blank and block.settings.tab_target_link_2 == blank and block.settings.tab_target_link_3 == blank and block.settings.tab_target_link_4 == blank and block.settings.tab_target_link_5 == blank
                  assign show_promotions = false
                endif
              endif
            -%}
          {%- endif -%}
          {%- if show_promotions -%}
            <li class="drawer__menu-group drawer__promotions">
              <ul class="mega-menu__list grid grid-cols-2 w-full h-full" role="list" tabindex="-1">
                {%- for i in (1..5) -%}
                  {%- liquid
                    assign show_promotion = false
                    assign promo_image = 'promo_image_' | append: i
                    if block.settings[promo_image] != blank
                      assign show_promotion = true
                    endif
                    if block.type == 'mega_menu_tab'
                      assign tab_target_link = 'tab_target_link_' | append: i
                      if block.settings[tab_target_link] == blank
                        assign show_promotion = false
                      endif
                    endif
                  -%}
                  {%- if show_promotion -%}
                    {%- liquid
                      assign promo_image_ratio = 'promo_image_ratio_' | append: i
                      assign promo_heading = 'promo_heading_' | append: i
                      assign promo_subtext = 'promo_subtext_' | append: i
                      assign promo_overlay_content = 'promo_overlay_content_' | append: i
                      assign promo_link = 'promo_link_' | append: i
                      assign promo_tag = 'promo_tag_' | append: i
                      assign promo_color_text = 'promo_color_text_' | append: i
                      assign promo_color_overlay = 'promo_color_overlay_' | append: i
                      assign promo_overlay_opacity = 'promo_overlay_opacity_' | append: i
                    -%}
                    <li class="drawer__menu-group mega-menu__item flex opacity-0 w-full">
                      <div class="media-card media-card--{{ settings.card_style }}{% if block.settings[promo_overlay_content] %} media-card--overlap{% endif %}">
                        <a class="media-card__link flex flex-col w-full h-full relative"{% if block.settings[promo_link] != blank %} href="{{ block.settings[promo_link] }}"{% else %} role="link" aria-disabled="true"{% endif %}
                          aria-label="{{ block.settings[promo_heading] | default: block.settings[promo_subtext] | escape }}"
                          style="--color-foreground: {{ block.settings[promo_color_text].rgb }};--color-overlay: {{ block.settings[promo_color_overlay].rgb }};--overlay-opacity: {{ block.settings[promo_overlay_opacity] | divided_by: 100.0 }};"
                        >
                          {%- if block.settings[promo_tag] != blank -%}
                            <div class="badges z-2 absolute grid gap-3 pointer-events-none">
                              <span class="badge badge--onsale flex items-center gap-1d5 font-medium leading-none">{{ block.settings[promo_tag] | escape }}</span>
                            </div>
                          {%- endif -%}
                          <div class="media media--{{ block.settings[promo_image_ratio] }} relative overflow-hidden">
                            {{- block.settings[promo_image] | image_url: width: block.settings[promo_image].width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080', is: 'lazy-image' -}}
                          </div>
                          {%- if block.settings[promo_heading] != blank or block.settings[promo_subtext] != blank -%}
                            <div class="media-card__content flex justify-between items-center gap-4 w-full">
                              <div class="media-card__text opacity-0 shrink-1 grid gap-0d5">
                                {%- if block.settings[promo_heading] != blank -%}
                                  <p>
                                    <span class="heading reversed-link text-lg tracking-tighter leading-tight">{{ block.settings[promo_heading] | escape }}</span>
                                  </p>
                                {%- endif -%}
                                {%- if block.settings[promo_subtext] != blank -%}
                                  <p class="leading-none text-xs xl:text-sm hidden md:block">{{ block.settings[promo_subtext] }}</p>
                                {%- endif -%}
                              </div>
                              {%- render 'icon', icon: 'arrow-right', size: 'xs', class: 'transform shrink-0 hidden md:block' -%}
                            </div>
                          {%- endif -%}
                        </a>
                      </div>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </li>
          {%- endif -%}
        {%- endif -%}

        {%- if m_button_label != blank -%}
          <li class="mega-menu__footer">
            <a class="button button--primary icon-with-text w-full"{% if m_button_link != blank %} href="{{ m_button_link }}"{% if block.settings.button_external %} target="_blank" rel="noopener noreferrer"{% endif %}{% else %} role="link" aria-disabled="true"{% endif %} is="hover-link">
              <span class="btn-fill" data-fill></span>
              <span class="btn-text">{{ m_button_label | escape }}</span>
            </a>
          </li>
        {%- endif -%}

        {%- liquid
          assign mega_secondary_menu = blank
          if block != blank
            assign mega_secondary_menu = block.settings.drawer_secondary_menu
          endif
        -%}
        {%- if mega_secondary_menu != blank and mega_secondary_menu.links.size > 0 -%}
          {%- assign mega_secondary_icon_size = block.settings.drawer_secondary_icon_size | default: 13 -%}
          <li class="menu-drawer__secondary" style="--menu-drawer-secondary-icon-size: {{ mega_secondary_icon_size }}px;">
            <ul class="menu-drawer__secondary-list" role="list">
              {%- for slink in mega_secondary_menu.links -%}
                {%- if slink.url != blank -%}
                  {%- liquid
                    assign mega_secondary_icon_key = 'drawer_secondary_icon_' | append: forloop.index
                    assign mega_secondary_icon = block.settings[mega_secondary_icon_key]
                  -%}
                  <li>
                    <a href="{{ slink.url }}" class="menu-drawer__secondary-link">
                      {%- if mega_secondary_icon != blank -%}
                        <span class="menu-drawer__secondary-icon" aria-hidden="true">
                          {{- mega_secondary_icon
                            | image_url: width: 96
                            | image_tag:
                              loading: 'lazy',
                              widths: '40,60,80,96',
                              width: mega_secondary_icon_size,
                              height: mega_secondary_icon_size,
                              class: 'menu-drawer__secondary-icon-img',
                              alt: '',
                              style: 'width: var(--menu-drawer-secondary-icon-size); height: var(--menu-drawer-secondary-icon-size); max-width: none;'
                          -}}
                        </span>
                      {%- endif -%}
                      <span>{{ slink.title | escape }}</span>
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </li>
        {%- endif -%}
      </ul>
    {%- endunless -%}
  </div>
</details>
