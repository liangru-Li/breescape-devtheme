{%- doc -%}
  Renders desktop mega menu with navigation links, product grids, or tabbed collections.

  Supports standard multi-column navigation or advanced tabbed product showcases.

  @param {object} section - Section object with menu configuration
  @param {object} link - Parent navigation link with child items
  @param {object} block - Mega menu block settings and content
  @param {number} position - Menu position for unique IDs
  @param {string} context - Context identifier for ID generation
  @param {boolean} full_width - Enable full-width container

  @example
  {% render 'header-nav-mega',
     section: section,
     link: link,
     block: block,
     position: forloop.index,
     context: 'start'
  %}
{%- enddoc -%}

{%- liquid
  assign section_rendering_api = false
  if section.index == nil
    assign section_rendering_api = true
  endif
-%}

{%- if block.type == 'mega_menu' -%}
  {%- liquid
    assign show_promotions = false
    if block.settings.promo_image_1 != blank or block.settings.promo_image_2 != blank or block.settings.promo_image_3 != blank or block.settings.promo_image_4 != blank or block.settings.promo_image_5 != blank
      assign show_promotions = true
    endif
    assign layout_style = block.settings.layout_style | default: 'default'
    assign sidebar_menu = block.settings.sidebar_menu
    assign grid_products = block.settings.grid_products
    assign grid_columns = block.settings.grid_columns | default: 5
    assign grid_width_percent = block.settings.grid_width_percent | default: 70
    assign grid_gap = block.settings.grid_gap | default: 16
    assign card_max_width = block.settings.card_max_width | default: 220
    assign title_bottom = block.settings.title_bottom | default: 12
    assign badge_size = block.settings.badge_size | default: 8
    assign show_sidebar = false
    assign is_grid_layout = false
    if layout_style == 'sidebar_grid' or layout_style == 'images_only'
      assign is_grid_layout = true
    endif
    if layout_style == 'images_only'
      assign show_sidebar = false
      assign grid_products = blank
      assign grid_width_percent = 100
    elsif sidebar_menu != blank and sidebar_menu.links.size > 0
      assign show_sidebar = true
    endif
    capture sidebar_grid_style
      echo '--mega-grid-width: '
      echo grid_width_percent
      echo '%;--mega-grid-cols: '
      echo grid_columns
      echo ';--mega-grid-gap: '
      echo grid_gap
      echo 'px;--mega-card-max: '
      echo card_max_width
      echo 'px;--mega-title-bottom: '
      echo title_bottom
      echo 'px;--mega-badge-size: '
      echo badge_size
      echo 'px;'
    endcapture
  -%}

  {%- if is_grid_layout -%}
    <div class="mega-menu__container invisible">
      {%- unless section_rendering_api -%}
        <div id="HeaderNavMega-{{ section.id }}-{{ position }}-{{ context }}" class="mega-menu__list mega-menu__list--sidebar-grid{% if layout_style == 'images_only' %} mega-menu__list--images-only{% endif %} page-width{% if full_width %} page-width--full{% endif %}{% if show_sidebar %} mega-menu__list--has-sidebar{% endif %} w-full h-full overflow-hidden" style="{{ sidebar_grid_style }}" tabindex="-1">
          {%- if show_sidebar -%}
            <aside class="mega-menu__sidebar opacity-0"></aside>
          {%- endif -%}
          <div class="mega-menu__grid-panel opacity-0">
            <ul class="mega-menu__product-grid" role="list">
              {%- for i in (1..grid_columns) -%}
                <li class="mega-menu__product-card mega-menu__product-card--placeholder"></li>
              {%- endfor -%}
            </ul>
          </div>
        </div>
      {%- else -%}
        <div id="HeaderNavMega-{{ section.id }}-{{ position }}-{{ context }}" class="mega-menu__list mega-menu__list--sidebar-grid{% if layout_style == 'images_only' %} mega-menu__list--images-only{% endif %} page-width{% if full_width %} page-width--full{% endif %}{% if show_sidebar %} mega-menu__list--has-sidebar{% endif %} w-full h-full overflow-hidden" style="{{ sidebar_grid_style }}" tabindex="-1">
          {%- if show_sidebar -%}
            <aside class="mega-menu__sidebar opacity-0">
              <ul class="mega-menu__sidebar-list" role="list">
                {%- for side_link in sidebar_menu.links -%}
                  <li class="mega-menu__sidebar-item">
                    <a href="{{ side_link.url }}" class="mega-menu__sidebar-link{% if side_link.current %} is-active{% endif %}"{% if side_link.current %} aria-current="page"{% endif %}>
                      {{- side_link.title | escape -}}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </aside>
          {%- endif -%}

          <div class="mega-menu__grid-panel opacity-0">
            {%- if layout_style == 'images_only' -%}
              {%- liquid
                assign io_tag_bg_rgb = block.settings.io_tag_bg.rgb | default: '0,0,0'
                assign io_tag_bg_op = block.settings.io_tag_bg_opacity | default: 0 | divided_by: 100.0
                assign io_tag_size = block.settings.io_tag_size | default: 15
                assign io_tag_color = block.settings.io_tag_color.rgb | default: '255,255,255'
              -%}
              <ul class="mega-menu__product-grid mega-menu__product-grid--promo" role="list">
                {%- for i in (1..6) -%}
                  {%- assign io_image = 'io_image_' | append: i -%}
                  {%- if block.settings[io_image] != blank -%}
                    {%- liquid
                      assign io_tag = 'io_tag_' | append: i
                      assign io_link = 'io_link_' | append: i
                      assign io_label = block.settings[io_tag]
                      assign io_aria = io_label | default: 'Image'
                    -%}
                    <li class="mega-menu__product-card-wrap mega-menu__product-card-wrap--promo opacity-0">
                      <a
                        class="mega-menu__promo-card"
                        {% if block.settings[io_link] != blank %}href="{{ block.settings[io_link] }}"{% else %}role="link" aria-disabled="true"{% endif %}
                        aria-label="{{ io_aria | escape }}"
                        style="--mega-promo-tag-color: {{ io_tag_color }};--mega-promo-tag-bg: {{ io_tag_bg_rgb }};--mega-promo-tag-bg-opacity: {{ io_tag_bg_op }};--mega-promo-tag-size: {{ io_tag_size }}px;--mega-promo-tag-weight: 400;"
                      >
                        <div class="mega-menu__promo-media">
                          {{- block.settings[io_image] | image_url: width: block.settings[io_image].width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080', class: 'mega-menu__promo-img', is: 'lazy-image', alt: io_aria -}}
                        </div>
                        {%- if io_label != blank -%}
                          <span class="mega-menu__promo-tag">{{ io_label | escape }}</span>
                        {%- endif -%}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- elsif grid_products != blank and grid_products.size > 0 -%}
              <ul class="mega-menu__product-grid" role="list">
                {%- for product in grid_products -%}
                  {%- liquid
                    assign card_badge = blank
                    assign card_badge_class = ''
                    assign has_theme_label = false
                    if product.metafields.theme.label.value != blank
                      assign has_theme_label = true
                    endif
                    unless has_theme_label
                      for tag in product.tags
                        assign tag_down = tag | downcase
                        if tag_down == 'best seller' or tag_down == 'bestseller' or tag_down contains 'best seller'
                          assign card_badge = 'Best Seller'
                          assign card_badge_class = 'is-bestseller'
                          break
                        endif
                        if tag_down == 'new arrival' or tag_down contains 'new arrival'
                          assign card_badge = 'New Arrival'
                          assign card_badge_class = 'is-new'
                          break
                        endif
                        if tag_down == 'new' or tag_down contains 'new'
                          assign card_badge = 'New Arrival'
                          assign card_badge_class = 'is-new'
                          break
                        endif
                        if tag_down contains 'bundle'
                          assign card_badge = tag
                          assign card_badge_class = 'is-bundle'
                          break
                        endif
                      endfor
                    endunless
                    assign card_subtitle = product.metafields.custom.mega_menu_subtitle.value | default: product.metafields.custom.piece_count.value | default: blank
                    assign card_pieces = product.metafields.custom.pieces.value | default: product.metafields.custom.pieces | default: product.metafields.custom.piece_count.value | default: blank

                    comment
                      先匹配文件名含 breescapeHeaderTab_navigation 的图（会同时命中 _mb_ / _pc_），
                      电脑端只用含 _pc_ 的那张；名称取 _pc_ 后面的值。
                      例：breescapeHeaderTab_navigation-20260805-2_pc_Beauty_Sleep_Duo → Beauty_Sleep_Duo
                    endcomment
                    assign nav_tab_image = blank
                    assign nav_tab_title = blank
                    for pimg in product.images
                      assign psrc = pimg.src | downcase
                      if psrc contains 'breescapeheadertab_navigation' and psrc contains '_pc_'
                        assign nav_tab_image = pimg
                        assign nav_fname = pimg.src | split: '/' | last | split: '?' | first
                        assign nav_fname_base = ''
                        assign nav_fname_parts = nav_fname | split: '.'
                        for nav_part in nav_fname_parts
                          unless forloop.last
                            if nav_fname_base != blank
                              assign nav_fname_base = nav_fname_base | append: '.'
                            endif
                            assign nav_fname_base = nav_fname_base | append: nav_part
                          endunless
                        endfor
                        assign nav_try = nav_fname_base | split: '_pc_'
                        if nav_try.size < 2
                          assign nav_try = nav_fname_base | split: '_PC_'
                        endif
                        if nav_try.size < 2
                          assign nav_try = nav_fname_base | downcase | split: '_pc_'
                        endif
                        if nav_try.size > 1
                          assign nav_tab_title = nav_try.last | replace: '_R_', '®' | replace: '_r_', '®' | replace: '_.', '.' | replace: '._', '.' | replace: '_', ' ' | replace: ' . ', '.' | replace: ' .', '.' | replace: '. ', '.'
                        endif
                        break
                      endif
                    endfor
                    if nav_tab_image == blank
                      assign nav_tab_image = product.featured_image
                    endif
                    if nav_tab_title == blank
                      assign nav_tab_title = product.title
                    endif
                  -%}
                  <li class="mega-menu__product-card-wrap opacity-0">
                    <a href="{{ product.url }}" class="mega-menu__product-card" aria-label="{{ nav_tab_title | escape }}">
                      <div class="mega-menu__product-media">
                        {%- if has_theme_label -%}
                          {%- render 'product-badges', product: product, class: 'mega-menu__product-badges' -%}
                        {%- elsif card_badge != blank -%}
                          <span class="mega-menu__product-badge {{ card_badge_class }}">{{ card_badge }}</span>
                        {%- endif -%}
                        {%- if nav_tab_image != blank -%}
                          {%- assign card_img_alt = nav_tab_image.alt | default: nav_tab_title -%}
                          {{- nav_tab_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200,300,400,600', class: 'mega-menu__product-img', alt: card_img_alt -}}
                        {%- else -%}
                          {{ 'product-1' | placeholder_svg_tag: 'mega-menu__product-img placeholder' }}
                        {%- endif -%}
                      </div>
                      <div class="mega-menu__product-meta">
                        <p class="mega-menu__product-title">
                          <span class="mega-menu__product-title-text">{{ nav_tab_title | escape }}{%- if card_pieces != blank -%}<span class="mega-menu__product-pieces">{{ card_pieces | escape }}</span>{%- endif -%}</span>
                        </p>
                        {%- if card_subtitle != blank -%}
                          <p class="mega-menu__product-subtitle">{{ card_subtitle | escape }}</p>
                        {%- endif -%}
                      </div>
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
      {%- endunless -%}
    </div>
  {%- else -%}
  <div class="mega-menu__container invisible">
    {%- unless section_rendering_api -%}
      <ul id="HeaderNavMega-{{ section.id }}-{{ position }}-{{ context }}" class="mega-menu__list page-width{% if full_width %} page-width--full{% endif %} flex flex-wrap w-full h-full overflow-hidden" role="list" tabindex="-1">
        {%- for i in (1..5) -%}
          <li class="mega-menu__item flex opacity-0 w-full aspect-square">
            <span class="media-card media-card--card w-full h-full"></span>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul id="HeaderNavMega-{{ section.id }}-{{ position }}-{{ context }}" class="mega-menu__list page-width{% if full_width %} page-width--full{% endif %} flex flex-wrap w-full h-full overflow-hidden" role="list" tabindex="-1">
        {%- if link.links != blank -%}
          <li class="mega-menu__item mega-menu__item--nav mega-menu__item--{{ block.settings.menu_width }}{% unless show_promotions %} mega-menu__item--full{% endunless %} opacity-0 w-full grid">
            <ul class="mega-menu__nav{% if link.links.size > 6 %} mega-menu__nav--more{% endif %}{% if show_promotions %} grid{% else %} flex flex-wrap{% endif %}">
              {%- for childlink in link.links -%}
                <li class="mega-menu__nav-item opacity-0">
                  {%- if block.settings.show_menu_image and childlink.type == 'collection_link' and childlink.object.image != blank -%}
                    <a href="{{ childlink.url }}" class="media media--wide block relative overflow-hidden">
                      {{- childlink.object.image | image_url: width: childlink.object.image.width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080', is: 'lazy-image' -}}
                    </a>
                  {%- endif -%}
                  <a href="{{ childlink.url }}" class="{% if block.settings.menu_width != 'small' %}heading {% endif %}reversed-link text-lg leading-tight tracking-tight{% if childlink.current %} active{% endif %}"{% if childlink.current %} aria-current="page"{% endif %}>
                    {{- childlink.title | escape -}}
                  </a>
                  {%- if childlink.links != blank -%}
                    <ul>
                      {%- for grandchildlink in childlink.links -%}
                        <li>
                          <a href="{{ grandchildlink.url }}" class="{% if block.settings.menu_width != 'small' %}reversed-link text-base {% else %}heading reversed-link text-xl-3xl tracking-tighter leading-tight{% endif %}{% if grandchildlink.current %} active{% endif %}"{% if grandchildlink.current %} aria-current="page"{% endif %}>
                            {{- grandchildlink.title | escape -}}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- if block.settings.button_label != blank -%}
              <div class="mega-menu__footer relative">
                <a class="mega-menu__link link icon-with-text flex items-center justify-between w-full h-full"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% if block.settings.button_external %} target="_blank" rel="noopener noreferrer"{% endif %}{% else %} role="link" aria-disabled="true"{% endif %}>
                  <span class="{% if block.settings.menu_width != 'small' %}heading {% endif %}link-text text-lg-2xl tracking-tight">{{ block.settings.button_label | escape }}</span>
                  {%- render 'icon', icon: 'arrow-right', size: 'lg', class: 'transform' -%}
                </a>
              </div>
            {%- endif -%}
          </li>
        {%- endif -%}

        {%- if show_promotions -%}
          {%- for i in (1..5) -%}
            {%- assign promo_image = 'promo_image_' | append: i -%}
            {%- if block.settings[promo_image] != blank -%}
              {%- liquid
                assign promo_image_ratio = 'promo_image_ratio_' | append: i
                assign promo_heading = 'promo_heading_' | append: i
                assign promo_subtext = 'promo_subtext_' | append: i
                assign promo_overlay_content = 'promo_overlay_content_' | append: i
                assign promo_link = 'promo_link_' | append: i
                assign promo_tag = 'promo_tag_' | append: i
                assign promo_color_text = 'promo_color_text_' | append: i
                assign promo_color_overlay = 'promo_color_overlay_' | append: i
                assign promo_overlay_opacity = 'promo_overlay_opacity_' | append: i
              -%}
              <li class="mega-menu__item flex opacity-0 w-full{% if link.links != blank %} align-self-start{% endif %}">
                <div class="media-card media-card--{{ settings.card_style }}{% if block.settings[promo_overlay_content] %} media-card--overlap{% endif %}">
                  <a class="media-card__link flex flex-col w-full h-full relative"{% if block.settings[promo_link] != blank %} href="{{ block.settings[promo_link] }}"{% else %} role="link" aria-disabled="true"{% endif %}
                    aria-label="{{ block.settings[promo_heading] | default: block.settings[promo_subtext] | escape }}"
                    style="--color-foreground: {{ block.settings[promo_color_text].rgb }};--color-overlay: {{ block.settings[promo_color_overlay].rgb }};--overlay-opacity: {{ block.settings[promo_overlay_opacity] | divided_by: 100.0 }};"
                  >
                    {%- if block.settings[promo_tag] != blank -%}
                      <div class="badges z-2 absolute grid gap-3 pointer-events-none">
                        <span class="badge badge--onsale flex items-center gap-1d5 font-medium leading-none">{{ block.settings[promo_tag] | escape }}</span>
                      </div>
                    {%- endif -%}
                    <div class="media media--{{ block.settings[promo_image_ratio] }} relative overflow-hidden">
                      {{- block.settings[promo_image] | image_url: width: block.settings[promo_image].width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080', is: 'lazy-image' -}}
                    </div>
                    {%- if block.settings[promo_heading] != blank or block.settings[promo_subtext] != blank -%}
                      <div class="media-card__content flex justify-between items-center gap-4 w-full">
                        <div class="media-card__text opacity-0 shrink-1 grid gap-0d5">
                          {%- if block.settings[promo_heading] != blank -%}
                            <p>
                              <span class="heading reversed-link text-xl-3xl tracking-tighter leading-tight">{{ block.settings[promo_heading] | escape }}</span>
                            </p>
                          {%- endif -%}
                          {%- if block.settings[promo_subtext] != blank -%}
                            <p class="leading-none text-xs">{{ block.settings[promo_subtext] }}</p>
                          {%- endif -%}
                        </div>
                        {%- render 'icon', icon: 'arrow-right', size: 'xs', class: 'transform shrink-0 hidden xl:block' -%}
                      </div>
                    {%- endif -%}
                  </a>
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endunless -%}
  </div>
  {%- endif -%}
{%- else -%}
  <div class="mega-menu__container invisible">
    {%- unless section_rendering_api -%}
      <ul id="HeaderNavMega-{{ section.id }}-{{ position }}-{{ context }}" class="mega-menu__list page-width{% if full_width %} page-width--full{% endif %} flex flex-wrap w-full h-full overflow-hidden" role="list" tabindex="-1">
        {%- for i in (1..5) -%}
          <li class="mega-menu__item flex opacity-0 w-full aspect-square">
            <span class="media-card media-card--card w-full h-full"></span>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul id="HeaderNavMega-{{ section.id }}-{{ position }}-{{ context }}" class="mega-menu__list mega-menu__list--tabs page-width{% if full_width %} page-width--full{% endif %} flex flex-wrap w-full h-full overflow-hidden" role="list" tabindex="-1">
        <li class="mega-menu__item mega-menu__item--tabs opacity-0 w-full flex flex-col gap-8">
          {%- if block.settings.heading_1 != blank -%}
            <p class="text-base xl:text-lg font-medium">{{ block.settings.heading_1 | escape }}</p>
          {%- endif -%}
          <tabs-element class="mega-menu__nav mega-menu__nav--tabs grid gap-1d5">
            {%- liquid
              assign forloop_first = true
              assign forloop_index = 0
            -%}
            {%- for i in (1..5) -%}
              {%- assign tab_target_link = 'tab_target_link_' | append: i -%}
              {%- if block.settings[tab_target_link] != blank -%}
                {%- liquid
                  assign tab_target = 'tab_target_' | append: i
                  assign tab_target_heading = block.settings[tab_target] | default: block.settings[tab_target_link].object.title
                  assign tab_icon = 'tab_icon_' | append: i
                  assign tab_icon_width = 'tab_icon_width_' | append: i
                -%}
                {%- capture tab_heading -%}
                  {%- if block.settings[tab_icon] != blank -%}
                    {%- assign icon_width = block.settings[tab_icon_width] -%}
                    {%- assign max_width = block.settings[tab_icon].width -%}
                    <figure class="media media--transparent relative inline-block shrink-0">
                      {%- capture sizes -%}{{ icon_width }}px{%- endcapture -%}
                      {%- capture widths -%}{{ icon_width | times: 1.5 | at_most: max_width | round }}, {{ icon_width | times: 2 | at_most: max_width }}, {{ icon_width | times: 3 | at_most: max_width }}{%- endcapture -%}
                      {{- block.settings[tab_icon] | image_url: width: max_width | image_tag: loading: 'lazy', sizes: sizes, widths: widths, class: 'image-fit' -}}
                    </figure>
                  {%- endif -%}
                  <span class="heading link-text text-xl-3xl tracking-tighter leading-tight">{{ tab_target_heading | escape }}</span>
                {%- endcapture -%}
                {%- if block.settings[tab_target_link].type == 'collection_link' or block.settings[tab_target_link].type == 'catalog_link' -%}
                  <button type="button" class="mega-menu__nav-item flex gap-2 items-center opacity-0 link icon-with-text text-left" role="tab" aria-controls="TabPanel-{{ block.id }}-{{ forloop_index }}" data-index="{{ forloop_index }}"{% if forloop_first %} disabled{% endif %}>
                    {{- tab_heading -}}
                  </button>
                  {%- liquid
                    assign forloop_first = false
                    assign forloop_index = forloop_index | plus: 1
                  -%}
                {%- else -%}
                  <a href="{{ block.settings[tab_target_link].url }}" class="mega-menu__nav-item flex gap-2 items-center opacity-0 link icon-with-text text-left">
                    {{- tab_heading -}}
                  </a>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </tabs-element>
          {%- if block.settings.button_label != blank -%}
            <div class="mega-menu__footer relative">
              <a class="mega-menu__link link icon-with-text flex items-center justify-between w-full h-full"{% if block.settings.button_link != blank %} href="{{ block.settings.button_link }}"{% if block.settings.button_external %} target="_blank" rel="noopener noreferrer"{% endif %}{% else %} role="link" aria-disabled="true"{% endif %}>
                <span class="heading link-text text-base-xl tracking-tight">{{ block.settings.button_label | escape }}</span>
                {%- render 'icon', icon: 'arrow-right', size: 'sm', class: 'transform shrink-0' -%}
              </a>
            </div>
          {%- endif -%}
        </li>
        <li class="mega-menu__item mega-menu__item--panels opacity-0 w-full">
          {%- liquid
            assign forloop_first = true
            assign forloop_index = 0
          -%}
          {%- for i in (1..5) -%}
            {%- assign tab_target_link = 'tab_target_link_' | append: i -%}
            {%- if block.settings[tab_target_link] != blank and block.settings[tab_target_link].type == 'collection_link' or block.settings[tab_target_link].type == 'catalog_link' -%}
              {%- liquid
                assign promo_image = 'promo_image_' | append: i
                assign tab_target = 'tab_target_' | append: i
                assign tab_target_heading = block.settings[tab_target] | default: block.settings[tab_target_link].object.title
                assign tab_product_limit = 'tab_product_limit_' | append: i
                assign tab_products = 'tab_products_' | append: i
                
                assign products_count = block.settings[tab_target_link].object.products_count
                assign products = block.settings[tab_products] | default: block.settings[tab_target_link].object.products
                if block.settings[tab_target_link].type == 'catalog_link'
                  assign products_count = collections.all.products_count
                  assign products = products | default: collections.all.products
                endif
              -%}
              <div id="TabPanel-{{ block.id }}-{{ forloop_index }}" class="mega-menu__panel{% if block.settings[promo_image] == blank %} without-promo{% endif %} grid w-full" role="tabpanel"{% unless forloop_first %} hidden{% endunless %}>
                <div class="grid gap-8">
                  <div class="flex items-center justify-between gap-4">
                    {%- if block.settings.heading_2 != blank -%}
                      <p class="text-sm text-opacity leading-none uppercase">{{ block.settings.heading_2 | escape }}</p>
                    {%- endif -%}
                    <a class="mega-menu__link link icon-with-text" href="{{ block.settings[tab_target_link].object.url }}">
                      <span class="heading link-text text-base-xl tracking-tight flex items-center gap-1">
                        {{- 'collections.subcollections.all_products' | t: collection: tab_target_heading -}}
                        {%- if products_count > 0 -%}
                          <span class="text-base font-medium tracking-tight">({{ products_count }})</span>
                        {%- endif -%}
                      </span>
                      {%- render 'icon', icon: 'arrow-right', size: 'sm', class: 'transform shrink-0' -%}
                    </a>
                  </div>
                  {%- liquid
                    assign column = 4
                    if products != blank and products.count < 4
                      assign column = products.count
                    endif

                    assign min_column = 2
                    if block.settings[promo_image] == blank
                      assign min_column = 3
                    endif
                  -%}
                  <slider-element id="Slider-{{ block.id }}-{{ forloop_index }}" class="grid slider slider--desktop slider--tablet" selector=".card-grid>.card" tabindex="0">
                    <motion-list class="product-grid card-grid card-grid--{{ column | at_least: min_column }} mobile:card-grid--1 grid" initialized>
                      {%- capture block_id -%}{{ block.id }}-{{ forloop_index }}{%- endcapture -%}
                      {%- for product in products limit: block.settings[tab_product_limit] -%}
                        {%- render 'product-card',
                          product: product,
                          product_id: product.id,
                          section_id: section.id,
                          block_id: block_id,
                          lazy_load: false,
                          image_ratio: settings.product_image_ratio,
                          image_fill: settings.product_image_fill,
                          show_secondary_image: settings.product_secondary_image,
                          show_multiple_images: settings.product_multiple_images,
                          show_vendor: settings.product_vendor,
                          title_truncation: settings.product_title_truncation,
                          title_line_limit: settings.product_title_line_limit,
                          show_rating: settings.product_rating,
                          show_color_swatches: settings.product_color_swatches,
                          show_countdown: settings.product_countdown,
                          show_quick_add: settings.product_quick_add,
                          show_quick_view: settings.product_quick_view,
                          vertical_badges: settings.product_vertical_badges,
                          show_sold_out: settings.product_sold_out,
                          show_save_amount: settings.product_save_amount,
                          save_type: settings.product_save_type,
                          show_icon_list: false
                        -%}
                      {%- else -%}
                        {%- for i in (1..4) -%}
                          {%- capture placeholder -%}product-{% cycle '1', '2', '3', '4' %}{%- endcapture -%}
                          {%- render 'product-card-placeholder',
                            placeholder: placeholder
                            image_ratio: settings.product_image_ratio,
                            show_vendor: settings.product_vendor
                          -%}
                        {%- endfor -%}
                      {%- endfor -%}
                    </motion-list>
                  </slider-element>
                </div>
                {%- if block.settings[promo_image] != blank -%}
                  {%- liquid
                    assign promo_image_ratio = 'promo_image_ratio_' | append: i
                    assign promo_heading = 'promo_heading_' | append: i
                    assign promo_subtext = 'promo_subtext_' | append: i
                    assign promo_overlay_content = 'promo_overlay_content_' | append: i
                    assign promo_link = 'promo_link_' | append: i
                    assign promo_tag = 'promo_tag_' | append: i
                    assign promo_color_text = 'promo_color_text_' | append: i
                    assign promo_color_overlay = 'promo_color_overlay_' | append: i
                    assign promo_overlay_opacity = 'promo_overlay_opacity_' | append: i
                  -%}
                  <div class="media-card media-card--{{ settings.card_style }}{% if block.settings[promo_overlay_content] %} media-card--overlap{% endif %}">
                    <a class="media-card__link flex flex-col w-full h-full relative"{% if block.settings[promo_link] != blank %} href="{{ block.settings[promo_link] }}"{% else %} role="link" aria-disabled="true"{% endif %}
                      aria-label="{{ block.settings[promo_heading] | default: block.settings[promo_subtext] | escape }}"
                      style="--color-foreground: {{ block.settings[promo_color_text].rgb }};--color-overlay: {{ block.settings[promo_color_overlay].rgb }};--overlay-opacity: {{ block.settings[promo_overlay_opacity] | divided_by: 100.0 }};"
                    >
                      {%- if block.settings[promo_tag] != blank -%}
                        <div class="badges z-2 absolute grid gap-3 pointer-events-none">
                          <span class="badge badge--onsale flex items-center gap-1d5 font-medium leading-none">{{ block.settings[promo_tag] | escape }}</span>
                        </div>
                      {%- endif -%}
                      <div class="media media--{{ block.settings[promo_image_ratio] }} relative overflow-hidden">
                        {{- block.settings[promo_image] | image_url: width: block.settings[promo_image].width | image_tag: loading: 'lazy', widths: '180,360,540,720,900,1080', is: 'lazy-image' -}}
                      </div>
                      {%- if block.settings[promo_heading] != blank or block.settings[promo_subtext] != blank -%}
                        <div class="media-card__content flex justify-between items-center gap-4 w-full">
                          <div class="media-card__text opacity-0 shrink-1 grid gap-0d5">
                            {%- if block.settings[promo_heading] != blank -%}
                              <p>
                                <span class="heading reversed-link text-xl-3xl tracking-tighter leading-tight">{{ block.settings[promo_heading] | escape }}</span>
                              </p>
                            {%- endif -%}
                            {%- if block.settings[promo_subtext] != blank -%}
                              <p class="leading-none text-xs">{{ block.settings[promo_subtext] }}</p>
                            {%- endif -%}
                          </div>
                          {%- render 'icon', icon: 'arrow-right', size: 'xs', class: 'transform shrink-0 hidden xl:block' -%}
                        </div>
                      {%- endif -%}
                    </a>
                  </div>
                {%- endif -%}
              </div>
              {%- liquid
                assign forloop_first = false
                assign forloop_index = forloop_index | plus: 1
              -%}
            {%- endif -%}
          {%- endfor -%}
        </li>
      </ul>
    {%- endunless -%}
  </div>
{%- endif -%}