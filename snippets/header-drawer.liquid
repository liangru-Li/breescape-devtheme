{%- doc -%}
  Renders a mobile navigation drawer with menu, localization, and account features.

  On mobile/tablet, expands from top to bottom (dropdown panel) to match Breescape mobile menu.

  @param {object} section - Section object with navigation and localization settings

  @example
  {% render 'header-drawer', section: section %}
{%- enddoc -%}

{%- liquid
  assign section_rendering_api = false
  if section.index == nil
    assign section_rendering_api = true
  endif

  assign main_menu = section.settings.menu_mobile | default: section.settings.menu
  assign menu_promo_image = section.settings.drawer_promo_image
  assign menu_promo_heading = section.settings.drawer_promo_heading
  assign menu_promo_subtext = section.settings.drawer_promo_subtext
  assign menu_promo_link = section.settings.drawer_promo_link
-%}

<menu-drawer id="MenuDrawer" class="menu-drawer drawer drawer--top z-30 fixed bottom-0 left-0 h-full w-full pointer-events-none"
  data-section-id="{{ section.id }}"
  hidden
>
  <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="MenuDrawer" aria-expanded="false"></overlay-element>
  <div class="drawer__inner menu-drawer__panel z-10 absolute top-0 flex flex-col w-full overflow-hidden">
    <div class="menu-drawer__topbar flex items-center justify-between gap-3">
      <div class="menu-drawer__brand shrink-0">
        {%- render 'header-logo', logo_h1: false -%}
      </div>
      <div class="menu-drawer__actions flex items-center gap-2">
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account class="flex items-center justify-center" menu="{{ settings.customer_account_menu }}">
            <magnet-element class="block" slot="signed-out-avatar">
              <span class="sr-only">
                {%- liquid
                  if customer
                    echo 'customer.account.title' | t
                  else
                    echo 'customer.login.title' | t
                  endif
                -%}
              </span>
              {%- render 'icon', icon: 'account', size: section.settings.icons_size -%}
            </magnet-element>
          </shopify-account>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="cart-drawer-button flex items-center justify-center relative" is="magnet-link" aria-controls="CartDrawer" aria-expanded="false" data-no-instant>
          <span class="sr-only">{{ 'general.cart.title' | t }}</span>
          <span class="cart-drawer-button__icon">
            {%- render 'icon', icon: 'cart', size: section.settings.icons_size -%}
            <cart-count class="count text-xs" aria-label="{{ 'general.cart.cart_count' | t: count: cart.item_count | escape }}"{% if cart == empty %} hidden{% endif %}>{{ cart.item_count }}</cart-count>
          </span>
        </a>
        <button class="menu-drawer__close flex items-center justify-center" type="button" is="magnet-button" aria-controls="MenuDrawer" aria-expanded="false" aria-label="{{ 'general.accessibility.close' | t | escape }}">
          {%- render 'icon', icon: 'close', size: section.settings.icons_size -%}
        </button>
      </div>
    </div>

    <div class="drawer__content menu-drawer__content flex flex-col grow shrink">
      <nav class="menu-drawer__nav relative grow overflow-hidden" role="navigation">
        <ul class="drawer__scrollable drawer__menu menu-drawer__menu relative w-full h-full" role="list" data-parent>
          {%- if menu_promo_image != blank -%}
            <li class="menu-drawer__promo">
              <a
                class="menu-drawer__promo-card"
                {% if menu_promo_link != blank %}href="{{ menu_promo_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
              >
                <div class="menu-drawer__promo-media">
                  {{- menu_promo_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,800,1000,1200', class: 'menu-drawer__promo-img', alt: menu_promo_heading | default: shop.name | escape -}}
                </div>
                {%- if menu_promo_heading != blank or menu_promo_subtext != blank -%}
                  <span class="menu-drawer__promo-copy">
                    {%- if menu_promo_heading != blank -%}
                      <span class="menu-drawer__promo-title">{{ menu_promo_heading | escape }}</span>
                    {%- endif -%}
                    {%- if menu_promo_subtext != blank -%}
                      <span class="menu-drawer__promo-sub">{{ menu_promo_subtext }}</span>
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}

          {%- for link in main_menu.links -%}
            <li class="drawer__menu-group">
              {%- liquid
                assign enable_mega_menu = false
                assign mega_menu_block = nil
                assign link_title_handle = link.title | downcase | handle

                for block in section.blocks
                  assign menu_title_handle = block.settings.menu_title | downcase | handle
                  if menu_title_handle == link_title_handle
                    assign enable_mega_menu = true
                    assign mega_menu_block = block
                    break
                  endif
                endfor
              -%}

              {%- if link.links != blank or enable_mega_menu -%}
                {%- render 'header-nav-drawer', section: section, link: link, enable_mega_menu: enable_mega_menu, enable_accordion_menu: section.settings.accordion_menu_mobile, block: mega_menu_block, position: forloop.index -%}
              {%- else -%}
                <a class="drawer__menu-item menu-drawer__link block heading text-2xl leading-none tracking-tight" data-name="{{- link.title | escape -}}" href="{{ link.url }}">
                  <span>{{ link.title | escape }}</span>
                  {%- render 'icon', icon: 'chevron-right', size: 'xs', class: 'menu-drawer__chevron shrink-0' -%}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}

          {%- comment -%} Secondary utility links（Header → Mobile drawer secondary links） {%- endcomment -%}
          {%- liquid
            assign secondary_menu = section.settings.menu_mobile_secondary
            if secondary_menu == blank or secondary_menu.links.size == 0
              assign secondary_menu = linklists['shawn-main-menu-mobile']
            endif
          -%}
          {%- if secondary_menu != blank and secondary_menu.links.size > 0 -%}
            {%- assign secondary_icon_size = section.settings.menu_mobile_secondary_icon_size | default: 20 -%}
            <li class="menu-drawer__secondary" style="--menu-drawer-secondary-icon-size: {{ secondary_icon_size }}px;">
              <ul class="menu-drawer__secondary-list" role="list">
                {%- for link in secondary_menu.links -%}
                  {%- if link.url != blank -%}
                    {%- liquid
                      assign secondary_icon_key = 'menu_mobile_secondary_icon_' | append: forloop.index
                      assign secondary_icon = section.settings[secondary_icon_key]
                    -%}
                    <li>
                      <a href="{{ link.url }}" class="menu-drawer__secondary-link">
                        {%- if secondary_icon != blank -%}
                          <span class="menu-drawer__secondary-icon" aria-hidden="true">
                            {{- secondary_icon
                              | image_url: width: 96
                              | image_tag:
                                loading: 'lazy',
                                widths: '40,60,80,96',
                                width: secondary_icon_size,
                                height: secondary_icon_size,
                                class: 'menu-drawer__secondary-icon-img',
                                alt: '',
                                style: 'width: var(--menu-drawer-secondary-icon-size); height: var(--menu-drawer-secondary-icon-size); max-width: none;'
                            -}}
                          </span>
                        {%- endif -%}
                        <span>{{ link.title | escape }}</span>
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </li>
          {%- endif -%}
        </ul>
      </nav>

      <div class="drawer__footer menu-drawer__footer grid w-full">
        {%- liquid
          if section.settings.enable_language_selector and localization.available_languages.size > 1
            assign enable_language_selector = true
          endif
          if section.settings.enable_country_selector and localization.available_countries.size > 1
            assign enable_country_selector = true
          endif
        -%}
        {%- if enable_language_selector or enable_country_selector -%}
          <div class="drawer__footer-top flex">
            {%- if enable_language_selector -%}
              <button type="button" class="flex gap-3 grow items-center justify-between" aria-controls="LocalizationLanguage-{{ section.id }}" aria-expanded="false">
                {%- unless section_rendering_api -%}
                  <api-button class="api-only" data-id="header_drawer_localization_language_form" data-section-id="{{ section.id }}"></api-button>
                {%- endunless -%}
                <span class="text-sm leading-none flex items-center gap-2 w-auto">
                  {%- render 'icon', icon: 'language', size: 'xs', class: 'stroke-1 hidden md:block shrink-0' -%}
                  {{- localization.language.endonym_name | capitalize -}}
                </span>
                {%- render 'icon', icon: 'chevron-down', size: 'xs', class: 'shrink-0' -%}
              </button>
            {%- endif -%}
            {%- if enable_country_selector -%}
              <button type="button" class="flex gap-3 grow items-center justify-between" aria-controls="LocalizationCountry-{{ section.id }}" aria-expanded="false">
                {%- unless section_rendering_api -%}
                  <api-button class="api-only" data-id="header_drawer_localization_country_form" data-section-id="{{ section.id }}"></api-button>
                {%- endunless -%}
                <span class="text-sm leading-none flex items-center gap-2 w-auto">
                  {%- render 'icon', icon: 'currency', size: 'xs', class: 'stroke-1 hidden md:block shrink-0' -%}
                  {{- localization.country.name }} ({{ localization.country.currency.iso_code }} {{ localization.country.currency.symbol }})
                </span>
                {%- render 'icon', icon: 'chevron-down', size: 'xs', class: 'shrink-0' -%}
              </button>
            {%- endif -%}

            {%- if enable_language_selector -%}
              <modal-element id="LocalizationLanguage-{{ section.id }}" class="modal invisible absolute bottom-0 left-0 w-full h-full" role="dialog" hidden>
                <overlay-element class="fixed-modal opacity-0 z-1 absolute top-0 left-0 w-full h-full" aria-controls="LocalizationLanguage-{{ section.id }}" aria-expanded="false"></overlay-element>
                <div class="modal__container flex flex-col z-3 absolute left-0 bottom-0 w-full">
                  <button class="close items-center justify-center absolute top-0 right-0" type="button" is="magnet-button" aria-controls="LocalizationLanguage-{{ section.id }}" aria-expanded="false" aria-label="{{ 'general.accessibility.close' | t | escape }}">
                    <span class="inline-block" data-text>
                      {%- render 'icon', icon: 'close' -%}
                    </span>
                  </button>
                  {%- unless section_rendering_api -%}
                    <div class="modal__content flex flex-col overflow-hidden" id="header_drawer_localization_language_form"></div>
                  {%- else -%}
                    {%- form 'localization', id: 'header_drawer_localization_language_form', class: 'modal__content flex flex-col overflow-hidden', is: 'localization-listbox' -%}
                      <ul class="modal__scrollable listbox grid gap-1d5 xl:gap-2" role="list" tabindex="-1">
                        {%- for language in localization.available_languages -%}
                          <li class="opacity-0">
                            <a class="text-sm reversed-link{% if language.iso_code == localization.language.iso_code %} active{% endif %}"
                              href="#"
                              hreflang="{{ language.iso_code }}"
                              lang="{{ language.iso_code }}"
                              {% if language.iso_code == localization.language.iso_code %}
                                aria-current="true"
                              {% endif %}
                              data-value="{{ language.iso_code }}"
                              title="{{ language.endonym_name | capitalize | escape }}"
                              data-no-instant
                            >
                              {{- language.endonym_name | capitalize -}}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                      <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" />
                    {%- endform -%}
                  {%- endunless -%}
                </div>
              </modal-element>
            {%- endif -%}
            {%- if enable_country_selector -%}
              <modal-element id="LocalizationCountry-{{ section.id }}" class="modal invisible absolute bottom-0 left-0 w-full h-full" role="dialog" hidden>
                <overlay-element class="fixed-modal opacity-0 z-1 absolute top-0 left-0 w-full h-full" aria-controls="LocalizationCountry-{{ section.id }}" aria-expanded="false"></overlay-element>
                <div class="modal__container flex flex-col z-3 absolute left-0 bottom-0 w-full">
                  <button class="close items-center justify-center absolute top-0 right-0" type="button" aria-controls="LocalizationCountry-{{ section.id }}" aria-expanded="false" is="magnet-button" aria-label="{{ 'general.accessibility.close' | t | escape }}">
                    <span class="inline-block" data-text>
                      {%- render 'icon', icon: 'close' -%}
                    </span>
                  </button>
                  {%- unless section_rendering_api -%}
                    <div class="modal__content flex flex-col overflow-hidden" id="header_drawer_localization_country_form"></div>
                  {%- else -%}
                    {%- form 'localization', id: 'header_drawer_localization_country_form', class: 'modal__content flex flex-col overflow-hidden', is: 'localization-listbox' -%}
                      {%- render 'corner', dir: 'top', prefix: 'dropdown' -%}
                      <ul class="modal__scrollable listbox grid gap-1d5 xl:gap-2" role="list" tabindex="-1">
                        {%- for country in localization.available_countries -%}
                          <li class="opacity-0">
                            <a class="text-sm reversed-link{% if country.iso_code == localization.country.iso_code %} active{% endif %}"
                              href="#"
                              {% if country.iso_code == localization.country.iso_code %}
                                aria-current="true"
                              {% endif %}
                              data-value="{{ country.iso_code }}"
                              title="{{ country.name | escape }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})"
                              data-no-instant
                            >
                              {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                      <input type="hidden" name="country_code" value="{{ localization.country.iso_code }}" />
                    {%- endform -%}
                  {%- endunless -%}
                </div>
              </modal-element>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</menu-drawer>
