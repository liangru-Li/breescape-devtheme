{%- doc -%}
  Links related products through shared metafield values, allowing navigation between products.

  Displays as color swatches or text labels with optional size chart integration.

  @param {object} product - Current product object
  @param {object} block - Block settings and attributes
  @param {string} section_id - Section identifier
  @param {string} product_id - Product identifier
  @param {string} [image_ratio] - Swatch image aspect ratio
  @param {string} [image_ratio_mobile] - Mobile swatch aspect ratio
  @param {boolean} [image_fill] - Fill vs contain swatch images

  @example
  {% render 'product-variants',
    product: product,
    block: block,
    section_id: section.id,
    product_id: product.id
  %}
{%- enddoc -%}

{%- liquid
  assign contains_product = false

  for product_variation in block.settings.products
    if product_variation == product
      assign contains_product = true
      break
    endif
  endfor
-%}

{%- if contains_product -%}
  {%- liquid
    assign is_color = false
    if block.settings.enable_color_swatches
      capture _is_color_opt
        render 'color-option-match', option_name: block.settings.option_name
      endcapture
      if _is_color_opt contains 'true'
        assign is_color = true
      endif
    endif

    assign is_size = false
    if block.settings.size_chart != blank
      assign size_trigger = 'products.general.size_trigger' | t | downcase
      assign downcased_option = block.settings.option_name | downcase
      if downcased_option contains size_trigger
        assign is_size = true
      endif
    endif

  -%}
  <div class="variant-picker grid gap-5 xo__comfort__input">
    <fieldset class="product-form__input variant-input-wrapper">
      <legend class="sr-only">{{ block.settings.option_name | escape }}</legend>
      {%- liquid
        assign metafield_parts = block.settings.option_value_metafield | split: '.'
        assign metafield_namespace = metafield_parts | first
        assign metafield_key = metafield_parts | last
      -%}
      <div class="form__label flex items-center justify-between gap-2 w-full">
        <div class="flex gap-2">
          <span style="{% if block.settings.label_weight and block.settings.label_weight != 'default' %}font-weight: {{ block.settings.label_weight }} !important;{% endif %}">{{ block.settings.option_name | escape }}:</span>
          <span style="{% if block.settings.value_weight and block.settings.value_weight != 'default' %}font-weight: {{ block.settings.value_weight }} !important;{% endif %}">{{ product.metafields[metafield_namespace][metafield_key].value | escape }}</span>
        </div>
        {%- if is_size -%}
          <div class="flex items-center gap-2">
            <button type="button" class="link leading-tight cursor-pointer font-bold" aria-controls="SizeChart-{{ section_id }}-{{ product_id }}" aria-expanded="false" style="{% if block.settings.size_guide_font_size and block.settings.size_guide_font_size > 0 %}font-size: {{ block.settings.size_guide_font_size }}px;{% else %}font-size: 14px;{% endif %}">
              {{- 'products.general.size_chart' | t -}}
            </button>
            <x-modal id="SizeChart-{{ section_id }}-{{ product_id }}" class="x-modal drawer z-30 fixed bottom-0 left-0 h-full w-full pointer-events-none"
              role="dialog"
              aria-modal="true"
              aria-label="{{ block.settings.size_chart.title | escape }}"
              hidden
            >
              <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="SizeChart-{{ section_id }}-{{ product_id }}" aria-expanded="false"></overlay-element>
              <div class="drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden">
                <gesture-element class="drawer__header flex justify-between opacity-0 invisible relative" tabindex="0">
                  <span class="drawer__title heading title-md">{{ block.settings.size_chart.title | escape }}</span>
                  <button class="button button--secondary button--close drawer__close hidden sm:flex items-center justify-center" type="button" is="hover-button" aria-controls="SizeChart-{{ section_id }}-{{ product_id }}" aria-expanded="false" aria-label="{{ 'general.accessibility.close' | t | escape }}">
                    <span class="btn-fill" data-fill></span>
                    <span class="btn-text">
                      {%- render 'icon', icon: 'close', size: 'sm' -%}
                    </span>
                  </button>
                </gesture-element>
                <div class="drawer__content opacity-0 invisible flex flex-col h-full grow shrink">
                  <div class="drawer__scrollable relative flex flex-col gap-5 md:gap-7 grow shrink">
                    <div class="rte text-base md:text-lg">{{ block.settings.size_chart.content }}</div>
                  </div>
                </div>
              </div>
            </x-modal>
          </div>
        {%- endif -%}
      </div>
      <ul class="swatches swatches--{{ settings.rounded_swatch }}{% if block.settings.color_swatch_type == 'variant' %} swatches--variant{% endif %} flex items-start flex-wrap gap-4"
          style="
            {%- if block.settings.swatch_min_width and block.settings.swatch_min_width > 0 -%}
              display: flex !important;
              flex-wrap: wrap !important;
              justify-content: flex-start !important;
              align-items: flex-start !important;
              grid-template-columns: none !important;
            {%- endif -%}
            {%- if block.settings.swatch_radius and block.settings.swatch_radius > 0 -%}--xy-swatch-radius: {{ block.settings.swatch_radius }}px;{%- endif -%}
            {%- if block.settings.swatch_min_width and block.settings.swatch_min_width > 0 -%}--xy-swatch-min-width: {{ block.settings.swatch_min_width }}px;{%- endif -%}
            {%- if block.settings.swatch_padding_y and block.settings.swatch_padding_y > 0 -%}--xy-swatch-pad-y: {{ block.settings.swatch_padding_y }}px;{%- endif -%}
          ">
        {%- for product_variation in block.settings.products -%}
          {%- assign value = product_variation.metafields[metafield_namespace][metafield_key].value -%}
          <li style="{% if block.settings.swatch_min_width and block.settings.swatch_min_width > 0 %}flex: 0 0 auto; width: var(--xy-swatch-min-width);{% endif %}">
            <magnet-element class="block" style="{% if block.settings.swatch_min_width and block.settings.swatch_min_width > 0 %}width: var(--xy-swatch-min-width);{% endif %}">
              <input
                type="radio"
                class="sr-only{% unless product_variation.available %} disabled{% endunless %}"
                id="{{ section_id }}-{{ product_id }}-{{ block.settings.option_name | handle }}-{{ forloop.index0 }}"
                {% if product_variation == product %}checked{% endif %}
                tabindex="-1"
              />
              {%- if is_color or value.swatch != blank -%}
                {%- liquid
                  assign file_extension = 'png'
                  assign file_name = value | handle | append: '.' | append: file_extension
                  assign swatch_fallback = value | split: ' ' | last | handle
                  assign swatch_fallback_override = false
                  assign swatch_image = blank
                  assign swatch_config_matched = false

                  comment
                    优先解析主题自定义 swatch_config (优先级高于 Shopify 原生 value.swatch).
                  endcomment
                  if settings.swatch_config != blank
                    assign value_downcase = value | downcase
                    assign swatch_config_arr = settings.swatch_config | newline_to_br | split: '<br />'
                    for sw_line in swatch_config_arr
                      assign sw_parts = sw_line | strip | split: ':'
                      assign sw_name = sw_parts.first | downcase | strip
                      assign sw_ashley_alias = 'ashley ' | append: value_downcase
                      if sw_name == value_downcase or sw_name == sw_ashley_alias
                        comment
                          用 remove_first 安全取右半, 避免 split.last 切丢 'https:' 前缀.
                        endcomment
                        assign sw_value_raw = sw_line | strip | remove_first: sw_parts.first | remove_first: ':'
                        assign sw_value = sw_value_raw | strip
                        if sw_value contains '#'
                          assign swatch_fallback = sw_value
                          assign swatch_fallback_override = true
                        else
                          assign file_name = sw_value
                        endif
                        assign swatch_config_matched = true
                        break
                      endif
                    endfor
                  endif

                  if swatch_config_matched == false and value.swatch != blank
                    if value.swatch.image
                      assign swatch_image = value.swatch.image | image_url: width: 128
                    elsif value.swatch.color
                      assign swatch_fallback = value.swatch.color
                    endif
                  endif

                  if swatch_image == blank and swatch_fallback_override == false
                    if images[file_name] != blank
                      assign swatch_image = images[file_name] | image_url: width: 128
                    elsif file_name contains 'cdn.shopify.com/'
                      assign swatch_image = file_name
                    elsif file_name contains 'http'
                      assign swatch_image = file_name
                    endif
                  endif
  
                  if block.settings.color_swatch_type == 'variant'
                    if product_variation.featured_media
                      assign swatch_image = product_variation.featured_media | image_url: width: 128
                      assign swatch_fallback_override = false
                    endif
                  endif
                -%}
                <a
                  href="{{ product_variation.url }}"
                  class="color-swatch{% if swatch_image != blank %} with-image{% endif %} block relative{% if block.settings.color_swatch_type == 'variant' and swatch_image != blank %} aspect-{{ image_ratio }} mobile:aspect-{{ image_ratio_mobile }}{% unless image_fill %} aspect-contain{% endunless %}{% endif %}"
                  title="{{ value | escape }}"
                  style="--swatch-background: {{ swatch_fallback }};{% if swatch_fallback_override == false and swatch_image != blank %}--swatch-background-image: url({{ swatch_image }});{% endif %}"
                >
                  <span class="tooltip opacity-0 pointer-events-none text-xs rounded-full z-10">{{ value | escape }}</span>
                </a>
              {%- else -%}
                <a
                  href="{{ product_variation.url }}"
                  class="label-swatch text-sm font-medium leading-none cursor-pointer block relative"
                  title="{{ value | escape }}"
                  style="
                    {%- if block.settings.swatch_radius and block.settings.swatch_radius > 0 -%}border-radius: var(--xy-swatch-radius) !important;{%- endif -%}
                    {%- if block.settings.swatch_min_width and block.settings.swatch_min_width > 0 -%}width: var(--xy-swatch-min-width) !important; min-width: var(--xy-swatch-min-width);{%- endif -%}
                    {%- if block.settings.swatch_padding_y and block.settings.swatch_padding_y > 0 -%}padding-top: var(--xy-swatch-pad-y) !important; padding-bottom: var(--xy-swatch-pad-y) !important;{%- endif -%}
                    text-align: {{ block.settings.swatch_text_align | default: 'left' }};
                  "
                >
                  {{- value -}}
                </a>
              {%- endif -%}
            </magnet-element>
          </li>
        {%- endfor -%}
      </ul>
    </fieldset>
  </div>
{%- endif -%}
